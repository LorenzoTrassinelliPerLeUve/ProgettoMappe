    private void CopiaStile(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value as string, out var id) && _elenco?.Vigneti.FirstOrDefault(v => v.Id == id)?.StileConfigurato is { } stile)
            _bloccoStile = stile;
    }

    private Task SalvaStiliAsync(IReadOnlyList<int> vigneti)
    {
        var dati = vigneti.Select(v => (object)new StileBilancioDto(v, _bloccoStile, _bloccoDal, null)).ToList();
        return SalvaBloccoAsync(TipoStile, dati, false,
            $"Salvato: stile «{ConfigurazioneWeb.StileBreve(_bloccoStile)}» dal {_bloccoDal.ToString("d/M/yyyy", It)} a {Quanti(dati.Count)}");
    }

    private static (CalibrazioneBilancioDto? Dati, string? Errore) Calibrazione(int idVigneto, ModuloCalibrazione m)
    {
        var dati = new CalibrazioneBilancioDto(idVigneto, ConfigurazioneWeb.Numero(m.Scheletro), ConfigurazioneWeb.Numero(m.Profondita),
            ConfigurazioneWeb.Numero(m.Larghezza), ConfigurazioneWeb.Numero(m.Awc));
        var testi = new[] { m.Scheletro, m.Profondita, m.Larghezza, m.Awc };
        var valori = new[] { dati.ScheletroPerc, dati.ProfonditaRadiciM, dati.LarghezzaRadiciM, dati.AwcMm };
        if (testi.Zip(valori).Any(x => !string.IsNullOrWhiteSpace(x.First) && x.Second is null))
            return (null, "Scrivi solo numeri (con la virgola o il punto).");
        var errore = ConfigurazioneWeb.ControllaCalibrazione(dati);
        return errore is null ? (dati, null) : (null, errore);
    }

    private async Task SalvaCalibrazioneAsync(int idVigneto, ModuloCalibrazione m)
    {
        var (dati, errore) = Calibrazione(idVigneto, m);
        if (dati is null)
        {
            _esitiRiga[idVigneto] = new(errore!, false);
            return;
        }
        var vuota = dati is { ScheletroPerc: null, ProfonditaRadiciM: null, LarghezzaRadiciM: null, AwcMm: null };
        if (vuota && _conf?.CalibrazioneDi(idVigneto) is null)
        {
            _esitiRiga[idVigneto] = new("Scrivi almeno un valore.", false);
            return;
        }
        // Tutti vuoti = toglie la calibrazione: si torna ai dati.
        var ok = await SalvaAsync(TipoCalibrazione, dati, vuota, vuota ? $"Tolta la correzione di {Nome(idVigneto)}" : $"Salvato il suolo di {Nome(idVigneto)}");
        _esitiRiga[idVigneto] = ok ? new(vuota ? "Tolta ✓" : "Salvato ✓", true) : new("Non salvato", false);
    }

    private Task SalvaCalibrazioniAsync(IReadOnlyList<int> vigneti, bool togli)
    {
        if (togli)
            return SalvaBloccoAsync(TipoCalibrazione, vigneti.Select(v => (object)new CalibrazioneBilancioDto(v)).ToList(), true,
                $"Tolte le correzioni del suolo a {Quanti(vigneti.Count)}: si torna ai dati di 4Grapes");
        // Le caselle vuote della barra non cambiano il valore già scritto nel vigneto.
        var b = _bloccoSuolo;
        var dati = new List<object>();
        foreach (var v in vigneti)
        {
            var attuale = _conf?.CalibrazioneDi(v)?.Dati;
            var m = new ModuloCalibrazione
            {
                Scheletro = string.IsNullOrWhiteSpace(b.Scheletro) ? Testo(attuale?.ScheletroPerc) : b.Scheletro,
                Profondita = string.IsNullOrWhiteSpace(b.Profondita) ? Testo(attuale?.ProfonditaRadiciM) : b.Profondita,
                Larghezza = string.IsNullOrWhiteSpace(b.Larghezza) ? Testo(attuale?.LarghezzaRadiciM) : b.Larghezza,
                Awc = string.IsNullOrWhiteSpace(b.Awc) ? Testo(attuale?.AwcMm) : b.Awc,
            };
            var (d, errore) = Calibrazione(v, m);
            if (d is null)
            {
                _esito = new(errore!, false);
                return Task.CompletedTask;
            }
            dati.Add(d);
        }
        if (new[] { b.Scheletro, b.Profondita, b.Larghezza, b.Awc }.All(string.IsNullOrWhiteSpace))
        {
            _esito = new("Scrivi almeno un valore nella barra in basso.", false);
            return Task.CompletedTask;
        }
        return SalvaBloccoAsync(TipoCalibrazione, dati, false, $"Salvati i valori del suolo di {Quanti(dati.Count)}");
    }

    private static string? Testo(double? v) => v?.ToString("0.###", CultureInfo.InvariantCulture);

    private Task SalvaStiliTargetAsync()
    {
        if (_conf is null)
            return Task.CompletedTask;
        var stili = _stiliTarget.Select(t => new StileTargetWeb(t.IdTarget, t.Descrizione, t.Stile == 0 ? null : t.Stile));
        return SalvaAsync(TipoModello, _conf.ModelloConStili(stili), fatto: "Salvata la corrispondenza: si ricalcolano tutte le aziende");
    }


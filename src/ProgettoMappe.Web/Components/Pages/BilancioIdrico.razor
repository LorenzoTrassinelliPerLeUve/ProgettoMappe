@page "/bilancio-idrico"
@using System.Globalization
@using Microsoft.Extensions.Logging
@using ProgettoMappe.Contracts
@using ProgettoMappe.Web.BilancioIdrico
@inject AziendeApiClient AziendeApiClient
@inject VignetiApiClient VignetiApiClient
@inject BilancioIdricoApiClient BilancioApi
@inject NavigationManager Navigation
@inject ILogger<BilancioIdrico> Logger

<PageTitle>Bilancio idrico</PageTitle>

@* DSS Bilancio Idrico, fase 3 (task #335, punto C): lo stato idrico di oggi dei vigneti dell'azienda, dal ricalcolo notturno. *@
<div class="contenitore bilancio-idrico">
    <header class="intestazione-pagina">
        <h1 class="titolo-pagina">Bilancio idrico</h1>
        <p class="sottotitolo">Acqua nel suolo, stress della vite e consiglio irriguo di oggi e dei prossimi giorni, per vigneto e per settore.</p>
    </header>

    @if (_errore is not null)
    {
        <div class="messaggio-errore" role="alert">
            <p>@_errore</p>
            <button type="button" class="pulsante-principale" @onclick="CaricaAsync">Riprova</button>
        </div>
    }
    else if (_aziende is null)
    {
        <p class="aziende-stato" role="status">Carico le aziende…</p>
    }
    else
    {
        <div class="ib-filtri">
            <label>
                <span>Azienda</span>
                <select value="@(Azienda?.ToString(CultureInfo.InvariantCulture) ?? "")" @onchange="e => CambiaAzienda(e.Value as string)">
                    <option value="">Scegli un'azienda…</option>
                    @foreach (var a in _aziende)
                    {
                        <option value="@a.Id">@a.Nome</option>
                    }
                </select>
            </label>
            @if (Azienda is not null)
            {
                <label>
                    <span>Ordine</span>
                    <select value="@(_perNome ? "nome" : "urgenza")" @onchange="CambiaOrdine">
                        <option value="urgenza">Per urgenza</option>
                        <option value="nome">Per nome</option>
                    </select>
                </label>
            }
        </div>

        @if (Azienda is { } azienda)
        {
            @if (_stato is null)
            {
                <p class="aziende-stato" role="status">Carico il bilancio…</p>
            }
            else
            {
                var stato = _stato;
                @* Task #378: una riga corta su quando è aggiornato; motore, parametri e regole in «Come è calcolato». *@
                <div class="bi-calcolo">
                    <span class="nota">@TestiBilancio.Aggiornato(stato.Calcolo)</span>
                    <button type="button" class="pulsante" disabled="@_ricalcolo" @onclick="RicalcolaAsync">@(_ricalcolo ? "Ricalcolo…" : "Ricalcola ora")</button>
                    <a class="pulsante" href="@($"bilancio-idrico/configurazione?azienda={azienda}")">Configurazione</a>
                </div>
                @if (stato.Calcolo is { ErroreDopo: { } err, ErroreIlUtc: { } quando })
                {
                    <p class="nota bi-avviso">L'ultimo tentativo (@TestiBilancio.Calcolato(quando)) non è riuscito: @err. I numeri sono quelli del calcolo precedente.</p>
                }
                @if (stato.Calcolo is { RicalcoloInAttesa: true })
                {
                    <p class="nota bi-avviso">La configurazione è cambiata: il ricalcolo dell'azienda è in corso, ricarica fra un minuto.</p>
                }
                @if (_messaggio is not null)
                {
                    <p class="nota bi-avviso" role="status">@_messaggio</p>
                }

                @if (stato.Vigneti.Count > 0)
                {
                    var vigneti = _perNome ? stato.Vigneti.OrderBy(v => Nome(v.IdVigneto)).ToList() : stato.Vigneti;
                    var riassunto = TestiBilancio.Riassunto(stato.Vigneti);
                    @* Task #378: la risposta alla domanda «irrigo oggi?» viene prima di tutto il resto. *@
                    <h2 class="titolo-sezione">Oggi, @TestiBilancio.Giorno(stato.Oggi)</h2>
                    <div class="bi-riassunto" role="status">
                        <div class="bi-tessera @(riassunto.Irrigare > 0 ? "bi-irrigare" : "bi-na")"><strong>@riassunto.Irrigare</strong> da irrigare
                            @if (riassunto.MmMassimi is { } mm)
                            {
                                <small>fino a @TestiBilancio.Mm(mm)</small>
                            }
                        </div>
                        <div class="bi-tessera bi-non-irrigare"><strong>@riassunto.NonIrrigare</strong> non irrigare</div>
                        <div class="bi-tessera bi-na"><strong>@riassunto.SenzaSuggerimento</strong> senza suggerimento</div>
                    </div>
                    @if (riassunto.Perche is { } perche)
                    {
                        <p class="bi-perche">Senza suggerimento: @perche.</p>
                    }

                    @* Telefono: una scheda per vigneto, niente tabelle larghe. *@
                    <ul class="bi-vigneti solo-mobile">
                        @foreach (var v in vigneti)
                        {
                            var note = TestiBilancio.AnomalieRiga(v, stato.Anomalie, stato.Vigneti.Count);
                            <li>
                                <div class="bi-vigneto-testa">
                                    <a href="@($"mappa/{azienda}?vigneto={v.IdVigneto}")">@Nome(v.IdVigneto)</a>
                                    <span class="bi-sugg @TestiBilancio.Classe(v.Suggerimento)">@TestiBilancio.Suggerimento(v.Suggerimento)@(v.Suggerimento == "IRRIGARE" ? $" {TestiBilancio.Mm(v.IrrigazioneSuggeritaMm)}" : "")</span>
                                </div>
                                @if (v.Settori.Count > 0)
                                {
                                    @* Task #405: «Ho irrigato» sulla riga, con ore e mm del consiglio del suo gruppo. *@
                                    <a class="pulsante bi-piccolo bi-ho-irrigato" href="@HoIrrigato(azienda, v)">Ho irrigato</a>
                                }
                                <ProssimiGiorni Giorni="v.Prossimi.Select(g => (g.Data, g.Suggerimento, g.PdlwpMpa))" />
                                <div class="nota">Stress @TestiBilancio.Stress(v.PdlwpMpa, v.SogliaMpa)@(v.SogliaMpa is null && v.PdlwpMpa is not null ? $" · {TestiBilancio.Soglia(v)}" : "")</div>
                                <div class="nota">Acqua nel suolo @TestiBilancio.Acqua(v.AwMm, v.AwcMm)</div>
                                <a class="bi-vai-link" href="@StoricoBilancio.Indirizzo(azienda, v.IdVigneto)">Giorno per giorno →</a>
                                @if (note.Count > 0)
                                {
                                    <details>
                                        <summary>@note.Count @(note.Count == 1 ? "dato mancante" : "dati mancanti")</summary>
                                        <ul>@foreach (var a in note) { <li>@a</li> }</ul>
                                    </details>
                                }
                            </li>
                        }
                    </ul>

                    <div class="tabella-scorrevole solo-desktop">
                        <table class="tabella-report bi-tabella">
                            <thead>
                                <tr>
                                    <th>Vigneto</th><th>Oggi</th><th>Prossimi giorni</th>
                                    <th title="Potenziale fogliare previsto (Pdlwp, MPa): più è negativo, più la vite soffre">Stress della vite</th>
                                    <th title="Stress voluto per lo stile del vino e la fase">Soglia</th>
                                    <th title="Acqua disponibile (AW) rispetto alla capacità del suolo (AWC)">Acqua nel suolo</th>
                                    <th title="Acqua che manca per tornare alla riserva voluta">Deficit</th><th>Note</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var v in vigneti)
                                {
                                    var note = TestiBilancio.AnomalieRiga(v, stato.Anomalie, stato.Vigneti.Count);
                                    <tr>
                                        <th scope="row"><a href="@($"mappa/{azienda}?vigneto={v.IdVigneto}")">@Nome(v.IdVigneto)</a>
                                            <small><a class="bi-vai-link" href="@StoricoBilancio.Indirizzo(azienda, v.IdVigneto)">giorno per giorno</a></small></th>
                                        <td><span class="bi-sugg @TestiBilancio.Classe(v.Suggerimento)">@TestiBilancio.Suggerimento(v.Suggerimento)@(v.Suggerimento == "IRRIGARE" ? $" {TestiBilancio.Mm(v.IrrigazioneSuggeritaMm)}" : "")</span>
                                            @if (v.Settori.Count > 0) { <a class="pulsante bi-piccolo" href="@HoIrrigato(azienda, v)">Ho irrigato</a> }</td>
                                        <td><ProssimiGiorni Giorni="v.Prossimi.Select(g => (g.Data, g.Suggerimento, g.PdlwpMpa))" /></td>
                                        <td class="@(v.PdlwpMpa < v.SogliaMpa ? "bi-oltre" : null)">@TestiBilancio.Mpa(v.PdlwpMpa)</td>
                                        <td>@TestiBilancio.Soglia(v)</td>
                                        <td>@TestiBilancio.Acqua(v.AwMm, v.AwcMm)</td>
                                        <td>@TestiBilancio.Mm(v.DeficitMm)</td>
                                        <td class="bi-note">
                                            @TestiBilancio.Criticita(v)
                                            @if (note.Count > 0)
                                            {
                                                <details>
                                                    <summary>@note.Count @(note.Count == 1 ? "dato mancante" : "dati mancanti")</summary>
                                                    <ul>@foreach (var a in note) { <li>@a</li> }</ul>
                                                </details>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <p class="nota">Stress della vite = potenziale fogliare previsto (Pdlwp, in MPa): più è negativo, più la vite soffre; oltre la soglia (lo stress voluto per lo stile del vino e la fase) si irriga.
                        Prossimi giorni: I = irrigare, · = non irrigare, – = senza suggerimento (manca la soglia), ? = dato non valido; il numero è il giorno del mese, dal giorno di oggi il meteo è previsto.</p>
                }
                else if (stato.Calcolo is not null)
                {
                    <p class="nota">Nessun vigneto calcolato per oggi.</p>
                }

                @if (stato.Settori.Count > 0)
                {
                    <h2 class="titolo-sezione">Settori irrigui</h2>
                    <div class="tabella-scorrevole">
                    <table class="tabella-report bi-tabella">
                        <thead><tr><th>Settore</th><th>Suggeriti</th><th>Ore</th><th>Vigneti</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var s in stato.Settori)
                            {
                                <tr>
                                    <th scope="row">@s.Nome</th>
                                    <td>@TestiBilancio.Mm(s.IrrigazioneSuggeritaMm)</td>
                                    <td>@(s.IrrigazioneSuggeritaOre is null ? "— (impianto non configurato)" : TestiBilancio.Ore(s.IrrigazioneSuggeritaOre))</td>
                                    <td class="bi-note">@string.Join(", ", s.Vigneti.Select(Nome))</td>
                                    @* Task #405: «Ho irrigato» con giorno, ore e mm già scritti dal consiglio. *@
                                    <td><a class="pulsante" href="@($"bilancio-idrico/configurazione?azienda={azienda}&irrigato={s.IdSettore}#irrigato")">Ho irrigato</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                    @if (stato.Shift.Count > 0)
                    {
                        <table class="tabella-report bi-tabella">
                            <thead><tr><th>Shift</th><th>Ore di comando</th><th>Settori</th></tr></thead>
                            <tbody>
                                @foreach (var s in stato.Shift)
                                {
                                    <tr><th scope="row">@s.Nome</th><td>@TestiBilancio.Ore(s.OreComando)</td><td>@s.SettoriCoinvolti</td></tr>
                                }
                            </tbody>
                        </table>
                    }
                }

                var senzaSettore = stato.Vigneti.Where(v => v.Settori.Count == 0).ToList();
                var senzaStile = stato.Vigneti.Where(v => !v.HaStile).ToList();
                @if (senzaSettore.Count > 0 || senzaStile.Count > 0)
                {
                    <h2 class="titolo-sezione">Da configurare</h2>
                    <ul class="bi-da-configurare">
                        @* Task #378: gli elenchi lunghi di nomi si aprono a richiesta. *@
                        @if (senzaStile.Count > 0)
                        {
                            <li><details><summary><strong>@Quanti(senzaStile.Count, stato.Vigneti.Count) senza stile del vino</strong>: niente soglia, niente suggerimento</summary>
                                @string.Join(", ", senzaStile.Select(v => Nome(v.IdVigneto)))</details>
                                @* Task #384: dal dato mancante al campo da compilare, in un clic. *@
                                <div class="bi-vai"><a class="pulsante-principale" href="@VignetiConfigurazione.Indirizzo(azienda, VignetiConfigurazione.Stile, true)">Imposta lo stile</a></div></li>
                        }
                        @if (senzaSettore.Count > 0)
                        {
                            <li><details><summary><strong>@Quanti(senzaSettore.Count, stato.Vigneti.Count) senza settore irriguo</strong>: solo monitoraggio, niente ore di irrigazione</summary>
                                @string.Join(", ", senzaSettore.Select(v => Nome(v.IdVigneto)))</details>
                                <div class="bi-vai"><a class="pulsante" href="@VignetiConfigurazione.Indirizzo(azienda, VignetiConfigurazione.Irrigazione)">Settori e impianti</a></div></li>
                        }
                    </ul>
                    <p><a class="pulsante" href="@($"bilancio-idrico/configurazione?azienda={azienda}")">Apri la configurazione</a></p>
                }

                @if (stato.Anomalie.Count > 0)
                {
                    <h2 class="titolo-sezione">Dati mancanti o da controllare</h2>
                    <ul class="bi-anomalie">
                        @foreach (var a in stato.Anomalie)
                        {
                            <li>
                                @a.Testo
                                @if (TestiBilancio.CosaFare(a.Codice) is { } cosa)
                                {
                                    <div class="bi-cosa-fare"><strong>Cosa fare:</strong> @cosa
                                        @if (VignetiConfigurazione.SezioneDi(a.Codice) is { } sezioneConf)
                                        {
                                            <a class="bi-vai-link" href="@VignetiConfigurazione.Indirizzo(azienda, sezioneConf, a.Codice is "stile" or "suolo")">Apri nella configurazione →</a>
                                        }
                                    </div>
                                }
                                @if (a.Vigneti.Count > 0)
                                {
                                    <details class="nota"><summary>@Quanti(a.Vigneti.Count, stato.Vigneti.Count)</summary>@string.Join(", ", a.Vigneti.Select(Nome))</details>
                                }
                            </li>
                        }
                    </ul>
                }
                <details class="bi-come">
                    <summary>Come è calcolato</summary>
                    <p class="nota">@TestiBilancio.Calcolo(stato.Calcolo)</p>
                    @if (TestiBilancio.Preset(stato.Calcolo) is { } preset)
                    {
                        <p class="nota">@preset
                            @if (stato.CambiRispettoAComeOggi is { } cambi)
                            {
                                <span> Con le regole del vecchio motore oggi cambierebbe il suggerimento di @cambi @(cambi == 1 ? "vigneto" : "vigneti").</span>
                            }
                        </p>
                    }
                    <p class="nota">Ogni notte, dal 1° gennaio, con il meteo, la fenologia e i rilievi del suolo di 4Grapes e la configurazione di Mappe.
                        Le grandezze giorno per giorno (ET0, Kc, ETa, acqua disponibile) sono nella scheda del vigneto sulla mappa.</p>
                </details>
            }
        }
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "azienda")] private int? Azienda { get; set; }

    private List<AziendaDto>? _aziende;
    private BilancioAziendaDto? _stato;
    private int? _statoAzienda;
    private Dictionary<int, string> _nomi = [];
    private string? _errore;
    private string? _messaggio;
    private bool _perNome;
    private bool _ricalcolo;

    private string Nome(int id) => _nomi.TryGetValue(id, out var n) ? n : $"Vigneto {id}";

    /// <summary>Task #405: «Ho irrigato» del vigneto = modulo della configurazione sul suo (primo) gruppo irriguo.</summary>
    private static string HoIrrigato(int azienda, StatoVignetoBilancioDto v) =>
        $"bilancio-idrico/configurazione?azienda={azienda}&irrigato={v.Settori[0]}#irrigato";

    private static string Quanti(int n, int su) => n == su ? $"Tutti i {n} vigneti" : n == 1 ? "1 vigneto" : $"{n} vigneti su {su}";

    protected override async Task OnParametersSetAsync()
    {
        if (_aziende is null)
            await CaricaAsync();
        else if (Azienda != _statoAzienda)
            await CaricaStatoAsync();
    }

    private async Task CaricaAsync()
    {
        _errore = null;
        try
        {
            _aziende = (await AziendeApiClient.GetAziendeAsync()).OrderBy(a => a.Nome).ToList();
            await CaricaStatoAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning("Pagina Bilancio idrico: aziende non lette ({Messaggio})", ex.Message);
            _errore = "Non riesco a leggere le aziende, riprova.";
        }
    }

    private async Task CaricaStatoAsync()
    {
        _stato = null;
        _messaggio = null;
        _statoAzienda = Azienda;
        if (Azienda is not { } id)
            return;
        try
        {
            var nomi = VignetiApiClient.GetVignetiPerAziendaAsync(id);
            _stato = await BilancioApi.GetStatoAziendaAsync(id);
            if (_stato is null)
            {
                _errore = "Azienda non trovata.";
                return;
            }
            _nomi = (await nomi).Vigneti.ToDictionary(v => v.Id, v => v.Nome);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning("Pagina Bilancio idrico: azienda {Azienda} non letta ({Messaggio})", id, ex.Message);
            _errore = "Non riesco a leggere il bilancio di questa azienda, riprova.";
        }
    }

    private async Task RicalcolaAsync()
    {
        if (Azienda is not { } id)
            return;
        _ricalcolo = true;
        _messaggio = null;
        try
        {
            var esito = await BilancioApi.RicalcolaAsync(id);
            await CaricaStatoAsync();
            _messaggio = esito.Errore is null ? "Ricalcolato adesso." : $"Ricalcolo non riuscito: {esito.Errore}";
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            _messaggio = "Il ricalcolo non ha risposto in tempo: riprova fra qualche minuto.";
        }
        finally
        {
            _ricalcolo = false;
        }
    }

    private void CambiaOrdine(ChangeEventArgs e) => _perNome = e.Value as string == "nome";

    private void CambiaAzienda(string? valore) =>
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("azienda", int.TryParse(valore, out var id) ? id : null));
}

        @if (c.Settori.Count == 0)
        {
            <p class="nota">Le irrigazioni si registrano su un settore o su un turno: prima crea un settore in «Settori e impianti».</p>
            return;
        }
        <p class="nota">Il bilancio aggiunge l'acqua data al suolo dei vigneti del settore. Con le ore, i mm li calcola dall'impianto (mm in un'ora × efficienza).</p>
        <div class="bi-modulo">
            <strong>Registra un'irrigazione</strong>
            <label>Giorno <input type="date" @bind="_irrigazione.Data" /></label>
            <label>
                Dove
                <select @bind="_irrigazione.Dove">
                    <option value="">—</option>
                    @foreach (var s in c.Settori) { <option value="@($"s{s.Dati.IdSettore}")">Settore: @s.Dati.Nome</option> }
                    @foreach (var s in c.Shift) { <option value="@($"h{s.Dati.IdShift}")">Turno: @s.Dati.Nome</option> }
                </select>
            </label>
            <label>Ore <input @bind="_irrigazione.Ore" inputmode="decimal" size="4" /></label>
            <label>oppure mm <input @bind="_irrigazione.Mm" inputmode="decimal" size="4" /></label>
            <button type="button" class="pulsante-principale" disabled="@(_login is null || _salvo)" @onclick="SalvaIrrigazioneAsync">Registra</button>
        </div>
        @if (c.Irrigazioni.Count > 0)
        {
            <table class="tabella-report bi-tabella bi-conf-tabella">
                <thead><tr><th>Giorno</th><th>Dove</th><th>Ore</th><th>mm</th><th class="bi-modifica">Registrata</th><th></th></tr></thead>
                <tbody>
                    @foreach (var i in c.Irrigazioni.Take(60))
                    {
                        var d = i.Dati;
                        <tr>
                            <td>@d.Data.ToString("d/M/yyyy", It)</td>
                            <td>@(d.IdSettore is { } se ? c.NomeSettore(se) : d.IdShift is { } sh ? "turno " + c.NomeShift(sh) : "—")</td>
                            <td>@TestiBilancio.Numero(d.DurataOre, "0.0")</td>
                            <td class="@(ConfigurazioneWeb.IrrigazioneImplausibile(d.VolumeMm) ? "bi-oltre" : "")">
                                @TestiBilancio.Numero(d.VolumeMm, "0.0")
                                @if (ConfigurazioneWeb.IrrigazioneImplausibile(d.VolumeMm))
                                {
                                    <small class="bi-manca">da controllare: controlla l'impianto</small>
                                }
                            </td>
                            <td class="nota bi-modifica">@Modifica(i)</td>
                            <td><button type="button" class="pulsante" disabled="@(_login is null || _salvo)" @onclick="() => Togli(TipoIrrigazione, d)">Togli</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    };

    private Task Togli(string tipo, object dati, string? cosa = null) => SalvaAsync(tipo, dati, true, tipo switch
    {
        TipoSettore => $"Tolto il settore {cosa}",
        TipoQuota => $"Tolto {cosa} dal settore",
        TipoImpianto => "Tolto l'impianto",
        TipoShift => $"Tolto il turno {cosa}",
        TipoIrrigazione => "Tolta l'irrigazione",
        _ => "Tolto",
    });

    private void ModificaSettore(SettoreBilancioDto s) =>
        _settore = new ModuloSettore { Id = s.IdSettore, Nome = s.Nome, Ettari = s.SuperficieM2 is { } m2 ? (m2 / 10_000).ToString("0.####", It) : null, Attivo = s.Attivo };

    private async Task SalvaSettoreAsync()
    {
        if (string.IsNullOrWhiteSpace(_settore.Nome))
        {
            _esito = new("Dai un nome al settore.", false);
            return;
        }
        var ettari = ConfigurazioneWeb.Numero(_settore.Ettari);
        if (ettari is <= 0 or > 1000)
        {
            _esito = new("La superficie va fra 0 e 1.000 ettari (o lasciala vuota).", false);
            return;
        }
        if (await SalvaAsync(TipoSettore, new SettoreBilancioDto(_settore.Id, Azienda!.Value, _settore.Nome.Trim(), ettari * 10_000, _settore.Attivo),
                fatto: $"Salvato il settore {_settore.Nome.Trim()}"))
            _settore = new();
    }

    private Task SalvaQuotaAsync()
    {
        if (_quota.Vigneto == 0 || _quota.Settore == 0 || ConfigurazioneWeb.Numero(_quota.Percentuale) is not { } perc || perc is <= 0 or > 100)
        {
            _esito = new("Scegli vigneto e settore e scrivi la parte del vigneto fra 1 e 100 %.", false);
            return Task.CompletedTask;
        }
        return SalvaAsync(TipoQuota, new QuotaBilancioDto(_quota.Settore, _quota.Vigneto, perc), fatto: $"Salvato: {Nome(_quota.Vigneto)} nel settore");
    }

    private Task SalvaImpiantoAsync()
    {
        var i = _impianto;
        if (i.Settore == 0)
        {
            _esito = new("Scegli il settore dell'impianto.", false);
            return Task.CompletedTask;
        }
        var portata = ConfigurazioneWeb.Numero(i.Portata);
        var gocc = ConfigurazioneWeb.Numero(i.Gocciolatori);
        var ali = ConfigurazioneWeb.Numero(i.Ali);
        var tasso = ConfigurazioneWeb.Numero(i.Tasso) ?? ConfigurazioneWeb.TassoDaGocciolatori(portata, gocc, ali);
        var eff = ConfigurazioneWeb.Numero(i.Efficienza);
        if (ConfigurazioneWeb.ControllaImpianto(gocc, ali, portata, tasso, eff) is { } errore)
        {
            _esito = new(errore, false);
            return Task.CompletedTask;
        }
        return SalvaAsync(TipoImpianto, new ImpiantoBilancioDto(i.Settore, i.Dal, null, i.Tipologia, gocc, ali, portata, tasso, eff),
            fatto: "Salvato l'impianto");
    }

    private async Task SalvaShiftAsync()
    {
        if (string.IsNullOrWhiteSpace(_shiftNome))
        {
            _esito = new("Dai un nome al turno.", false);
            return;
        }
        if (await SalvaAsync(TipoShift, new ShiftBilancioDto(0, Azienda!.Value, _shiftNome.Trim()), fatto: $"Salvato il turno {_shiftNome.Trim()}"))
            _shiftNome = "";
    }

    private Task SalvaSettoreShiftAsync()
    {
        if (_settoreShift.Shift == 0 || _settoreShift.Settore == 0)
        {
            _esito = new("Scegli turno e settore.", false);
            return Task.CompletedTask;
        }
        return SalvaAsync(TipoSettoreShift, new SettoreShiftBilancioDto(_settoreShift.Shift, _settoreShift.Settore, _settoreShift.Dal, null),
            fatto: "Salvato il settore nel turno");
    }

    private async Task SalvaIrrigazioneAsync()
    {
        var ir = _irrigazione;
        var ore = ConfigurazioneWeb.Numero(ir.Ore);
        var mm = ConfigurazioneWeb.Numero(ir.Mm);
        int? settore = ir.Dove.StartsWith('s') && int.TryParse(ir.Dove[1..], out var s) ? s : null;
        int? shift = ir.Dove.StartsWith('h') && int.TryParse(ir.Dove[1..], out var h) ? h : null;
        if (settore is null && shift is null)
        {
            _esito = new("Scegli il settore o il turno.", false);
            return;
        }
        if (ConfigurazioneWeb.ControllaIrrigazione(ore, mm) is { } errore)
        {
            _esito = new(errore, false);
            return;
        }
        if (await SalvaAsync(TipoIrrigazione, new IrrigazioneBilancioDto(0, Azienda!.Value, ir.Data, settore, shift, ore, mm),
                fatto: $"Registrata l'irrigazione del {ir.Data.ToString("d/M", It)}"))
            _irrigazione = new();
    }
}

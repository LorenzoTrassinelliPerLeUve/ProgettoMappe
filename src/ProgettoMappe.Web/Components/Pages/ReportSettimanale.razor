@page "/report-settimanale"
@using System.Globalization
@using Microsoft.Extensions.Logging
@using ProgettoMappe.Contracts
@using ProgettoMappe.Web.ReportFineStagione
@using ProgettoMappe.Web.ReportSettimanale
@using ProgettoMappe.Web.Tematismi
@inject AziendeApiClient AziendeApiClient
@inject VignetiApiClient VignetiApiClient
@inject NavigationManager Navigation
@inject ILogger<ReportSettimanale> Logger

<PageTitle>@T("titolo")</PageTitle>

<div class="contenitore indice-bigot report-fine-stagione">
    <header class="intestazione-pagina">
        <h1 class="titolo-pagina">@T("titolo")</h1>
        <p class="sottotitolo">@T("pagina.sottotitolo")</p>
    </header>

    @if (_aziende is null && _errore is null)
    {
        <p class="aziende-stato" role="status">@T("carico")</p>
    }
    else
    {
        <div class="ib-filtri">
            <label>
                <span>@T("filtro.azienda")</span>
                <select value="@(Azienda?.ToString(CultureInfo.InvariantCulture) ?? "")" @onchange="e => Cambia(azienda: Numero(e.Value))">
                    <option value="">@T("filtro.scegli")</option>
                    @foreach (var a in _aziende ?? [])
                    {
                        <option value="@a.Id">@a.Nome</option>
                    }
                </select>
            </label>
            <label>
                <span>@T("filtro.settimana")</span>
                <select value="@SettimanaScelta.Codice" @onchange="e => Cambia(settimana: e.Value as string)">
                    @foreach (var s in SettimanaReport.Elenco(Oggi))
                    {
                        <option value="@s.Codice">@s.Etichetta(Lingua)</option>
                    }
                </select>
            </label>
            <label>
                <span>@T("filtro.lingua")</span>
                <select value="@TestiReport.Codice(Lingua)" @onchange="e => Cambia(lingua: e.Value as string)">
                    <option value="it">Italiano</option>
                    <option value="en">English</option>
                </select>
            </label>
        </div>

        @if (_errore is not null)
        {
            <div class="messaggio-errore" role="alert">
                <p>@_errore</p>
                <button type="button" class="pulsante-principale" @onclick="CaricaAsync">@T("riprova")</button>
            </div>
        }
        else if (Azienda is not null && _rilievi is null)
        {
            <p class="aziende-stato" role="status">@T("carico")</p>
        }
        else if (_rilievi is { } rilievi && NomeAzienda is { } nome)
        {
            var s = SettimanaScelta;
            var anno = s.Anno;
            var selezione = SelezioneSettimanale.Di(new DatiSettimanale(nome, s, rilievi, _campo));
            var sel = selezione.Settimana;
            var stagione = selezione.Stagione;
            var superfici = selezione.Superfici;
            var nomi = (_campo?.Vigneti ?? []).ToDictionary(v => v.IdVigneto);
            var settimane = Enumerable.Range(1, s.Numero).ToList();
            var etichette = settimane.Select(SettimanaQlik.Etichetta).ToList();
            var cultura = TestiReport.Cultura(Lingua);
            var parametri = $"azienda={Azienda}&settimana={s.Codice}&lingua={TestiReport.Codice(Lingua)}";

            <p class="rfs-scarica">
                <a href="@($"report-settimanale/powerpoint?{parametri}")" download data-enhance-nav="false">@T("scarica.powerpoint")</a>
                · <a href="@($"report-settimanale/pdf?{parametri}")" target="_blank" rel="noopener" data-enhance-nav="false">@T("scarica.pdf")</a>
            </p>

            @if (CalcoloSettimanale.TestiControlli(rilievi.Riepilogo, s, sel.Count, T) is { Count: > 0 } controlli)
            {
                <div class="rfs-controlli" role="note">
                    <h2>@T("controlli.titolo")</h2>
                    <ul>
                        @foreach (var riga in controlli)
                        {
                            <li>@riga</li>
                        }
                    </ul>
                </div>
            }

            @foreach (var sezione in SezioniSettimanale.Della(Lingua))
            {
                <section class="ib-sezione">
                    @switch (sezione.Chiave)
                    {
                        case "sezione.copertina":
                            <h2>@T("titolo")</h2>
                            <p class="rfs-azienda">@nome</p>
                            <p>@s.Etichetta(Lingua) · @T("cruscotto.al", s.A.ToString("dd/MM", CultureInfo.InvariantCulture))</p>
                            <p class="nota">@T("generato.il", Oggi.ToString("d", cultura))</p>
                            <p class="nota">@(rilievi.Snapshot is { } costruito
                                ? T("dati.snapshot", TimeZoneInfo.ConvertTime(costruito, TematismiBigot.FusoItalia).ToString("g", cultura))
                                : T("dati.diretti"))</p>
                            break;

                        case "sezione.dashboard":
                            var c = CalcoloSettimanale.Cruscotto(sel, nomi.Count);
                            <h2>@T(sezione.Chiave)</h2>
                            <p class="nota">@T("cruscotto.al", s.A.ToString("dd/MM", CultureInfo.InvariantCulture))</p>
                            <div class="ib-kpi">
                                <Kpi Nome="@T("cruscotto.rilievi")" Valore="@c.Rilievi.ToString("N0", cultura)" />
                                <Kpi Nome="@T("cruscotto.organi")" Valore="@c.Organi.ToString("N0", cultura)" />
                                <Kpi Nome="@T("cruscotto.monitorati")" Valore="@c.Monitorati.ToString(cultura)" />
                                <Kpi Nome="@T("cruscotto.totali")" Valore="@c.VignetiTotali.ToString(cultura)" />
                                <Kpi Nome="@T("cruscotto.percentuale")" Valore="@(c.VignetiTotali > 0 ? ((double)c.Monitorati / c.VignetiTotali).ToString("P0", cultura) : "—")" />
                            </div>
                            @if (c.PerTipo.Count > 0)
                            {
                                <GraficoLineeReport Cultura="cultura" Etichette="@c.PerTipo.Select(t => NomeTipo(rilievi, t.Tipo)).ToList()"
                                    Serie="@([new GraficoLineeReport.SerieGrafico(T("cruscotto.rilievi"), "#8dc63e", c.PerTipo.Select(t => (decimal?)t.Rilievi).ToList(), true)])" />
                            }
                            break;

                        case "sezione.meteo":
                            var meteo = CalcoloSettimanale.Meteo(rilievi.Meteo, anno, settimane);
                            <h2>@T(sezione.Chiave)</h2>
                            <p class="nota">@T("meteo.nota")</p>
                            @if (meteo.Pioggia.All(v => v is null) && meteo.TMedia.All(v => v is null))
                            {
                                <p class="nota">@T("meteo.vuoto")</p>
                            }
                            else
                            {
                                <GraficoLineeReport Cultura="cultura" Etichette="etichette" Serie="@([
                                    new GraficoLineeReport.SerieGrafico(T("meteo.pioggia"), "#3c6fb4", Dec(meteo.Pioggia), true),
                                    new GraficoLineeReport.SerieGrafico(T("meteo.tmin"), "#5f727f", Dec(meteo.TMin)),
                                    new GraficoLineeReport.SerieGrafico(T("meteo.tmed"), "#8dc63e", Dec(meteo.TMedia)),
                                    new GraficoLineeReport.SerieGrafico(T("meteo.tmax"), "#c0392b", Dec(meteo.TMax)),
                                ])" />
                            }
                            break;

                        case "sezione.sanita-grappoli" or "sezione.sanita-foglia":
                            <h2>@T(sezione.Chiave)</h2>
                            @if (sezione.Chiave == "sezione.sanita-grappoli")
                            {
                                <p>@CalcoloSettimanale.RiassuntoGrappolo(sel, superfici, rilievi.Danni, anno, cultura, T)</p>
                            }
                            <div class="ib-tabella-scorre">
                                <table class="ib-tabella">
                                    <thead><tr><th></th><th class="numero">@T("kpi.intensita")</th><th class="numero">@T("kpi.diffusione")</th>
                                        <th class="numero">@T("kpi.senza-danno")</th><th class="numero">@T("kpi.copertura")</th></tr></thead>
                                    <tbody>
                                        @foreach (var k in CalcoloSettimanale.Sanita(sel, superfici, sezione.Chiave == "sezione.sanita-grappoli" ? CalcoloSettimanale.Grappolo : CalcoloSettimanale.Foglia))
                                        {
                                            <tr><td>@T(k.Avversita.Chiave)</td><td class="numero">@k.Intensita.ToString("P1", cultura)</td>
                                                <td class="numero">@k.Diffusione.ToString("P1", cultura)</td>
                                                <td class="numero">@(k.SenzaDanno?.ToString("P0", cultura) ?? "—")</td>
                                                <td class="numero">@k.Copertura.ToString("P0", cultura)</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            break;

                        case "sezione.grafico-grappoli" or "sezione.grafico-foglia":
                            var elenco = sezione.Chiave == "sezione.grafico-grappoli" ? CalcoloSettimanale.Grappolo : CalcoloSettimanale.Foglia;
                            var danni = CalcoloSettimanale.Sanita(sel, superfici, elenco);
                            <h2>@T(sezione.Chiave, anno)</h2>
                            <GraficoLineeReport Cultura="cultura" Etichette="@danni.Select(k => T(k.Avversita.Chiave)).ToList()"
                                Serie="@([new GraficoLineeReport.SerieGrafico(T("kpi.intensita"), "#c0392b", danni.Select(k => (decimal?)Math.Round((decimal)k.Intensita * 100, 2)).ToList(), true)])" />
                            break;

                        case "sezione.fenologia":
                            var fasi = CalcoloSettimanale.Fasi(rilievi, _campo);
                            <h2>@T(sezione.Chiave)</h2>
                            @if (fasi.Count == 0)
                            {
                                <p class="nota">@T("fase.nessuna")</p>
                            }
                            else
                            {
                                var periodi = CalcoloSettimanale.PeriodiFase(anno);
                                <div class="ib-tabella-scorre">
                                    <table class="ib-tabella">
                                        <thead><tr><th></th>
                                            <th class="numero">@T("fase.annata", anno)</th><th class="numero">@T("fase.precedente", anno - 1)</th>
                                            <th class="numero">@T("fase.storico5")</th><th class="numero">@T("fase.storico10")</th></tr></thead>
                                        <tbody>
                                            @for (var fase = 1; fase <= 4; fase++)
                                            {
                                                var f = fase;
                                                <tr><td>@T($"fase.{f}")</td>
                                                    @foreach (var p in periodi)
                                                    {
                                                        <td class="numero">@(CalcoloSettimanale.GiornoFase(fasi, f, p.Anni) is { } g ? CalcoloSanitaReport.GiornoMese(g) : "—")</td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            break;

                        case "sezione.bbch-vitigno-foglie" or "sezione.bbch-vitigno-grappoli":
                            var codiciVitigno = sezione.Chiave.EndsWith("foglie") ? CalcoloSettimanale.BbchFoglie : CalcoloSettimanale.BbchGrappoli;
                            <h2>@T(sezione.Chiave)</h2>
                            <GraficoLineeReport Cultura="cultura" Etichette="etichette"
                                Serie="@(CalcoloSettimanale.BbchPerVitigno(stagione, codiciVitigno, nomi.ToDictionary(n => n.Key, n => n.Value.Vitigno), anno, settimane)
                                    .Select((serie, i) => new GraficoLineeReport.SerieGrafico(serie.Nome, Colore(i), Dec(serie.Valori))).ToList())" />
                            break;

                        case "sezione.bbch-storico-foglie" or "sezione.bbch-storico-grappoli":
                            var codici = sezione.Chiave.EndsWith("foglie") ? CalcoloSettimanale.BbchFoglie : CalcoloSettimanale.BbchGrappoli;
                            var tutti = rilievi.Rilievi;
                            <h2>@T(sezione.Chiave)</h2>
                            <GraficoLineeReport Cultura="cultura" Etichette="etichette" Serie="@([
                                new GraficoLineeReport.SerieGrafico(T("bbch.anno"), "#8dc63e", Dec(CalcoloSettimanale.BbchPerSettimana(stagione, codici, a => a == anno, settimane))),
                                new GraficoLineeReport.SerieGrafico(T("bbch.precedente"), "#5f727f", Dec(CalcoloSettimanale.BbchPerSettimana(tutti, codici, a => a == anno - 1, settimane))),
                                new GraficoLineeReport.SerieGrafico(T("bbch.storica"), "#3c3950", Dec(CalcoloSettimanale.BbchPerSettimana(tutti, codici, a => a >= anno - 5 && a <= anno - 1, settimane))),
                            ])" />
                            break;

                        case "sezione.vigoria":
                            <h2>@T(sezione.Chiave)</h2>
                            <div class="ib-quadranti">
                                @foreach (var a in new[] { anno - 2, anno - 1, anno })
                                {
                                    var v = CalcoloSettimanale.Vigoria(_campo?.Vigoria ?? [], a);
                                    <Contachilometri Scala="CalcoloSettimanale.ScalaVigoria" Valore="v" Titolo="@T("vigoria.media", a)"
                                        Testo="@(CalcoloSettimanale.ClasseVigoria(v) is { } cl ? $"{T(cl)} · {v!.Value.ToString("N2", cultura)}" : null)" />
                                }
                            </div>
                            break;

                        case "sezione.germogli":
                            var germogli = CalcoloSettimanale.GermogliPerVigneto(sel.Where(r => r.TipoRilievo == 113)).OrderByDescending(g => g.Value).ToList();
                            var germogliAnni = CalcoloSettimanale.GermogliPerAnno(rilievi.Rilievi.Where(r => r.TipoRilievo == 113
                                && CalcoloSettimanale.Settimana(r) == s.Numero && r.Data.Year <= anno)).OrderBy(g => g.Key).ToList();
                            <h2>@T(sezione.Chiave)</h2>
                            @if (germogli.Count == 0)
                            {
                                <p class="nota">@T("vuoto")</p>
                            }
                            else
                            {
                                <GraficoLineeReport Cultura="cultura" Etichette="@germogli.Select(g => NomeVigneto(nomi, g.Key)).ToList()"
                                    Serie="@([new GraficoLineeReport.SerieGrafico("cm", "#8dc63e", germogli.Select(g => (decimal?)Math.Round((decimal)g.Value, 1)).ToList(), true)])" />
                            }
                            @if (germogliAnni.Count > 0)
                            {
                                <h3>@T("germogli.storico")</h3>
                                <GraficoLineeReport Cultura="cultura" Etichette="@germogliAnni.Select(g => g.Key.ToString(CultureInfo.InvariantCulture)).ToList()"
                                    Serie="@([new GraficoLineeReport.SerieGrafico("cm", "#3c3950", germogliAnni.Select(g => (decimal?)Math.Round((decimal)g.Value, 1)).ToList(), true)])" />
                            }
                            break;

                        case "sezione.deficit-idrico":
                            <h2>@T(sezione.Chiave)</h2>
                            <div class="ib-quadranti">
                                @foreach (var a in new[] { anno - 2, anno - 1, anno })
                                {
                                    var v = CalcoloSettimanale.StatoIdrico(a == anno ? stagione : rilievi.Rilievi, a);
                                    <Contachilometri Scala="CalcoloSettimanale.ScalaStatoIdrico" Valore="v" Titolo="@T("idrico.titolo", a)"
                                        Testo="@(CalcoloStatoIdricoReport.Classe(v) is { } cl ? $"{T("idrico." + cl)} · {v!.Value.ToString("N2", cultura)}" : null)" />
                                }
                            </div>
                            <h3>@T("idrico.andamento")</h3>
                            <GraficoLineeReport Cultura="cultura" Etichette="etichette"
                                Serie="@(CalcoloSettimanale.StatoIdricoPerVigna(stagione,nomi.ToDictionary(n => n.Key, n => n.Value.Vigna), settimane)
                                    .Select((serie, i) => new GraficoLineeReport.SerieGrafico(serie.Nome, Colore(i), Dec(serie.Valori))).ToList())" />
                            break;

                        case "sezione.tignole":
                            <h2>@T(sezione.Chiave)</h2>
                            <GraficoLineeReport Cultura="cultura" Etichette="etichette"
                                Serie="@(CalcoloSettimanale.Catture(stagione, settimane)
                                    .Select((serie, i) => new GraficoLineeReport.SerieGrafico(NomeTipo(rilievi, serie.Tipo), Colore(i), Dec(serie.Valori))).ToList())" />
                            break;

                        case "sezione.tignole-larve":
                            <h2>@T(sezione.Chiave)</h2>
                            <div class="ib-quadranti">
                                @foreach (var g in CalcoloSettimanale.Generazioni)
                                {
                                    var (valore, copertura) = CalcoloSettimanale.Generazione(sel, superfici, g.Codici);
                                    <Contachilometri Scala="g.Scala" Valore="valore" Titolo="@T(g.Chiave)"
                                        Testo="@($"{valore.ToString("N1", cultura)} · {T("tignole.controllati", copertura.ToString("P0", cultura))}")" />
                                }
                            </div>
                            <h3>@T("tignole.diffusione")</h3>
                            var diffusione = CalcoloSettimanale.DiffusioneTignole(sel).OrderByDescending(d => d.Value).ToList();
                            <GraficoLineeReport Cultura="cultura" Etichette="@diffusione.Select(d => NomeVigneto(nomi, d.Key)).ToList()"
                                Serie="@([new GraficoLineeReport.SerieGrafico("%", "#8e477d", diffusione.Select(d => (decimal?)d.Value).ToList(), true)])" />
                            break;

                        case "sezione.esca":
                            var esca = CalcoloSettimanale.Esca(sel, rilievi.Esca);
                            <h2>@T(sezione.Chiave)</h2>
                            <div class="ib-kpi">
                                <Kpi Nome="@T("esca.rilievi")" Valore="@esca.Rilievi.ToString(cultura)" />
                                <Kpi Nome="@T("esca.piante")" Valore="@esca.Piante.ToString("N0", cultura)" />
                                @foreach (var v in CalcoloSettimanale.ValoriEsca)
                                {
                                    <Kpi Nome="@T("esca." + v)" Valore="@esca.PerValore.GetValueOrDefault(v).ToString("N0", cultura)" />
                                }
                            </div>
                            break;

                        case "sezione.considerazioni":
                            <h2>@T(sezione.Chiave)</h2>
                            <p class="nota">@T("considerazioni.testo")</p>
                            break;
                    }
                </section>
            }
        }
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "azienda")] private int? Azienda { get; set; }
    [SupplyParameterFromQuery(Name = "settimana")] private string? Settimana { get; set; }
    [SupplyParameterFromQuery(Name = "lingua")] private string? CodiceLingua { get; set; }

    private static readonly string[] Colori = ["#8dc63e", "#3c6fb4", "#c0392b", "#f8981d", "#3c3950", "#5f727f", "#8e477d", "#276e27"];

    private List<AziendaDto>? _aziende;
    private RilieviSettimanaDto? _rilievi;
    private CampoReportFineStagioneDto? _campo;
    private (int?, SettimanaReport)? _caricati;
    private string? _errore;

    private LinguaReport Lingua => TestiReport.DaCodice(CodiceLingua);

    private DateOnly Oggi => DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, TematismiBigot.FusoItalia).DateTime);

    /// <summary>La settimana dell'indirizzo; senza (o non valida, o futura) quella di oggi, come Qlik.</summary>
    private SettimanaReport SettimanaScelta =>
        SettimanaReport.DaCodice(Settimana) is { } s && (s.Anno, s.Numero).CompareTo((Oggi.Year, SettimanaReport.Di(Oggi).Numero)) <= 0
            ? s : SettimanaReport.Di(Oggi);

    private string? NomeAzienda => _aziende?.FirstOrDefault(a => a.Id == Azienda)?.Nome;

    private string T(string chiave, params object[] valori) => TestiSettimanale.Testo(Lingua, chiave, valori);

    private static string Colore(int i) => Colori[i % Colori.Length];

    private static string NomeVigneto(IReadOnlyDictionary<int, VignetoFineStagioneDto> nomi, int id) =>
        nomi.TryGetValue(id, out var n) ? n.Nome : id.ToString(CultureInfo.InvariantCulture);

    private static IReadOnlyList<decimal?> Dec(IReadOnlyList<double?> valori) =>
        valori.Select(v => v is { } x ? (decimal?)Math.Round((decimal)x, 2) : null).ToList();

    private string NomeTipo(RilieviSettimanaDto rilievi, int tipo) =>
        rilievi.NomiTipi.TryGetValue(tipo, out var nome) && nome.Length > 0 ? nome
        : tipo == 0 ? T("rilievi.bbch") : tipo.ToString(CultureInfo.InvariantCulture);

    protected override async Task OnParametersSetAsync()
    {
        if (_aziende is null)
        {
            await CaricaAsync();
        }
        else if (_caricati != (Azienda, SettimanaScelta))
        {
            await CaricaRilieviAsync();
        }
    }

    private async Task CaricaAsync()
    {
        _errore = null;
        try
        {
            _aziende = (await AziendeApiClient.GetAziendeAsync()).OrderBy(a => a.Nome).ToList();
            await CaricaRilieviAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning("Report settimanale: aziende non lette ({Messaggio})", ex.Message);
            _errore = T("errore.aziende");
        }
    }

    /// <summary>I rilievi dall'inizio di cinque anni prima (storico BBCH) alla fine della settimana, e i dati di campo dello snapshot.</summary>
    private async Task CaricaRilieviAsync()
    {
        _rilievi = null;
        _campo = null;
        _errore = null;
        var settimana = SettimanaScelta;
        _caricati = (Azienda, settimana);
        if (Azienda is not { } id)
        {
            return;
        }

        try
        {
            _rilievi = await VignetiApiClient.GetRilieviSettimanaAsync(id, new DateOnly(settimana.Anno - 5, 1, 1), settimana.A);
            if (_rilievi is null)
            {
                _errore = T("errore");
                return;
            }
            _campo = await VignetiApiClient.GetCampoReportFineStagioneAsync(id);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning("Report settimanale: rilievi dell'azienda {Azienda} non letti ({Messaggio})", id, ex.Message);
            _errore = T("errore");
        }
    }

    private void Cambia(int? azienda = -1, string? settimana = "-", string? lingua = "-")
    {
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["azienda"] = azienda == -1 ? Azienda : azienda,
            ["settimana"] = settimana == "-" ? Settimana : settimana,
            ["lingua"] = lingua == "-" ? CodiceLingua : lingua == "it" ? null : lingua,
        }), replace: true);
    }

    private static int? Numero(object? valore) =>
        int.TryParse(valore as string, NumberStyles.Integer, CultureInfo.InvariantCulture, out var n) ? n : null;
}

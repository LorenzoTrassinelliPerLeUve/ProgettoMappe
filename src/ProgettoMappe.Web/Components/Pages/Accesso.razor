@page "/accesso"
@layout ProgettoMappe.Web.Components.Layout.LayoutAccesso
@using System.Security.Claims
@using ProgettoMappe.Contracts
@using ProgettoMappe.Contracts.Accesso
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Options
@using ProgettoMappe.Web.Accesso
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@inject NavigationManager Navigation
@inject IOptions<AccessoOptions> AccessoOptionsAccessor
@inject IVerificaCredenziali Verifica
@inject LimiteTentativi Limite
@inject ILogger<Accesso> Logger

@* Pagina statica (niente circuito interattivo): il login deve scrivere il cookie nella risposta HTTP.
   Pagina neutra (task #400): marchio Perleuve · 4Grapes, niente menù di Mappe, testi IT/EN in TestiAccesso (gli stessi
   dell'accesso unico /perleuve/accesso dell'Api). *@
<PageTitle>@T("titolo") · Perleuve 4Grapes</PageTitle>

<div class="pagina-accesso" lang="@_lingua">
    <header class="testata-accesso">
        <span class="brand-marchio" role="img" aria-label="Perleuve"><span>Per</span><span>Le</span><span>Uve</span></span>
        <span class="testata-accesso-nome">4Grapes<small>@T("marchio")</small></span>
        <nav class="lingue-accesso" aria-label="@T("lingua")">
            @foreach (var (codice, nome) in TestiAccesso.Lingue)
            {
                if (codice == _lingua)
                {
                    <span aria-current="true">@nome</span>
                }
                else
                {
                    <a href="@Navigation.GetUriWithQueryParameter(TestiAccesso.Parametro, codice)" hreflang="@codice" lang="@codice">@nome</a>
                }
            }
        </nav>
    </header>

    <main class="scheda scheda-accesso">
        <h1 class="titolo-pagina">@T("titolo")</h1>
        <p class="destinazione-accesso">@T("stai-entrando"): <strong>@T("mappe")</strong></p>
        <p class="sottotitolo">@T("credenziali")</p>

        <form method="post" @formname="accesso" @onsubmit="EntraAsync">
            <AntiforgeryToken />
            @if (_errore is null && HttpMethods.IsGet(HttpContext.Request.Method)
                 && (Scaduta == 1 || SessioneScaduta.Scaduta(HttpContext)))
            {
                <p class="errore-accesso" role="status">@T("scaduta")</p>
            }
            @if (_errore is not null)
            {
                <p class="errore-accesso" role="alert">@T(_errore)</p>
            }
            <label>
                @T("email")
                <input name="Dati.NomeUtente" value="@Dati?.NomeUtente" type="email" inputmode="email" autocomplete="username"
                       autocapitalize="none" spellcheck="false" maxlength="50" required autofocus="@(_errore is null)" />
            </label>
            <label>
                @T("password")
                <span class="campo-password">
                    <input name="Dati.Password" type="password" autocomplete="current-password" maxlength="256" required
                           autofocus="@(_errore is not null)" />
                    @* Senza JavaScript il pulsante non fa niente e la password resta nascosta. *@
                    <button type="button" class="mostra-password" aria-pressed="false" aria-label="@T("mostra-password")"
                            data-mostra="@T("mostra")" data-nascondi="@T("nascondi")" onclick="@ScriptMostraPassword">@T("mostra")</button>
                </span>
            </label>
            <button type="submit" class="pulsante-principale">@T("entra")</button>
        </form>
        @* Il recupero sta nell'accesso unico dell'Api (inoltrato dal Web): se lì è spento, la sua pagina porta al portale 4Grapes. *@
        <p class="nota-accesso"><a href="/perleuve/password-dimenticata?@(TestiAccesso.Parametro)=@_lingua">@T("password-dimenticata")</a></p>
    </main>

    <footer class="piede-accesso">
        <span>Perleuve · 4Grapes</span>
        @if (TestiAccesso.CollegamentoPiede(AccessoOptionsAccessor.Value.Privacy) is { } privacy)
        {
            <a href="@privacy">@T("privacy")</a>
        }
        @if (TestiAccesso.CollegamentoPiede(AccessoOptionsAccessor.Value.Assistenza) is { } assistenza)
        {
            <a href="@assistenza">@T("assistenza")</a>
        }
    </footer>
</div>

@code {
    /// <summary>Lo stesso del pulsante «Mostra» delle pagine Perleuve dell'Api.</summary>
    private const string ScriptMostraPassword =
        "var i=this.previousElementSibling,m=i.type==='password';i.type=m?'text':'password';"
        + "this.textContent=m?this.dataset.nascondi:this.dataset.mostra;this.setAttribute('aria-pressed',m)";

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "accesso")]
    private DatiAccesso? Dati { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    // 1 = rimandati qui da cookie o modulo di prima di un riavvio (SessioneScaduta).
    [SupplyParameterFromQuery(Name = SessioneScaduta.Parametro)]
    private int? Scaduta { get; set; }

    // Lingua scelta (?lingua=en); senza, quella del browser. Il modulo torna allo stesso indirizzo, quindi resta.
    [SupplyParameterFromQuery(Name = TestiAccesso.Parametro)]
    private string? LinguaScelta { get; set; }

    private string _lingua = TestiAccesso.Italiano;

    // Chiave di TestiAccesso del messaggio d'errore.
    private string? _errore;

    private string T(string chiave) => TestiAccesso.T(_lingua, chiave);

    protected override void OnInitialized()
    {
        // Single sign-on (task #403): questa pagina resta solo come rimando all'accesso unico.
        if (AccessoOptionsAccessor.Value.AccessoUnico.Abilitato)
        {
            Navigation.NavigateTo("/accesso/entra" + (string.IsNullOrWhiteSpace(ReturnUrl) ? ""
                : "?returnUrl=" + Uri.EscapeDataString(UrlRitorno.Sicuro(ReturnUrl))), forceLoad: true);
            return;
        }
        Dati ??= new();
        _lingua = TestiAccesso.Lingua(LinguaScelta, HttpContext.Request.Headers.AcceptLanguage.ToString());
    }

    private async Task EntraAsync()
    {
        var nomeUtente = Dati?.NomeUtente?.Trim() ?? "";
        var password = Dati?.Password ?? "";

        if (Limite.Bloccato(nomeUtente))
        {
            _errore = "bloccato";
            return;
        }

        UtenteAccessoDto? utente;
        try
        {
            utente = string.IsNullOrEmpty(nomeUtente) || string.IsNullOrEmpty(password)
                ? null
                : await Verifica.VerificaAsync(nomeUtente, password, HttpContext.RequestAborted);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException
                                   && !HttpContext.RequestAborted.IsCancellationRequested)
        {
            // Api o 4Grapes non raggiungibili (o permesso mancante su dbo.Utente): non è colpa della password.
            Logger.LogError(ex, "Verifica delle credenziali non riuscita");
            _errore = "non-disponibile";
            return;
        }

        if (utente is null)
        {
            // Stesso messaggio per utente inesistente e password errata: non rivela quali utenti esistono.
            Limite.RegistraErrore(nomeUtente);
            _errore = "errore-credenziali";
            Logger.LogInformation("Accesso negato");
            return;
        }

        Limite.RegistraSuccesso(nomeUtente);

        var identita = new ClaimsIdentity(
            [
                new Claim(ClaimTypes.NameIdentifier, nomeUtente), new Claim(ClaimTypes.Name, utente.Nome),
                // L'Id 4Grapes: permessi del Portale e IdUtente di LogOp (task #225).
                new Claim(ProgettoMappe.Web.Portale.UtentePortale.ClaimIdUtente, utente.Id.ToString(System.Globalization.CultureInfo.InvariantCulture)),
            ],
            CookieAuthenticationDefaults.AuthenticationScheme);
        await HttpContext.SignInAsync(
            CookieAuthenticationDefaults.AuthenticationScheme,
            new ClaimsPrincipal(identita),
            new AuthenticationProperties
            {
                IsPersistent = false,
                ExpiresUtc = DateTimeOffset.UtcNow.Add(AccessoOptionsAccessor.Value.DurataSessione()),
            });

        Navigation.NavigateTo(UrlRitorno.Sicuro(string.IsNullOrWhiteSpace(ReturnUrl) || ReturnUrl == "/"
            ? AccessoOptionsAccessor.Value.PaginaIniziale : ReturnUrl), forceLoad: true);
    }

    private sealed class DatiAccesso
    {
        public string? NomeUtente { get; set; }
        public string? Password { get; set; }
    }
}

@page "/stampa/{AziendaId:int}"
@using System.Globalization
@using System.Net
@using System.Text.Json
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Logging
@using ProgettoMappe.Web.Filtri
@using ProgettoMappe.Web.Formati
@using ProgettoMappe.Web.Options
@using ProgettoMappe.Web.Stampa
@using ProgettoMappe.Web.Tematismi
@inject VignetiApiClient VignetiApiClient
@inject AziendeApiClient AziendeApiClient
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime
@inject ConfigurazioneMappa Configurazione
@inject CatalogoTematismi Catalogo
@inject ILogger<Stampa> Logger
@implements IAsyncDisposable

@* Layout di stampa a riquadri (task #90): i vigneti vicini in un riquadro di mappa ciascuno, i riquadri
   su un foglio A4/A3 grandi in proporzione ai loro vigneti (task #91), con legenda e indice; l'indice
   che non ci sta continua su altre pagine. La barra a sinistra non si stampa (app.css).
   Modo manuale (task #92): i riquadri li disegna l'utente su una mappa d'insieme e vanno in una griglia
   a 12 colonne (Stampa/StampaManuale); il resto del foglio è lo stesso.
   Più pagine (task #94): nel modo manuale ogni riquadro ha la sua pagina (PagineManuali), nell'automatico
   i riquadri che non ci stanno a una misura leggibile passano alla pagina dopo (RiquadriStampa.Pagine);
   ogni pagina ha intestazione, legenda compatta e «pagina N di M». *@

<PageTitle>Layout di stampa@(NomeAzienda is { } n ? $" · {n}" : "")</PageTitle>

<div class="stampa-pagina" id="@_id">
    <aside class="stampa-controlli">
        <a class="torna" href="@LinkMappa.Leggi(Navigation.Uri).Indirizzo(AziendaId)">← Torna alla mappa</a>
        <h1>Layout di stampa</h1>

        @if (_errore is not null)
        {
            <p class="stampa-errore" role="alert">@_errore</p>
        }
        else if (_vigneti is null)
        {
            <p class="nota" role="status">@(_stato ?? "Carico i vigneti…")</p>
        }
        else
        {
            @if (_telefono)
            {
                <p class="nota">Il modo manuale, con i riquadri disegnati a mano, si usa dal computer.</p>
            }
            else
            {
                <div class="stampa-gruppo" role="group" aria-label="Modo">
                    <span class="titolo">Riquadri</span>
                    <div class="pulsanti-scelta">
                        <button type="button" class="@(_modo == ModoStampa.Automatico ? "attivo" : "")" aria-pressed="@(_modo == ModoStampa.Automatico)"
                                @onclick="() => CambiaModo(ModoStampa.Automatico)">Automatico</button>
                        <button type="button" class="@(_modo == ModoStampa.Manuale ? "attivo" : "")" aria-pressed="@(_modo == ModoStampa.Manuale)"
                                @onclick="() => CambiaModo(ModoStampa.Manuale)">Manuale</button>
                    </div>
                </div>
            }

            <label>
                Titolo
                <input type="text" maxlength="120" placeholder="@NomeAzienda" @bind="_titolo" @bind:event="oninput" @bind:after="TitoloCambiato" />
            </label>

            <div class="stampa-gruppo" role="group" aria-label="Foglio">
                <span class="titolo">Foglio</span>
                <div class="pulsanti-scelta">
                    @foreach (var formato in Enum.GetValues<FormatoFoglio>())
                    {
                        var f = formato;
                        <button type="button" class="@(_foglio.Formato == f ? "attivo" : "")" aria-pressed="@(_foglio.Formato == f)"
                                @onclick="() => CambiaFoglio(_foglio with { Formato = f })">@f</button>
                    }
                </div>
                <div class="pulsanti-scelta">
                    <button type="button" class="@(!_foglio.Orizzontale ? "attivo" : "")" aria-pressed="@(!_foglio.Orizzontale)"
                            @onclick="() => CambiaFoglio(_foglio with { Orizzontale = false })">Verticale</button>
                    <button type="button" class="@(_foglio.Orizzontale ? "attivo" : "")" aria-pressed="@_foglio.Orizzontale"
                            @onclick="() => CambiaFoglio(_foglio with { Orizzontale = true })">Orizzontale</button>
                </div>
            </div>

            <div class="stampa-gruppo" role="group" aria-label="Sfondo">
                <span class="titolo">Sfondo</span>
                <div class="pulsanti-scelta">
                    <button type="button" class="@(!_satellite ? "attivo" : "")" aria-pressed="@(!_satellite)"
                            @onclick="() => CambiaSfondo(false)">Mappa</button>
                    <button type="button" class="@(_satellite ? "attivo" : "")" aria-pressed="@_satellite"
                            disabled="@(Configurazione.ImageryPredefinitaId is null)" @onclick="() => CambiaSfondo(true)">Satellite</button>
                </div>
            </div>

            @if (_modo == ModoStampa.Manuale)
            {
                @RiquadriManuali
            }
            else
            {
                <label>
                    Distanza di raggruppamento: <strong>@TestoDistanza</strong>
                    <input type="range" min="@Numero(RiquadriStampa.DistanzaMinimaKm)" max="@Numero(RiquadriStampa.DistanzaMassimaKm)" step="0.5"
                           value="@Numero(_distanzaKm)" @onchange="CambiaDistanza" />
                    <span class="nota">Vigneti più vicini di così stanno nello stesso riquadro.</span>
                </label>

                <div class="stampa-gruppo">
                    <span class="titolo">Riquadri (@_riquadri.Count@(_nascosti.Count > 0 ? $" di {_tutti.Count}" : ""))</span>
                    <ul class="stampa-elenco-riquadri">
                        @foreach (var riquadro in _tutti)
                        {
                            var r = riquadro;
                            var nascosto = _nascosti.Contains(r.Chiave);
                            <li class="@(nascosto ? "nascosto" : "")" @key="@($"{_generazione}-{r.Chiave}")">
                                <span class="lettera">@r.Lettera</span>
                                <span class="conteggio">@(r.Vigneti.Count == 1 ? "1 vigneto" : $"{r.Vigneti.Count} vigneti")</span>
                                @if (_tutti.Count > 1)
                                {
                                    <select aria-label="Unisci il riquadro @r.Lettera con un altro" @onchange="e => Unisci(r.Chiave, e)">
                                        <option value="" selected>Unisci con…</option>
                                        @foreach (var altro in _tutti.Where(a => a.Chiave != r.Chiave))
                                        {
                                            <option value="@altro.Chiave">@altro.Lettera</option>
                                        }
                                    </select>
                                }
                                <button type="button" class="leggero" disabled="@(!nascosto && _riquadri.Count <= 1)"
                                        @onclick="() => CommutaNascosto(r.Chiave)">@(nascosto ? "Mostra" : "Nascondi")</button>
                            </li>
                        }
                    </ul>
                    @if (_unioni.Count > 0)
                    {
                        <button type="button" class="leggero" @onclick="SeparaRiquadri">Separa i riquadri uniti</button>
                    }
                    @if (_fogliRiquadri.Count > 1)
                    {
                        <p class="nota">
                            @($"I riquadri vanno su {_fogliRiquadri.Count} pagine: quelli con tanti vigneti hanno bisogno di spazio per leggere i numeri.")
                            @(" Per averne meno, aumenta la distanza o unisci i riquadri.")
                        </p>
                    }
                </div>
            }

            <div class="stampa-gruppo" role="group" aria-label="Indice dei vigneti">
                <span class="titolo">Indice</span>
                <div class="pulsanti-scelta">
                    @foreach (var (posizione, testo) in new[] { (PosizioneIndice.Sotto, "Sotto i riquadri"), (PosizioneIndice.PaginaAParte, "Pagina a parte"), (PosizioneIndice.Nessuno, "Nessuno") })
                    {
                        var p = posizione;
                        <button type="button" class="@(Indice == p ? "attivo" : "")" aria-pressed="@(Indice == p)"
                                @onclick="() => CambiaIndice(p)">@testo</button>
                    }
                </div>
                @if (_pagine.Count > 1)
                {
                    <span class="nota">
                        @(Indice == PosizioneIndice.Sotto ? "L'indice continua" : "L'indice va")
                        @(_pagine.Count == 2 ? "su una pagina in più" : $"su {_pagine.Count - 1} pagine in più"), dopo i riquadri, con la stessa intestazione.
                    </span>
                }
            </div>

            <p class="nota stampa-totale-pagine"><strong>@TestoPagine(TotalePagine)</strong>@(TotalePagine > 1 ? " da stampare, nell'ordine." : " da stampare.")</p>
            <div class="stampa-azioni">
                @* Stampa e PNG li fa stampa.js nel click stesso (vedi preparaFoglio). *@
                <button type="button" data-stampa disabled="@(!Pronto)">Stampa / salva PDF</button>
                <button type="button" class="leggero" data-salva-png="@NomeFile" disabled="@(!Pronto)">Salva PNG</button>
            </div>
            <p class="nota" role="status">
                @if (_riquadri.Count == 0)
                {
                    @("Disegna almeno un riquadro sulla mappa d'insieme.")
                }
                else if (!Pronto)
                {
                    @($"Preparo i riquadri: {_pronti} di {_riquadri.Count}…")
                }
                else if (_falliti > 0)
                {
                    @($"{_falliti} riquadri senza mappa: riprova cambiando sfondo.")
                }
                else
                {
                    @("Pronto. Nella finestra di stampa scegli «Salva come PDF» per avere il file; margini: nessuno.")
                    @(TotalePagine > 1 ? " «Salva PNG» scarica un file per pagina: se il browser lo chiede, consenti più download." : "")
                }
            </p>
            @if (_avvisoPng is not null)
            {
                <p class="stampa-errore" role="alert">@_avvisoPng</p>
            }
            @if (_stato is not null)
            {
                <p class="nota">@_stato</p>
            }
        }
    </aside>

    <div class="stampa-anteprima">
        @if (_vigneti is not null && _errore is null)
        {
            @if (_modo == ModoStampa.Manuale)
            {
                @* La mappa la crea stampa.js (apriInsieme): il div resta sempre uguale, senza classi che cambiano. *@
                <section class="stampa-insieme @(_inDisegno ? "in-disegno" : "")" aria-label="Mappa d'insieme">
                    <p class="nota">
                        @if (_inDisegno)
                        {
                            <strong>Trascina sulla mappa per disegnare il riquadro</strong>@(" (Esc per annullare).")
                        }
                        else
                        {
                            @("Sposta un riquadro dalla sua etichetta, allargalo da bordi e angoli. Il foglio sotto si aggiorna da solo.")
                        }
                    </p>
                    <div class="stampa-insieme-mappa" id="@InsiemeId"></div>
                </section>
            }

            @* Un foglio per pagina, uno sotto l'altro a video; in stampa ognuno è una pagina (app.css). *@
            <div class="stampa-fogli" id="@FoglioId">
                @* Pagine di riquadri (task #94); l'indice «sotto» sta sotto l'ultima, le sue pagine in più vengono dopo. *@
                @foreach (var foglioRiquadri in _fogliRiquadri)
                {
                    var paginaFoglio = foglioRiquadri;
                    var indiceQui = paginaFoglio.Numero == _fogliRiquadri.Count ? IndicePrimaPagina : 0;
                    @EtichettaPagina((paginaFoglio.Numero, Manuale && paginaFoglio.Indici.Count == 0 && _pagineManuali > 1))
                <div class="stampa-foglio" style="@StileFoglio" @key="@($"riquadri-{paginaFoglio.Numero}")">
                    @Intestazione

                    <div class="stampa-riquadri" style="@($"height: {TestiStampa.Mm(paginaFoglio.Altezza)}")" data-pagina-manuale="@(Manuale ? paginaFoglio.Numero : null)">
                        @if (Manuale && paginaFoglio.Indici.Count == 0)
                        {
                            <p class="stampa-pagina-vuota" data-solo-video>Pagina vuota: trascina qui un riquadro, o scegli la pagina @paginaFoglio.Numero nell'elenco dei riquadri.</p>
                        }
                        @foreach (var i in paginaFoglio.Indici.Where(i => i < _riquadri.Count && i < _celle.Count))
                        {
                            var riquadro = _riquadri[i];
                            var cella = _celle[i];
                            <div class="stampa-riquadro" @key="@($"{_generazione}-{riquadro.Chiave}")"
                                 draggable="@(Manuale ? "true" : null)" data-chiave-manuale="@(Manuale ? riquadro.Chiave : null)"
                                 title="@(Manuale ? "Trascina su un altro riquadro per cambiare l'ordine, o in una parte vuota di un'altra pagina" : null)"
                                 style="@($"left: {TestiStampa.Mm(cella.X)}; top: {TestiStampa.Mm(cella.Y)}; width: {TestiStampa.Mm(cella.Larghezza)}; height: {TestiStampa.Mm(cella.Altezza)}")">
                                <div class="riquadro-mappa" id="@IdRiquadro(riquadro)"></div>
                                @if (_riquadri.Count > 1)
                                {
                                    <span class="riquadro-lettera">@riquadro.Lettera</span>
                                }
                                <span class="riquadro-nord" title="Nord">
                                    <span>N</span>
                                    <svg viewBox="0 0 12 16" aria-hidden="true">
                                        <path d="M6 0 L12 16 L6 12 L0 16 Z" fill="currentColor" />
                                    </svg>
                                </span>
                            </div>
                        }
                    </div>

                    @if (_vociLegenda.Count > 0 || indiceQui > 0)
                    {
                        <div class="stampa-fascia" style="@($"padding-top: {TestiStampa.Mm(FoglioStampa.Spazio)}")">
                            @if (_vociLegenda.Count > 0 && _tema is { } tema)
                            {
                                @* Senza indice accanto la legenda è compatta: voci in fila, a colonne (FoglioStampa.ColonneLegenda). *@
                                <div class="stampa-legenda @(indiceQui == 0 ? "compatta" : "")"
                                     style="@(indiceQui == 0 ? null : $"width: {TestiStampa.Mm(FoglioStampa.LarghezzaLegenda)}")">
                                    <h3>@LegendaTematismo.Titolo(tema, _anno, _annoDa)</h3>
                                    <ul style="@(indiceQui == 0 ? $"grid-template-columns: repeat({_foglio.ColonneLegenda}, minmax(0, 1fr))" : null)">
                                        @foreach (var voce in _vociLegenda)
                                        {
                                            <li class="@(voce.Vuota ? "vuota" : "")">
                                                <span class="campione @voce.Css" style="@(voce.Colore is null ? null : $"background-color: {voce.Colore}")"></span>
                                                <span class="etichetta">@voce.Testo</span>
                                                <span class="conteggio">@voce.Conteggio</span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                            @if (indiceQui > 0)
                            {
                                <div class="stampa-indice">
                                    <h3>Indice dei vigneti@(_pagine.Count > 1 ? $" · segue a pagina {FoglioStampa.PaginaIndice(_fogliRiquadri.Count, 1)}" : "")</h3>
                                    @ColonneIndice((_pagine[0], _foglio.ColonneIndice))
                                </div>
                            }
                        </div>
                    }

                    @Piede(paginaFoglio.Numero)
                </div>
                }

                @for (var p = 1; p < _pagine.Count; p++)
                {
                    var pagina = p;
                    var numero = FoglioStampa.PaginaIndice(_fogliRiquadri.Count, pagina);
                    @EtichettaPagina((numero, false))
                    <div class="stampa-foglio" style="@StileFoglio" @key="@($"indice-{pagina}")">
                        @Intestazione
                        <div class="stampa-indice seguito" style="@($"height: {TestiStampa.Mm(_foglio.AltezzaCorpo)}")">
                            <h3>Indice dei vigneti@(pagina > 1 || IndicePrimaPagina > 0 ? " (segue)" : "")</h3>
                            @ColonneIndice((_pagine[pagina], _foglio.ColonneIndiceSeguito))
                        </div>
                        @Piede(numero)
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public int AziendaId { get; set; }

    private const int TentativiFonte = 12;
    private static readonly TimeSpan AttesaFonte = TimeSpan.FromSeconds(10);

    private readonly string _id = $"stampa-{Guid.NewGuid():N}";
    private string FoglioId => $"{_id}-foglio";
    private readonly CancellationTokenSource _cts = new();
    private readonly int _annoCorrente = DateTime.Now.Year;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Stampa>? _dotNetRef;

    // Dati: vigneti dell'azienda (dopo i filtri del link) e tematismo del link, calcolati una volta.
    private string? _errore;
    private string? _stato;
    private string? _nomeAzienda;
    private IReadOnlyList<VignetoDto>? _vigneti;
    private Dictionary<int, VignetoDto> _perId = [];
    private IReadOnlyList<VignetoInStampa> _inStampa = [];
    private Tematismo? _tema;
    private IReadOnlyList<IRigaVigneto>? _righe;
    private IReadOnlyDictionary<int, string>? _nomiClassi;
    private int? _anno;
    private int? _annoDa;
    private string? _filtri;

    // Scelte dell'utente nella barra.
    private FoglioStampa _foglio = new(FormatoFoglio.A4, true);
    private bool _satellite;
    private double _distanzaKm = RiquadriStampa.DistanzaPredefinitaKm;
    private readonly List<(int A, int B)> _unioni = [];
    private readonly HashSet<int> _nascosti = [];
    // Null = predefinita (pagina a parte oltre 30 vigneti, FoglioStampa.PosizionePredefinita).
    private PosizioneIndice? _sceltaIndice;
    private string _titolo = "";

    // Layout calcolato (Ricalcola).
    private IReadOnlyList<IReadOnlyList<VignetoInStampa>> _gruppi = [];
    private IReadOnlyList<RiquadroStampa> _tutti = [];
    private IReadOnlyList<RiquadroStampa> _riquadri = [];
    private IReadOnlyList<CellaStampa> _celle = [];
    private IReadOnlyDictionary<int, int> _numeri = new Dictionary<int, int>();
    private TematismoCalcolato? _calcolato;
    private IReadOnlyList<VoceLegenda> _vociLegenda = [];
    // L'indice diviso per pagina: la prima sotto l'ultima pagina di riquadri, le altre da sole (task #91).
    private IReadOnlyList<IReadOnlyList<RigaIndice>> _pagine = [];
    // Le pagine di riquadri (task #94): indici in _riquadri / _celle e altezza dell'area dei riquadri.
    private IReadOnlyList<FoglioRiquadri> _fogliRiquadri = [];

    private sealed record FoglioRiquadri(int Numero, IReadOnlyList<int> Indici, double Altezza, DisposizioneManuale? Disposizione);

    // Disegno dei riquadri in stampa.js: ogni ricalcolo è una generazione nuova.
    private int _generazione;
    private bool _daDisegnare;
    private int _pronti;
    private int _falliti;
    private string? _baseUsata;
    private string? _avvisoPng;

    // Modo manuale (task #92): riquadri disegnati dall'utente, con una chiave che resta finché c'è la pagina.
    private ModoStampa _modo;
    private bool _telefono;
    private string _chiaveTema = "-";
    // In ordine di pagina (PagineManuali.InOrdine); _pagineManuali conta anche le pagine vuote.
    private List<RiquadroDisegnato> _manuali = [];
    private int _pagineManuali = 1;
    private int _prossimaChiave;
    private bool _inDisegno;
    private bool _layoutLetto;
    private bool _confermaAutomatico;
    private bool _insiemeAperto;
    private bool _insiemeDaAggiornare;
    private bool _daSalvare;
    private string? _avvisoLayout;

    private sealed record LayoutNelBrowser(string Testo, bool Riserva);

    private bool Manuale => _modo == ModoStampa.Manuale;

    private string InsiemeId => $"{_id}-insieme";

    /// <summary>Un layout per azienda e tematismo nel browser; «ultimo» = l'ultimo salvato dell'azienda, di riserva.</summary>
    private string ChiaveLocale => $"mappe-stampa-manuale:{AziendaId}:{_chiaveTema}";

    private string ChiaveRiserva => $"mappe-stampa-manuale:{AziendaId}:ultimo";

    private sealed record RigaIndice(int Numero, string Nome, string? Vigna, string Superficie, bool SoloPunto, string Valore, string ValoreIntero, string? Colore);

    private bool Pronto => _riquadri.Count > 0 && _pronti >= _riquadri.Count;

    private string? NomeAzienda => _nomeAzienda;

    private string Titolo => string.IsNullOrWhiteSpace(_titolo) ? NomeAzienda ?? $"Azienda {AziendaId}" : _titolo.Trim();

    private string Sottotitolo
    {
        get
        {
            var tema = _tema is { } t && (t.SenzaAnno || _anno is not null) ? LegendaTematismo.Titolo(t, _anno, _annoDa) : "Vigneti";
            if (_tema is { Fonte: FonteTematismo.Rilievi or FonteTematismo.Difesa })
            {
                tema += ", a oggi";
            }
            return _filtri is null ? tema : $"{tema} · {_filtri}";
        }
    }

    private string TestoVigneti
    {
        get
        {
            // Distinti: nel modo manuale due zone possono coprire lo stesso vigneto.
            var ids = _riquadri.SelectMany(r => r.Vigneti).Distinct().ToList();
            var ettari = ids.Select(id => _perId.GetValueOrDefault(id)).Where(v => v is { SoloPunto: false }).Sum(v => v!.SuperficieEttari ?? 0);
            return $"{(ids.Count == 1 ? "1 vigneto" : $"{ids.Count} vigneti")} · {FormatoSuperficie.Testo(ettari)}";
        }
    }

    private string TestoDistanza => _distanzaKm.ToString("0.#", CultureInfo.GetCultureInfo("it-IT")) + " km";

    private string NomeFile => ImmagineMappa.NomeFile(NomeAzienda ?? $"azienda {AziendaId}", _tema?.Nome) + "-foglio";

    /// <summary>Vigneti dell'indice sotto l'ultima pagina di riquadri (0 con l'indice a parte o senza indice).</summary>
    private int IndicePrimaPagina => _pagine.Count > 0 ? _pagine[0].Count : 0;

    /// <summary>
    /// Altezza dei riquadri nella pagina <paramref name="numero"/> di <paramref name="pagineRiquadri"/>: tutte
    /// hanno sotto la legenda compatta, l'ultima anche l'indice «sotto».
    /// </summary>
    private double AltezzaPagina(int numero, int pagineRiquadri) =>
        _foglio.AltezzaRiquadri(_vociLegenda.Count, numero == pagineRiquadri ? IndicePrimaPagina : 0);

    private int TotalePagine => FoglioStampa.TotalePagine(_fogliRiquadri.Count, _pagine.Select(p => p.Count).ToList());

    private static string TestoPagine(int pagine) => pagine == 1 ? "1 pagina" : $"{pagine} pagine";

    /// <summary>Mezzo millimetro meno della carta: con gli arrotondamenti il browser non aggiunge una pagina vuota.</summary>
    private string StileFoglio =>
        $"width: {TestiStampa.Mm(_foglio.Larghezza)}; height: {TestiStampa.Mm(_foglio.Altezza - 0.5)}; padding: {TestiStampa.Mm(FoglioStampa.Margine)}";

    /// <summary>La stessa intestazione in ogni pagina.</summary>
    private RenderFragment Intestazione => @<header class="stampa-intestazione" style="@($"height: {TestiStampa.Mm(FoglioStampa.AltezzaIntestazione)}; margin-bottom: {TestiStampa.Mm(FoglioStampa.Spazio)}")">
        <span class="stampa-marchio" aria-hidden="true"><span>Per</span><span>Le</span><span>Uve</span></span>
        <div class="stampa-titoli">
            <h2>@Titolo</h2>
            <p>@Sottotitolo</p>
        </div>
        <div class="stampa-data">
            <span>@OggiItalia.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)</span>
            <span>@TestoVigneti</span>
        </div>
    </header>;


@page "/mappa/{AziendaId:int}"
@using Microsoft.Extensions.Options
@using ProgettoMappe.Web.Options
@inject VignetiApiClient VignetiApiClient
@inject IJSRuntime JsRuntime
@inject IOptions<MapOptions> MapOptionsAccessor
@inject ConfigurazioneMappa Configurazione
@implements IAsyncDisposable

<PageTitle>Mappa vigneti</PageTitle>

<div class="mappa-layout">
    <aside class="vigneti-list">
        <h1>Vigneti</h1>

        @if (_vigneti is null)
        {
            <p>Caricamento...</p>
        }
        else if (_vigneti.Count == 0)
        {
            <p>Nessun vigneto trovato per questa azienda.</p>
        }
        else
        {
            <ul>
                @foreach (var vigneto in _vigneti)
                {
                    <li id="@IdVoceElenco(vigneto.Id)" class="@(vigneto.Id == _vignetoSelezionatoId ? "selezionato" : "")">
                        <button type="button" @onclick="() => SelezionaVignetoAsync(vigneto.Id)">
                            @vigneto.Nome
                        </button>
                    </li>
                }
            </ul>
        }

        @if (_vignetoSelezionato is not null)
        {
            <div class="info-panel">
                <h2>@_vignetoSelezionato.Nome</h2>
                @if (!string.IsNullOrWhiteSpace(_vignetoSelezionato.Varieta))
                {
                    <p>Varietà: @_vignetoSelezionato.Varieta</p>
                }
                @if (_vignetoSelezionato.SuperficieEttari is not null)
                {
                    <p>Superficie: @_vignetoSelezionato.SuperficieEttari ha</p>
                }
                @if (string.IsNullOrWhiteSpace(_vignetoSelezionato.GeometriaGeoJson))
                {
                    <p class="nota">Geometria non disponibile</p>
                }
            </div>
        }
    </aside>

    <div class="mappa-area">
        <div id="@_mapElementId" class="mappa"></div>

        <div class="mappa-controlli">
            <div class="gruppo-pulsanti" role="group" aria-label="Tipo di mappa">
                <button type="button" class="@(_satellite ? "" : "attivo")" aria-pressed="@(!_satellite)"
                        @onclick="() => ImpostaSatelliteAsync(false)">Mappa</button>
                <button type="button" class="@(_satellite ? "attivo" : "")" aria-pressed="@_satellite"
                        disabled="@(_imageryId is null)" @onclick="() => ImpostaSatelliteAsync(true)">Satellite</button>
            </div>
            <button type="button" class="@(_terreno ? "attivo" : "")" aria-pressed="@_terreno"
                    disabled="@(Configurazione.TerrainId is null)" @onclick="CommutaTerrenoAsync">3D</button>

            @if (Configurazione.ModalitaSviluppatore)
            {
                <select aria-label="Basemap (sviluppo)" value="@_basemapId" @onchange="CambiaBasemapAsync">
                    <option value="@IdStyleInterno">Interno (offline)</option>
                    @foreach (var basemap in Configurazione.DelRuolo(RuoloSorgente.Basemap))
                    {
                        <option value="@basemap.Id">@basemap.Nome</option>
                    }
                </select>
                <select aria-label="Imagery (sviluppo)" value="@_imageryId" @onchange="CambiaImageryAsync">
                    @foreach (var imagery in Configurazione.DelRuolo(RuoloSorgente.Imagery))
                    {
                        <option value="@imagery.Id">@imagery.Nome</option>
                    }
                </select>
            }
        </div>

        @if (_avviso is not null)
        {
            <div class="mappa-avviso" role="status">
                <span>@_avviso</span>
                <button type="button" aria-label="Chiudi avviso" @onclick="() => _avviso = null">×</button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public int AziendaId { get; set; }

    private const string IdStyleInterno = "interno";
    private const string AvvisoRiserva = "Mappa di base non disponibile. È stata utilizzata la mappa di riserva.";
    private const string AvvisoInterno = "Mappa di base non disponibile. I dati dei vigneti restano consultabili.";

    private readonly string _mapElementId = $"mappa-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private DotNetObjectReference<Mappa>? _dotNetRef;
    private List<VignetoDto>? _vigneti;
    private VignetoDto? _vignetoSelezionato;
    private int? _vignetoSelezionatoId;

    // Stato cartografico: vive in Blazor e viene sincronizzato con il modulo JS.
    private string? _basemapId;
    private string? _imageryId;
    private bool _satellite;
    private bool _terreno;
    private string? _avviso;

    protected override void OnInitialized()
    {
        _imageryId = Configurazione.ImageryPredefinitaId;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var opzioni = MapOptionsAccessor.Value;
        _module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/mappa.js");
        _dotNetRef = DotNetObjectReference.Create(this);

        // Le sorgenti risolte possono contenere API key negli URL: vanno solo al browser (dove
        // una chiave è comunque visibile, protetta per Origin dal provider), mai nei log.
        await _module.InvokeVoidAsync("creaMappa", _mapElementId, new
        {
            centro = opzioni.CentroInizialeValido(),
            zoom = opzioni.ZoomIniziale,
            sorgenti = Configurazione.Sorgenti.Select(s => new
            {
                s.Id, s.Nome, Ruolo = s.Ruolo.ToString(), s.Tipo, s.StyleUrl, s.TileUrl, s.TileJsonUrl,
                s.Attribution, s.MinZoom, s.MaxZoom, s.TileSize, s.Encoding, s.Bounds,
            }),
            basemapId = Configurazione.BasemapPredefinitaId,
            basemapFallbackId = Configurazione.BasemapFallbackId,
            avvisoIniziale = Configurazione.BasemapPredefinitaSostituita ? "riserva" : null,
            timeoutStyleMs = Configurazione.TimeoutStyleMs,
            terrainId = Configurazione.TerrainId,
            terrainExaggeration = Configurazione.TerrainExaggeration,
        }, _dotNetRef);

        _vigneti = await VignetiApiClient.GetVignetiPerAziendaAsync(AziendaId);
        var geojson = await VignetiApiClient.GetVignetiGeoJsonAsync(AziendaId);
        await _module.InvokeVoidAsync("mostraVigneti", _mapElementId, geojson);

        StateHasChanged();
    }

    private string IdVoceElenco(int vignetoId) => $"{_mapElementId}-voce-{vignetoId}";

    /// <summary>
    /// Selezione dall'elenco: aggiorna lo stato Blazor e chiede al JS di evidenziare il vigneto
    /// e portarci la camera (il JS non richiama Blazor in questo percorso).
    /// </summary>
    private async Task SelezionaVignetoAsync(int vignetoId)
    {
        AggiornaSelezione(vignetoId);

        if (_module is not null)
        {
            await _module.InvokeVoidAsync("selezionaVigneto", _mapElementId, vignetoId);
        }
    }

    /// <summary>
    /// Richiamato dal JS quando l'utente clicca un vigneto sulla mappa: il JS ha già evidenziato
    /// il poligono, qui si aggiornano solo pannello ed elenco (nessuna chiamata a selezionaVigneto,
    /// quindi nessun movimento della camera e nessun loop).
    /// </summary>
    [JSInvokable]
    public async Task OnVignetoCliccato(int vignetoId)
    {
        AggiornaSelezione(vignetoId);
        StateHasChanged();

        if (_module is not null)
        {
            await _module.InvokeVoidAsync("portaInVista", IdVoceElenco(vignetoId));
        }
    }

    /// <summary>
    /// Richiamato dal JS quando una basemap è stata applicata (anche dopo un fallback): avviso è
    /// "riserva", "interno" oppure null. Non blocca nulla: i dati 4Grapes non dipendono dalla basemap.
    /// </summary>
    [JSInvokable]
    public void OnStatoBasemap(string basemapId, string? avviso)
    {
        _basemapId = basemapId;
        _avviso = avviso switch
        {
            "riserva" => AvvisoRiserva,
            "interno" => AvvisoInterno,
            _ => null,
        };
        StateHasChanged();
    }

    private async Task ImpostaSatelliteAsync(bool satellite)
    {
        _satellite = satellite && _imageryId is not null;
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("impostaImagery", _mapElementId, _satellite ? _imageryId : null);
        }
    }

    private async Task CommutaTerrenoAsync()
    {
        _terreno = !_terreno;
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("impostaTerreno", _mapElementId, _terreno);
        }
    }

    /// <summary>Solo modalità sviluppatore (benchmark): basemap scelta per provider.</summary>
    private async Task CambiaBasemapAsync(ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        if (_module is not null && !string.IsNullOrEmpty(id))
        {
            await _module.InvokeVoidAsync("impostaBasemap", _mapElementId, id);
        }
    }

    /// <summary>Solo modalità sviluppatore (benchmark): imagery scelta per provider.</summary>
    private async Task CambiaImageryAsync(ChangeEventArgs e)
    {
        _imageryId = e.Value?.ToString();
        if (_satellite)
        {
            await ImpostaSatelliteAsync(true);
        }
    }

    /// <summary>Solo stato applicativo: vigneto selezionato per elenco e pannello informazioni.</summary>
    private void AggiornaSelezione(int vignetoId)
    {
        _vignetoSelezionatoId = vignetoId;
        _vignetoSelezionato = _vigneti?.FirstOrDefault(v => v.Id == vignetoId);
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("distruggiMappa", _mapElementId);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Il circuito Blazor è già stato chiuso (es. navigazione via o crash del circuito):
                // lato client non c'è più nulla da ripulire, né la mappa né il modulo JS.
            }
        }
    }
}

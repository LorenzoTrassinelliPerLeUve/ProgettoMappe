@page "/bilancio-idrico/configurazione"
@page "/bilancio-idrico/configurazione-nuova"
@using System.Globalization
@using System.Security.Claims
@using System.Text.Json
@using Microsoft.Extensions.Logging
@using ProgettoMappe.Contracts
@using ProgettoMappe.Web.BilancioIdrico
@using ProgettoMappe.Web.Portale
@inject AziendeApiClient AziendeApiClient
@inject VignetiApiClient VignetiApiClient
@inject BilancioIdricoApiClient BilancioApi
@inject PortaleApiClient PortaleApi
@inject NavigationManager Navigation
@inject IConfiguration Configurazione
@inject IWebHostEnvironment Ambiente
@inject ILogger<ConfigurazioneNuova> Logger

<PageTitle>Configura il bilancio idrico</PageTitle>

@* Task #405: la configurazione intorno al vigneto (dal giro 2 al posto della pagina di prima, che resta per gli interni su
   /bilancio-idrico/configurazione/esperti). Pietre (scheletro) a parte: dato di 4Grapes con origine e data, valore a mano che prevale. Una tabella tipo foglio (stile, suolo, radici, gruppo irriguo, stato) con salvataggio a ogni
   scelta, l'irrigazione solo se l'azienda irriga (gruppi, impianto, turni in parole del consulente), «Ho irrigato» e il diario,
   avanzamento e cosa manca in cima; i parametri del modello solo per MasterUser e SysAdmin. Logica in
   Web/BilancioIdrico/ConfigurazioneVigneti. *@
<div class="contenitore bilancio-idrico bi-conf bi-conf2">
    <header class="intestazione-pagina">
        <h1 class="titolo-pagina">Configura il bilancio idrico</h1>
        <p class="sottotitolo">Tre domande per avere i consigli di irrigazione: che vino fai in ogni vigneto, com'è il suolo, e se l'azienda irriga.</p>
    </header>

    @if (_errore is not null)
    {
        <div class="messaggio-errore" role="alert">
            <p>@_errore</p>
            <button type="button" class="pulsante-principale" @onclick="CaricaAsync">Riprova</button>
        </div>
    }
    else if (_aziende is null)
    {
        <p class="aziende-stato" role="status">Carico le aziende…</p>
    }
    else
    {
        <div class="ib-filtri">
            <label>
                <span>Azienda</span>
                <select value="@(Azienda?.ToString(CultureInfo.InvariantCulture) ?? "")" @onchange="e => CambiaAzienda(e.Value as string)">
                    <option value="">Scegli un'azienda…</option>
                    @foreach (var a in _aziende)
                    {
                        <option value="@a.Id">@a.Nome</option>
                    }
                </select>
            </label>
        </div>

        @if (Azienda is { } azienda && _cv is { } cv)
        {
            <div class="bi-calcolo">
                <a class="pulsante" href="@($"bilancio-idrico?azienda={azienda}")">← Torna al bilancio</a>
                <span class="nota">Ogni scelta si salva da sola, con il tuo nome. Il bilancio si ricalcola in pochi secondi.</span>
            </div>
            @if (_login is null)
            {
                <p class="bi-esito bi-esito-errore" role="alert">Per cambiare qualcosa devi entrare con il tuo utente. <a href="accesso?ReturnUrl=@Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))">Entra</a></p>
            }

            @* 4) Avanzamento e cosa manca. *@
            <section class="bi-avanzamento" aria-label="Avanzamento della configurazione">
                <p class="bi-avanzamento-testo"><strong>Configurazione completa: @cv.Pronti @(cv.Pronti == 1 ? "vigneto" : "vigneti") su @cv.Totale</strong></p>
                <div class="bi-barra" role="progressbar" aria-valuemin="0" aria-valuemax="@cv.Totale" aria-valuenow="@cv.Pronti">
                    <span style="width: @(cv.Percentuale.ToString(CultureInfo.InvariantCulture))%"></span>
                </div>
                @{ var cose = cv.CoseDaFare(); }
                @if (cose.Count == 0)
                {
                    <p class="bi-ok">Tutto pronto: ogni vigneto ha il suo consiglio. <a href="@($"bilancio-idrico?azienda={azienda}")">Vedi i consigli</a></p>
                }
                else
                {
                    <h2 class="titolo-sezione">Cosa ti manca per avere i consigli</h2>
                    <ol class="bi-cose">
                        @foreach (var c in cose)
                        {
                            <li>
                                <strong>@c.Testo</strong>
                                <button type="button" class="pulsante bi-piccolo" @onclick="() => FaiOra(c.Azione)">Fallo ora</button>
                                <span class="nota">@c.Perche</span>
                            </li>
                        }
                    </ol>
                }
            </section>

            @if (_esito is { } esito)
            {
                <p class="bi-esito @(esito.Ok ? "bi-esito-ok" : "bi-esito-errore")" role="status">@esito.Testo</p>
            }

            @* 1) La tabella dei vigneti. *@
            <section class="bi-conf-sezione" id="vigneti">
                <h2 class="titolo-sezione">I vigneti dell'azienda</h2>
                @{ var righe = RigheMostrate(cv); }
                <p class="bi-filtro">
                    @if (Vigneto is { } solo)
                    {
                        <span>Solo il vigneto <strong>@(cv.Righe.FirstOrDefault(r => r.Id == solo)?.Nome)</strong>.</span>
                        <a href="@IndirizzoPagina(azienda)">Mostra tutti</a>
                    }
                    else
                    {
                        var daCompletare = cv.Attivi.Count(r => !r.Pronto);
                        <label><input type="checkbox" checked="@_soloDaCompletare" disabled="@(daCompletare == 0 && !_soloDaCompletare)"
                                      @onchange="e => { _soloDaCompletare = e.Value is true; _scelti.Clear(); }" /> Solo quelli da completare (@daCompletare)</label>
                    }
                </p>
                <details class="nota bi-aiuto">
                    <summary>Cosa vogliono dire le colonne</summary>
                    <p><strong>Stile del vino</strong>: quanta sete si lascia alla vite prima di consigliare di irrigare (1 = poca, 6 = tanta).
                        <strong>Suolo</strong>: quanta acqua tiene il terreno per la vite (riserva utile, mm); viene dall'analisi di 4Grapes, se c'è.
                        <strong>Pietre</strong>: lo scheletro del suolo; c'è il dato dell'analisi di 4Grapes, se non torna scegli il valore a mano (si torna al dato scegliendo la prima voce).
                        <strong>Radici</strong>: facoltativo, solo se le avete misurate. <strong>Irrigato</strong>: il gruppo che lo bagna, se l'azienda irriga.</p>
                    <ul>@foreach (var s in ConfigurazioneWeb.Stili) { <li>@s.Value</li> }</ul>
                </details>
                <p class="nota bi-come-fare">Scegli nella cella: si salva subito. Per dare gli stessi valori a più vigneti spunta le righe e usa «Riempi giù» o «Copia da».</p>

                <table class="tabella-report bi-tabella bi-conf-tabella bi-foglio">
                    <thead><tr>
                        <th><input type="checkbox" title="Scegli tutti" aria-label="Scegli tutti quelli in elenco"
                                   checked="@(righe.Count > 0 && righe.Where(r => r.NelCalcolo).All(r => _scelti.Contains(r.Id)))"
                                   @onchange="e => { if (e.Value is true) _scelti.UnionWith(righe.Where(r => r.NelCalcolo).Select(r => r.Id)); else _scelti.Clear(); }" /></th>
                        <th>Vigneto</th><th>Stile del vino</th><th>Suolo<small>riserva d'acqua</small></th><th>Pietre<small>scheletro, %</small></th><th>Radici<small>facoltativo</small></th>
                        @if (cv.Irriga) { <th>Irrigato</th> }
                        <th>Stato</th>
                    </tr></thead>
                    <tbody>
                        @foreach (var r in righe)
                        {
                            <tr class="@(r.NelCalcolo ? "" : "bi-fuori") @(_scelti.Contains(r.Id) ? "bi-scelta" : "")" id="@($"riga-{r.Id}")">
                                <td>@if (r.NelCalcolo) { <input type="checkbox" id="@($"v{r.Id}")" checked="@_scelti.Contains(r.Id)" aria-label="@($"Scegli {r.Nome}")"
                                                                @onchange="e => { if (e.Value is true) _scelti.Add(r.Id); else _scelti.Remove(r.Id); }" /> }</td>
                                <th scope="row">
                                    <label for="@($"v{r.Id}")">@r.Nome</label>
                                    @if (r.Vigna is { Length: > 0 } vigna && vigna != r.Nome) { <small class="nota">@vigna</small> }
                                    @if (!r.NelCalcolo) { <small class="nota">non attivo in 4Grapes: fuori dal bilancio</small> }
                                </th>
                                @if (r.NelCalcolo)
                                {
                                    <td data-etichetta="Stile del vino" class="@(r.Stile is null && !r.StileDalTarget ? "bi-cella-manca" : "")">
                                        <select value="@(r.Stile?.ToString(CultureInfo.InvariantCulture) ?? "")" disabled="@(_login is null || _salvo)"
                                                aria-label="@($"Stile del vino di {r.Nome}")" @onchange="e => SalvaStileAsync(r, e.Value as string)">
                                            <option value="">@(r.StileDalTarget ? "dal target di concimazione" : "— scegli —")</option>
                                            @foreach (var s in ConfigurazioneWeb.Stili) { <option value="@s.Key">@ConfigurazioneWeb.StileBreve(s.Key)</option> }
                                        </select>
                                    </td>
                                    <td data-etichetta="Suolo" class="@(r.Suolo == FonteSuoloRiga.Manca ? "bi-cella-manca" : "")">
                                        @switch (r.Suolo)
                                        {
                                            case FonteSuoloRiga.Analisi:
                                                <span>@TestiBilancio.Numero(r.AwcMm, "0") mm</span> <small class="nota bi-inline">dall'analisi</small>
                                                break;
                                            case FonteSuoloRiga.Scelto:
                                                <span>@TestiBilancio.Numero(r.AwcMm, "0") mm</span> <small class="nota bi-inline">scelto qui</small>
                                                break;
                                            default:
                                                <span class="bi-manca">manca l'analisi</span>
                                                break;
                                        }
                                        <button type="button" class="pulsante bi-piccolo" disabled="@(_login is null)" @onclick="() => ApriSuolo(r.Id)"
                                                aria-expanded="@(_suoloAperto == r.Id ? "true" : "false")">@(r.Suolo == FonteSuoloRiga.Manca ? "Descrivi il suolo" : "Cambia")</button>
                                    </td>
                                    var sch = r.Scheletro ?? new ScheletroRiga(null, null, null, null, null);
                                    <td data-etichetta="Pietre (scheletro)">
                                        <select value="@(sch.ManualePerc?.ToString(CultureInfo.InvariantCulture) ?? "")" disabled="@(_login is null || _salvo)"
                                                aria-label="@($"Pietre nel suolo di {r.Nome}")" @onchange="e => SalvaScheletroAsync(r, e.Value as string)">
                                            <option value="">@(sch.DatiPerc is { } dp ? $"{dp.ToString("0.#", It)}% (4Grapes)" : "— a mano —")</option>
                                            @foreach (var vp in ValoriScheletro(sch.ManualePerc)) { <option value="@vp.ToString(CultureInfo.InvariantCulture)">@vp.ToString("0.#", It)%</option> }
                                        </select>
                                        @if (sch.ManualePerc is not null)
                                        {
                                            <small class="nota">a mano @sch.Modifica · @sch.TestoOrigine@(sch.DatiPerc is { } d2 ? $": {d2.ToString("0.#", It)}%" : "")</small>
                                        }
                                        else
                                        {
                                            <small class="nota">@sch.TestoOrigine</small>
                                        }
                                    </td>
                                    <td data-etichetta="Radici">
                                        <select value="@RadiciGuidate.Chiave(r.Calibrazione?.ProfonditaRadiciM, r.Calibrazione?.LarghezzaRadiciM)" disabled="@(_login is null || _salvo)"
                                                aria-label="@($"Radici di {r.Nome}")" @onchange="e => SalvaRadiciAsync(r, e.Value as string)">
                                            <option value="">@(r.RadiciDalRilievo ? "dal rilievo di 4Grapes" : "non misurate")</option>
                                            @foreach (var s in RadiciGuidate.Scelte) { <option value="@RadiciGuidate.Chiave(s.Profondita, s.Larghezza)">@s.Nome</option> }
                                            @if (r.Calibrazione is { ProfonditaRadiciM: var p, LarghezzaRadiciM: var l } && (p ?? l) is not null
                                                 && RadiciGuidate.Scelte.All(s => s.Profondita != p || s.Larghezza != l))
                                            {
                                                <option value="@RadiciGuidate.Chiave(p, l)">@RadiciGuidate.Nome(p, l)</option>
                                            }
                                        </select>
                                    </td>
                                    @if (cv.Irriga)
                                    {
                                        <td data-etichetta="Irrigato">
                                            @if (r.Gruppi.Count > 1)
                                            {
                                                <span>@cv.Irrigato(r)</span>
                                            }
                                            else
                                            {
                                                <select value="@(r.Gruppi.FirstOrDefault().ToString(CultureInfo.InvariantCulture))" disabled="@(_login is null || _salvo)"
                                                        aria-label="@($"Gruppo irriguo di {r.Nome}")" @onchange="e => SalvaGruppoAsync(r, e.Value as string)">
                                                    <option value="0">no</option>
                                                    @foreach (var s in cv.Conf.Settori) { <option value="@s.Dati.IdSettore">sì · @s.Dati.Nome</option> }
                                                </select>
                                            }
                                        </td>
                                    }
                                    <td data-etichetta="Stato">
                                        @if (r.Pronto)
                                        {
                                            <span class="bi-ok">✓ pronto</span>
                                        }
                                        else
                                        {
                                            <span class="bi-manca">manca @string.Join(", ", r.Mancano)</span>
                                        }
                                        @if (_esitiRiga.GetValueOrDefault(r.Id) is { } er)
                                        {
                                            <small class="@(er.Ok ? "bi-ok" : "bi-manca")" role="status">@er.Testo</small>
                                        }
                                    </td>
                                }
                                else
                                {
                                    <td colspan="@(cv.Irriga ? 6 : 5)"></td>
                                }
                            </tr>
                            @if (_suoloAperto == r.Id)
                            {
                                <tr class="bi-guida"><td colspan="@(cv.Irriga ? 8 : 7)">
                                    @GuidaSuolo(r)
                                </td></tr>
                            }
                        }
                    </tbody>
                </table>

                @if (_scelti.Count > 0)
                {
                    var prima = righe.FirstOrDefault(r => _scelti.Contains(r.Id));
                    <div class="bi-blocco" role="group" aria-label="Stessi valori ai vigneti scelti">
                        <strong>@ConfigurazioneVigneti.Quanti(_scelti.Count) @(_scelti.Count == 1 ? "scelto" : "scelti")</strong>
                        @if (prima is not null && _scelti.Count > 1)
                        {
                            <button type="button" class="pulsante-principale" disabled="@(_login is null || _salvo)" @onclick="() => CopiaAsync(prima.Id)"
                                    title="Stile, suolo e radici del primo vigneto scelto agli altri">Riempi giù da «@prima.Nome»</button>
                        }
                        <label>oppure copia da
                            <select value="" disabled="@(_login is null || _salvo)" @onchange="e => CopiaDaAsync(e.Value as string)">
                                <option value="">un vigneto…</option>
                                @foreach (var v in cv.Attivi.Where(v => v.Stile is not null || v.Calibrazione is not null)) { <option value="@v.Id">@v.Nome</option> }
                            </select>
                        </label>
                        <button type="button" class="pulsante" @onclick="() => _scelti.Clear()">Annulla la scelta</button>
                    </div>
                }
            </section>

            @* 2) Irrigazione solo se serve. *@
            <section class="bi-conf-sezione" id="irrigazione">
                <h2 class="titolo-sezione">Irrigazione</h2>
                @if (!cv.Irriga && _passo == 0)
                {
                    <div class="bi-domanda">
                        <p><strong>L'azienda irriga?</strong></p>
                        @if (cv.NonIrriga)
                        {
                            <p><span class="bi-ok">No, non irriga.</span> <span class="nota">Risposto @ConfigurazioneWeb.ModificaBreve(cv.Conf.Azienda!).</span></p>
                            <p class="nota">Non serve altro: il bilancio dà lo stesso lo stato dell'acqua di ogni vigneto e quando la vite comincia a soffrire.</p>
                            <button type="button" class="pulsante" disabled="@(_login is null || _salvo)" @onclick="() => RispondiIrrigaAsync(true)">Ora irriga</button>
                        }
                        else
                        {
                            <p class="nota">Se sì, ti chiediamo quali vigneti si bagnano insieme e com'è l'impianto: così il consiglio dice anche quante ore irrigare.</p>
                            <button type="button" class="pulsante-principale" disabled="@(_login is null || _salvo)" @onclick="() => RispondiIrrigaAsync(true)">Sì, irriga</button>
                            <button type="button" class="pulsante" disabled="@(_login is null || _salvo)" @onclick="() => RispondiIrrigaAsync(false)">No</button>
                        }
                    </div>
                }
                else
                {
                    @if (_passo > 0)
                    {
                        @Percorso(cv)
                    }
                    else
                    {
                        <ul class="bi-gruppi">
                            @foreach (var s in cv.Conf.Settori)
                            {
                                var id = s.Dati.IdSettore;
                                var imp = cv.Impianto(id, _oggi);
                                var vigneti = cv.Righe.Where(r => r.Gruppi.Contains(id)).ToList();
                                <li class="bi-gruppo">
                                    <div class="bi-gruppo-testa"><strong>@s.Dati.Nome</strong> <span class="nota">@ConfigurazioneVigneti.Quanti(vigneti.Count)</span></div>
                                    <p class="nota">@(vigneti.Count == 0 ? "Nessun vigneto: scegli i vigneti nella colonna «Irrigato» della tabella." : string.Join(", ", vigneti.Select(v => v.Nome)))</p>
                                    @if (imp is { } i && ConfigurazioneVigneti.HaImpianto(cv.Conf, id))
                                    {
                                        var (_, testo, ok, _) = ImpiantoGuidato.Controlla(i.IdTipologiaImpianto ?? 1, i.DistanzaGocciolatoriM, i.DistanzaAliM, i.PortataLh);
                                        <p>@ImpiantoGuidato.Tipo(i.IdTipologiaImpianto ?? 1).Nome ·
                                            @TestiBilancio.Numero(i.TassoMmOra, "0.##") mm all'ora
                                            @if (testo is not null && !ok) { <small class="bi-manca">@testo</small> }
                                            else if (ConfigurazioneWeb.TassoImplausibile(i.TassoMmOra)) { <small class="bi-manca">da controllare: troppo</small> }
                                        </p>
                                    }
                                    else
                                    {
                                        <p class="bi-manca">Manca l'impianto: niente ore di irrigazione.</p>
                                    }
                                    <button type="button" class="pulsante" disabled="@(_login is null)" @onclick="() => CambiaImpianto(id)">@(imp is null ? "Descrivi l'impianto" : "Cambia l'impianto")</button>
                                    <button type="button" class="pulsante" disabled="@(_login is null || _salvo)" @onclick="() => TogliGruppoAsync(s.Dati)">Togli il gruppo</button>
                                </li>
                            }
                        </ul>
                        <button type="button" class="pulsante" disabled="@(_login is null)" @onclick="NuovoGruppo">+ Un altro gruppo di vigneti</button>

                        @if (cv.Conf.Settori.Count > 1)
                        {
                            <details class="bi-turni" open="@(cv.Conf.Shift.Count > 0)">
                                <summary><strong>Aprite più gruppi insieme?</strong> <span class="nota">facoltativo</span></summary>
                                @Turni(cv)
                            </details>
                        }
                    }
                }
            </section>

            @* 3) Ho irrigato e il diario. *@
            @if (cv.Irriga)
            {
                <section class="bi-conf-sezione" id="irrigato">
                    <h2 class="titolo-sezione">Ho irrigato</h2>
                    @HoIrrigato(cv)
                    @Diario(cv)
                </section>
            }

            @if (_interno)
            {
                <p class="nota bi-esperti">Per esperti (MasterUser e SysAdmin):
                    <a href="@VignetiConfigurazione.IndirizzoEsperti(azienda, VignetiConfigurazione.Esperti)">parametri del modello</a> ·
                    <a href="@VignetiConfigurazione.IndirizzoEsperti(azienda, VignetiConfigurazione.Suolo)">correzioni fini del suolo</a> ·
                    <a href="@VignetiConfigurazione.IndirizzoEsperti(azienda, VignetiConfigurazione.Irrigazione)">settori, quote parziali e turni</a></p>
            }
        }
        else if (Azienda is not null)
        {
            <p class="aziende-stato" role="status">Carico la configurazione…</p>
        }
    }
</div>

@code {
    private const string TipoSettore = "settore", TipoQuota = "quota", TipoImpianto = "impianto", TipoShift = "shift",
        TipoSettoreShift = "settore-shift", TipoStile = "stile", TipoIrrigazione = "irrigazione", TipoCalibrazione = "calibrazione", TipoAzienda = "azienda";
    private static readonly CultureInfo It = CultureInfo.GetCultureInfo("it-IT");

    [SupplyParameterFromQuery(Name = "azienda")] private int? Azienda { get; set; }
    [SupplyParameterFromQuery(Name = "vigneto")] private int? Vigneto { get; set; }
    [SupplyParameterFromQuery(Name = "irrigato")] private int? Irrigato { get; set; }
    // Gli indirizzi della pagina di prima (VignetiConfigurazione.Indirizzo): sezione esperti → pagina per esperti, solo=mancanti → filtro.
    [SupplyParameterFromQuery(Name = "sezione")] private string? Sezione { get; set; }
    [SupplyParameterFromQuery(Name = "solo")] private string? Solo { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? StatoAccesso { get; set; }

    private sealed record Esito(string Testo, bool Ok);
    private sealed class ModuloSuolo { public int Tessitura; public double Profondita = 0.8; public string? Awc; }
    private sealed class ModuloImpianto { public int Tipologia = 1; public string? Distanza, Ali, Portata; }
    private sealed class ModuloIrrigazione { public int IdEvento; public string Dove = ""; public DateOnly Data = DateOnly.FromDateTime(DateTime.Today); public string? Ore, Mm; }

    private List<AziendaDto>? _aziende;
    private int? _confAzienda;
    private ConfigurazioneVigneti? _cv;
    private BilancioAziendaDto? _stato;
    private string? _errore;
    private Esito? _esito;
    private readonly Dictionary<int, Esito> _esitiRiga = [];
    private bool _salvo;
    private string? _login;
    private int? _idUtente;
    private bool _interno;
    private readonly DateOnly _oggi = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly InizioAnno => new(_oggi.Year, 1, 1);

    private readonly HashSet<int> _scelti = [];
    private bool _soloDaCompletare;
    private int? _suoloAperto;
    private ModuloSuolo _suolo = new();

    // Percorso guidato dell'irrigazione: 1 = quali vigneti, 2 = com'è l'impianto, 3 = turni. _gruppo = settore che si sta facendo.
    private int _passo;
    private int _gruppo;
    private readonly HashSet<int> _vignetiGruppo = [];
    private string _nomeGruppo = "";
    private bool _nomeScritto;
    private ModuloImpianto _impianto = new();
    private string _nomeTurno = "";
    private readonly HashSet<int> _gruppiTurno = [];
    private ModuloIrrigazione _irr = new();

    private string IndirizzoPagina(int azienda) => $"bilancio-idrico/configurazione?azienda={azienda}";

    private IReadOnlyList<RigaConfigurazione> RigheMostrate(ConfigurazioneVigneti cv) =>
        Vigneto is { } id ? cv.Righe.Where(r => r.Id == id).ToList()
        : _soloDaCompletare ? cv.Righe.Where(r => r.NelCalcolo && !r.Pronto).ToList()
        : cv.Righe;

    protected override async Task OnInitializedAsync()
    {
        if (StatoAccesso is not null && (await StatoAccesso).User is { Identity.IsAuthenticated: true } utente)
        {
            _login = utente.FindFirstValue(ClaimTypes.NameIdentifier);
            _idUtente = UtentePortale.IdUtente(utente);
            var esperienza = await EsperienzaAsync(utente);
            // «Per esperti» solo a MasterUser e SysAdmin (proprietario, 27/11), non dalla categoria della #401.
            _interno = await EspertiBilancio.EspertoAsync(utente, PortaleApi, Logger);
            // Chi è in consultazione (task #401) vede la configurazione ma non la cambia: comandi spenti come senza accesso.
            if (TipiEsperienza.SoloConsultazione(esperienza))
                _login = null;
        }
        // Solo in Development (foto del prototipo, docs/specifiche/bilancio-idrico/config-v2): un autore finto per vedere i comandi accesi.
        else if (Ambiente.IsDevelopment() && Configurazione["BilancioIdrico:AutoreDiProva"] is { Length: > 0 } prova)
            (_login, _interno) = (prova, true);
    }

    /// <summary>L'esperienza della task #401: niente modifiche in consultazione; se non si sa, null.</summary>
    private async Task<string?> EsperienzaAsync(ClaimsPrincipal utente)
    {
        if (UtentePortale.IdUtente(utente) is not { } id)
            return null;
        try
        {
            return (await PortaleApi.GetEsperienzaAsync(id)).Dati?.Esperienza;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning("Configurazione nuova: esperienza dell'utente {Utente} non letta ({Messaggio})", id, ex.Message);
            return null;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Sezione == VignetiConfigurazione.Esperti && Azienda is { } az)
        {
            Navigation.NavigateTo(VignetiConfigurazione.IndirizzoEsperti(az, VignetiConfigurazione.Esperti));
            return;
        }
        if (Solo == "mancanti")
            _soloDaCompletare = true;
        if (_aziende is null)
            await CaricaAsync();
        else if (Azienda != _confAzienda)
            await CaricaConfigurazioneAsync();
    }

    private async Task CaricaAsync()
    {
        _errore = null;
        try
        {
            _aziende = (await AziendeApiClient.GetAziendeAsync()).OrderBy(a => a.Nome).ToList();
            await CaricaConfigurazioneAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning("Configurazione nuova: aziende non lette ({Messaggio})", ex.Message);
            _errore = "Non riesco a leggere le aziende, riprova.";
        }
    }

    private async Task CaricaConfigurazioneAsync()
    {
        var cambiata = _confAzienda != Azienda;
        _confAzienda = Azienda;
        if (cambiata)
        {
            _cv = null;
            _scelti.Clear();
            _esitiRiga.Clear();
            _passo = 0;
        }
        if (Azienda is not { } id)
            return;
        try
        {
            var vigneti = VignetiApiClient.GetVignetiPerAziendaAsync(id);
            var stato = StatoAsync(id);
            var conf = ConfigurazioneWeb.Da(await BilancioApi.GetVociAsync(id));
            _stato = await stato;
            _cv = ConfigurazioneVigneti.Da((await vigneti).Vigneti, conf, _stato, _oggi);
            if (cambiata && Irrigato is { } settore && conf.Settori.Any(s => s.Dati.IdSettore == settore))
                PreparaIrrigazione($"s{settore}");
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning("Configurazione nuova dell'azienda {Azienda} non letta ({Messaggio})", id, ex.Message);
            _errore = "Non riesco a leggere la configurazione di questa azienda, riprova.";
        }
    }

    private async Task<BilancioAziendaDto?> StatoAsync(int id)
    {
        try
        {
            return await BilancioApi.GetStatoAziendaAsync(id);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning("Configurazione nuova: stato dell'azienda {Azienda} non letto ({Messaggio})", id, ex.Message);
            return null;
        }
    }

    private void CambiaAzienda(string? valore) =>
        Navigation.NavigateTo(int.TryParse(valore, out var id) ? IndirizzoPagina(id) : "bilancio-idrico/configurazione");

    // ---------- salvataggi ----------

    /// <summary>Salva una voce; null = non salvata (l'errore è in <see cref="_esito"/>), altrimenti la voce come l'ha salvata l'Api.</summary>
    private async Task<VoceBilancioDto?> SalvaAsync(string tipo, object dati, bool elimina = false)
    {
        if (Azienda is not { } id || _login is null)
        {
            _esito = new("Per cambiare qualcosa devi entrare con il tuo utente.", false);
            return null;
        }
        try
        {
            var esito = await BilancioApi.SalvaVoceAsync(id, tipo,
                new SalvaVoceBilancioDto(_login, JsonSerializer.SerializeToElement(dati, dati.GetType(), ConfigurazioneWeb.Json), elimina), _idUtente);
            if (esito.Errore is not null)
            {
                _esito = new($"Non salvato: {esito.Errore}.", false);
                return null;
            }
            return esito.Valore;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning("Configurazione nuova: {Tipo} non salvata ({Messaggio})", tipo, ex.Message);
            _esito = new("Non riesco a salvare, riprova.", false);
            return null;
        }
    }

    private async Task<bool> SalvaBloccoAsync(string tipo, IEnumerable<object> dati)
    {
        var lista = dati.Select(d => JsonSerializer.SerializeToElement(d, d.GetType(), ConfigurazioneWeb.Json)).ToList();
        if (lista.Count == 0 || Azienda is not { } id || _login is null)
            return true;
        try
        {
            var esito = await BilancioApi.SalvaBloccoAsync(id, tipo, new SalvaVociBilancioDto(_login, lista), _idUtente);
            if (esito.Errore is null)
                return true;
            _esito = new($"Non salvato, nessun vigneto cambiato: {esito.Errore}.", false);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning("Configurazione nuova: {Tipo} in blocco non salvato ({Messaggio})", tipo, ex.Message);
            _esito = new("Non riesco a salvare, riprova: nessun vigneto è cambiato.", false);
        }
        return false;
    }

    /// <summary>Un salvataggio di riga: «Salvo…», poi «Salvato ✓» nella riga e la configurazione riletta.</summary>
    private async Task RigaAsync(int idVigneto, Func<Task<bool>> salva)
    {
        _salvo = true;
        _esito = null;
        _esitiRiga[idVigneto] = new("Salvo…", true);
        try
        {
            var ok = await salva();
            _esitiRiga[idVigneto] = ok ? new("Salvato ✓", true) : new("Non salvato", false);
            if (ok)
                await CaricaConfigurazioneAsync();
        }
        finally
        {
            _salvo = false;
        }
    }

    private Task SalvaStileAsync(RigaConfigurazione r, string? valore) => RigaAsync(r.Id, async () =>
    {
        if (int.TryParse(valore, out var stile))
            return await SalvaAsync(TipoStile, new StileBilancioDto(r.Id, stile, InizioAnno, null)) is not null;
        // «scegli» su uno stile scritto qui = lo si toglie (torna al target di concimazione, se c'è).
        var voce = _cv?.Conf.StileDi(r.Id, _oggi);
        return voce is null || await SalvaAsync(TipoStile, voce.Dati, elimina: true) is not null;
    });

    private Task SalvaCalibrazioneAsync(int idVigneto, CalibrazioneBilancioDto c)
    {
        var vuota = c is { ScheletroPerc: null, ProfonditaRadiciM: null, LarghezzaRadiciM: null, AwcMm: null };
        return RigaAsync(idVigneto, async () =>
        {
            if (!vuota && ConfigurazioneWeb.ControllaCalibrazione(c) is { } errore)
            {
                _esito = new(errore, false);
                return false;
            }
            return await SalvaAsync(TipoCalibrazione, c, elimina: vuota) is not null;
        });
    }

    private Task SalvaRadiciAsync(RigaConfigurazione r, string? chiave)
    {
        var (p, l) = RadiciGuidate.DaChiave(chiave);
        var c = (r.Calibrazione ?? new CalibrazioneBilancioDto(r.Id)) with { ProfonditaRadiciM = p, LarghezzaRadiciM = l };
        return SalvaCalibrazioneAsync(r.Id, c);
    }

    /// <summary>Lo scheletro scritto a mano (vuoto = si torna al dato di 4Grapes), da solo: il resto della calibrazione non cambia.</summary>
    private Task SalvaScheletroAsync(RigaConfigurazione r, string? valore) =>
        SalvaCalibrazioneAsync(r.Id, (r.Calibrazione ?? new CalibrazioneBilancioDto(r.Id)) with { ScheletroPerc = ConfigurazioneWeb.Numero(valore) });

    /// <summary>I valori della tendina delle pietre, con quello scritto a mano se non è fra questi.</summary>
    private static IEnumerable<double> ValoriScheletro(double? manuale)
    {
        double[] valori = [0, 5, 10, 15, 20, 25, 30, 40, 50, 60, 70];
        return manuale is { } m && !valori.Contains(m) ? valori.Append(m).Order() : valori;
    }

    private async Task RispondiIrrigaAsync(bool irriga)
    {
        if (Azienda is not { } azienda)
            return;
        _salvo = true;
        try
        {
            if (await SalvaAsync(TipoAzienda, new AziendaBilancioDto(azienda, irriga)) is null)
                return;
            await CaricaConfigurazioneAsync();
            if (irriga)
                NuovoGruppo();
            else
                _esito = new("Salvato: l'azienda non irriga ✓", true);
        }
        finally
        {
            _salvo = false;
        }
    }

    private void ApriSuolo(int id)
    {
        _suoloAperto = _suoloAperto == id ? null : id;
        _suolo = new();
    }

    private RenderFragment GuidaSuolo(RigaConfigurazione r) => __builder =>
    {
        // Le pietre sono quelle della colonna «Pietre» (dato di 4Grapes o scritto a mano): non si scelgono di nuovo qui.
        var pietre = r.Scheletro?.Usato ?? 0;
        var awc = _suolo.Tessitura == 0 ? null : SuoloGuidato.RiservaUtile(_suolo.Tessitura, _suolo.Profondita, pietre);
        <div class="bi-modulo bi-guida-suolo">

@page "/bilancio-idrico/configurazione/esperti"
@using System.Globalization
@using System.Security.Claims
@using System.Text.Json
@using Microsoft.Extensions.Logging
@using ProgettoMappe.Contracts
@using ProgettoMappe.Web.BilancioIdrico
@inject AziendeApiClient AziendeApiClient
@inject VignetiApiClient VignetiApiClient
@inject BilancioIdricoApiClient BilancioApi
@inject NavigationManager Navigation
@inject PortaleApiClient PortaleApi
@inject IConfiguration Configurazione
@inject IWebHostEnvironment Ambiente
@inject ILogger<ConfigurazioneBilancio> Logger
@using ProgettoMappe.Web.Portale

<PageTitle>Configurazione del bilancio idrico</PageTitle>

@* DSS Bilancio Idrico, fase 3 (task #335, punto D): settori, quote, impianti, shift, stili e irrigazioni registrate, con le
   Api della fase 2. Ogni modifica è una versione nuova con autore e data; dopo, l'Api ricalcola l'azienda in background.
   Task #384 (passata UX): una sezione per volta, «cosa manca» in cima con il collegamento alla sezione, stile e suolo in
   blocco, parole al posto delle sigle, controlli di plausibilità, esito vicino al pulsante, tabella comune in «Per esperti». *@
<div class="contenitore bilancio-idrico bi-conf">
    <header class="intestazione-pagina">
        <h1 class="titolo-pagina">Configurazione per esperti</h1>
        <p class="sottotitolo">Tutti i dati del motore uno per uno (settori con quote parziali, impianti con efficienza, turni, correzioni fini del suolo, parametri comuni). Per il lavoro di tutti i giorni c'è la <a href="@(Azienda is { } az0 ? $"bilancio-idrico/configurazione?azienda={az0}" : "bilancio-idrico/configurazione")">configurazione</a>.</p>
    </header>

    @if (!_interno)
    {
        <p class="bi-esito bi-esito-errore" role="alert">Questa pagina è solo per gli esperti Perleuve. <a href="@(Azienda is { } az1 ? $"bilancio-idrico/configurazione?azienda={az1}" : "bilancio-idrico/configurazione")">Vai alla configurazione</a></p>
    }
    else if (_errore is not null)
    {
        <div class="messaggio-errore" role="alert">
            <p>@_errore</p>
            <button type="button" class="pulsante-principale" @onclick="CaricaAsync">Riprova</button>
        </div>
    }
    else if (_aziende is null)
    {
        <p class="aziende-stato" role="status">Carico le aziende…</p>
    }
    else
    {
        <div class="ib-filtri">
            <label>
                <span>Azienda</span>
                <select value="@(Azienda?.ToString(CultureInfo.InvariantCulture) ?? "")" @onchange="e => CambiaAzienda(e.Value as string)">
                    <option value="">Scegli un'azienda…</option>
                    @foreach (var a in _aziende)
                    {
                        <option value="@a.Id">@a.Nome</option>
                    }
                </select>
            </label>
        </div>

        @if (Azienda is { } azienda && _conf is { } c && _elenco is { } el)
        {
            var sezione = el.SezioneDaAprire(Sezione);
            <div class="bi-calcolo">
                <a class="pulsante" href="@($"bilancio-idrico?azienda={azienda}")">← Torna al bilancio dell'azienda</a>
                <span class="nota">Ogni modifica resta nello storico con il tuo nome. Il bilancio si ricalcola da solo in pochi secondi.</span>
            </div>
            @if (_login is null)
            {
                <p class="bi-esito bi-esito-errore" role="alert">Per modificare devi entrare con il tuo utente: ogni modifica porta il nome di chi la fa. <a href="accesso?ReturnUrl=@Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))">Entra</a></p>
            }

            @* Task #384: cosa manca, con il collegamento ai vigneti da completare. *@
            <h2 class="titolo-sezione">Cosa manca</h2>
            @if (el.SenzaStile + el.SenzaAnalisiSuolo + el.SenzaSettore == 0)
            {
                <p class="nota">Tutti i vigneti nel bilancio hanno lo stile del vino, i dati del suolo e un settore.</p>
            }
            else
            {
                <div class="bi-riassunto">
                    @if (el.SenzaStile > 0)
                    {
                        <a class="bi-tessera bi-tessera-manca" href="@VignetiConfigurazione.IndirizzoEsperti(azienda, VignetiConfigurazione.Stile, true)">
                            <strong>@el.SenzaStile</strong> senza stile del vino<small>Senza stile non c'è suggerimento. Imposta lo stile →</small>
                        </a>
                    }
                    @if (el.SenzaAnalisiSuolo > 0)
                    {
                        <a class="bi-tessera bi-tessera-manca" href="@VignetiConfigurazione.IndirizzoEsperti(azienda, VignetiConfigurazione.Suolo, true)">
                            <strong>@el.SenzaAnalisiSuolo</strong> senza analisi del suolo<small>Suggerimento poco affidabile. Scrivi la riserva utile →</small>
                        </a>
                    }
                    @if (el.SenzaSettore > 0)
                    {
                        <a class="bi-tessera bi-na" href="@VignetiConfigurazione.IndirizzoEsperti(azienda, VignetiConfigurazione.Irrigazione)">
                            <strong>@el.SenzaSettore</strong> senza settore irriguo<small>Facoltativo: servono solo per le ore di irrigazione →</small>
                        </a>
                    }
                </div>
            }
            @if (el.FuoriCalcolo > 0)
            {
                <p class="nota">@(el.FuoriCalcolo == 1 ? "1 vigneto non è attivo" : $"{el.FuoriCalcolo} vigneti non sono attivi") in 4Grapes (estirpati, non a carico o di vigne nascoste): restano fuori dal bilancio e sono in grigio in fondo agli elenchi.</p>
            }

            <nav class="bi-linguette" aria-label="Sezioni della configurazione">
                @foreach (var (chiave, nome) in VignetiConfigurazione.Sezioni)
                {
                    var mancanti = chiave is VignetiConfigurazione.Irrigazione ? 0 : el.Mancanti(chiave);
                    <a class="pillola @(chiave == sezione ? "attiva" : "")" aria-current="@(chiave == sezione ? "page" : null)"
                       href="@VignetiConfigurazione.IndirizzoEsperti(azienda, chiave)">
                        @nome
                        @if (mancanti > 0)
                        {
                            <span class="bi-conta" title="vigneti da completare">@mancanti</span>
                        }
                    </a>
                }
            </nav>

            @if (_esito is { } esito)
            {
                <p class="bi-esito @(esito.Ok ? "bi-esito-ok" : "bi-esito-errore")" role="status">
                    @esito.Testo
                    @if (esito.Ok)
                    {
                        <a href="@($"bilancio-idrico?azienda={azienda}")">Vedi il bilancio aggiornato</a>
                    }
                </p>
            }

            @switch (sezione)
            {
                case VignetiConfigurazione.Stile:
                    var vignetiStile = el.DaMostrare(sezione, SoloMancanti, Vigneto);
                    <section class="bi-conf-sezione">
                        <h2 class="titolo-sezione">Stile del vino</h2>
                        <p class="nota">Lo stile dice <strong>quanto stress idrico si lascia alla vite</strong> prima di consigliare di irrigare: con 1 si irriga appena la vite comincia a soffrire, con 6 si aspetta di più. Senza stile il vigneto non ha suggerimento. Se nella configurazione manca, il bilancio lo prende dal target di concimazione di 4Grapes, quando c'è.</p>
                        <details class="nota"><summary>I sei stili</summary>
                            <ul>@foreach (var s in ConfigurazioneWeb.Stili) { <li>@s.Value</li> }</ul>
                        </details>
                        @Filtro(azienda, sezione, el, "Solo i vigneti senza stile")
                        <p class="nota bi-come-fare">Spunta i vigneti (anche uno solo, o tutti con la casella in alto): in fondo allo schermo compare la barra per scegliere lo stile e applicarlo a tutti insieme.</p>
                        <table class="tabella-report bi-tabella bi-conf-tabella">
                            <thead><tr><th>@CasellaTutti(vignetiStile)</th><th>Vigneto</th><th>Stile oggi</th><th class="bi-modifica">Ultima modifica</th></tr></thead>
                            <tbody>
                                @foreach (var v in vignetiStile)
                                {
                                    var voce = c.StileDi(v.Id, _oggi);
                                    <tr class="@(v.NelCalcolo ? "" : "bi-fuori")">
                                        <td>@Casella(v)</td>
                                        <th scope="row"><label for="@($"v{v.Id}")">@v.Nome</label></th>
                                        <td>
                                            @if (!v.NelCalcolo)
                                            {
                                                <span class="nota">non attivo: fuori dal bilancio</span>
                                            }
                                            else if (v.StileConfigurato is { } st)
                                            {
                                                @ConfigurazioneWeb.StileBreve(st)
                                            }
                                            else if (v.StileDalTarget)
                                            {
                                                <span class="nota">dal target di concimazione</span>
                                            }
                                            else
                                            {
                                                <span class="bi-manca">manca</span>
                                            }
                                        </td>
                                        <td class="nota bi-modifica">@(voce is null ? "" : Modifica(voce))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        @if (SceltiFra(vignetiStile).Count > 0)
                        {
                        <div class="bi-blocco" role="group" aria-label="Stile ai vigneti scelti">
                            <strong>@Scelti(vignetiStile)</strong>
                            <label>Stile
                                <select @bind="_bloccoStile">
                                    <option value="0">Scegli…</option>
                                    @foreach (var s in ConfigurazioneWeb.Stili) { <option value="@s.Key">@ConfigurazioneWeb.StileBreve(s.Key)</option> }
                                </select>
                            </label>
                            @{ var conStile = el.Vigneti.Where(v => v.StileConfigurato is not null).ToList(); }
                            @if (conStile.Count > 0)
                            {
                                <label>oppure copia da
                                    <select value="" @onchange="CopiaStile">
                                        <option value="">un vigneto…</option>
                                        @foreach (var v in conStile) { <option value="@v.Id">@v.Nome (@v.StileConfigurato)</option> }
                                    </select>
                                </label>
                            }
                            <label>Vale dal <input type="date" @bind="_bloccoDal" /></label>
                            <button type="button" class="pulsante-principale" disabled="@(_login is null || _salvo || _bloccoStile == 0)"
                                    @onclick="() => SalvaStiliAsync(SceltiFra(vignetiStile))">@(_salvo ? "Salvo…" : $"Applica a {Quanti(SceltiFra(vignetiStile).Count)}")</button>
                            <button type="button" class="pulsante" @onclick="() => _scelti.Clear()">Annulla la scelta</button>
                        </div>
                        }
                    </section>
                    break;

                case VignetiConfigurazione.Suolo:
                    var vignetiSuolo = el.DaMostrare(sezione, SoloMancanti, Vigneto);
                    @* Come nella #378: quello che vale per tutti si dice una volta sola, non su ogni riga. *@
                    var radiciATutti = el.Vigneti.Count(v => v.NelCalcolo) > 1 && el.Vigneti.Where(v => v.NelCalcolo).All(v => v.SenzaRadici);
                    <section class="bi-conf-sezione">
                        <h2 class="titolo-sezione">Suolo e radici</h2>
                        <p class="nota">Il bilancio calcola quanta acqua il suolo può tenere per la vite (la <strong>riserva utile</strong>, in mm) dall'analisi del suolo di 4Grapes e dalle radici. Qui scrivi un valore <strong>misurato in campo</strong> quando l'analisi manca o i numeri non tornano: prende il posto di quello di 4Grapes. Casella vuota = si usano i dati di 4Grapes; in grigio il valore che il bilancio usa oggi.</p>
                        @Filtro(azienda, sezione, el, "Solo i vigneti senza analisi del suolo")
                        @if (radiciATutti)
                        {
                            <p class="nota">Nessun vigneto ha il rilievo delle radici in 4Grapes: è facoltativo, senza il bilancio usa tutto il profilo del suolo. Se le radici sono state misurate, scrivi profondità e larghezza.</p>
                        }
                        <p class="nota bi-come-fare">Scrivi nella riga del vigneto e premi «Salva». Per dare gli stessi valori a più vigneti spuntali: in fondo allo schermo compare la barra (le caselle lasciate vuote non cambiano).</p>
                        <table class="tabella-report bi-tabella bi-conf-tabella bi-righe-schede">
                            <thead><tr>
                                <th>@CasellaTutti(vignetiSuolo)</th><th>Vigneto</th>
                                <th>Pietre nel suolo<small>scheletro, % (0–99)</small></th>
                                <th>Profondità delle radici<small>m (fino a 5)</small></th>
                                <th>Larghezza delle radici<small>m (fino a 10)</small></th>
                                <th>Riserva utile<small>AWC, mm (fino a 1000)</small></th>
                                <th></th>
                            </tr></thead>
                            <tbody>
                                @foreach (var v in vignetiSuolo)
                                {
                                    var m = _calibrazioni[v.Id];
                                    var voce = c.CalibrazioneDi(v.Id);
                                    <tr class="@(v.NelCalcolo ? "" : "bi-fuori")">
                                        <td>@Casella(v)</td>
                                        <th scope="row">
                                            <label for="@($"v{v.Id}")">@v.Nome</label>
                                            @if (!v.NelCalcolo)
                                            {
                                                <small class="nota">non attivo: fuori dal bilancio</small>
                                            }
                                            else if (v.SenzaAnalisiSuolo)
                                            {
                                                <small class="bi-manca">manca l'analisi del suolo</small>
                                            }
                                            else if (v.SenzaRadici && !radiciATutti)
                                            {
                                                <small class="nota">manca il rilievo delle radici (facoltativo)</small>
                                            }
                                            @if (voce is not null)
                                            {
                                                <small class="nota bi-modifica">@Modifica(voce)</small>
                                            }
                                        </th>
                                        <td data-etichetta="Pietre %"><input @bind="m.Scheletro" inputmode="decimal" size="4" aria-label="Pietre nel suolo, %" /></td>
                                        <td data-etichetta="Profondità radici m"><input @bind="m.Profondita" inputmode="decimal" size="4" aria-label="Profondità delle radici, m" /></td>
                                        <td data-etichetta="Larghezza radici m"><input @bind="m.Larghezza" inputmode="decimal" size="4" aria-label="Larghezza delle radici, m" /></td>
                                        <td data-etichetta="Riserva utile mm"><input @bind="m.Awc" inputmode="decimal" size="7" aria-label="Riserva utile, mm"
                                                   placeholder="@(v.AwcMm is { } awc ? "oggi " + awc.ToString("0", It) : "")" title="@(v.AwcMm is { } a2 ? $"Oggi il bilancio usa {a2.ToString("0", It)} mm" : "")" /></td>
                                        <td>
                                            <button type="button" class="pulsante" disabled="@(_login is null || _salvo)" @onclick="() => SalvaCalibrazioneAsync(v.Id, m)">Salva</button>
                                            @if (_esitiRiga.GetValueOrDefault(v.Id) is { } er)
                                            {
                                                <small class="@(er.Ok ? "bi-ok" : "bi-manca")" role="status">@er.Testo</small>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        @if (SceltiFra(vignetiSuolo).Count > 0)
                        {
                        <div class="bi-blocco bi-blocco-suolo" role="group" aria-label="Stessi valori ai vigneti scelti">
                            <strong>@Scelti(vignetiSuolo)</strong>
                            <label>Pietre % <input @bind="_bloccoSuolo.Scheletro" inputmode="decimal" size="4" /></label>
                            <label>Profondità radici m <input @bind="_bloccoSuolo.Profondita" inputmode="decimal" size="4" /></label>
                            <label>Larghezza radici m <input @bind="_bloccoSuolo.Larghezza" inputmode="decimal" size="4" /></label>
                            <label>Riserva utile mm <input @bind="_bloccoSuolo.Awc" inputmode="decimal" size="4" /></label>
                            <button type="button" class="pulsante-principale" disabled="@(_login is null || _salvo)"
                                    @onclick="() => SalvaCalibrazioniAsync(SceltiFra(vignetiSuolo), false)">@(_salvo ? "Salvo…" : $"Applica a {Quanti(SceltiFra(vignetiSuolo).Count)}")</button>
                            <button type="button" class="pulsante" disabled="@(_login is null || _salvo)"
                                    @onclick="() => SalvaCalibrazioniAsync(SceltiFra(vignetiSuolo), true)">Togli le correzioni</button>
                            <button type="button" class="pulsante" @onclick="() => _scelti.Clear()">Annulla la scelta</button>
                        </div>
                        }
                    </section>
                    break;

                case VignetiConfigurazione.Irrigazione:
                    <section class="bi-conf-sezione">
                        @SezioneIrrigazione(azienda, c, el)
                    </section>
                    break;

                case VignetiConfigurazione.Fatte:
                    <section class="bi-conf-sezione">
                        @SezioneFatte(c)
                    </section>
                    break;

                default:
                    <section class="bi-conf-sezione">
                        <h2 class="titolo-sezione">Per esperti</h2>
                        <p class="bi-esito bi-esito-errore"><strong>Attenzione:</strong> quello che si cambia qui vale per <strong>tutte le aziende</strong> e le ricalcola tutte.</p>
                        @if (TestiBilancio.Preset(_stato?.Calcolo) is { } regole)
                        {
                            <p class="nota">@regole Le regole (soglie per stile e fase, curve dei coefficienti colturali, turni) sono nel codice e le decide Perleuve con l'agronomo.</p>
                        }
                        <h3>Stile del vino dal target di concimazione</h3>
                        <p class="nota">Per i vigneti senza stile il bilancio usa il target di concimazione di 4Grapes con questa corrispondenza. <strong>Da compilare con Matteo</strong>: un target senza stile lascia il vigneto senza suggerimento.</p>
                        <table class="tabella-report bi-tabella bi-conf-tabella">
                            <thead><tr><th>Target di concimazione</th><th>Stile del vino</th></tr></thead>
                            <tbody>
                                @foreach (var t in _stiliTarget)
                                {
                                    <tr>
                                        <th scope="row">@t.Descrizione</th>
                                        <td><select @bind="t.Stile"><option value="0">— da decidere —</option>@foreach (var s in ConfigurazioneWeb.Stili) { <option value="@s.Key">@ConfigurazioneWeb.StileBreve(s.Key)</option> }</select></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <p class="nota">
                            <button type="button" class="pulsante" disabled="@(_login is null || _salvo)" @onclick="SalvaStiliTargetAsync">Salva la corrispondenza per tutte le aziende</button>
                            @if (c.Modello is { } mod)
                            {
                                <span> Ultima modifica: @Modifica(mod).</span>
                            }
                        </p>
                    </section>
                    break;
            }
        }
        else if (Azienda is not null)
        {
            <p class="aziende-stato" role="status">Carico la configurazione…</p>
        }
    }
</div>

@code {
    private const string TipoSettore = "settore", TipoQuota = "quota", TipoImpianto = "impianto", TipoShift = "shift",
        TipoSettoreShift = "settore-shift", TipoStile = "stile", TipoIrrigazione = "irrigazione", TipoCalibrazione = "calibrazione",
        TipoModello = "modello";
    private static readonly CultureInfo It = CultureInfo.GetCultureInfo("it-IT");

    [SupplyParameterFromQuery(Name = "azienda")] private int? Azienda { get; set; }
    [SupplyParameterFromQuery(Name = "sezione")] private string? Sezione { get; set; }
    [SupplyParameterFromQuery(Name = "solo")] private string? Solo { get; set; }
    [SupplyParameterFromQuery(Name = "vigneto")] private int? Vigneto { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? StatoAccesso { get; set; }

    private bool SoloMancanti => Solo == "mancanti";

    private sealed record Esito(string Testo, bool Ok);
    private sealed class ModuloSettore { public int Id; public string Nome = ""; public string? Ettari; public bool Attivo = true; }
    private sealed class ModuloQuota { public int Vigneto; public int Settore; public string? Percentuale = "100"; }
    private sealed class ModuloImpianto
    {
        public int Settore; public DateOnly Dal = new(DateTime.Today.Year, 1, 1); public int Tipologia = 1;
        public string? Gocciolatori, Ali, Portata, Tasso, Efficienza;
    }
    private sealed class ModuloSettoreShift { public int Shift; public int Settore; public DateOnly Dal = new(DateTime.Today.Year, 1, 1); }
    private sealed class ModuloCalibrazione
    {
        public string? Scheletro, Profondita, Larghezza, Awc;

        public static ModuloCalibrazione Da(CalibrazioneBilancioDto? c) => new()
        {
            Scheletro = Testo(c?.ScheletroPerc), Profondita = Testo(c?.ProfonditaRadiciM), Larghezza = Testo(c?.LarghezzaRadiciM), Awc = Testo(c?.AwcMm),
        };

        private static string? Testo(double? v) => v?.ToString("0.###", CultureInfo.GetCultureInfo("it-IT"));
    }
    private sealed class SceltaStileTarget { public int IdTarget; public string Descrizione = ""; public int Stile; }
    private sealed class ModuloIrrigazione { public DateOnly Data = DateOnly.FromDateTime(DateTime.Today); public string Dove = ""; public string? Ore, Mm; }

    private List<AziendaDto>? _aziende;
    private int? _confAzienda;
    private string? _sezioneMostrata;
    private ConfigurazioneWeb? _conf;
    private BilancioAziendaDto? _stato;
    private VignetiConfigurazione? _elenco;
    private List<VignetoDto> _vigneti = [];
    private string? _errore;
    private Esito? _esito;
    private readonly Dictionary<int, Esito> _esitiRiga = [];
    private bool _salvo;
    private string? _login;
    private DateOnly _oggi = DateOnly.FromDateTime(DateTime.Today);

    private readonly HashSet<int> _scelti = [];
    private int _bloccoStile;
    private DateOnly _bloccoDal = new(DateTime.Today.Year, 1, 1);
    private ModuloCalibrazione _bloccoSuolo = new();
    private ModuloSettore _settore = new();
    private ModuloQuota _quota = new();
    private ModuloImpianto _impianto = new();
    private string _shiftNome = "";
    private ModuloSettoreShift _settoreShift = new();
    private readonly Dictionary<int, ModuloCalibrazione> _calibrazioni = [];
    private List<SceltaStileTarget> _stiliTarget = [];
    private ModuloIrrigazione _irrigazione = new();

    private string Nome(int id) => _vigneti.FirstOrDefault(v => v.Id == id)?.Nome ?? $"Vigneto {id}";

    private static string Quanti(int n) => n == 1 ? "1 vigneto" : $"{n} vigneti";

    private static string Modifica<T>(VoceLetta<T> v) => ConfigurazioneWeb.ModificaBreve(v);

    private List<int> SceltiFra(IEnumerable<VignetoConfigurazione> mostrati) => mostrati.Where(v => _scelti.Contains(v.Id)).Select(v => v.Id).ToList();

    private string Scelti(IReadOnlyList<VignetoConfigurazione> mostrati) =>
        SceltiFra(mostrati).Count is var n && n == 0 ? "Nessun vigneto scelto" : $"{Quanti(n)} {(n == 1 ? "scelto" : "scelti")}";

    protected override async Task OnInitializedAsync()
    {
        if (StatoAccesso is not null && (await StatoAccesso).User is { Identity.IsAuthenticated: true } utente)
        {
            _login = utente.FindFirstValue(ClaimTypes.NameIdentifier);
            // Task #405: questa pagina (per tipo di dato del motore) è solo per gli interni Perleuve; gli altri usano la configurazione.
            _interno = UtentePortale.IdUtente(utente) is { } idUtente
                       && await EsperienzaAsync(idUtente) == TipiEsperienza.Interno;
        }
        else if (Ambiente.IsDevelopment() && Configurazione["BilancioIdrico:AutoreDiProva"] is { Length: > 0 } prova)
            (_login, _interno) = (prova, true);
    }

    private bool _interno;

    private async Task<string?> EsperienzaAsync(int idUtente)
    {
        try
        {
            return (await PortaleApi.GetEsperienzaAsync(idUtente)).Dati?.Esperienza;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning("Configurazione per esperti: esperienza dell'utente {Utente} non letta ({Messaggio})", idUtente, ex.Message);
            return null;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Cambiando sezione (o filtro) le spunte e l'esito di prima non valgono più.
        var chiaveVista = $"{Sezione}|{Solo}|{Vigneto}";
        if (chiaveVista != _sezioneMostrata)
        {
            _sezioneMostrata = chiaveVista;
            _scelti.Clear();
            _esito = null;
            _esitiRiga.Clear();
        }
        if (_aziende is null)
            await CaricaAsync();
        else if (Azienda != _confAzienda)
            await CaricaConfigurazioneAsync();
    }

    private async Task CaricaAsync()
    {
        _errore = null;
        try
        {
            _aziende = (await AziendeApiClient.GetAziendeAsync()).OrderBy(a => a.Nome).ToList();
            await CaricaConfigurazioneAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning("Configurazione bilancio: aziende non lette ({Messaggio})", ex.Message);
            _errore = "Non riesco a leggere le aziende, riprova.";
        }
    }

    private async Task CaricaConfigurazioneAsync()
    {
        _confAzienda = Azienda;
        _conf = null;
        _elenco = null;
        if (Azienda is not { } id)
            return;
        try
        {
            var vigneti = VignetiApiClient.GetVignetiPerAziendaAsync(id);
            var stato = StatoAsync(id);
            _conf = ConfigurazioneWeb.Da(await BilancioApi.GetVociAsync(id));
            _vigneti = (await vigneti).Vigneti.OrderBy(v => v.Nome).ToList();
            _stato = await stato;
            _elenco = VignetiConfigurazione.Da(_vigneti, _conf, _stato, _oggi);
            _calibrazioni.Clear();
            foreach (var v in _vigneti)
                _calibrazioni[v.Id] = ModuloCalibrazione.Da(_conf.CalibrazioneDi(v.Id)?.Dati);
            _stiliTarget = _conf.StiliDaTarget().Select(t => new SceltaStileTarget { IdTarget = t.IdTarget, Descrizione = t.Descrizione, Stile = t.IdStileVino ?? 0 }).ToList();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning("Configurazione bilancio dell'azienda {Azienda} non letta ({Messaggio})", id, ex.Message);
            _errore = "Non riesco a leggere la configurazione di questa azienda, riprova.";
        }
    }

    /// <summary>L'ultimo calcolo, per sapere cosa manca: se non si legge, la pagina funziona lo stesso con la sola configurazione.</summary>
    private async Task<BilancioAziendaDto?> StatoAsync(int id)
    {
        try
        {
            return await BilancioApi.GetStatoAziendaAsync(id);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning("Configurazione bilancio: stato dell'azienda {Azienda} non letto ({Messaggio})", id, ex.Message);
            return null;
        }
    }

    /// <summary>Rilegge la configurazione dopo un salvataggio, tenendo spunte ed esiti.</summary>
    private async Task RileggiAsync()
    {
        var scelti = _scelti.ToList();
        await CaricaConfigurazioneAsync();
        _scelti.UnionWith(scelti);
    }

    private async Task<bool> SalvaAsync(string tipo, object dati, bool elimina = false, string? fatto = null)
    {
        if (Azienda is not { } id)
            return false;
        if (_login is null)
        {
            _esito = new("Per modificare devi entrare con il tuo utente: ogni modifica porta il nome di chi la fa.", false);
            return false;
        }
        _salvo = true;
        try
        {
            var esito = await BilancioApi.SalvaVoceAsync(id, tipo,
                new SalvaVoceBilancioDto(_login, JsonSerializer.SerializeToElement(dati, dati.GetType(), ConfigurazioneWeb.Json), elimina));
            if (esito.Errore is not null)
            {
                _esito = new($"Non salvato: {esito.Errore}.", false);
                return false;
            }
            _esito = new($"{fatto ?? (elimina ? "Tolto" : "Salvato")}. Il bilancio dell'azienda si ricalcola da solo fra pochi secondi.", true);
            await RileggiAsync();
            return true;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning("Configurazione bilancio: {Tipo} non salvata ({Messaggio})", tipo, ex.Message);
            _esito = new("Non riesco a salvare, riprova.", false);
            return false;
        }
        finally
        {
            _salvo = false;
        }
    }

    private async Task<bool> SalvaBloccoAsync(string tipo, IReadOnlyList<object> dati, bool elimina, string fatto)
    {
        if (Azienda is not { } id || _login is null)
            return false;
        _salvo = true;
        try
        {
            var json = dati.Select(d => JsonSerializer.SerializeToElement(d, d.GetType(), ConfigurazioneWeb.Json)).ToList();
            var esito = await BilancioApi.SalvaBloccoAsync(id, tipo, new SalvaVociBilancioDto(_login, json, elimina));
            if (esito.Errore is not null)
            {
                _esito = new($"Non salvato, nessun vigneto cambiato: {esito.Errore}.", false);
                return false;
            }
            _esito = new($"{fatto}. Il bilancio dell'azienda si ricalcola da solo fra pochi secondi.", true);
            _scelti.Clear();
            await RileggiAsync();
            return true;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning("Configurazione bilancio: {Tipo} in blocco non salvato ({Messaggio})", tipo, ex.Message);
            _esito = new("Non riesco a salvare, riprova: nessun vigneto è cambiato.", false);
            return false;
        }
        finally
        {
            _salvo = false;
        }
    }

    private RenderFragment Casella(VignetoConfigurazione v) =>
        @<input type="checkbox" id="@($"v{v.Id}")" data-vigneto="@v.Id" checked="@_scelti.Contains(v.Id)" aria-label="@($"Scegli {v.Nome}")"
                @onchange="e => { if (e.Value is true) _scelti.Add(v.Id); else _scelti.Remove(v.Id); }" />;

    private RenderFragment CasellaTutti(IReadOnlyList<VignetoConfigurazione> mostrati) =>
        @<input type="checkbox" title="Scegli tutti quelli in elenco" aria-label="Scegli tutti quelli in elenco"
                checked="@(mostrati.Count > 0 && mostrati.All(v => _scelti.Contains(v.Id)))"
                @onchange="e => { if (e.Value is true) _scelti.UnionWith(mostrati.Where(v => v.NelCalcolo).Select(v => v.Id)); else _scelti.ExceptWith(mostrati.Select(v => v.Id)); }" />;

    private RenderFragment Filtro(int azienda, string sezione, VignetiConfigurazione el, string testo) =>

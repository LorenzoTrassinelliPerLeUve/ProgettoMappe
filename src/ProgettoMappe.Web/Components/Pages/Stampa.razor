    private string? Crediti => TestiStampa.Crediti(Configurazione.Sorgenti.FirstOrDefault(s => s.Id == _baseUsata)?.Attribution);

    private static DateOnly OggiItalia => DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, TematismiBigot.FusoItalia).DateTime);

    private static string Numero(double valore) => valore.ToString("0.#", CultureInfo.InvariantCulture);

    private string IdRiquadro(RiquadroStampa riquadro) => $"{_id}-r{_generazione}-{riquadro.Chiave}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/stampa.js");
            _dotNetRef = DotNetObjectReference.Create(this);
            _telefono = await _module.InvokeAsync<bool>("preparaFoglio", _id, FoglioId, new
            {
                sorgenti = Configurazione.Sorgenti.Select(s => new
                {
                    s.Id, s.Nome, Ruolo = s.Ruolo.ToString(), s.Tipo, s.StyleUrl, s.TileUrl, s.TileJsonUrl,
                    s.Attribution, s.MinZoom, s.MaxZoom, s.TileSize, s.Encoding, s.Bounds,
                }),
                basemapId = Configurazione.BasemapPredefinitaId,
                basemapFallbackId = Configurazione.BasemapFallbackId,
                imageryId = Configurazione.ImageryPredefinitaId,
            }, _dotNetRef);
            // Il modo del link; sul telefono sempre l'automatico.
            _modo = !_telefono && QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query).TryGetValue("modo", out var modo)
                && modo == "manuale" ? ModoStampa.Manuale : ModoStampa.Automatico;
            await CaricaAsync();
            return;
        }

        if (_module is null)
        {
            return;
        }

        if (_daDisegnare)
        {
            _daDisegnare = false;
            await _module.InvokeVoidAsync("impostaPagina", _foglio.PerPagina);
            await _module.InvokeVoidAsync("disegnaRiquadri", FoglioId, _generazione, new
            {
                satellite = _satellite,
                colori = _calcolato?.Colori,
                classi = Classi(),
                numeri = _numeri.ToDictionary(n => n.Key.ToString(CultureInfo.InvariantCulture), n => n.Value),
                riquadri = _riquadri.Select(r => new { id = IdRiquadro(r), ids = r.Vigneti, bbox = r.Ingombro.ComeArray() }),
                esatta = Manuale,
            });
        }

        if (Manuale && _insiemeDaAggiornare && _vigneti is not null && _errore is null)
        {
            _insiemeDaAggiornare = false;
            _insiemeAperto = true;
            await _module.InvokeVoidAsync("apriInsieme", FoglioId, InsiemeId, new
            {
                satellite = _satellite,
                colori = _calcolato?.Colori,
                classi = Classi(),
                riquadri = _riquadri.Select((r, i) => new
                {
                    chiave = r.Chiave,
                    lettera = r.Lettera,
                    bbox = r.Ingombro.ComeArray(),
                    testo = TestoConteggio(r.Vigneti.Count)
                        + (_pagineManuali > 1 && i < _manuali.Count ? $" · pag. {_manuali[i].Riquadro.Pagina}" : ""),
                }),
            });
        }
        else if (!Manuale && _insiemeAperto)
        {
            _insiemeAperto = false;
            await _module.InvokeVoidAsync("chiudiInsieme", FoglioId);
        }

        if (_daSalvare)
        {
            _daSalvare = false;
            var testo = FileLayout.Scrivi(LayoutAttuale, AziendaId, _chiaveTema, DateTimeOffset.UtcNow);
            if (!await _module.InvokeAsync<bool>("scriviLayout", ChiaveLocale, ChiaveRiserva, testo))
            {
                _avvisoLayout = "Questo browser non tiene il layout: usa «Salva layout» per non perderlo.";
                StateHasChanged();
            }
        }
    }

    /// <summary>Classe del tematismo per ogni vigneto (null senza tematismo), per i riquadri e la mappa d'insieme.</summary>
    private Dictionary<string, int>? Classi() =>
        _calcolato is { } c ? _inStampa.ToDictionary(v => v.Id.ToString(CultureInfo.InvariantCulture), v => c.Classificazione.ClasseDi(v.Id)) : null;

    private static string TestoConteggio(int vigneti) => vigneti == 1 ? "1 vigneto" : $"{vigneti} vigneti";

    /// <summary>Vigneti, nome dell'azienda e righe del tematismo del link; poi il primo disegno.</summary>
    private async Task CaricaAsync()
    {
        var ct = _cts.Token;
        var link = LinkMappa.Leggi(Navigation.Uri);
        VignetiAziendaDto risposta;
        try
        {
            risposta = await VignetiApiClient.GetVignetiPerAziendaAsync(AziendaId, ct);
        }
        catch (Exception ex) when (!ct.IsCancellationRequested)
        {
            Logger.LogWarning("Stampa: vigneti dell'azienda {AziendaId} non disponibili ({Tipo}: {Messaggio})",
                AziendaId, ex.GetType().Name, ex.Message);
            _errore = ex is HttpRequestException { StatusCode: HttpStatusCode.NotFound }
                ? "Questa azienda non è tra quelle disponibili."
                : "Non riesco a leggere i vigneti da 4Grapes: ricarica la pagina fra poco.";
            StateHasChanged();
            return;
        }

        try
        {
            _nomeAzienda = (await AziendeApiClient.GetAziendeAsync()).FirstOrDefault(a => a.Id == AziendaId)?.Nome.Trim();
        }
        catch (Exception ex) when (!ct.IsCancellationRequested)
        {
            // Senza nome il foglio resta utile: «Azienda 1673», e il titolo si può scrivere a mano.
            Logger.LogWarning("Stampa: elenco aziende non disponibile ({Tipo}: {Messaggio})", ex.GetType().Name, ex.Message);
        }

        // Gli stessi filtri della mappa: vigna e vitigno del link (quelli che non esistono si ignorano).
        var vigneti = FiltriVigneti.Applica(risposta.Vigneti, link.Vigna, link.Vitigno);
        var filtri = new List<string>();
        if (link.Vigna is { } vigna && FiltriVigneti.Vigne(risposta.Vigneti).FirstOrDefault(o => o.Id == vigna) is { } opzioneVigna)
        {
            filtri.Add($"Vigna {opzioneVigna.Nome}");
        }
        if (link.Vitigno is { } vitigno && FiltriVigneti.Vitigni(risposta.Vigneti, null).FirstOrDefault(o => o.Id == vitigno) is { } opzioneVitigno)
        {
            filtri.Add($"Vitigno {opzioneVitigno.Nome}");
        }
        if (filtri.Count == 0 && vigneti.Count != risposta.Vigneti.Count)
        {
            vigneti = risposta.Vigneti; // filtro del link che non esiste più: tutta l'azienda
        }
        _filtri = filtri.Count > 0 ? string.Join(" · ", filtri) : null;

        _perId = vigneti.DistinctBy(v => v.Id).ToDictionary(v => v.Id);
        _inStampa = RiquadriStampa.DaGeoJson(risposta.GeoJson).Where(v => _perId.ContainsKey(v.Id)).ToList();
        _vigneti = vigneti;
        if (_inStampa.Count == 0)
        {
            _errore = "Nessun vigneto con geometria da mettere sul foglio.";
            StateHasChanged();
            return;
        }

        _chiaveTema = Catalogo.Trova(link.Tema)?.Id ?? "-";
        if (Catalogo.Trova(link.Tema) is { } tema)
        {
            _stato = "Carico i dati del tematismo…";
            StateHasChanged();
            await CaricaTematismoAsync(tema, link, ct);
            if (ct.IsCancellationRequested)
            {
                return;
            }
        }

        if (_module is not null)
        {
            await _module.InvokeVoidAsync("impostaVigneti", FoglioId, risposta.GeoJson);
        }
        if (Manuale)
        {
            await LeggiLayoutNelBrowserAsync();
        }
        RaggruppaERidisegna();
    }

    /// <summary>
    /// Righe della fonte del tematismo, anno e confronto del link (o quelli predefiniti, come la mappa).
    /// Se il server non ha ancora i dati riprova per un po'; se non arrivano il foglio esce senza colori.
    /// </summary>
    private async Task CaricaTematismoAsync(Tematismo tema, LinkMappa link, CancellationToken ct)
    {
        try
        {
            for (var tentativo = 1; tentativo <= TentativiFonte; tentativo++)
            {
                var (righe, nomi, pronto) = await LeggiFonteAsync(tema, ct);
                if (pronto)
                {
                    _tema = tema;
                    _righe = righe;
                    _nomiClassi = nomi;
                    var anni = ConfrontoBigot.AnniConDati(tema, righe);
                    if (!tema.SenzaAnno)
                    {
                        _anno = link.Anno is { } a && anni.Contains(a) ? a : TematismiBigot.AnnoPredefinito(tema, anni, _annoCorrente);
                        _annoDa = tema.Confrontabile && link.Da is { } da && da != _anno && anni.Contains(da) ? da : null;
                    }
                    _stato = null;
                    return;
                }

                _stato = "Dati del tematismo in preparazione sul server…";
                StateHasChanged();
                await Task.Delay(AttesaFonte, ct);
            }
            _stato = "Dati del tematismo non disponibili al momento: il foglio è senza colori.";
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // Pagina chiusa.
        }
        catch (Exception ex)
        {
            Logger.LogWarning("Stampa: dati di {Tematismo} non disponibili ({Tipo}: {Messaggio})", tema.Nome, ex.GetType().Name, ex.Message);
            _stato = "Dati del tematismo non raggiungibili: il foglio è senza colori.";
        }
    }

    /// <summary>Le righe di una fonte come le legge la mappa, con i nomi delle classi che arrivano coi dati.</summary>
    private async Task<(IReadOnlyList<IRigaVigneto> Righe, IReadOnlyDictionary<int, string>? Nomi, bool Pronto)> LeggiFonteAsync(
        Tematismo tema, CancellationToken ct)
    {
        switch (tema.Fonte)
        {
            case FonteTematismo.Bigot:
                var bigot = await VignetiApiClient.GetIndiciBigotAsync(AziendaId, ct);
                return (bigot.Indici, null, bigot.Pronto);
            case FonteTematismo.Fenologia:
                var fenologia = await VignetiApiClient.GetFenologiaAsync(AziendaId, ct);
                return (fenologia.Fasi, TematismiFenologia.NomiFasi(fenologia.Fasi), fenologia.Pronto);
            case FonteTematismo.Rilievi:
                var rilievi = await VignetiApiClient.GetUltimiRilieviAsync(AziendaId, ct);
                return (rilievi.Rilievi, null, rilievi.Pronto);
            case FonteTematismo.Difesa:
                var difesa = await VignetiApiClient.GetDifesaAsync(AziendaId, ct);
                return (difesa.Vigneti, tema.NomiDaiDati ? TematismiDifesa.NomiLinee(difesa.Vigneti) : null, difesa.Pronto);
            case FonteTematismo.Ndvi:
                // Il passaggio predefinito della mappa (l'ultimo pulito): il selettore delle date non è nel link.
                var ndvi = await VignetiApiClient.GetNdviAsync(AziendaId, _annoCorrente, ct);
                var passaggi = await VignetiApiClient.GetPassaggiNdviAsync(AziendaId, ct);
                return (TematismiNdvi.Righe(ndvi, TematismiNdvi.PassaggioPredefinito(passaggi.Passaggi, ndvi, OggiItalia)), null, ndvi.Pronto);
            default:
                var statistiche = await VignetiApiClient.GetStatisticheAsync(AziendaId, ct);
                IReadOnlyList<IRigaVigneto> righe = tema.Fonte switch
                {
                    FonteTematismo.Rischi => statistiche.Rischi,
                    FonteTematismo.Vigoria => statistiche.Vigoria,
                    _ => statistiche.PotenzialeIdrico,
                };
                return (righe, null, statistiche.Pronto);
        }
    }

    /// <summary>Gruppi da capo (distanza cambiata): unioni e riquadri nascosti valevano per i gruppi di prima.</summary>
    private void RaggruppaERidisegna()
    {
        _gruppi = RiquadriStampa.Raggruppa(_inStampa, _distanzaKm * 1000);
        _unioni.Clear();
        _nascosti.Clear();
        Ridisegna();
    }

    /// <summary>Riquadri, numeri, tematismo sui vigneti del foglio, legenda, indice e griglia; poi un disegno nuovo.</summary>
    private void Ridisegna()
    {
        IReadOnlyList<int> pagineAutomatiche = [];
        if (Manuale)
        {
            // Lettere nell'ordine del foglio, pagina dopo pagina; vigneti = quelli col centro nella zona disegnata.
            _manuali = PagineManuali.InOrdine(_manuali);
            _pagineManuali = PagineManuali.Conta(_pagineManuali, _manuali.Select(m => m.Riquadro));
            _riquadri = _manuali.Select((m, i) => new RiquadroStampa(
                m.Chiave, RiquadriStampa.Lettera(i), GrigliaManuale.Contenuti(m.Riquadro.Zona, _inStampa), m.Riquadro.Zona)).ToList();
        }
        else
        {
            _tutti = RiquadriStampa.Riquadri(_gruppi, _unioni);
            _nascosti.RemoveWhere(k => _tutti.All(r => r.Chiave != k));
            _riquadri = _tutti.Where(r => !_nascosti.Contains(r.Chiave)).ToList();
            pagineAutomatiche = RiquadriStampa.Pagine(_riquadri);
        }
        _numeri = RiquadriStampa.Numera(_riquadri, _inStampa);
        var sulFoglio = _numeri.Keys.ToList();

        _calcolato = null;
        _vociLegenda = [];
        if (_tema is { } tema && _righe is { } righe && (tema.SenzaAnno || _anno is not null))
        {
            var regola = _annoDa is not null ? Catalogo.Regola(tema) : null;
            _calcolato = CalcoloTematismo.Calcola(tema, regola, righe, _anno, _annoDa, sulFoglio);
            _vociLegenda = LegendaTematismo.Voci(tema, regola, _anno, _calcolato.Conteggi, null, _nomiClassi);
        }

        var indice = Indice == PosizioneIndice.Nessuno ? [] : _numeri.OrderBy(n => n.Value).Select(n =>
        {
            var vigneto = _perId[n.Key];
            var valore = _calcolato?.Valori.GetValueOrDefault(n.Key);
            var testo = valore?.Testo ?? "–";
            return new RigaIndice(n.Value, vigneto.Nome.Trim(), string.IsNullOrWhiteSpace(vigneto.Vigna) ? null : vigneto.Vigna.Trim(),
                vigneto.SoloPunto ? "solo punto" : FormatoSuperficie.Breve(vigneto.SuperficieEttari), vigneto.SoloPunto,
                TestiStampa.Accorcia(testo, TestiStampa.CaratteriValore), testo, valore?.Colore);
        }).ToList();
        var pagine = new List<IReadOnlyList<RigaIndice>>();
        foreach (var quante in _foglio.PagineIndice(indice.Count, Indice))
        {
            pagine.Add(indice.Skip(pagine.Sum(p => p.Count)).Take(quante).ToList());
        }
        _pagine = pagine;

        if (Manuale)
        {
            var pagineManuali = PagineManuali.Disponi(_manuali.Select(m => m.Riquadro).ToList(), _pagineManuali, _foglio.LarghezzaUtile,
                p => AltezzaPagina(p, _pagineManuali), FoglioStampa.SpazioRiquadri);
            var celle = new CellaStampa[_riquadri.Count];
            foreach (var pagina in pagineManuali)
            {
                for (var k = 0; k < pagina.Riquadri.Count; k++)
                {
                    celle[pagina.Riquadri[k]] = pagina.Disposizione.Celle[k];
                }
            }
            _celle = celle;
            _fogliRiquadri = pagineManuali.Select(p => new FoglioRiquadri(p.Numero, p.Riquadri, AltezzaPagina(p.Numero, _pagineManuali), p.Disposizione)).ToList();
            _insiemeDaAggiornare = true;
            _daSalvare = true;
        }
        else
        {
            var numeroPagine = pagineAutomatiche.DefaultIfEmpty(1).Max();
            _celle = RiquadriStampa.DisponiPagine(_riquadri, pagineAutomatiche, _foglio.LarghezzaUtile,
                p => AltezzaPagina(p, numeroPagine), FoglioStampa.SpazioRiquadri);
            _fogliRiquadri = Enumerable.Range(1, numeroPagine).Select(p => new FoglioRiquadri(
                p, Enumerable.Range(0, _riquadri.Count).Where(i => pagineAutomatiche[i] == p).ToList(), AltezzaPagina(p, numeroPagine), null)).ToList();
        }
        _generazione++;
        _pronti = 0;
        _falliti = 0;
        _avvisoPng = null;
        _daDisegnare = true;
        StateHasChanged();
    }

    private void CambiaFoglio(FoglioStampa foglio)
    {
        if (foglio != _foglio)
        {
            _foglio = foglio;
            Ridisegna();
        }
    }

    private void CambiaSfondo(bool satellite)
    {
        if (satellite != _satellite)
        {
            _satellite = satellite;
            Ridisegna();
        }
    }

    private void CambiaDistanza(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var km))
        {
            _distanzaKm = Math.Clamp(km, RiquadriStampa.DistanzaMinimaKm, RiquadriStampa.DistanzaMassimaKm);
            RaggruppaERidisegna();
        }
    }

    private void Unisci(int chiave, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var altro) && altro != chiave)
        {
            _unioni.Add((chiave, altro));
            // Un riquadro unito a uno nascosto si vede: chi unisce vuole vederli insieme.
            _nascosti.Remove(chiave);
            _nascosti.Remove(altro);
            Ridisegna();
        }
    }

    private void SeparaRiquadri()
    {
        _unioni.Clear();
        Ridisegna();
    }

    private void CommutaNascosto(int chiave)
    {
        if (!_nascosti.Remove(chiave))
        {
            _nascosti.Add(chiave);
        }
        Ridisegna();
    }

    private PosizioneIndice Indice => _sceltaIndice ?? FoglioStampa.PosizionePredefinita(_numeri.Count);

    private void CambiaIndice(PosizioneIndice posizione)
    {
        if (posizione != Indice)
        {
            _sceltaIndice = posizione;
            Ridisegna();
        }
    }

    // ---------- Modo manuale (task #92) ----------

    /// <summary>I comandi del modo manuale nella barra: riquadri disegnati e layout salvato.</summary>
    private RenderFragment RiquadriManuali => @<text>
        <div class="stampa-gruppo">
            <span class="titolo">Riquadri disegnati (@_manuali.Count)</span>
            <div class="stampa-azioni">
                <button type="button" disabled="@(_inDisegno || _manuali.Count >= GrigliaManuale.MassimoRiquadri)" @onclick="NuovoRiquadro">+ Riquadro</button>
                <button type="button" class="leggero" disabled="@(_inDisegno || _manuali.Count >= GrigliaManuale.MassimoRiquadri)"
                        title="Un riquadro con la zona che vedi ora sulla mappa d'insieme" @onclick="RiquadroDaInquadratura">Dall'inquadratura</button>
                <button type="button" class="leggero" disabled="@_inDisegno" @onclick="PartiDallAutomatico">Parti dall'automatico</button>
                <button type="button" class="leggero" disabled="@(_pagineManuali >= PagineManuali.MassimoPagine)"
                        title="Un foglio in più, con lo stesso formato e orientamento" @onclick="AggiungiPagina">+ Pagina</button>
            </div>
            @if (_confermaAutomatico)
            {
                <p class="nota avviso-leggero">I @_manuali.Count riquadri disegnati lasciano il posto a quelli dell'automatico: premi di nuovo per confermare.</p>
            }
            @if (_manuali.Count == 0)
            {
                <p class="nota">Premi «+ Riquadro» e trascina un rettangolo sulla mappa d'insieme, oppure parti dai riquadri dell'automatico e aggiustali.</p>
            }
            <ul class="stampa-elenco-riquadri manuale">
                @for (var p = 1; p <= _pagineManuali; p++)
                {
                    var paginaElenco = p;
                    @if (_pagineManuali > 1)
                    {
                        var vuota = _manuali.All(m => m.Riquadro.Pagina != paginaElenco);
                        <li class="pagina" @key="@($"pagina-{paginaElenco}")">
                            <span>Pagina @paginaElenco@(vuota ? " · vuota" : "")</span>
                            @if (vuota)
                            {
                                <button type="button" class="leggero" title="Togli questa pagina vuota" aria-label="Togli la pagina @paginaElenco"
                                        @onclick="() => TogliPagina(paginaElenco)">×</button>
                            }
                        </li>
                    }
                @for (var i = 0; i < _manuali.Count && i < _riquadri.Count; i++)
                {
                    if (_manuali[i].Riquadro.Pagina != paginaElenco)
                    {
                        continue;
                    }
                    var indice = i;
                    var (chiave, manuale) = _manuali[i];
                    var riquadro = _riquadri[i];
                    <li @key="chiave">
                        <button type="button" class="lettera" title="Mostra il riquadro @riquadro.Lettera sulla mappa d'insieme"
                                @onclick="() => MostraZona(manuale.Zona)">@riquadro.Lettera</button>
                        <span class="conteggio">@TestoConteggio(riquadro.Vigneti.Count)</span>
                        <select aria-label="Larghezza del riquadro @riquadro.Lettera" title="Larghezza nel foglio" value="@manuale.Colonne"
                                @onchange="e => CambiaTaglia(chiave, e, righe: false)">
                            @foreach (var taglia in GrigliaManuale.Taglie)
                            {
                                <option value="@taglia">@GrigliaManuale.NomeTaglia(taglia)</option>
                            }
                        </select>
                        <select aria-label="Altezza del riquadro @riquadro.Lettera in righe" title="Altezza nel foglio, in righe (12 in tutto)" value="@manuale.Righe"
                                @onchange="e => CambiaTaglia(chiave, e, righe: true)">
                            @for (var r = 1; r <= GrigliaManuale.Righe; r++)
                            {
                                <option value="@r">@(r == 1 ? "1 riga" : $"{r} righe")</option>
                            }
                        </select>
                        <select aria-label="Pagina del riquadro @riquadro.Lettera" title="Pagina in cui sta il riquadro" value="@manuale.Pagina"
                                @onchange="e => CambiaPagina(chiave, e)">
                            @for (var pag = 1; pag <= _pagineManuali; pag++)
                            {
                                <option value="@pag">@($"pag. {pag}")</option>
                            }
                        </select>
                        <button type="button" class="leggero" title="Prima nel foglio" aria-label="Sposta su il riquadro @riquadro.Lettera"
                                disabled="@(indice == 0)" @onclick="() => SpostaRiquadro(indice, su: true)">↑</button>
                        <button type="button" class="leggero" title="Dopo nel foglio" aria-label="Sposta giù il riquadro @riquadro.Lettera"
                                disabled="@(indice == _manuali.Count - 1)" @onclick="() => SpostaRiquadro(indice, su: false)">↓</button>
                        <button type="button" class="leggero" title="Elimina" aria-label="Elimina il riquadro @riquadro.Lettera"
                                @onclick="() => OnEliminaRiquadro(chiave)">×</button>
                    </li>
                }
                }
            </ul>
            @if (_manuali.Count > 0)
            {
                var compresse = _fogliRiquadri.Where(f => f.Disposizione is { Compressa: true }).ToList();
                <span class="nota @(compresse.Count > 0 ? "avviso-leggero" : "")">
                    @(compresse.Count switch
                    {
                        0 => _fogliRiquadri.Count == 1 && _fogliRiquadri[0].Disposizione is { } d
                            ? $"Righe usate: {d.RigheUsate} su {GrigliaManuale.Righe}. "
                            : $"{_fogliRiquadri.Count} pagine di riquadri, {GrigliaManuale.Righe} righe ciascuna. ",
                        1 => $"A pagina {compresse[0].Numero} i riquadri occupano {compresse[0].Disposizione!.RigheUsate} righe su {GrigliaManuale.Righe}: le righe si accorciano per stare nel foglio. ",
                        _ => $"Alle pagine {string.Join(", ", compresse.Select(c => c.Numero))} i riquadri occupano più di {GrigliaManuale.Righe} righe: le righe si accorciano. ",
                    })
                    @("Nel foglio trascina un riquadro su un altro per cambiare l'ordine, o in una parte vuota di un'altra pagina.")
                </span>
            }
        </div>

        <div class="stampa-gruppo" role="group" aria-label="Layout">
            <span class="titolo">Layout</span>
            <div class="stampa-azioni">
                <button type="button" class="leggero" disabled="@(_manuali.Count == 0)" @onclick="ScaricaLayout">Salva layout</button>
                <label class="pulsante-file">
                    Carica layout
                    <InputFile class="visualmente-nascosto" accept=".json,application/json" OnChange="CaricaLayout" />
                </label>
            </div>
            <span class="nota">Si tiene da solo in questo browser, per azienda e tematismo. Il file serve a conservarlo o a usarlo su un altro computer.</span>
            @if (_avvisoLayout is not null)
            {
                <p class="nota avviso-leggero" role="status">@_avvisoLayout</p>
            }
        </div>
    </text>;

    /// <summary>Il layout manuale com'è adesso, da salvare.</summary>
    private LayoutManuale LayoutAttuale =>
        new(_manuali.Select(m => m.Riquadro).ToList(), _foglio, _sceltaIndice, _titolo.Trim(), _satellite, _pagineManuali);

    private async Task CambiaModo(ModoStampa modo)
    {
        if (modo == _modo || _telefono)
        {
            return;
        }

        _modo = modo;
        _inDisegno = false;
        _confermaAutomatico = false;
        // Il link del foglio dice il modo (modo=manuale); l'automatico è quello senza.
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("modo", Manuale ? "manuale" : null), replace: true);
        if (Manuale && !_layoutLetto)
        {
            await LeggiLayoutNelBrowserAsync();
        }
        Ridisegna();
    }

    /// <summary>Il layout di questa azienda e tematismo salvato nel browser (o l'ultimo dell'azienda), se c'è.</summary>
    private async Task LeggiLayoutNelBrowserAsync()
    {
        _layoutLetto = true;
        if (_module is null)
        {
            return;
        }
        var salvato = await _module.InvokeAsync<LayoutNelBrowser?>("leggiLayout", ChiaveLocale, ChiaveRiserva);
        if (salvato is not null && FileLayout.Leggi(salvato.Testo, out _) is { } letto && (letto.Azienda is null || letto.Azienda == AziendaId))
        {
            ApplicaLayout(letto.Layout);
            _avvisoLayout = salvato.Riserva && letto.Tematismo != _chiaveTema
                ? "Ripreso il layout di questa azienda fatto con un altro tematismo." : null;
        }
    }

    private void ApplicaLayout(LayoutManuale layout)
    {
        _manuali = PagineManuali.InOrdine(layout.Riquadri.Select(r => new RiquadroDisegnato(++_prossimaChiave, r)));
        _pagineManuali = PagineManuali.Conta(layout.Pagine, layout.Riquadri);
        _foglio = layout.Foglio;
        _sceltaIndice = layout.Indice;
        _titolo = layout.Titolo;
        _satellite = layout.Satellite && Configurazione.ImageryPredefinitaId is not null;
        _confermaAutomatico = false;
    }

    private async Task NuovoRiquadro()
    {
        _confermaAutomatico = false;
        _inDisegno = _module is not null && await _module.InvokeAsync<bool>("disegnaZona", FoglioId);
    }

    private async Task RiquadroDaInquadratura()
    {
        _confermaAutomatico = false;
        if (_module is not null && Zona(await _module.InvokeAsync<double[]?>("zonaInquadratura", FoglioId)) is { } zona)
        {
            AggiungiRiquadro(zona);
        }
    }

    /// <summary>
    /// Un riquadro nuovo nell'ultima pagina, largo metà foglio, alto quanto basta a mostrare la zona con
    /// poco margine.
    /// </summary>
    private void AggiungiRiquadro(Ingombro zona)
    {
        if (_manuali.Count >= GrigliaManuale.MassimoRiquadri)
        {
            return;
        }
        var righe = GrigliaManuale.RigheAdatte(zona, 6, _foglio.LarghezzaUtile, AltezzaPagina(_pagineManuali, _pagineManuali), FoglioStampa.SpazioRiquadri);
        _manuali.Add(new RiquadroDisegnato(++_prossimaChiave, new RiquadroManuale(zona, 6, righe, _pagineManuali)));
        Ridisegna();
    }

    private void AggiungiPagina()
    {
        if (_pagineManuali < PagineManuali.MassimoPagine)
        {
            _pagineManuali++;
            _confermaAutomatico = false;
            Ridisegna();
        }
    }

    private void TogliPagina(int pagina)
    {
        (_manuali, _pagineManuali) = PagineManuali.TogliPagina(_manuali, _pagineManuali, pagina);
        Ridisegna();
    }

    private void CambiaPagina(int chiave, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var pagina))
        {
            OnRiquadroSuPagina(chiave, pagina);
        }
    }

    /// <summary>Una zona arrivata da stampa.js: [W, S, E, N] in gradi, larga e alta più di zero.</summary>
    private static Ingombro? Zona(double[]? b) =>
        b is [var o, var s, var e, var n] && new[] { o, s, e, n }.All(double.IsFinite) && o < e && s < n
            ? new Ingombro(Math.Max(o, -180), Math.Max(s, -85), Math.Min(e, 180), Math.Min(n, 85))
            : null;

    private void PartiDallAutomatico()
    {
        if (_manuali.Count > 0 && !_confermaAutomatico)
        {
            _confermaAutomatico = true;
            return;
        }
        _confermaAutomatico = false;

        // I riquadri che l'automatico mostra adesso (distanza, unioni e nascosti scelti là), con le sue pagine e la sua disposizione.
        var automatici = RiquadriStampa.Riquadri(_gruppi, _unioni).Where(r => !_nascosti.Contains(r.Chiave)).ToList();
        var pagine = RiquadriStampa.Pagine(automatici);
        var numeroPagine = pagine.DefaultIfEmpty(1).Max();
        var celle = RiquadriStampa.DisponiPagine(automatici, pagine, _foglio.LarghezzaUtile, p => AltezzaPagina(p, numeroPagine), FoglioStampa.SpazioRiquadri);
        _manuali = GrigliaManuale.DaAutomatico(automatici, celle, pagine, _foglio.LarghezzaUtile, p => AltezzaPagina(p, numeroPagine), FoglioStampa.SpazioRiquadri)
            .Select(r => new RiquadroDisegnato(++_prossimaChiave, r)).ToList();
        _pagineManuali = numeroPagine;
        Ridisegna();
    }

    private async Task MostraZona(Ingombro zona)
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("mostraZona", FoglioId, zona.ComeArray());
        }
    }

    private void CambiaTaglia(int chiave, ChangeEventArgs e, bool righe)
    {
        var i = _manuali.FindIndex(m => m.Chiave == chiave);
        if (i >= 0 && int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var valore))
        {
            var r = _manuali[i].Riquadro;
            _manuali[i] = new RiquadroDisegnato(chiave, righe
                ? r with { Righe = Math.Clamp(valore, 1, GrigliaManuale.Righe) }
                : r with { Colonne = GrigliaManuale.Taglia(valore) });
            Ridisegna();
        }
    }

    private void SpostaRiquadro(int indice, bool su)
    {
        _manuali = PagineManuali.SuOGiu(_manuali, indice, su);
        Ridisegna();
    }

    private void TitoloCambiato() => _daSalvare = Manuale;

    private async Task ScaricaLayout()
    {
        if (_module is not null)
        {
            var testo = FileLayout.Scrivi(LayoutAttuale, AziendaId, _chiaveTema, DateTimeOffset.UtcNow);
            await _module.InvokeVoidAsync("scaricaLayout", FileLayout.NomeFile(NomeAzienda ?? $"azienda {AziendaId}"), testo);
        }
    }

    private async Task CaricaLayout(InputFileChangeEventArgs e)
    {
        string testo;
        try
        {
            using var lettore = new StreamReader(e.File.OpenReadStream(FileLayout.DimensioneMassima));
            testo = await lettore.ReadToEndAsync();
        }
        catch (IOException)
        {
            _avvisoLayout = "Il file è troppo grande per essere un layout.";
            return;
        }

        if (FileLayout.Leggi(testo, out var errore) is not { } letto)
        {
            _avvisoLayout = errore;
            return;
        }

        ApplicaLayout(letto.Layout);
        var note = new List<string> { $"Layout caricato: {letto.Layout.Riquadri.Count} riquadri." };
        if (letto.Azienda is { } azienda && azienda != AziendaId)
        {
            note.Add("È stato fatto per un'altra azienda: controlla le zone.");
        }
        if (letto.RiquadriScartati > 0)
        {
            note.Add($"{letto.RiquadriScartati} riquadri non validi sono stati saltati.");
        }
        _avvisoLayout = string.Join(" ", note);
        Ridisegna();
    }

    /// <summary>Da stampa.js: il rettangolo disegnato dopo «+ Riquadro» (null = annullato con Esc).</summary>
    [JSInvokable]
    public void OnZonaDisegnata(double[]? bbox)
    {
        _inDisegno = false;
        if (Zona(bbox) is { } zona)
        {
            AggiungiRiquadro(zona);
        }
        else
        {
            StateHasChanged();
        }
    }

    /// <summary>Da stampa.js: un riquadro spostato o ridimensionato sulla mappa d'insieme.</summary>
    [JSInvokable]
    public void OnZonaCambiata(int chiave, double[] bbox)
    {
        var i = _manuali.FindIndex(m => m.Chiave == chiave);
        if (i >= 0 && Zona(bbox) is { } zona)
        {
            _manuali[i] = new RiquadroDisegnato(chiave, _manuali[i].Riquadro with { Zona = zona });
            Ridisegna();
        }
    }

    [JSInvokable]
    public void OnEliminaRiquadro(int chiave)
    {
        if (_manuali.RemoveAll(m => m.Chiave == chiave) > 0)
        {
            _confermaAutomatico = false;
            Ridisegna();
        }
    }

    /// <summary>Da stampa.js: nel foglio il riquadro <paramref name="da"/> lasciato sopra <paramref name="su"/> prende il suo posto e la sua pagina.</summary>
    [JSInvokable]
    public void OnRiquadroTrascinato(int da, int su)
    {
        var (i, j) = (_manuali.FindIndex(m => m.Chiave == da), _manuali.FindIndex(m => m.Chiave == su));
        if (i >= 0 && j >= 0)
        {
            _manuali = PagineManuali.Sposta(_manuali, i, j);
            Ridisegna();
        }
    }

    /// <summary>Da stampa.js (o dal campo «Pagina»): il riquadro lasciato in una parte vuota di una pagina va in fondo a quella pagina.</summary>
    [JSInvokable]
    public void OnRiquadroSuPagina(int chiave, int pagina)
    {
        if (pagina >= 1 && pagina <= _pagineManuali && _manuali.Any(m => m.Chiave == chiave && m.Riquadro.Pagina != pagina))
        {
            _manuali = PagineManuali.InPagina(_manuali, chiave, pagina);
            Ridisegna();
        }
    }

    /// <summary>Da stampa.js, a ogni riquadro fotografato (o fallito).</summary>
    [JSInvokable]
    public void OnRiquadroPronto(int generazione, int fatti, int falliti, string? baseUsata)
    {
        if (generazione != _generazione)
        {
            return;
        }
        _pronti = fatti;
        _falliti = falliti;
        _baseUsata = baseUsata;
        StateHasChanged();
    }

    /// <summary>Da stampa.js se «Salva PNG» non riesce (il buon esito è il file scaricato).</summary>
    [JSInvokable]
    public void OnPngNonSalvato()
    {
        _avvisoPng = "Non riesco a creare il PNG: riprova, o usa «Stampa / salva PDF».";
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("distruggiFoglio", FoglioId);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuito chiuso: il browser ha già tolto la pagina.
            }
        }
        _dotNetRef?.Dispose();
        _cts.Dispose();
    }
}

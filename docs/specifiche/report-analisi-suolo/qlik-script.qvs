///$tab Main
SET ThousandSep='.';
SET DecimalSep=',';
SET MoneyThousandSep='.';
SET MoneyDecimalSep=',';
SET MoneyFormat='$ ###0.00;-$ ###0.00';
SET TimeFormat='hh:mm:ss TT';
SET DateFormat='DD/MM/YYYY';
SET TimestampFormat='DD/MM/YYYY hh:mm:ss[.fff] TT';
SET FirstWeekDay=6;
SET BrokenWeeks=1;
SET ReferenceDay=0;
SET FirstMonthOfYear=1;
SET CollationLocale='en-US';
SET CreateSearchIndexOnReload=1;
SET MonthNames='Gen;Feb;Mar;Apr;Mag;Giu;Lug;Ago;Set;Ott;Nov;Dic';
SET LongMonthNames='Gennaio;Febbraio;Marzo;Aprile;Maggio;Giugno;Luglio;Agosto;Settembre;Ottobre;Novembre;Dicembre';
SET DayNames='Lun;Mar;Mer;Gio;Ven;Sab;Dom';
SET LongDayNames='Lunedì;Martedì;Mercoledì;Giovedì;Venerdì;Sabato;Domenica';
SET NumericalAbbreviation='3:k;6:M;9:G;12:T;15:P;18:E;21:Z;24:Y;-3:m;-6:μ;-9:n;-12:p;-15:f;-18:a;-21:z;-24:y';
///$tab SERVER
LIB CONNECT TO 'Microsoft_SQL_Server_209.227.229.20';

///$tab 4GRAPES
[Ente]:
LOAD IdEnte, 
	RagioneSociale;

SELECT IdEnte,
	RagioneSociale
	FROM "4g".dbo.Ente;

[Vigna]:
LOAD
	[IdVigna],
    [Ente_IdEnte] as [IdEnte],
	[Vigna];
	
SELECT IdVigna,
	Ente_IdEnte,
	Vigna	
FROM "4g".dbo.Vigna;

[Vigneto]:
LOAD IdVigneto, 
	NomeVigneto, 
	Vigna_IdVigna AS [IdVigna], 
	Vitigno_idVitigno as [idVitigno];

SELECT IdVigneto,
	NomeVigneto,
	Vigna_IdVigna,
	Vitigno_idVitigno
FROM "4g".dbo.Vigneto;

[Vitigno]:
LOAD
	[idVitigno],
	[Vitigno];
    
SELECT idVitigno,
	Vitigno
	FROM "4g".dbo.Vitigno;
	
[SubVigneto]:
LOAD IdSubVigneto, 
	Nome as [Nome.SubVigneto];

SELECT IdSubVigneto,
	Nome,
	IdVigneto
FROM "4g".dbo.SubVigneto;


[VignetoMaps]:
LOAD
  	IdVigneto,
	AdministrativeAreaLevel3 as [Comune],
	AdministrativeAreaLevel2 as [Provincia],
	AdministrativeAreaLevel1 as [Regione],
	Country as [Stato];
  
   
  SELECT
  	IdVigneto,
	AdministrativeAreaLevel3,
	AdministrativeAreaLevel2,
	AdministrativeAreaLevel1,
	Country
	FROM "4g".dbo.VignetoMaps;

///$tab TESSITURA
[Tessitura]:

LOAD IdTessitura, 
	Sabbia, 
	Limo, 
	Argilla, 
	Descrizione, 
	PuntoDiAppassimentoPermanente, 
	EquivalenteDiUmidita, 
	CapacitaDiCampo, 
	Saturazione, 
	ConducibilitaIdraulicaSaturazione, 
	AcquaDisponibile_g_100g, 
	AcquaDisponibile_mm_m, 
	PesoSpecificoApparente, 
	IdTessituraSuolo, 
	MinSO, 
	MaxSO, 
	MinN, 
	MaxN,
    MinP,
    MaxP;


SELECT IdTessitura,
	Sabbia,
	Limo,
	Argilla,
	Descrizione,
	PuntoDiAppassimentoPermanente,
	EquivalenteDiUmidita,
	CapacitaDiCampo,
	Saturazione,
	ConducibilitaIdraulicaSaturazione,
	"AcquaDisponibile_g_100g",
	"AcquaDisponibile_mm_m",
	PesoSpecificoApparente,
	IdTessituraSuolo,
	MinSO,
	MaxSO,
	MinN,
	MaxN,
     MinP,
    MaxP
FROM "4g".dbo.Tessitura;


///$tab ANALISI TERRENO
ANALISI_TERRENI:

LOAD
    ANNO as [Anno_Analisi],
    IdVigneto,
    IdSubVingeto,
    VIGNETO,
    "PROFONDITA' cm",
    "CODICE PUNTO",

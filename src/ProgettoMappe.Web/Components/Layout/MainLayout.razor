@inherits LayoutComponentBase

<div class="page">
    <header class="top-row">
        <a class="brand" href="">
            <span class="brand-marchio" aria-hidden="true">
                <span>Per</span><span>Le</span><span>Uve</span>
            </span>
            <span class="brand-testo">
                <span class="brand-titolo">Viticoltura di precisione</span>
                <span class="brand-sottotitolo">Mappe vigneti · 4Grapes</span>
            </span>
        </a>
        <nav>
            <NavLink href="" Match="NavLinkMatch.All">Aziende</NavLink>
            <AuthorizeView>
                <Authorized>
                    <form class="esci" method="post" action="accesso/esci" data-enhance="false">
                        <AntiforgeryToken />
                        <span class="utente">@context.User.Identity?.Name</span>
                        <button type="submit">Esci</button>
                    </form>
                </Authorized>
            </AuthorizeView>
        </nav>
    </header>

    <main>
        @Body
    </main>
</div>

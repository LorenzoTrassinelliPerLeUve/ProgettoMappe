@page "/esperienza"
@page "/esperienza/{Voce}"
@using System.Globalization
@using ProgettoMappe.Web.Esperienze
@using ProgettoMappe.Web.Portale
@using ProgettoMappe.Web.Components.Esperienze
@using ProgettoMappe.Web.Components.Portale.Nuovo
@inject PortaleApiClient Api
@inject NavigationManager Nav

@*
    Prototipo delle tre esperienze dopo l'accesso (task #401, docs/specifiche/tre-esperienze/PROPOSTA.md). L'esperienza
    viene dalla categoria dell'utente (GET api/portale/esperienza); un interno Perleuve può provare le altre con «Vedi
    come…» (?come=). Menù e pagine iniziali da Web/Esperienze/MenuEsperienze; le sezioni del Portale si aprono dentro,
    come nel prototipo /portale-nuovo (task #387), da cui vengono testata, menù e barra del telefono.
*@

<PageTitle>@(_voce is { } v ? $"{v.Titolo} · 4Grapes" : $"{_menu.Iniziale} · 4Grapes")</PageTitle>

<div class="pn es es-@_menu.Esperienza">
    @if (_idUtente is null)
    {
        <div class="messaggio-errore" role="alert">
            <p>Per entrare serve l'accesso con il tuo utente 4Grapes.</p>
            <a class="pulsante-principale" href="accesso?ReturnUrl=%2Fesperienza" data-enhance-nav="false">Accedi</a>
        </div>
    }
    else if (_errore is not null)
    {
        <div class="messaggio-errore" role="alert">
            <p>@_errore</p>
            <button type="button" class="pulsante-principale" @onclick="CaricaAsync">Riprova</button>
        </div>
    }
    else if (_utente is null || _esperienza is null)
    {
        <p class="aziende-stato" role="status">Preparo la tua pagina…</p>
    }
    else
    {
        <div class="pn-testata">
            <button type="button" class="pn-sezioni solo-mobile" aria-expanded="@(_menuAperto ? "true" : "false")"
                    @onclick="() => _menuAperto = !_menuAperto">☰ Menù</button>
            <p class="pn-dove">
                <a href="@MenuEsperienze.Indirizzo(_menu.Esperienza, null, Azienda, ComeAttivo)">@_menu.Iniziale</a>
                @if (_voce is { } dove)
                {
                    <span aria-hidden="true"> › </span><span>@dove.Titolo</span>
                }
            </p>
            @if (_aziende.Count > 0)
            {
                <label class="pn-azienda">
                    <span>Azienda</span>
                    <select value="@(Azienda?.ToString(CultureInfo.InvariantCulture) ?? "")" @onchange="CambiaAzienda">
                        @if (_menu.Esperienza == TipiEsperienza.Interno)
                        {
                            <option value="">Tutte le aziende</option>
                        }
                        @foreach (var a in _aziende)
                        {
                            <option value="@a.Id">@a.Nome</option>
                        }
                    </select>
                </label>
            }
            @if (_esperienza.Esperienza == TipiEsperienza.Interno)
            {
                <label class="pn-azienda es-come">
                    <span>Vedi come</span>
                    <select value="@_menu.Esperienza" @onchange="CambiaCome">
                        <option value="@TipiEsperienza.Interno">Perleuve (io)</option>
                        <option value="@TipiEsperienza.Consulenza">Azienda in consulenza</option>
                        <option value="@TipiEsperienza.Abbonato">Abbonato</option>
                    </select>
                </label>
            }
        </div>

        @if (ComeAttivo is not null)
        {
            <p class="es-prova" role="status">Stai vedendo Mappe come lo vede: <strong>@_menu.Nome</strong>. I dati e i permessi restano i tuoi.</p>
        }

        <div class="pn-corpo">
            <nav class="pn-menu @(_menuAperto ? "aperto" : "")" aria-label="Menù">
                <a class="pn-oggi @(_voce is null ? "attiva" : "")" href="@MenuEsperienze.Indirizzo(_menu.Esperienza, null, Azienda, ComeAttivo)"
                   @onclick="() => _menuAperto = false">@(_menu.Esperienza == TipiEsperienza.Consulenza ? "🏡" : "☀") @_menu.Iniziale</a>
                @foreach (var g in _gruppi)
                {
                    <h2><span aria-hidden="true">@g.Icona</span> @g.Titolo</h2>
                    <ul>
                        @foreach (var v in g.Voci)
                        {
                            <li>
                                <a href="@MenuEsperienze.Indirizzo(_menu.Esperienza, v, Azienda, ComeAttivo)" class="@(_voce == v ? "attiva" : "")"
                                   target="@(v.App ? "_blank" : null)" @onclick="() => _menuAperto = false">
                                    @v.Titolo
                                    @if (v.Per(_menu.Esperienza) == Accesso.Vede && _menu.Esperienza != TipiEsperienza.Interno)
                                    {
                                        <span class="es-solo-vede" title="Qui guardi soltanto">👁</span>
                                    }
                                    @if (v.Fuori is not null)
                                    {
                                        <span class="pn-fuori" title="@(v.App ? "Un'app di 4Grapes" : "Un'altra pagina")">↗</span>
                                    }
                                </a>
                            </li>
                        }
                    </ul>
                }
                <p class="pn-nota">Prototipo (task #401): il menù di oggi resta com'è.</p>
            </nav>

            <main class="pn-contenuto">
                @if (_voce is null)
                {
                    @if (_menu.Esperienza != TipiEsperienza.Interno)
                    {
                        <h1 class="pn-titolo">@Titolo()</h1>
                    }
                    <p class="es-frase">@_menu.Frase</p>
                    @switch (_menu.Esperienza)
                    {
                        case TipiEsperienza.Interno:
                            <OggiPortale Utente="_utente" Azienda="Azienda" Gruppi="MenuPortaleNuovo.Visibili(_utente)" />
                            <section class="pn-blocco">
                                <h2>Report da preparare</h2>
                                <div class="pn-scorciatoie">
                                    @foreach (var chiave in new[] { "report-settimanale", "report-fine-stagione", "report-laore", "bilancio-configurazione" })
                                    {
                                        var voce = MenuEsperienze.Voci.First(x => x.Chiave == chiave);
                                        <a href="@MenuEsperienze.Indirizzo(_menu.Esperienza, voce, Azienda, ComeAttivo)"><strong>@voce.Titolo</strong><span>@voce.Frase</span></a>
                                    }
                                </div>
                            </section>
                            break;
                        case TipiEsperienza.Consulenza:
                            <CruscottoAzienda Utente="_utente" Esperienza="@_menu.Esperienza" Azienda="Azienda" Come="@ComeAttivo"
                                              TitoloConsulta="I tuoi report e i nostri consigli" />
                            break;
                        default:
                            <section class="pn-blocco">
                                <h2>Cosa vuoi fare</h2>
                                <div class="es-azioni">
                                    @foreach (var (chiave, testo, icona, extra) in AzioniAbbonato)
                                    {
                                        var voce = MenuEsperienze.Voci.First(x => x.Chiave == chiave);
                                        <a href="@(MenuEsperienze.Indirizzo(_menu.Esperienza, voce, Azienda, ComeAttivo) + extra)">
                                            <span aria-hidden="true">@icona</span>@testo
                                        </a>
                                    }
                                </div>
                            </section>
                            <h2 class="es-sotto">Come stanno i tuoi vigneti</h2>
                            <CruscottoAzienda Utente="_utente" Esperienza="@_menu.Esperienza" Azienda="Azienda" Come="@ComeAttivo" />
                            break;
                    }
                }
                else if (_voce.Sezione is { } sezione && global::ProgettoMappe.Web.Components.Pages.Portale.Portale.Pagine.TryGetValue(sezione, out var pagina))
                {
                    <h1 class="pn-titolo">@_voce.Titolo</h1>
                    @if (_voce.Per(_menu.Esperienza) == Accesso.Vede && _menu.Esperienza != TipiEsperienza.Interno)
                    {
                        <p class="es-prova">👁 Qui guardi soltanto@(_voce.Nota is { } n ? $" ({n})" : "").</p>
                    }
                    <DynamicComponent Type="pagina" Parameters="@(new Dictionary<string, object?> { ["Utente"] = _utente, ["Scritture"] = Scritture() })" />
                }
                else
                {
                    <p class="messaggio-errore" role="alert">Questa pagina non c'è nel tuo menù.</p>
                }
            </main>
        </div>

        <nav class="pn-barra solo-mobile" aria-label="Le voci più usate">
            @foreach (var (testo, icona, chiave) in _menu.Barra)
            {
                var voce = chiave is null ? null : MenuEsperienze.Voci.First(x => x.Chiave == chiave);
                <a href="@MenuEsperienze.Indirizzo(_menu.Esperienza, voce, Azienda, ComeAttivo)" class="@(_voce == voce ? "attiva" : "")">
                    <span aria-hidden="true">@icona</span>@testo
                </a>
            }
            <button type="button" @onclick="() => _menuAperto = !_menuAperto"><span aria-hidden="true">☰</span>Altro</button>
        </nav>
    }
</div>

@code {
    [Parameter] public string? Voce { get; set; }
    [SupplyParameterFromQuery(Name = "azienda")] public int? Azienda { get; set; }
    [SupplyParameterFromQuery(Name = "come")] public string? Come { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? StatoAccesso { get; set; }

    /// <summary>La home degli abbonati: le cose che fanno in vigna, una per tasto.</summary>
    private static readonly (string Chiave, string Testo, string Icona, string Extra)[] AzioniAbbonato =
    [
        ("trattamenti", "Registra un trattamento", "🛡", ""),
        ("produzione", "Inserisci la vendemmia", "🍇", ""),
        ("fallanze", "Conta le fallanze", "🌱", ""),
        ("galleria", "Guarda le foto", "📷", ""),
        ("vigneti", "I miei vigneti", "🏡", ""),
        ("bilancio-configurazione", "Imposta lo stile del vino", "🍷", "&sezione=stile"),
    ];

    private int? _idUtente;
    private PortaleUtenteDto? _utente;
    private EsperienzaUtenteDto? _esperienza;
    private StatoScrittureDto? _scritture;
    private string? _errore;
    private MenuEsperienza _menu = MenuEsperienze.Interno;
    private IReadOnlyList<GruppoEsperienza> _gruppi = [];
    private List<VoceFiltroDto> _aziende = [];
    private VoceEsperienza? _voce;
    private bool _menuAperto;

    /// <summary>Il «Vedi come…» vale solo per gli interni e solo se diverso dalla loro esperienza.</summary>
    private string? ComeAttivo =>
        _esperienza?.Esperienza == TipiEsperienza.Interno && TipiEsperienza.Valida(Come) && Come != TipiEsperienza.Interno ? Come : null;

    protected override async Task OnInitializedAsync()
    {
        _idUtente = UtentePortale.IdUtente(StatoAccesso is null ? null : (await StatoAccesso).User);
        await CaricaAsync();
    }

    protected override void OnParametersSet() => Componi();

    private async Task CaricaAsync()
    {
        if (_idUtente is not { } id) return;

        _errore = null;
        var utente = await Api.GetUtenteAsync(id);
        var esperienza = await Api.GetEsperienzaAsync(id);
        if (!utente.Riuscita || utente.Dati is null || !esperienza.Riuscita || esperienza.Dati is null)
        {
            _errore = utente.Errore ?? esperienza.Errore ?? "Non riesco a capire che tipo di utente sei.";
            return;
        }

        (_utente, _esperienza) = (utente.Dati, esperienza.Dati);
        _scritture = (await Api.GetScrittureAsync(id)).Dati;
        // Le aziende dell'utente: per il prototipo quelle del calendario dei trattamenti, come /portale-nuovo.
        var calendario = await Api.GetTrattamentiGiornalieriAsync(id, DateOnly.FromDateTime(DateTime.Today), new Dictionary<string, string>());
        _aziende = calendario.Dati?.Filtri.Aziende.Where(a => int.TryParse(a.Id, out var n) && n > 0).ToList() ?? [];
        Componi();
    }

    private void Componi()
    {
        if (_utente is null || _esperienza is null) return;
        _menu = MenuEsperienze.Di(ComeAttivo ?? _esperienza.Esperienza);
        _gruppi = MenuEsperienze.Visibili(_menu, _utente);
        _voce = Voce is null ? null : _gruppi.SelectMany(g => g.Voci).FirstOrDefault(v => v.Chiave.Equals(Voce, StringComparison.OrdinalIgnoreCase));

        // Chi guarda la propria azienda parte da quella: senza un'azienda scelta, la prima delle sue.
        if (_menu.Esperienza != TipiEsperienza.Interno && Azienda is null && _aziende.Count > 0)
        {
            Nav.NavigateTo(Nav.GetUriWithQueryParameter("azienda", _aziende[0].Id), replace: true);
        }
    }

    /// <summary>Nella consultazione il Portale non salva niente: le sezioni si aprono con le scritture spente.</summary>
    private StatoScrittureDto? Scritture() =>
        _voce?.Per(_menu.Esperienza) == Accesso.Vede
            ? new StatoScrittureDto("spente", "Consultazione: qui si guarda e basta.")
            : _scritture;

    private string Titolo()
    {
        var oggi = DateTime.Now.ToString("dddd d MMMM", CultureInfo.GetCultureInfo("it-IT"));
        var nome = _aziende.FirstOrDefault(a => a.Id == Azienda?.ToString(CultureInfo.InvariantCulture))?.Nome;
        return _menu.Esperienza == TipiEsperienza.Consulenza ? nome ?? "La mia azienda" : $"Oggi, {oggi}";
    }

    private void CambiaAzienda(ChangeEventArgs e)
    {
        int? scelta = int.TryParse(e.Value?.ToString(), out var n) && n > 0 ? n : null;
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("azienda", scelta), replace: true);
    }

    private void CambiaCome(ChangeEventArgs e)
    {
        var scelta = e.Value?.ToString();
        Nav.NavigateTo(MenuEsperienze.Indirizzo(scelta ?? TipiEsperienza.Interno, null, Azienda,
            scelta == TipiEsperienza.Interno ? null : scelta));
    }
}

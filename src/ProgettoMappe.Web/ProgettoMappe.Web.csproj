<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\ProgettoMappe.Contracts\ProgettoMappe.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Markdig" Version="1.4.0" />
  </ItemGroup>

  <!-- Il testo della pagina «Guida» (Guida/TestoGuida): si modifica in docs/mappe/guida.md. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\mappe\guida.md" LogicalName="ProgettoMappe.Web.guida.md" />
    <!-- Report settimanale (task #213): settimane di Qlik esportate dall'app (ReportSettimanale/SettimanaQlik). -->
    <EmbeddedResource Include="..\..\docs\specifiche\report-settimanale\dati\DOY_WEEK.csv" LogicalName="ProgettoMappe.Web.DOY_WEEK.csv" />
    <EmbeddedResource Include="..\..\docs\specifiche\report-settimanale\dati\WEEK_REF.csv" LogicalName="ProgettoMappe.Web.WEEK_REF.csv" />
  </ItemGroup>

  <!-- Il logo Perleuve dei report PowerPoint (Report/ModelloReport), dentro l'assembly. -->
  <ItemGroup>
    <EmbeddedResource Include="Report\Risorse\logo-perleuve.png" LogicalName="ProgettoMappe.Web.logo-perleuve.png" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>progettomappe-web</UserSecretsId>
  </PropertyGroup>

</Project>

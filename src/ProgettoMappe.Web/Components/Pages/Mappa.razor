    /// <summary>
    /// Carica una fonte dei tematismi diversa dal BIGOT: se il server non l'ha ancora pronta riprova
    /// ogni <see cref="AttesaIndici"/>, come gli indici. <paramref name="nome"/> è plurale («… non disponibili»).
    /// </summary>
    private async Task CaricaFonteAsync<T>(FonteTematismo fonte, string nome, Func<CancellationToken, Task<T>> leggi,
        Func<T, bool> pronta, Action<T> applica, Action<string> stato, CancellationToken ct)
    {
        try
        {
            for (var tentativo = 1; tentativo <= TentativiIndici && !ct.IsCancellationRequested; tentativo++)
            {
                var risposta = await leggi(ct);
                if (ct.IsCancellationRequested)
                {
                    return;
                }
                if (pronta(risposta))
                {
                    await InvokeAsync(async () =>
                    {
                        applica(risposta);
                        ApplicaAnniIniziali(fonte);
                        await ApplicaFiltriAsync(adatta: false);
                        StateHasChanged();
                        AggiornaIndirizzo();
                    });
                    return;
                }

                await InvokeAsync(() => { stato($"{nome} in preparazione sul server…"); StateHasChanged(); });
                await Task.Delay(AttesaIndici, ct);
            }

            await InvokeAsync(() => { stato($"{nome} non disponibili al momento."); StateHasChanged(); });
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // Pagina chiusa o azienda cambiata durante il caricamento.
        }
        catch (Exception ex)
        {
            Logger.LogWarning("{Nome} non disponibili ({Tipo}: {Messaggio})", nome, ex.GetType().Name, ex.Message);
            await InvokeAsync(() => { stato($"{nome} non raggiungibili."); StateHasChanged(); });
        }
    }

    private static readonly System.Collections.Concurrent.ConcurrentDictionary<string, byte> ValoriNonPrevistiSegnalati = new();

    /// <summary>
    /// Classi e conteggi della legenda per parametro e anno correnti, sui vigneti indicati; restituisce
    /// quello che serve alla mappa (null = nessun tematismo).
    /// </summary>
    private object? CalcolaTematismo(IReadOnlyList<VignetoDto> vigneti)
    {
        var tema = TematismoAttivo;
        _conteggi = [];
        _classificazione = null;
        _riepilogo = null;
        _valoriElenco = null;

        if (tema is not null && (tema.SenzaAnno || Anno is not null) && RigheDi(tema.Fonte) is { } righe && _vigneti is not null)
        {
            ClassificazioneTematismo classificazione;
            List<string> colori;
            if (Confronto && AnnoDa is { } annoDa && Anno is { } annoA)
            {
                var regola = Catalogo.Regola(tema);
                var (variazioni, conRiga) = ConfrontoBigot.Variazioni(tema, regola, righe, annoDa, annoA);
                classificazione = new ClassificazioneTematismo(variazioni.ToDictionary(v => v.Key, v => v.Value.Classe), [], conRiga);
                colori = ConfrontoBigot.Classi(tema, regola).Select(c => c.Colore).ToList();
                // Riepilogo sui vigneti di Vigna/Vitigno visibili sulla mappa, come i conteggi della legenda.
                _riepilogo = ConfrontoBigot.Riepilogo(variazioni, vigneti.Where(v => v.HaGeometria).Select(v => v.Id));
                // Nell'elenco la variazione, ordinabile dal più migliorato.
                _valoriElenco = variazioni.ToDictionary(v => v.Key,
                    v => new ValoreElenco(ConfrontoBigot.TestoDelta(tema, v.Value.Delta), colori[v.Value.Classe], v.Value.Miglioramento));
            }
            else
            {
                classificazione = TematismiBigot.ClassiPerVigneto(tema, righe, Anno);
                colori = tema.Classi.Select(c => c.Colore).ToList();
                // Nell'elenco il valore come nella scheda (stesso testo e colore), ordinabile per valore.
                _valoriElenco = [];
                foreach (var riga in righe.Where(r => tema.SenzaAnno || r is IRigaAnnuale a && a.Anno == Anno))
                {
                    if (SchedaBigot.Valore(tema, riga) is { Testo: not SchedaBigot.Vuoto } valore)
                    {
                        _valoriElenco[riga.IdVigneto] = new ValoreElenco(valore.Testo, valore.Colore, tema.ValoreConfronto(riga));
                    }
                }
            }
            _classificazione = classificazione;
            foreach (var valore in classificazione.ValoriNonPrevisti)
            {
                // Una riga di log per valore e tematismo, non a ogni cambio di anno o azienda.
                if (ValoriNonPrevistiSegnalati.TryAdd($"{tema.Id}|{valore}", 0))
                {
                    Logger.LogWarning("Indici BIGOT: valore {Valore} di {Tematismo} non previsto dalla mappa, mostrato come \"Altro\"",
                        valore, tema.Nome);
                }
            }
            // Conteggi della legenda solo sui vigneti visibili sulla mappa (con geometria).
            _conteggi = TematismiBigot.Conteggi(classificazione, vigneti.Where(v => v.HaGeometria).Select(v => v.Id));
            // Alla mappa la classe di ogni vigneto, anche "nessun dato" (-1) e "fuori perimetro" (-2).
            var classi = _vigneti.Where(v => v.HaGeometria).DistinctBy(v => v.Id).ToDictionary(v => v.Id, v => classificazione.ClasseDi(v.Id));
            return new { colori, classi };
        }

        return null;
    }

    /// <summary>Parametro, anni e confronto: nella colonna di sinistra (desktop) e nel pannello «Mappe tematiche» (telefono).</summary>
    private RenderFragment ControlliTematismo => __builder =>
    {
        <label>
            Colora per
            <select @bind="TematismoId" @bind:after="ParametroCambiatoAsync" disabled="@(!_indiciPronti && !_statistichePronte && !_fenologiaPronta && !_rilieviPronti && !_difesaPronta)">
                <option value="">Nessun parametro</option>
                @foreach (var gruppo in Catalogo.Tutti.GroupBy(t => t.Gruppo))
                {
                    <optgroup label="@gruppo.Key">
                        @foreach (var t in gruppo)
                        {
                            <option value="@t.Id" disabled="@(!FontePronta(t.Fonte))">@t.Nome</option>
                        }
                    </optgroup>
                }
            </select>
        </label>
        if (TematismoAttivo is { Fonte: FonteTematismo.Rilievi })
        {
            <p class="nota">Ultimo rilievo di ogni vigneto, a oggi.</p>
        }
        else if (TematismoAttivo is { Fonte: FonteTematismo.Difesa })
        {
            <p class="nota">Dati di difesa di ogni vigneto, a oggi.</p>
        }
        else if (TematismoAttivo is { SenzaAnno: true })
        {
            <p class="nota">Un valore per vigneto, senza anno.</p>
        }
        else if (Anno is { } annoScelto && AnniCursore is { Count: > 0 } anniBarra)
        {
            @* Un solo comando: due pillole («Anno», «Confronta con») e una barra con i soli anni con dati;
               la pillola attiva dice quale dei due anni cambia toccando la barra. *@
            var sceltaDa = Confronto && _sceltaDa;
            <div class="scelta-anni">
                <div class="pillole" role="group" aria-label="Anni">
                    <button type="button" class="pillola @(sceltaDa ? "" : "attiva")" aria-pressed="@(!sceltaDa)"
                            @onclick="() => _sceltaDa = false">
                        <span class="titolo">Anno</span> <strong>@annoScelto</strong>
                    </button>
                    @if (Confronto)
                    {
                        <span class="pillola confronto @(sceltaDa ? "attiva" : "")">
                            <button type="button" aria-pressed="@sceltaDa" @onclick="() => _sceltaDa = true">
                                <span class="titolo">Confronta con</span> <strong>@AnnoDa</strong>
                            </button>
                            <button type="button" class="togli" aria-label="Spegni il confronto" title="Spegni il confronto"
                                    @onclick="SpegniConfrontoAsync">×</button>
                        </span>
                    }
                    else
                    {
                        <button type="button" class="pillola aggiungi" disabled="@(TematismoAttivo is not { Confrontabile: true } || anniBarra.Count < 2)"
                                title="@(TematismoAttivo is null ? "Scegli prima un parametro" : !TematismoAttivo.Confrontabile ? "La fenologia non si confronta fra anni" : anniBarra.Count < 2 ? "C'è un anno solo con dati" : "Confronta con un altro anno")"
                                @onclick="AccendiConfrontoAsync">+ Confronta con…</button>
                    }
                </div>
                <div class="barra-anni" role="group" aria-label="@(sceltaDa ? "Anno di confronto" : "Anno mostrato")">
                    @foreach (var a in anniBarra)
                    {
                        var anno = a;
                        var altro = Confronto && anno == (sceltaDa ? Anno : AnnoDa);
                        <button type="button" class="@(anno == Anno ? "scelto" : "") @(Confronto && anno == AnnoDa ? "confronto" : "")"
                                aria-pressed="@(anno == (sceltaDa ? AnnoDa : Anno))" disabled="@altro"
                                title="@(anno == _annoCorrente ? "Anno in corso" : null)" @onclick="() => ScegliAnnoBarraAsync(anno)">
                            @anno@(anno == _annoCorrente ? "*" : "")
                        </button>
                    }
                </div>
                @if (anniBarra.Contains(_annoCorrente))
                {
                    <p class="nota">* anno in corso, dati non definitivi.</p>
                }
            </div>
        }
        if (!_indiciPronti)
        {
            <p class="nota">@(_statoIndici ?? "Indici BIGOT in caricamento…")</p>
        }
        else if (_anni.Count == 0)
        {
            <p class="nota">Nessun indice BIGOT per i vigneti di questa azienda.</p>
        }
        if (!_statistichePronte)
        {
            <p class="nota">@(_statoStatistiche ?? "Rischi, vigoria e potenziale idrico in caricamento…")</p>
        }
        if (!_fenologiaPronta)
        {
            <p class="nota">@(_statoFenologia ?? "Dati di fenologia in caricamento…")</p>
        }
        if (!_rilieviPronti)
        {
            <p class="nota">@(_statoRilievi ?? "Ultimi rilievi in caricamento…")</p>
        }
        if (!_difesaPronta)
        {
            <p class="nota">@(_statoDifesa ?? "Trattamenti e linee di difesa in caricamento…")</p>
        }
    };

    /// <summary>Note, riepilogo del confronto e voci della legenda: riquadro sulla mappa (desktop) e pannello «Mappe tematiche» (telefono).</summary>
    private RenderFragment CorpoLegenda(Tematismo tema) => __builder =>
    {
        var regolaLegenda = Catalogo.Regola(tema);
        if ((Confronto ? ConfrontoBigot.Nota(tema, regolaLegenda) : tema.Nota) is { } notaLegenda)
        {
            <p class="nota">@notaLegenda</p>
        }
        if (Confronto && _riepilogo is { } riepilogo)
        {
            var classiConfronto = ConfrontoBigot.Classi(tema, regolaLegenda);
            <div class="riepilogo-confronto">
                @if (riepilogo.Confrontati > 0)
                {
                    @* Quanti vigneti per classe, come barra; i numeri sono nelle voci qui sotto. *@
                    <div class="barra-classi" aria-hidden="true">
                        @for (var i = 0; i < classiConfronto.Count; i++)
                        {
                            if (_conteggi.GetValueOrDefault(i) is > 0 and var n)
                            {
                                <span style="@($"flex-grow: {n}; background-color: {classiConfronto[i].Colore}")"></span>
                            }
                        }
                    </div>
                    <p>
                        @riepilogo.Confrontati vigneti confrontati · variazione media
                        <strong class="variazione-media">@ConfrontoBigot.TestoDelta(tema, riepilogo.VariazioneMedia ?? 0)</strong>
                    </p>
                    <details class="vigneti-variazione">
                        <summary>Vigneti dal peggiore</summary>
                        <ol>
                            @foreach (var v in riepilogo.DalPeggiore)
                            {
                                var variazione = v;
                                <li>
                                    <button type="button" class="@(variazione.IdVigneto == _vignetoSelezionatoId ? "selezionato" : "")"
                                            @onclick="() => SelezionaVignetoAsync(variazione.IdVigneto)">
                                        <span class="variazione" style="@($"--colore: {classiConfronto[variazione.Classe].Colore}")">@ConfrontoBigot.TestoDelta(tema, variazione.Delta)</span>
                                        <span class="nome">@NomeVigneto(variazione.IdVigneto)</span>
                                    </button>
                                </li>
                            }
                        </ol>
                    </details>
                }
                else
                {
                    <p>Nessun vigneto con un valore in entrambi gli anni.</p>
                }
            </div>
        }
        <ul>
            @foreach (var voce in LegendaTematismo.Voci(tema, Confronto ? regolaLegenda : null, Anno, _conteggi, _classeFiltro, NomiClassi(tema)))
            {
                var attiva = _classeFiltro == voce.Classe;
                <li>
                    <button type="button" class="@(attiva ? "attiva" : voce.Vuota ? "vuota" : _classeFiltro is null ? "" : "spenta")" aria-pressed="@attiva"
                            disabled="@(voce.Vuota && !attiva)" title="@(attiva ? "Mostra di nuovo tutti i vigneti" : voce.Vuota ? "Nessun vigneto in questa classe" : "Mostra solo questi vigneti")"
                            @onclick="() => ClasseLegendaAsync(voce.Classe)">
                        <span class="campione @voce.Css" style="@(voce.Colore is null ? null : $"background-color: {voce.Colore}")"></span>
                        <span class="etichetta">@voce.Testo</span>
                        <span class="conteggio">@voce.Conteggio</span>
                    </button>
                </li>
            }
        </ul>
        <p class="nota">@(_classeFiltro is null ? "Clic su una voce per vedere solo quei vigneti." : "Clic di nuovo sulla voce per vederli tutti.")</p>
    };

    /// <summary>Quadratino col colore della voce di legenda; senza colore (valore vuoto) uno spazio della stessa larghezza.</summary>
    private static RenderFragment CampioneColore(string? colore) => __builder =>
    {
        <span class="campione @(colore is null ? "vuoto" : null)" style="@(colore is null ? null : $"background-color: {colore}")" aria-hidden="true"></span>
    };

    private string? NomeAzienda => _aziende?.FirstOrDefault(a => a.Id == AziendaId)?.Nome;

    private static string Testo(object? valore, string suffisso = "") => valore switch
    {
        null => "–",
        decimal d => d.ToString("0.##", CultureInfo.GetCultureInfo("it-IT")) + suffisso,
        string s when string.IsNullOrWhiteSpace(s) => "–",
        _ => valore + suffisso,
    };

    private string IdVoceElenco(int vignetoId) => $"{_mapElementId}-voce-{vignetoId}";

    private bool FiltroAttivo => VignaFiltro != "" || VitignoFiltro != "" || _classeFiltro is not null || SoloPuntoNascosti;

    /// <summary>«Scarica»: i vigneti dell'elenco (tutti, o solo i filtrati) con l'anno scelto (BIGOT, rischi, vigoria).</summary>
    private string LinkEsportazione(string formato) => EsportazioneVigneti.Link(AziendaId, formato,
        Anno, FiltroAttivo ? _vignetiFiltrati.Select(v => v.Id) : null,
        Confronto ? AnnoDa : null, Confronto ? TematismoAttivo?.Id : null);

    // Casella di ricerca (vedi Filtri/RicercaMappa): proposte dalla terza lettera, frecce e Invio per scegliere.
    private string TestoRicerca { get; set; } = "";
    private IReadOnlyList<RisultatoRicerca> _risultatiRicerca = [];
    private int _risultatoAttivo;

    private string IdRisultato(int indice) => $"{_mapElementId}-risultato-{indice}";

    private static string EtichettaTipo(TipoRisultato tipo) => tipo switch
    {
        TipoRisultato.Azienda => "Azienda",
        TipoRisultato.Vigna => "Vigna",
        _ => "Vigneto",
    };

    private void AggiornaRicerca()
    {
        _risultatiRicerca = RicercaMappa.Cerca(TestoRicerca, _aziende ?? [], _vigneti ?? [], AziendaId, NomeAzienda);
        _risultatoAttivo = 0;
    }

    private void SvuotaRicerca()
    {
        TestoRicerca = "";
        _risultatiRicerca = [];
        _risultatoAttivo = 0;
    }

    private async Task TastoRicercaAsync(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown" when _risultatiRicerca.Count > 0:
                _risultatoAttivo = (_risultatoAttivo + 1) % _risultatiRicerca.Count;
                break;
            case "ArrowUp" when _risultatiRicerca.Count > 0:
                _risultatoAttivo = (_risultatoAttivo - 1 + _risultatiRicerca.Count) % _risultatiRicerca.Count;
                break;
            case "Enter" when _risultatiRicerca.Count > 0:
                await ScegliRisultatoAsync(_risultatiRicerca[Math.Min(_risultatoAttivo, _risultatiRicerca.Count - 1)]);
                break;
            case "Escape":
                SvuotaRicerca();
                break;
        }
    }

    /// <summary>
    /// Azienda: si apre (se è già aperta si tolgono i filtri e si inquadra tutta). Vigna: diventa il
    /// filtro e la camera la inquadra. Vigneto: si tolgono i filtri che lo nascondono, la mappa lo
    /// centra e si apre la scheda.
    /// </summary>
    private async Task ScegliRisultatoAsync(RisultatoRicerca risultato)
    {
        SvuotaRicerca();
        switch (risultato.Tipo)
        {
            case TipoRisultato.Azienda when risultato.Id != AziendaId:
                ApriAzienda(risultato.Id);
                return;
            case TipoRisultato.Azienda:
                VignaFiltro = "";
                VitignoFiltro = "";
                await FiltriCambiatiAsync();
                _pannelloAperto = false;
                return;
            case TipoRisultato.Vigna:
                VignaFiltro = risultato.Id.ToString(CultureInfo.InvariantCulture);
                VitignoFiltro = "";
                await FiltriCambiatiAsync();
                _pannelloAperto = false;
                return;
            default:
                if (_vignetiFiltrati.All(v => v.Id != risultato.Id))
                {
                    VignaFiltro = "";
                    VitignoFiltro = "";
                    MostraSoloPunto = true;
                    await ApplicaFiltriAsync(adatta: false);
                    AggiornaIndirizzo();
                }
                await SelezionaVignetoAsync(risultato.Id);
                if (_module is not null)
                {
                    await _module.InvokeVoidAsync("portaInVista", IdVoceElenco(risultato.Id));
                }
                return;
        }
    }

    /// <summary>
    /// Selezione dall'elenco: aggiorna lo stato Blazor e chiede al JS di evidenziare il vigneto
    /// e portarci la camera (il JS non richiama Blazor in questo percorso).
    /// </summary>
    private async Task SelezionaVignetoAsync(int vignetoId)
    {
        AggiornaSelezione(vignetoId);
        // Su mobile si torna alla mappa con la scheda del vigneto.
        _pannelloAperto = false;
        _foglioTemaAperto = false;

        if (_module is not null)
        {
            await _module.InvokeVoidAsync("selezionaVigneto", _mapElementId, vignetoId);
        }
    }

    /// <summary>
    /// Richiamato dal JS quando l'utente clicca un vigneto sulla mappa: il JS ha già evidenziato
    /// il poligono, qui si aggiornano solo pannello ed elenco (nessuna chiamata a selezionaVigneto,
    /// quindi nessun movimento della camera e nessun loop).
    /// </summary>
    [JSInvokable]
    public async Task OnVignetoCliccato(int vignetoId)
    {
        AggiornaSelezione(vignetoId);
        _foglioTemaAperto = false; // telefono: la scheda prende il posto del pannello dei temi
        StateHasChanged();

        if (_module is not null)
        {
            await _module.InvokeVoidAsync("portaInVista", IdVoceElenco(vignetoId));
        }
    }

    /// <summary>
    /// Richiamato dal JS quando una basemap è stata applicata (anche dopo un fallback): avviso è
    /// "riserva", "interno" oppure null. Non blocca nulla: i dati 4Grapes non dipendono dalla basemap.
    /// </summary>
    [JSInvokable]
    public void OnStatoBasemap(string basemapId, string? avviso)
    {
        _basemapId = basemapId;
        _avviso = avviso switch
        {
            "riserva" => AvvisoRiserva,
            "interno" => AvvisoInterno,
            _ => null,
        };
        StateHasChanged();
    }

    /// <summary>
    /// Richiamato dal JS quando le tessere di sfondo (basemap o satellite) smettono di arrivare
    /// (true) o tornano ad arrivare (false). Solo un avviso: vigneti e filtri non ne dipendono.
    /// </summary>
    [JSInvokable]
    public void OnSfondoNonRisponde(bool nonRisponde)
    {
        _avvisoSfondo = nonRisponde;
        StateHasChanged();
    }

    /// <summary>ricorda = scelta dell'utente (pulsanti Mappa/Satellite): resta nel browser per la prossima apertura.</summary>
    private async Task ImpostaSatelliteAsync(bool satellite, bool ricorda = true)
    {
        _satellite = satellite && _imageryId is not null;
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("impostaImagery", _mapElementId, _satellite ? _imageryId : null);
            if (ricorda)
            {
                await _module.InvokeVoidAsync("ricordaSatellite", satellite);
            }
        }
    }

    /// <summary>«Dove sono»: il primo tocco accende il GPS (mappa.js lo segue), il secondo lo spegne.</summary>
    private async Task CommutaPosizioneAsync()
    {
        _posizioneAttiva = !_posizioneAttiva;
        _vignetoPosizione = null;
        _messaggioPosizione = _posizioneAttiva ? "Cerco la tua posizione…" : null;
        if (_module is not null)
        {
            await _module.InvokeVoidAsync(_posizioneAttiva ? "attivaPosizione" : "fermaPosizione", _mapElementId);
        }
    }

    /// <summary>
    /// Richiamato da mappa.js quando cambia l'esito della posizione: dentro un vigneto (entrandoci se ne
    /// apre la scheda, sul telefono il pannello ridotto; il JS l'ha già evidenziato), altrimenti il più
    /// vicino con la distanza. Senza vigneti con geometria nessun messaggio.
    /// </summary>
    [JSInvokable]
    public async Task OnPosizione(int? dentro, int? vicino, double? metri)
    {
        if (!_posizioneAttiva)
        {
            return;
        }

        if (dentro is { } id)
        {
            _messaggioPosizione = null;
            if (id != _vignetoPosizione)
            {
                _vignetoPosizione = id;
                AggiornaSelezione(id);
                _pannelloAperto = false;
                _foglioTemaAperto = false;
                StateHasChanged();
                if (_module is not null)
                {
                    await _module.InvokeVoidAsync("portaInVista", IdVoceElenco(id));
                }
                return;
            }
        }
        else
        {
            _vignetoPosizione = null;
            var nome = _vigneti?.FirstOrDefault(v => v.Id == vicino)?.Nome;
            _messaggioPosizione = nome is not null && metri is { } m ? FormatoDistanza.Messaggio(m, nome) : null;
        }
        StateHasChanged();
    }

    /// <summary>Permesso negato, GPS muto per 10 s o browser senza posizione: un messaggio, il pulsante si spegne.</summary>
    [JSInvokable]
    public void OnPosizioneErrore(int codice)
    {
        _posizioneAttiva = false;
        _vignetoPosizione = null;
        _messaggioPosizione = codice switch
        {
            1 => "Posizione non concessa: consentila al browser nelle impostazioni del telefono.",
            3 => "Il GPS non risponde: riprova all'aperto.",
            0 => "Questo browser non può dare la posizione.",
            _ => "Posizione non disponibile: riprova fra poco.",
        };
        StateHasChanged();
    }

    private async Task CommutaTerrenoAsync()
    {
        _terreno = !_terreno;
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("impostaTerreno", _mapElementId, _terreno);
        }
    }

    /// <summary>Solo modalità sviluppatore (benchmark): basemap scelta per provider.</summary>
    private async Task CambiaBasemapAsync(ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        if (_module is not null && !string.IsNullOrEmpty(id))
        {
            await _module.InvokeVoidAsync("impostaBasemap", _mapElementId, id);
        }
    }

    /// <summary>Solo modalità sviluppatore (benchmark): imagery scelta per provider.</summary>
    private async Task CambiaImageryAsync(ChangeEventArgs e)
    {
        _imageryId = e.Value?.ToString();
        if (_satellite)
        {
            await ImpostaSatelliteAsync(true);
        }
    }

    /// <summary>Chiusura della scheda: deseleziona senza muovere la camera.</summary>
    private async Task DeselezionaAsync()
    {
        _vignetoSelezionato = null;
        _vignetoSelezionatoId = null;
        AggiornaIndirizzo();
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("selezionaVigneto", _mapElementId, null);
        }
    }

    /// <summary>Vigneto selezionato per elenco e pannello informazioni; l'indirizzo lo segue (link alla scheda).</summary>
    private void AggiornaSelezione(int vignetoId)
    {
        _vignetoSelezionatoId = vignetoId;
        _vignetoSelezionato = _vigneti?.FirstOrDefault(v => v.Id == vignetoId);
        AggiornaIndirizzo();
    }

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        _ctsIndici?.Dispose();
        _cts.Dispose();
        _dotNetRef?.Dispose();

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("distruggiMappa", _mapElementId);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Il circuito Blazor è già stato chiuso (es. navigazione via o crash del circuito):
                // lato client non c'è più nulla da ripulire, né la mappa né il modulo JS.
            }
        }
    }
}

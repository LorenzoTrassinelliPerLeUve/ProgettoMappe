@using Microsoft.AspNetCore.Components.Web
<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Visualizzatore mappe - viticoltura di precisione</title>
    <base href="/" />
    <meta name="theme-color" content="#8dc63e" />
    @* MapLibre e caratteri (Montserrat, Source Sans 3) sono serviti dal sito stesso (wwwroot/lib,
       wwwroot/fonts): nessuna dipendenza da CDN esterni perché la mappa nasca. *@
    <link rel="stylesheet" href="lib/maplibre-gl-4.7.1/maplibre-gl.css" />
    <link rel="stylesheet" href="css/app.css" />
    <HeadOutlet @rendermode="ModalitaPagina" />
</head>

<body>
    <Routes @rendermode="ModalitaPagina" />
    <script src="lib/maplibre-gl-4.7.1/maplibre-gl.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Le pagine marcate [ExcludeFromInteractiveRouting] (il login) restano statiche: devono poter
    // scrivere il cookie di sessione nella risposta HTTP.
    private IComponentRenderMode? ModalitaPagina =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}

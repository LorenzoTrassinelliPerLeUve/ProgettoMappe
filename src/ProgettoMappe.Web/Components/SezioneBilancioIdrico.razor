@using System.Globalization
@using Microsoft.Extensions.Logging
@using ProgettoMappe.Contracts
@using ProgettoMappe.Web.BilancioIdrico
@inject BilancioIdricoApiClient BilancioApi
@inject ILogger<SezioneBilancioIdrico> Logger

@* Scheda del vigneto (task #335, punto B): il bilancio idrico del ricalcolo notturno, con tutte le grandezze in vista. *@
<details class="bi-scheda" @ontoggle="ApertoAsync">
    <summary class="titolo-sezione">Bilancio idrico</summary>
    @if (_errore is not null)
    {
        <p class="nota">@_errore <button type="button" class="riprova" @onclick="CaricaAsync">Riprova</button></p>
    }
    else if (_dati is null)
    {
        <p class="nota" role="status">@(_caricato ? "" : "Carico il bilancio…")</p>
    }
    else if (_dati.Giorni.Count == 0)
    {
        <p class="nota">@TestiBilancio.Calcolo(_dati.Calcolo)</p>
        <p class="nota">Questo vigneto non è nel calcolo (non attivo in 4Grapes e in nessun settore).</p>
    }
    else
    {
        var b = _dati;
        var oggi = b.Giorni.LastOrDefault(g => g.Data <= b.Oggi) ?? b.Giorni[0];
        var prossimi = b.Giorni.Where(g => g.Data > oggi.Data).ToList();
        <p>
            <span class="bi-sugg @TestiBilancio.Classe(oggi.Suggerimento)">@TestiBilancio.Suggerimento(oggi.Suggerimento)</span>
            @if (oggi.Suggerimento == "IRRIGARE")
            {
                <span> · @TestiBilancio.Mm(oggi.IrrigazioneSuggeritaMm) suggeriti</span>
            }
            <span class="nota"> (@TestiBilancio.Giorno(oggi.Data))</span>
        </p>
        @if (prossimi.Count > 0)
        {
            <p class="bi-prossimi">
                @foreach (var g in prossimi)
                {
                    <span class="bi-giorno @TestiBilancio.Classe(g.Suggerimento)" title="@($"{TestiBilancio.Giorno(g.Data)}: {TestiBilancio.Suggerimento(g.Suggerimento)}, Pdlwp {TestiBilancio.Mpa(g.PdlwpMpa)}")">@TestiBilancio.Lettera(g.Suggerimento)</span>
                }
                <span class="nota">prossimi giorni</span>
            </p>
        }
        <table class="valori-bigot">
            <tr><th title="Potenziale fogliare previsto">Pdlwp</th><td>@TestiBilancio.Mpa(oggi.PdlwpMpa) (soglia @(oggi.SogliaMpa is null ? (b.Anomalie.Count > 0 ? "assente: il perché è in fondo" : "assente") : TestiBilancio.Mpa(oggi.SogliaMpa)))</td></tr>
            <tr><th>Deficit</th><td>@TestiBilancio.Mm(oggi.DeficitMm)</td></tr>
            <tr><th title="Acqua disponibile / capacità del suolo (AWC)">Acqua (AW / AWC)</th><td>@TestiBilancio.Numero(oggi.AwMm, "0") / @TestiBilancio.Numero(oggi.AwcMm, "0") mm</td></tr>
            <tr><th>ET0 · Kc · Ks · ETa</th><td>@TestiBilancio.Numero(oggi.Et0Mm, "0.0") · @TestiBilancio.Numero(oggi.Kc) · @TestiBilancio.Numero(oggi.Ks) · @TestiBilancio.Mm(oggi.EtaMm)</td></tr>
            <tr><th>BBCH · fase</th><td>@(oggi.Bbch?.ToString(CultureInfo.InvariantCulture) ?? "—") · @(oggi.Fase?.ToString(CultureInfo.InvariantCulture) ?? "—")</td></tr>
        </table>

        var acqua = GraficoBilancio.Acqua(b);
        var potenziale = GraficoBilancio.Potenziale(b);
        <p class="nota bi-legenda"><span style="color:#2a7ab0">━ AW</span> acqua disponibile · <span style="color:#8a99a6">┅ AWC</span> capacità · <span style="color:#2a7ab0">▮</span> pioggia+irrigazione</p>
        <svg class="bi-grafico" viewBox="0 0 @GraficoBilancio.Larghezza @GraficoBilancio.Altezza" role="img" aria-label="Acqua disponibile e capacità del suolo">
            @Asse(acqua, "0")
            @foreach (var g in b.Giorni.Where(g => g.Data >= acqua.Da && (g.PioggiaMm ?? 0) + g.IrrigazioneMm > 0))
            {
                var mm = Math.Min((g.PioggiaMm ?? 0) + g.IrrigazioneMm, acqua.MaxY);
                <rect x="@N(acqua.X(g.Data) - 0.6)" y="@N(acqua.Y(mm))" width="1.2" height="@N(acqua.Y(0) - acqua.Y(mm))" fill="#2a7ab0" opacity="0.35" />
            }
            @foreach (var l in acqua.Linee(b.Giorni.Select(g => (g.Data, g.AwcMm))))
            {
                <polyline points="@l" fill="none" stroke="#8a99a6" stroke-width="1" stroke-dasharray="3 2" />
            }
            @foreach (var l in acqua.Linee(b.Giorni.Select(g => (g.Data, (double?)g.AwMm))))
            {
                <polyline points="@l" fill="none" stroke="#2a7ab0" stroke-width="1.5" />
            }
            @Oggi(acqua)
        </svg>
        <p class="nota bi-legenda"><span style="color:#3c3950">━ Pdlwp</span> previsto · <span style="color:#d9534f">┅ soglia</span> · <span style="color:#d97a00">● misurato</span></p>
        <svg class="bi-grafico" viewBox="0 0 @GraficoBilancio.Larghezza @GraficoBilancio.Altezza" role="img" aria-label="Potenziale fogliare previsto, soglia e misure">
            @Asse(potenziale, "0.0")
            @foreach (var l in potenziale.Linee(b.Giorni.Select(g => (g.Data, g.SogliaMpa))))
            {
                <polyline points="@l" fill="none" stroke="#d9534f" stroke-width="1" stroke-dasharray="3 2" />
            }
            @foreach (var l in potenziale.Linee(b.Giorni.Select(g => (g.Data, g.PdlwpMpa))))
            {
                <polyline points="@l" fill="none" stroke="#3c3950" stroke-width="1.5" />
            }
            @foreach (var m in b.Misurati.Where(m => m.Data >= potenziale.Da && m.Data <= potenziale.A))
            {
                <circle cx="@N(potenziale.X(m.Data))" cy="@N(potenziale.Y(m.Mpa))" r="2.5" fill="#d97a00"><title>@($"{m.Data:d/M}: {TestiBilancio.Mpa(m.Mpa)} ({m.Tipo})")</title></circle>
            }
            @Oggi(potenziale)
        </svg>
        @if (b.NotaMisurati is not null)
        {
            <p class="nota">@b.NotaMisurati</p>
        }

        <details>
            <summary>Giorno per giorno</summary>
            <div class="tabella-scorrevole">
                <table class="valori-bigot bi-tabella">
                    <thead><tr><th>Giorno</th><th>ET0</th><th>Pioggia</th><th>Irrig.</th><th>Kc</th><th>Ks</th><th>ETa</th><th>AW</th><th>Pdlwp</th><th>Consiglio</th></tr></thead>
                    <tbody>
                        @foreach (var g in b.Giorni.Where(g => g.Data >= b.Oggi.AddDays(-14)))
                        {
                            <tr class="@(g.Previsione ? "nota" : null)">
                                <th scope="row">@TestiBilancio.Giorno(g.Data)@(g.Previsione ? " (prev.)" : "")</th>
                                <td>@TestiBilancio.Numero(g.Et0Mm, "0.0")</td><td>@TestiBilancio.Numero(g.PioggiaMm, "0.0")</td>
                                <td>@TestiBilancio.Numero(g.IrrigazioneMm, "0.0")</td><td>@TestiBilancio.Numero(g.Kc)</td><td>@TestiBilancio.Numero(g.Ks)</td>
                                <td>@TestiBilancio.Numero(g.EtaMm, "0.0")</td><td>@TestiBilancio.Numero(g.AwMm, "0")</td><td>@TestiBilancio.Numero(g.PdlwpMpa)</td>
                                <td>@TestiBilancio.Lettera(g.Suggerimento)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="nota">mm al giorno; Pdlwp in MPa. ETa = ET0 × Kc × Ks. «prev.» = meteo previsto.</p>
        </details>

        @if (b.Anomalie.Count > 0)
        {
            <ul class="bi-anomalie nota">@foreach (var a in b.Anomalie) { <li>@a</li> }</ul>
        }
        <p class="nota">@TestiBilancio.Calcolo(b.Calcolo) <a href="@($"bilancio-idrico?azienda={AziendaId}")">Tutta l'azienda</a></p>
    }
</details>

@code {
    [Parameter, EditorRequired] public int AziendaId { get; set; }
    [Parameter, EditorRequired] public int VignetoId { get; set; }

    private BilancioVignetoDto? _dati;
    private string? _errore;
    private bool _caricato;

    private static string N(double v) => v.ToString("0.#", CultureInfo.InvariantCulture);

    /// <summary>Si legge solo quando la sezione si apre: chi non la guarda non paga la richiesta.</summary>
    private async Task ApertoAsync()
    {
        if (!_caricato)
            await CaricaAsync();
    }

    private async Task CaricaAsync()
    {
        _errore = null;
        _caricato = true;
        try
        {
            _dati = await BilancioApi.GetVignetoAsync(AziendaId, VignetoId);
            if (_dati is null)
                _errore = "Bilancio non disponibile per questo vigneto.";
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning("Bilancio idrico del vigneto {Vigneto} non letto ({Messaggio})", VignetoId, ex.Message);
            _errore = "Non riesco a leggere il bilancio idrico.";
        }
    }

    private static RenderFragment Asse(GraficoBilancio g, string formato) => __builder =>
    {
        foreach (var t in g.Tacche())
        {
            @* <text> dentro un <g>: subito dopo il codice Razor lo prenderebbe per il suo tag speciale. *@
            <g>
                <line x1="@N(GraficoBilancio.Margine)" x2="@N(GraficoBilancio.Larghezza - 4)" y1="@N(g.Y(t))" y2="@N(g.Y(t))" stroke="#e3e6e8" stroke-width="0.5" />
                <text x="@N(GraficoBilancio.Margine - 3)" y="@N(g.Y(t) + 3)" text-anchor="end">@t.ToString(formato, CultureInfo.GetCultureInfo("it-IT"))</text>
            </g>
        }
        <g>
            <text x="@N(GraficoBilancio.Margine)" y="@N(GraficoBilancio.Altezza - 2)">@g.Da.ToString("d/M", CultureInfo.InvariantCulture)</text>
            <text x="@N(GraficoBilancio.Larghezza - 4)" y="@N(GraficoBilancio.Altezza - 2)" text-anchor="end">@g.A.ToString("d/M", CultureInfo.InvariantCulture)</text>
        </g>
    };

    private static RenderFragment Oggi(GraficoBilancio g) => __builder =>
    {
        <g>
            <line x1="@N(g.X(g.Oggi))" x2="@N(g.X(g.Oggi))" y1="2" y2="@N(GraficoBilancio.Altezza - 14)" stroke="#8dc63e" stroke-width="1" />
            <text x="@N(g.X(g.Oggi))" y="@N(GraficoBilancio.Altezza - 2)" text-anchor="middle">oggi</text>
        </g>
    };
}

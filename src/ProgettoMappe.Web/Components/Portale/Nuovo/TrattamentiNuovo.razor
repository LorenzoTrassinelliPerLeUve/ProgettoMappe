@using System.Globalization
@using ProgettoMappe.Web.Portale
@inject PortaleApiClient Api
@inject NavigationManager Nav

@*
    Trattamenti nel Portale nuovo (prototipo, task #387). Lo stesso calendario di oggi (api/portale/trattamenti/giornalieri), ma:
    il giorno si sfoglia (‹ ›) e resta nell'indirizzo con l'azienda; i colori hanno il nome scritto dentro (Da fare, Fatto…);
    un filtro solo in vista (tipo di trattamento) e la ricerca del vigneto, gli altri in «Altri filtri» nella fase 2;
    sul computer la tabella della settimana con il nome del vigneto fermo a sinistra, sul telefono una scheda per vigneto del
    giorno scelto con la settimana in piccolo. Toccare un trattamento apre i prodotti sotto.
*@

<div class="pn-intestazione">
    <h1 class="pn-titolo">Trattamenti</h1>
    <a class="pulsante-principale" href="portale/trattamenti">Segna un trattamento</a>
</div>

<div class="pn-giorno" role="group" aria-label="Giorno">
    <a class="pn-freccia" href="@Link(Giorno.AddDays(-1))" aria-label="Giorno prima">‹</a>
    <strong>@Etichetta(Giorno)<small>@Giorno.ToString("dddd d MMMM", It)</small></strong>
    <a class="pn-freccia" href="@Link(Giorno.AddDays(1))" aria-label="Giorno dopo">›</a>
    @if (Giorno != Oggi)
    {
        <a class="pn-torna" href="@Link(Oggi)">Torna a oggi</a>
    }
</div>

<div class="pn-filtri">
    <div class="pn-pillole" role="group" aria-label="Tipo di trattamento">
        @foreach (var (valore, testo) in Tipi)
        {
            <button type="button" class="@(_tipo == valore ? "attiva" : "")" aria-pressed="@(_tipo == valore ? "true" : "false")"
                    @onclick="() => ScegliTipoAsync(valore)">@testo</button>
        }
    </div>
    <input type="search" placeholder="Cerca un vigneto" aria-label="Cerca un vigneto" @bind="_cerca" @bind:event="oninput" />
</div>

<ul class="pn-legenda" aria-label="Cosa vogliono dire i colori">
    @foreach (var stato in new[] { "suggerito", "suggerito-altre", "automatico", "effettivo", "esclusi" })
    {
        <li><span class="pn-chip pn-@stato">@RiepilogoOggi.Stato(stato)</span></li>
    }
</ul>

@if (_errore is not null)
{
    <div class="messaggio-errore" role="alert">
        <p>@_errore</p>
        <button type="button" class="pulsante-principale" @onclick="CaricaAsync">Riprova</button>
    </div>
}
else if (_dati is null)
{
    <p class="aziende-stato" role="status">Carico i trattamenti…</p>
}
else
{
    var righe = Righe.ToList();
    var colonna = Math.Max(0, _dati.Giorni.ToList().IndexOf(_dati.Data));

    <p class="pn-conta">
        @(righe.Count == 1 ? "1 vigneto" : $"{righe.Count} vigneti"),
        @(DaFare(righe, colonna) is var n && n == 0 ? "nessuno da trattare" : n == 1 ? "1 da trattare" : $"{n} da trattare") @Etichetta(Giorno).ToLowerInvariant()
    </p>

    @* Computer: la settimana intera. *@
    <div class="pn-calendario solo-desktop">
        <table>
            <thead>
                <tr>
                    <th scope="col" class="pn-fermo">Vigneto</th>
                    @foreach (var g in _dati.Giorni)
                    {
                        <th scope="col" class="@(g == _dati.Data ? "pn-scelto" : "")">@g.ToString("ddd d/M", It)</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var r in righe)
                {
                    <tr>
                        <th scope="row" class="pn-fermo">@r.Nome</th>
                        @for (var i = 0; i < r.Giorni.Count; i++)
                        {
                            var cella = r.Giorni[i];
                            <td class="@(i == colonna ? "pn-scelto" : "")">
                                @foreach (var p in cella.Pulsanti)
                                {
                                    <button type="button" class="pn-chip pn-@p.Stato" title="@string.Join("\n", p.Suggerimento.Where(s => s.Length > 0))"
                                            @onclick="() => Apri(r.Id, p.Id)">@RiepilogoOggi.Avversita(p.Testo)</button>
                                }
                            </td>
                        }
                    </tr>
                    @if (_aperto is { } a && a.Vigneto == r.Id && Trova(r, a.Trattamento) is { } scelto)
                    {
                        <tr class="pn-dettaglio"><td colspan="@(r.Giorni.Count + 1)">@Dettaglio(r.Nome, scelto)</td></tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @* Telefono: il giorno scelto, una scheda per vigneto; la settimana in piccolo. *@
    <ul class="pn-schede solo-mobile">
        @foreach (var r in righe.OrderByDescending(r => r.Giorni[colonna].Pulsanti.Count > 0))
        {
            var oggiPulsanti = r.Giorni[colonna].Pulsanti;
            <li class="@(oggiPulsanti.Count == 0 ? "pn-scheda-vuota" : "")">
                <div class="pn-scheda-testa">
                    <strong>@r.Nome</strong>
                    <span class="pn-settimana" aria-label="La settimana">
                        @for (var i = 0; i < r.Giorni.Count; i++)
                        {
                            var stato = r.Giorni[i].Pulsanti.FirstOrDefault()?.Stato ?? "niente";
                            <span class="pn-punto pn-@stato @(i == colonna ? "pn-scelto" : "")" title="@_dati.Giorni[i].ToString("ddd d/M", It): @RiepilogoOggi.Stato(stato)"></span>
                        }
                    </span>
                </div>
                @if (oggiPulsanti.Count == 0)
                {
                    <small>Niente in programma</small>
                }
                else
                {
                    <div class="pn-chips">
                        @foreach (var p in oggiPulsanti)
                        {
                            <button type="button" class="pn-chip pn-@p.Stato" @onclick="() => Apri(r.Id, p.Id)">
                                @RiepilogoOggi.Avversita(p.Testo)<small>@RiepilogoOggi.Stato(p.Stato)</small>
                            </button>
                        }
                    </div>
                    @if (_aperto is { } a && a.Vigneto == r.Id && Trova(r, a.Trattamento) is { } scelto)
                    {
                        @Dettaglio(r.Nome, scelto)
                    }
                }
            </li>
        }
    </ul>
}

@code {
    [Parameter, EditorRequired] public PortaleUtenteDto Utente { get; set; } = default!;
    [Parameter] public StatoScrittureDto? Scritture { get; set; }
    [Parameter] public int? Azienda { get; set; }
    [Parameter] public string? Data { get; set; }

    private static readonly CultureInfo It = CultureInfo.GetCultureInfo("it-IT");
    private static readonly (string Valore, string Testo)[] Tipi = [("0", "Tutti"), ("100", "Peronospora e oidio"), ("200", "Altre avversità")];

    private TrattamentiGiornalieriDto? _dati;
    private string? _errore;
    private string _tipo = "0";
    private string _cerca = "";
    private (int Vigneto, int Trattamento)? _aperto;
    private string? _caricata;

    private static DateOnly Oggi => DateOnly.FromDateTime(DateTime.Now);

    private DateOnly Giorno => DateOnly.TryParseExact(Data, "yyyy-MM-dd", out var g) ? g : Oggi;

    private IEnumerable<RigaCalendarioTrattamentiDto> Righe => _dati is null ? [] :
        _dati.Vigneti.Where(r => _cerca.Length == 0 || r.Nome.Contains(_cerca, StringComparison.CurrentCultureIgnoreCase));

    protected override async Task OnParametersSetAsync()
    {
        var chiave = $"{Azienda}|{Giorno}|{_tipo}";
        if (_caricata != chiave)
        {
            _caricata = chiave;
            await CaricaAsync();
        }
    }

    private async Task CaricaAsync()
    {
        _errore = null;
        _dati = null;
        _aperto = null;
        var filtri = new Dictionary<string, string> { ["tipo"] = _tipo };
        if (Azienda is { } a) filtri["azienda"] = a.ToString(CultureInfo.InvariantCulture);
        var risposta = await Api.GetTrattamentiGiornalieriAsync(Utente.IdUtente, Giorno, filtri);
        if (risposta.Dati is null)
        {
            _errore = risposta.Errore is { } e ? $"Non riesco a leggere i trattamenti: {e}" : "Non riesco a leggere i trattamenti.";
            return;
        }

        _dati = risposta.Dati;
    }

    private async Task ScegliTipoAsync(string tipo)
    {
        _tipo = tipo;
        _caricata = $"{Azienda}|{Giorno}|{_tipo}";
        await CaricaAsync();
    }

    private void Apri(int vigneto, int trattamento) =>
        _aperto = _aperto is { } a && a.Vigneto == vigneto && a.Trattamento == trattamento ? null : (vigneto, trattamento);

    private static PulsanteTrattamentoDto? Trova(RigaCalendarioTrattamentiDto r, int id) =>
        r.Giorni.SelectMany(g => g.Pulsanti).FirstOrDefault(p => p.Id == id);

    private static int DaFare(List<RigaCalendarioTrattamentiDto> righe, int colonna) =>
        colonna < 0 ? 0 : righe.Count(r => r.Giorni[colonna].Pulsanti.Any(p => RiepilogoOggi.StatiDaFare.Contains(p.Stato)));

    private string Link(DateOnly giorno) => Nav.GetUriWithQueryParameter("data", giorno == Oggi ? null : giorno.ToString("yyyy-MM-dd"));

    private static string Etichetta(DateOnly giorno) =>
        giorno == Oggi ? "Oggi" : giorno == Oggi.AddDays(1) ? "Domani" : giorno == Oggi.AddDays(-1) ? "Ieri"
        : CultureInfo.GetCultureInfo("it-IT").TextInfo.ToTitleCase(giorno.ToString("dddd d MMMM", It));

    private RenderFragment Dettaglio(string vigneto, PulsanteTrattamentoDto p) => @<div class="pn-prodotti">
        <p><strong>@vigneto</strong> · @RiepilogoOggi.Stato(p.Stato) · @RiepilogoOggi.Avversita(p.Testo)</p>
        <ul>
            @foreach (var riga in p.Suggerimento.Where(s => s.Length > 0))
            {
                <li>@riga.Replace("Alle:", "Alle ore")</li>
            }
        </ul>
        <a href="portale/trattamenti">Apri e modifica nel Portale di oggi</a>
    </div>;
}

                    <h3 class="titolo-sezione">Meteo</h3>
                    @PannelloMeteo
                </div>
            </div>
        </section>

        @if (_avviso is not null || _avvisoSfondo || _messaggioPosizione is not null)
        {
            <div class="mappa-avvisi">
                @if (_messaggioPosizione is not null)

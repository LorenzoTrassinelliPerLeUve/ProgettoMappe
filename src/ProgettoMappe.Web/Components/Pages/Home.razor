@page "/"
@using Microsoft.Extensions.Logging
@using ProgettoMappe.Web.Avvisi
@using ProgettoMappe.Web.Dispositivi
@using ProgettoMappe.Web.Filtri
@using ProgettoMappe.Web.Meteo
@using ProgettoMappe.Web.Tematismi
@implements IAsyncDisposable
@inject AziendeApiClient AziendeApiClient
@inject IJSRuntime JsRuntime
@inject ILogger<Home> Logger

<PageTitle>Aziende</PageTitle>

<div class="contenitore">
    <header class="intestazione-pagina">
        <h1 class="titolo-pagina">Aziende</h1>
        <p class="sottotitolo">Seleziona un'azienda per aprire la mappa interattiva dei suoi vigneti.</p>
    </header>

    <div class="aziende-strumenti">
        <label class="aziende-ricerca">
            <span class="visualmente-nascosto">Cerca un'azienda</span>
            <input @ref="_casellaRicerca" type="search" placeholder="Cerca un'azienda per nome…" autocomplete="off"
                   @bind="_testo" @bind:event="oninput" />
        </label>
        <label class="aziende-ordine">
            Ordina per
            <select @bind="_ordine">
                <option value="@OrdineAziende.Nome">nome</option>
                <option value="@OrdineAziende.Punteggio">punteggio BIGOT</option>
                <option value="@OrdineAziende.Pioggia">pioggia (7 giorni)</option>
            </select>
        </label>
    </div>

    @if (_errore)
    {
        <div class="messaggio-errore" role="alert">
            <p>Non riesco a leggere le aziende da 4Grapes, riprova.</p>
            <button type="button" class="pulsante-principale" @onclick="CaricaAsync">Riprova</button>
        </div>
    }
    else if (_riepilogo is null)
    {
        <p class="aziende-stato" role="status">Carico le aziende…</p>
    }
    else if (_riepilogo.Aziende.Count == 0)
    {
        <p class="nota">Nessuna azienda trovata. Verificare il collegamento al database 4Grapes.</p>
    }
    else
    {
        var linguette = ElencoAziende.Linguette(_riepilogo.Aziende, _gruppi, _testo);
        var gruppo = _gruppi.FirstOrDefault(g => g.Id == _gruppoId);
        var aziende = ElencoAziende.Filtra(_riepilogo.Aziende, _testo, gruppo, _ordine, _pioggia);

        @if (linguette.Count > 1)
        {
            <div class="linguette-gruppi" role="group" aria-label="Gruppo">
                @foreach (var linguetta in linguette)
                {
                    <button type="button" class="linguetta" aria-pressed="@(linguetta.IdGruppo == gruppo?.Id ? "true" : "false")"
                            @onclick="() => _gruppoId = linguetta.IdGruppo">
                        @linguetta.Nome <span class="conteggio">@linguetta.Conteggio</span>
                    </button>
                }
            </div>
        }

        @if (_avvisi is not null && ElencoAvvisi.Riassunto(_avvisi) is { } riassunto)
        {
            <a class="avvisi-riassunto @(_avvisi.Avvisi.Count > 0 ? "con-avvisi" : "")" href="avvisi">
                <span>@riassunto</span>
                <span class="apri">Vedi gli avvisi <span aria-hidden="true">→</span></span>
            </a>
        }

        @if (!_riepilogo.BigotPronto)
        {
            <p class="nota aziende-nota">
                Punteggi BIGOT ancora in caricamento.
                <button type="button" class="riprova" @onclick="CaricaAsync">Aggiorna</button>
            </p>
        }

        @if (_statoMeteo is not null)
        {
            <p class="nota aziende-nota">
                @_statoMeteo
                <button type="button" class="riprova" @onclick="CaricaMeteoAsync">Riprova</button>
            </p>
        }

        @if (aziende.Count == 0)
        {
            <p class="nota aziende-nota">
                @NessunRisultato(gruppo is not null)
                @if (!string.IsNullOrWhiteSpace(_testo))
                {
                    <button type="button" class="riprova" @onclick="() => _testo = null">Cancella la ricerca</button>
                }
            </p>
        }
        else
        {
            <ul class="griglia-aziende">
                @foreach (var azienda in aziende)
                {
                    <li>
                        <a class="scheda-azienda" href="@($"mappa/{azienda.Id}")">
                            <span class="nome">@azienda.Nome@PuntinoFermi(azienda.Id)</span>
                            @CartellinoMeteo(azienda.Id)
                            <span class="numeri" title="@TitoloNumeri(azienda)">
                                @(azienda.NumeroVigneti == 1 ? "1 vigneto" : $"{azienda.NumeroVigneti} vigneti")
                                · @ElencoAziende.Ettari(azienda.Ettari)
                            </span>
                            @SchedaBigot(azienda)
                            <span class="apri">Apri la mappa <span aria-hidden="true">→</span></span>
                        </a>
                    </li>
                }
            </ul>
        }
    }
</div>

@code {
    private RiepilogoAziendeDto? _riepilogo;
    private Dictionary<int, MeteoAziendaDto>? _meteo;
    private Dictionary<int, decimal?>? _pioggia;
    private string? _statoMeteo;
    private List<GruppoDto> _gruppi = [];
    private bool _errore;
    private string? _testo;
    private int? _gruppoId;
    private OrdineAziende _ordine = OrdineAziende.Nome;
    private ElementReference _casellaRicerca;
    private IJSObjectReference? _module;

    private Dictionary<int, RiepilogoDispositiviDto>? _dispositivi;
    private AvvisiDto? _avvisi;

    protected override Task OnInitializedAsync() =>
        Task.WhenAll(CaricaAsync(), CaricaMeteoAsync(), CaricaDispositiviAsync(), CaricaAvvisiAsync());

    /// <summary>Quanti avvisi (task #70), a parte come il meteo: se non arrivano manca solo la riga degli avvisi.</summary>
    private async Task CaricaAvvisiAsync()
    {
        try
        {
            _avvisi = await AziendeApiClient.GetAvvisiAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning("Avvisi non disponibili ({Tipo}: {Messaggio})", ex.GetType().Name, ex.Message);
        }
    }

    /// <summary>
    /// Dispositivi fermi per azienda (task #69), a parte come il meteo: se non arrivano le schede restano
    /// senza puntino (è un avviso in più, non un dato della scheda).
    /// </summary>
    private async Task CaricaDispositiviAsync()
    {
        try
        {
            var dispositivi = await AziendeApiClient.GetDispositiviAsync();
            _dispositivi = dispositivi?.Aziende.ToDictionary(d => d.AziendaId) ?? [];
        }
        catch (Exception ex)
        {
            Logger.LogWarning("Dispositivi delle aziende non disponibili ({Tipo}: {Messaggio})", ex.GetType().Name, ex.Message);
        }
    }

    /// <summary>Un puntino rosso accanto al nome se l'azienda ha stazioni o trappole ferme da oltre 10 giorni.</summary>
    private RenderFragment PuntinoFermi(int aziendaId) => __builder =>
    {
        if (_dispositivi?.GetValueOrDefault(aziendaId) is { Fermi: > 0 } d)
        {
            var testo = TestiDispositivi.Fermi(d.Fermi);
            <span class="puntino-fermi" role="img" aria-label="@testo" title="@testo"></span>
        }
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // Fuoco sulla ricerca solo sul computer: sul telefono aprirebbe la tastiera sopra le schede.
        try
        {
            _module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/aziende.js");
            await _module.InvokeVoidAsync("fuocoSuComputer", _casellaRicerca);
        }
        catch (JSDisconnectedException)
        {
            // Pagina chiusa nel frattempo.
        }
    }

    /// <summary>Api o 4Grapes non raggiungibili: un messaggio e "Riprova" invece della pagina rotta.</summary>
    private async Task CaricaAsync()
    {
        _errore = false;
        _riepilogo = null;
        var gruppi = CaricaGruppiAsync();
        try
        {
            _riepilogo = await AziendeApiClient.GetRiepilogoAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning("Riepilogo aziende non disponibile ({Tipo}: {Messaggio})", ex.GetType().Name, ex.Message);
            _errore = true;
        }

        _gruppi = await gruppi;
    }

    /// <summary>
    /// Meteo di tutte le aziende, a parte dal riepilogo: le schede compaiono subito e i cartellini
    /// quando arriva (la prima lettura da 4Grapes prende qualche secondo). Se non arriva le schede
    /// restano, senza cartellino, con una nota.
    /// </summary>
    private async Task CaricaMeteoAsync()
    {
        _statoMeteo = null;
        try
        {
            var meteo = await AziendeApiClient.GetMeteoAsync();
            _meteo = meteo?.Aziende.ToDictionary(m => m.AziendaId) ?? [];
            _pioggia = _meteo.ToDictionary(m => m.Key, m => m.Value.Pioggia);
        }
        catch (Exception ex)
        {
            Logger.LogWarning("Meteo delle aziende non disponibile ({Tipo}: {Messaggio})", ex.GetType().Name, ex.Message);
            _statoMeteo = "Meteo non disponibile al momento.";
        }
    }

    /// <summary>«7 gg: 42 mm · peronospora alta» sotto il nome; niente finché il meteo non è arrivato.</summary>
    private RenderFragment CartellinoMeteo(int aziendaId) => __builder =>
    {
        if (_meteo is null)
        {
            return;
        }

        var meteo = _meteo.GetValueOrDefault(aziendaId) ?? new MeteoAziendaDto(aziendaId, [], null, null, []);
        var alta = meteo.Infezioni.Any(i => i.Alta == true);
        <span class="cartellino-meteo @(meteo.Pioggia is null ? "vuoto" : "") @(alta ? "allerta" : "")" title="@TestiMeteo.TitoloCartellino(meteo)">
            @TestiMeteo.Cartellino(meteo)
        </span>
    };

    /// <summary>Senza gruppi la pagina funziona lo stesso: solo senza linguette.</summary>
    private async Task<List<GruppoDto>> CaricaGruppiAsync()
    {
        try
        {
            return await AziendeApiClient.GetGruppiAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning("Gruppi non disponibili per le linguette ({Tipo}: {Messaggio})", ex.GetType().Name, ex.Message);
            return [];
        }
    }

    private string NessunRisultato(bool conGruppo) => string.IsNullOrWhiteSpace(_testo)
        ? "Nessuna azienda in questo gruppo."
        : $"Nessuna azienda con «{_testo.Trim()}» nel nome{(conGruppo ? " in questo gruppo" : "")}.";

    private static string? TitoloNumeri(RiepilogoAziendaDto azienda)
    {
        var righe = new[]
        {
            azienda.VignetiSenzaSuperficie switch
            {
                0 => null,
                1 => "Un vigneto senza superficie registrata non è contato negli ettari",
                var n => $"{n} vigneti senza superficie registrata non sono contati negli ettari",
            },
            azienda.VignetiSoloPunto switch
            {
                0 => null,
                1 => "Un vigneto senza poligono (solo un punto) non è contato negli ettari",
                var n => $"{n} vigneti senza poligono (solo un punto) non sono contati negli ettari",
            },
        }.OfType<string>().ToList();
        return righe.Count == 0 ? null : string.Join("\n", righe);
    }

    private RenderFragment SchedaBigot(RiepilogoAziendaDto azienda) => __builder =>
    {
        var anno = _riepilogo?.AnnoBigot;
        if (_riepilogo is not { BigotPronto: true } || anno is null)
        {
            return;
        }

        if (azienda.PunteggioBigot is { } punteggio)
        {
            var classe = TematismiBigot.ClassePunteggio(punteggio);
            <span class="bigot" title="@($"Media di {azienda.VignetiConPunteggio} vigneti con tutti i {TematismiBigot.ParametriTotali} parametri nel {anno} (classe {classe.Etichetta})")">
                <span class="pallino" style="background-color: @classe.Colore" aria-hidden="true"></span>
                BIGOT @anno: <strong>@ElencoAziende.Punteggio(punteggio)</strong>
            </span>
        }
        else
        {
            <span class="bigot vuoto">BIGOT @anno: nessun vigneto con tutti i parametri</span>
        }
    };

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}

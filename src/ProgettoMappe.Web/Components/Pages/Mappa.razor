@page "/mappa/{AziendaId:int}"
@using Microsoft.Extensions.Options
@using ProgettoMappe.Web.Options
@using ProgettoMappe.Web.Tematismi
@using ProgettoMappe.Web.Filtri
@using ProgettoMappe.Web.Formati
@using ProgettoMappe.Web.Meteo
@using System.Globalization
@using System.Net
@using System.Text.Json
@using Microsoft.Extensions.Logging
@inject VignetiApiClient VignetiApiClient
@inject ILogger<Mappa> Logger
@inject AziendeApiClient AziendeApiClient
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime
@inject IOptions<MapOptions> MapOptionsAccessor
@inject ConfigurazioneMappa Configurazione
@inject IOptions<PortaleFourGrapesOptions> PortaleAccessor
@inject CatalogoTematismi Catalogo
@implements IAsyncDisposable

<PageTitle>Mappa vigneti</PageTitle>

<div id="@($"{_mapElementId}-layout")" class="mappa-layout">
    @* Su desktop è la barra laterale; su mobile un pannello dal basso, trascinabile dalla sua
       intestazione (data-foglio, vedi collegaFogli in mappa.js e app.css). *@
    <aside id="@($"{_mapElementId}-pannello")" class="vigneti-list @(_pannelloAperto ? "aperto" : "")" aria-label="Filtri e vigneti" data-foglio>
        <div class="pannello-intestazione solo-mobile" data-maniglia>
            <span class="titolo-sezione">Filtri e vigneti</span>
            <button type="button" class="chiudi" aria-label="Chiudi pannello" data-chiudi @onclick="() => _pannelloAperto = false">×</button>
        </div>
        <section class="scheda ricerca" role="search">
            <label for="@($"{_mapElementId}-cerca")" class="titolo-sezione">Cerca</label>
            <input id="@($"{_mapElementId}-cerca")" type="search" autocomplete="off" spellcheck="false" enterkeyhint="search" data-fuoco
                   placeholder="Azienda, vigna o vigneto" role="combobox" aria-autocomplete="list"
                   aria-expanded="@(_risultatiRicerca.Count > 0)" aria-controls="@($"{_mapElementId}-risultati")"
                   aria-activedescendant="@(_risultatiRicerca.Count > 0 ? IdRisultato(_risultatoAttivo) : null)"
                   @bind="TestoRicerca" @bind:event="oninput" @bind:after="AggiornaRicerca" @onkeydown="TastoRicercaAsync" />
            @if (_risultatiRicerca.Count > 0)
            {
                <ul id="@($"{_mapElementId}-risultati")" class="risultati-ricerca" role="listbox" aria-label="Risultati">
                    @for (var i = 0; i < _risultatiRicerca.Count; i++)
                    {
                        var risultato = _risultatiRicerca[i];
                        var indice = i;
                        <li id="@IdRisultato(indice)" role="option" aria-selected="@(indice == _risultatoAttivo)"
                            class="@(indice == _risultatoAttivo ? "attivo" : "")">
                            <button type="button" tabindex="-1" @onclick="() => ScegliRisultatoAsync(risultato)">
                                <span class="tipo">@EtichettaTipo(risultato.Tipo)</span>
                                <span class="nome">@risultato.Nome</span>
                                @if (risultato.Dettaglio is not null)
                                {
                                    <span class="dettaglio">@risultato.Dettaglio</span>
                                }
                            </button>
                        </li>
                    }
                </ul>
            }
            else if (RicercaMappa.Normalizza(TestoRicerca).Length >= RicercaMappa.LettereMinime)
            {
                <p class="nota">Nessun risultato@(_aziende is null ? " (elenco aziende non ancora disponibile)" : "").</p>
            }
        </section>

        <section class="scheda elenco-vigneti">
            <h2 class="titolo-sezione">
                Vigneti
                @if (_vigneti is { Count: > 0 })
                {
                    <span class="contatore">@_vignetiFiltrati.Count@(_vignetiFiltrati.Count != _vigneti.Count ? $" / {_vigneti.Count}" : "")</span>
                }
            </h2>
            @if (_vigneti is { Count: > 1 })
            {
                <label class="ordina">
                    Ordina per
                    <select @bind="Ordine" @bind:after="OrdineCambiato">
                        @foreach (var ordine in Enum.GetValues<OrdineElenco>())
                        {
                            <option value="@ordine" disabled="@(ordine == OrdineElenco.Valore && TematismoAttivo is null)">@ElencoVigneti.Etichetta(ordine)</option>
                        }
                    </select>
                </label>
            }
            @if (_erroreVigneti is not null)
            {
                <p class="nota">Vigneti non disponibili.</p>
            }
            else if (_vigneti is null)
            {
                <p class="nota">Carico i vigneti…</p>
            }
            else if (_vigneti.Count == 0)
            {
                <p class="nota">Nessun vigneto trovato per questa azienda.</p>
            }
            else if (_vignetiFiltrati.Count == 0)
            {
                <p class="nota">Nessun vigneto corrisponde ai filtri.</p>
            }
            else
            {
                @* data-vigneto: il passaggio del mouse evidenzia il poligono (vedi collegaEvidenzaElenco in mappa.js). *@
                <ul>
                    @foreach (var voce in _vociElenco)
                    {
                        var vigneto = voce.Vigneto;
                        <li id="@IdVoceElenco(vigneto.Id)" data-vigneto="@vigneto.Id" class="@(vigneto.Id == _vignetoSelezionatoId ? "selezionato" : "")">
                            <button type="button" @onclick="() => SelezionaVignetoAsync(vigneto.Id)">
                                <span class="riga">
                                    <span class="nome">@vigneto.Nome</span>
                                    @if (voce.Valore is { } valore)
                                    {
                                        <span class="valore">@CampioneColore(valore.Colore)@valore.Testo</span>
                                    }
                                </span>
                                <span class="dettaglio">@string.Join(" · ", new[] { voce.Vitigno, voce.Superficie, vigneto.SoloPunto ? "solo punto" : null }.OfType<string>())</span>
                                @if (vigneto.GeometriaNonAttendibile)
                                {
                                    <span class="dettaglio avviso">geometria non attendibile</span>
                                }
                            </button>
                        </li>
                    }
                </ul>
            }
        </section>

        <section class="scheda riquadro tematismo-controlli filtri">
            <h2 class="titolo-sezione">
                <button type="button" class="apri-chiudi" aria-expanded="@(!FiltriChiusi)" @onclick="CommutaFiltri">
                    Filtri
                    @if (FiltriChiusi && FiltriAttivi > 0)
                    {
                        <span class="contatore">@FiltriAttivi attivi</span>
                    }
                    <span class="freccia" aria-hidden="true">@(FiltriChiusi ? "▸" : "▾")</span>
                </button>
            </h2>
            @if (!FiltriChiusi)
            {
                <label>
                    Gruppo
                    <select @bind="GruppoFiltro" @bind:after="GruppoCambiato" disabled="@(_gruppi is null || _aziende is null)">
                        <option value="">Tutti i gruppi</option>
                        @foreach (var gruppo in _gruppi ?? [])
                        {
                            @* selected anche qui: il gruppo può arrivare dal link prima delle opzioni. *@
                            <option value="@gruppo.Id" selected="@(gruppo.Id.ToString(CultureInfo.InvariantCulture) == GruppoFiltro)">@FiltriAziende.Etichetta(gruppo, FiltriAziende.DelGruppo(_aziende ?? [], gruppo).Count)</option>
                        }
                    </select>
                </label>
                <label>
                    Azienda
                    <select value="@AziendaId" @onchange="CambiaAzienda" disabled="@(_aziende is null)">
                        @if (_aziende is null)
                        {
                            <option value="@AziendaId">@(_erroreAziende ? "Elenco non disponibile" : "Caricamento…")</option>
                        }
                        else
                        {
                            @* selected sull'opzione (non solo value sul select): le opzioni arrivano dopo il primo render. *@
                            @foreach (var azienda in AziendeVisibili)
                            {
                                <option value="@azienda.Id" selected="@(azienda.Id == AziendaId)">@azienda.Nome</option>
                            }
                        }
                    </select>
                </label>
                @if (_erroreAziende)
                {
                    <p class="nota">
                        Non riesco a leggere le aziende da 4Grapes.
                        <button type="button" class="riprova" @onclick="RiprovaElencoAziende">Riprova</button>
                    </p>
                }
                <label>
                    Vigna
                    <select @bind="VignaFiltro" @bind:after="FiltriCambiatiAsync" disabled="@(_vigneti is null)">
                        <option value="">Tutte (@(_vigneti?.Count ?? 0))</option>
                        @foreach (var vigna in _opzioniVigne)
                        {
                            <option value="@vigna.Id">@vigna.Nome (@vigna.Conteggio)</option>
                        }
                    </select>
                </label>
                <label>
                    Vitigno
                    <select @bind="VitignoFiltro" @bind:after="FiltriCambiatiAsync" disabled="@(_vigneti is null)">
                        <option value="">Tutti</option>
                        @foreach (var vitigno in _opzioniVitigni)
                        {
                            <option value="@vitigno.Id">@vitigno.Nome (@vitigno.Conteggio)</option>
                        }
                    </select>
                </label>
                @* Vigneti senza poligono in 4Grapes, sulla mappa come pallini: solo se l'azienda ne ha. *@
                @if (VignetiSoloPunto > 0)
                {
                    <label class="casella">
                        <input type="checkbox" @bind="MostraSoloPunto" @bind:after="FiltriCambiatiAsync" />
                        Vigneti senza poligono (@VignetiSoloPunto)
                    </label>
                }
            }
        </section>

        @* Sul telefono gli stessi comandi stanno nel pannello «Mappe tematiche» dal basso. *@
        <section class="scheda riquadro tematismo-controlli solo-desktop">
            <h2 class="titolo-sezione">
                <button type="button" class="apri-chiudi" aria-expanded="@(!TemiChiusi)" @onclick="CommutaTemi">
                    Mappe tematiche
                    @if (TemiChiusi && TematismoAttivo is { } temaChiuso)
                    {
                        <span class="contatore">@temaChiuso.Nome</span>
                    }
                    <span class="freccia" aria-hidden="true">@(TemiChiusi ? "▸" : "▾")</span>
                </button>
            </h2>
            @if (!TemiChiusi)
            {
                @ControlliTematismo
            }
        </section>

        @* Meteo dell'azienda (task #67): per azienda, non sui poligoni. Sul telefono sta nel pannello «Mappe tematiche». *@
        <section class="scheda riquadro meteo-azienda solo-desktop" aria-label="Meteo">
            <h2 class="titolo-sezione">Meteo</h2>
            @PannelloMeteo
        </section>
    </aside>

    <div class="mappa-area">
        <div id="@_mapElementId" class="mappa"></div>

        @* Mai una mappa vuota muta: o si sta caricando, o si dice perché non ci sono vigneti. *@
        @if (_erroreVigneti is not null)
        {
            <div class="mappa-stato errore" role="alert">
                <p>@_erroreVigneti</p>
                <button type="button" class="pulsante-principale" @onclick="RiprovaAsync">Riprova</button>
            </div>
        }
        else if (_vigneti is null)
        {
            <div class="mappa-stato" role="status">
                <p>Carico i vigneti…</p>
            </div>
        }

        @* Sul telefono una riga sola: Filtri, Mappa/Satellite, «⋯» (con dentro 3D e Inquadra). *@
        <div class="mappa-controlli">
            @* data-apre-foglio: mappa.js apre il pannello e la tastiera della ricerca nel tocco stesso (vedi collegaFogli). *@
            <button type="button" class="solo-mobile apri-pannello" aria-expanded="@_pannelloAperto"
                    aria-controls="@($"{_mapElementId}-pannello")" data-apre-foglio="@($"{_mapElementId}-pannello")"
                    aria-label="Filtri" @onclick="CommutaPannello">
                ☰ <span class="etichetta">Filtri</span>
                @if (_vigneti is { Count: > 0 })
                {
                    <span class="contatore">@_vignetiFiltrati.Count</span>
                }
            </button>
            <div class="gruppo-pulsanti tipo-mappa" role="group" aria-label="Tipo di mappa">
                <button type="button" class="@(_satellite ? "" : "attivo")" aria-pressed="@(!_satellite)"
                        @onclick="() => ImpostaSatelliteAsync(false)">Mappa</button>
                <button type="button" class="@(_satellite ? "attivo" : "")" aria-pressed="@_satellite"
                        disabled="@(_imageryId is null)" @onclick="() => ImpostaSatelliteAsync(true)">Satellite</button>
                <button type="button" class="solo-desktop @(_terreno ? "attivo" : "")" aria-pressed="@_terreno"
                        disabled="@(Configurazione.TerrainId is null)" @onclick="CommutaTerrenoAsync">3D</button>
            </div>
            <button type="button" class="leggero solo-desktop" disabled="@(NienteDaInquadrare)"
                    title="Torna a vedere tutti i vigneti dell'elenco" @onclick="InquadraAsync">Inquadra</button>
            @* Sul telefono solo il mirino, nella riga dei pulsanti; sul computer anche la scritta. *@
            <button type="button" class="leggero dove-sono @(_posizioneAttiva ? "attivo" : "")" aria-pressed="@_posizioneAttiva"
                    aria-label="Dove sono" title="@(_posizioneAttiva ? "Smetti di seguire la tua posizione" : "Mostra dove sei sulla mappa")"
                    @onclick="CommutaPosizioneAsync">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <circle cx="12" cy="12" r="7" /><circle cx="12" cy="12" r="2.5" fill="currentColor" stroke="none" />
                    <path d="M12 2v3M12 19v3M2 12h3M19 12h3" />
                </svg>
                <span class="solo-desktop">Dove sono</span>
            </button>
            @* Azioni sui dati, separate dagli stili e leggere: un menu (lo chiude mappa.js, vedi collegaMenu). *@
            <details class="menu-azioni" data-menu>
                <summary class="@(_linkCopiato == "mappa" ? "attivo" : "")" aria-label="Azioni">
                    @if (_linkCopiato == "mappa")
                    {
                        <span class="solo-desktop">Link copiato </span>@("✓")
                    }
                    else
                    {
                        @("⋯")<span class="solo-desktop"> Azioni</span>
                    }
                </summary>
                <div class="menu-voci">
                    <button type="button" class="solo-mobile @(_terreno ? "attivo" : "")" aria-pressed="@_terreno"
                            disabled="@(Configurazione.TerrainId is null)" @onclick="CommutaTerrenoAsync">
                        Rilievo 3D@(_terreno ? " ✓" : "")
                    </button>
                    <button type="button" class="solo-mobile" disabled="@(NienteDaInquadrare)" @onclick="InquadraAsync">
                        Inquadra tutti i vigneti
                    </button>
                    @* La copia la fa mappa.js nel click stesso (Safari/iOS la permettono solo lì): vedi collegaCopiaLink. *@
                    <button type="button" data-copia-link="mappa"
                            title="Copia l'indirizzo di questa vista: chi lo apre vede la stessa mappa">Copia link</button>
                    @* Anche l'immagine la fa mappa.js nel click (iOS apre una scheda solo lì): vedi collegaSalvaImmagine. *@
                    @if (_erroreVigneti is null && NomeAzienda is { } aziendaImmagine)
                    {
                        <button type="button" data-salva-immagine="@ImmagineMappa.ComeJson(DatiImmagine(aziendaImmagine))"
                                title="Scarica un'immagine PNG di questa vista, con la legenda">Salva immagine</button>
                    }
                    @if (_erroreVigneti is null && _vignetiFiltrati.Any(v => v.HaGeometria))
                    {
                        var daScaricare = _vignetiFiltrati.Count(v => v.HaGeometria);
                        var senzaGeometria = _vignetiFiltrati.Count - daScaricare;
                        <p class="menu-titolo">Scarica @(FiltroAttivo ? "i vigneti filtrati" : "tutti i vigneti") (@daScaricare)</p>
                        @foreach (var formato in EsportazioneVigneti.Formati)
                        {
                            <a href="@LinkEsportazione(formato.Id)" download>@formato.Nome</a>
                        }
                        <p class="nota">
                            WGS84, con vigna, vitigno, superficie@(Anno is { } annoFile ? $", indice BIGOT, rischi e vigoria {annoFile}" : ""), potenziale idrico@(Confronto && TematismoAttivo is { } temaFile ? $", variazione di {temaFile.Nome} {AnnoDa} → {Anno}" : "").
                            @if (_vignetiFiltrati.Any(v => v.SoloPunto))
                            {
                                @(" I vigneti senza poligono sono uno strato a parte di punti.")
                            }
                            @if (senzaGeometria > 0)
                            {
                                @($" {senzaGeometria} vigneti senza geometria non sono inclusi.")
                            }
                        </p>
                    }
                </div>
            </details>

            @if (Configurazione.ModalitaSviluppatore)
            {
                <select aria-label="Basemap (sviluppo)" value="@_basemapId" @onchange="CambiaBasemapAsync">
                    <option value="@IdStyleInterno">Interno (offline)</option>
                    @foreach (var basemap in Configurazione.DelRuolo(RuoloSorgente.Basemap))
                    {
                        <option value="@basemap.Id">@basemap.Nome</option>
                    }
                </select>
                <select aria-label="Imagery (sviluppo)" value="@_imageryId" @onchange="CambiaImageryAsync">
                    @foreach (var imagery in Configurazione.DelRuolo(RuoloSorgente.Imagery))
                    {
                        <option value="@imagery.Id">@imagery.Nome</option>
                    }
                </select>
            }
        </div>

        @* Colonna di destra sopra la mappa: scheda del vigneto in alto, legenda in basso (sopra i crediti);
           la scheda si accorcia per lasciare posto alla legenda, così non si coprono mai. *@
        <div class="mappa-destra">
            @if (_vignetoSelezionato is not null)
            {
                var sottotitolo = string.Join(" · ", new[] { _vignetoSelezionato.Vigna, NomeAzienda }.Where(s => !string.IsNullOrWhiteSpace(s)));
                var link4Grapes = PortaleFourGrapesOptions.Link(PortaleAccessor.Value.IndirizzoVigneto, _vignetoSelezionato.Id);
                var valoreTema = _valoriElenco?.GetValueOrDefault(_vignetoSelezionato.Id);
                @* Sul telefono un pannello dal basso: ridotto (nome, vitigno, valore del tematismo) o espanso
                   (tutto); si trascina dalla maniglia e dall'intestazione, giù fino a chiuderlo (vedi collegaFogli). *@
                <div class="info-panel" aria-label="Dettaglio vigneto" data-foglio data-espandibile>
                    <button type="button" class="info-maniglia solo-mobile" aria-label="Espandi o riduci la scheda" aria-expanded="false"
                            data-maniglia data-espandi></button>
                    <div class="info-intestazione" data-maniglia>
                        <div class="info-titoli">
                            <h2>@_vignetoSelezionato.Nome</h2>
                            @if (sottotitolo != "")
                            {
                                <p class="info-sottotitolo">@sottotitolo</p>
                            }
                        </div>
                        <button type="button" class="chiudi" aria-label="Chiudi dettaglio" data-chiudi @onclick="DeselezionaAsync">×</button>
                    </div>
                    <div class="info-riassunto solo-mobile">
                        <p>
                            @if (!string.IsNullOrWhiteSpace(_vignetoSelezionato.Varieta))
                            {
                                <span>@_vignetoSelezionato.Varieta</span>
                            }
                            @if (TematismoAttivo is { } temaRiassunto && valoreTema is not null)
                            {
                                <span class="valore-colore">@CampioneColore(valoreTema.Colore)@temaRiassunto.Nome: <strong>@valoreTema.Testo</strong></span>
                            }
                        </p>
                        <button type="button" class="info-espandi" data-espandi aria-expanded="false">
                            <span class="se-ridotta">Dettagli ▴</span><span class="se-espansa">Riduci ▾</span>
                        </button>
                    </div>
                    <dl class="info-dati">
                        @if (!string.IsNullOrWhiteSpace(_vignetoSelezionato.Varieta))
                        {
                            <dt>Vitigno</dt><dd>@_vignetoSelezionato.Varieta</dd>
                        }
                        <dt>Superficie</dt>
                        <dd class="@(_vignetoSelezionato.SuperficieEttari is null ? "nota" : null)">@FormatoSuperficie.Testo(_vignetoSelezionato.SuperficieEttari)</dd>
                        @if (_vignetoSelezionato.AnnoImpianto is { } annoImpianto)
                        {
                            <dt>Impianto</dt><dd>@annoImpianto</dd>
                        }
                    </dl>
                    <div class="info-azioni">
                        @if (link4Grapes is not null)
                        {
                            <a class="pulsante" href="@link4Grapes" target="_blank" rel="noopener noreferrer">Apri in 4Grapes</a>
                        }
                        @* Copia l'indirizzo, che contiene il vigneto: chi lo apre trova la scheda aperta (vedi collegaCopiaLink). *@
                        <button type="button" class="pulsante @(_linkCopiato == "scheda" ? "attivo" : "")" data-copia-link="scheda"
                                title="Copia il link a questa scheda">@(_linkCopiato == "scheda" ? "Copiato ✓" : "Copia link")</button>
                    </div>
                    @if (_vignetoSelezionato.GeometriaNonAttendibile)
                    {
                        <p class="nota">Geometria non attendibile: in 4Grapes il poligono è troppo grande per un vigneto, quindi non è mostrato sulla mappa.</p>
                    }
                    else if (!_vignetoSelezionato.HaGeometria)
                    {
                        <p class="nota">Geometria non disponibile</p>
                    }
                    else if (_vignetoSelezionato.SoloPunto)
                    {
                        <p class="nota">Solo punto: in 4Grapes il vigneto non ha il poligono, sulla mappa è un pallino. Non è contato negli ettari totali.</p>
                    }
                    @if (_sottovigneti?.Sottovigneti.Where(s => s.IdVigneto == _vignetoSelezionato.Id).ToList() is { Count: > 0 } sottovigneti)
                    {
                        @* I nomi arrivano da 4Grapes: Razor li scrive come testo. *@
                        <h3 class="titolo-sezione">Sottovigneti (@sottovigneti.Count)</h3>
                        <table class="valori-bigot sottovigneti">
                            @foreach (var s in sottovigneti)
                            {
                                <tr>
                                    <th>@s.Nome</th>
                                    <td class="@(s.SuperficieEttari is null ? "nota" : null)">@FormatoSuperficie.Breve(s.SuperficieEttari)@(s.HaGeometria ? "" : " · senza forma")</td>
                                </tr>
                            }
                        </table>
                        <p class="nota">Sulla mappa avvicinandosi: bordo tratteggiato dentro il vigneto, nome al tocco.</p>
                    }
                    else if (_statoSottovigneti is not null)
                    {
                        <p class="nota">@_statoSottovigneti</p>
                    }

                    @if (Confronto && TematismoAttivo is { } temaScheda && Anno is { } annoAl && AnnoDa is { } annoDal && RigheDi(temaScheda.Fonte) is { } righeConfronto)
                    {
                        var regolaScheda = Catalogo.Regola(temaScheda);
                        var confrontoScheda = ConfrontoBigot.Scheda(temaScheda, regolaScheda, righeConfronto, _vignetoSelezionato.Id, annoDal, annoAl);
                        <div class="confronto-scheda">
                            <p class="titolo-confronto">@confrontoScheda.Nome</p>
                            <p class="riga-confronto">
                                @if (confrontoScheda.Variazione is { } variazione)
                                {
                                    <span class="variazione" style="@($"--colore: {confrontoScheda.Colore}")">@variazione</span>
                                }
                                <span>@confrontoScheda.Testo</span>
                            </p>
                            @if (temaScheda.Id == "punteggio" && _indici is not null
                                 && ConfrontoBigot.ParametriCambiati(_indici, Catalogo.Regola, _vignetoSelezionato.Id, annoDal, annoAl) is { Count: > 0 } cambiati)
                            {
                                <p class="nota">Parametri cambiati di più:</p>
                                <ul class="parametri-cambiati">

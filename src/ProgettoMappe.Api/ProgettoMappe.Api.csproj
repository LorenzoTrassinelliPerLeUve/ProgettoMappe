<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>progettomappe-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="OpenIddict.Server.AspNetCore" Version="7.9.0" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="7.9.0" />
    <PackageReference Include="NetTopologySuite.IO.Esri.Shapefile" Version="1.2.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProgettoMappe.Domain\ProgettoMappe.Domain.csproj" />
    <ProjectReference Include="..\ProgettoMappe.Infrastructure\ProgettoMappe.Infrastructure.csproj" />
    <ProjectReference Include="..\ProgettoMappe.Contracts\ProgettoMappe.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Modelli HTML dei bollettini, copiati dalla cartella Email di 4GrapesAPI (task #280). -->
    <!-- WithCulture=false: «.IT.html» e «.EN.html» non sono risorse di una lingua (finirebbero in assembly satellite). -->
    <EmbeddedResource Include="Portale\ModelliBollettino\*.html" WithCulture="false"
                      LogicalName="ModelliBollettino.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>

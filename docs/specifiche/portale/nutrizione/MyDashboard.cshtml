@section Scripts {
    <script>
        var IdRaggruppamentoSelezionato = null;
        var IdClasseDocumentoSelezionato = null;

        var ajaxUrl = $("#TabellaDinamica").attr("data-url");

        var table = $("#TabellaDinamica").DataTable({
            stateSave: true,
            "oLanguage": { "sUrl": datatableLangFile },
            "bServerSide": true,
            "bProcessing": true,
            "searching": true,
            "paging": false,
            "ordering": false,
            "sAjaxSource": ajaxUrl,
            "fnServerParams": function (aoData) {
                aoData.push(
                    { "name": "Anno", "value": @Model.Anno },
                    { "name": "Periodo", "value": @Model.Periodo },
                    { "name": "IdRaggruppamento", "value": IdRaggruppamentoSelezionato },
                    { "name": "IdClasseDocumento", "value": IdClasseDocumentoSelezionato }
                );
            },
            "aoColumns": [
                { "sName": "0", "sClass": "text-center" },
                { "sName": "1", "sClass": "text-center"  },
                { "sName": "2", "sType": "string", "sClass": "text-center" },
                { "sName": "3", "sType": "string", "sClass": "text-center" },
                { "sName": "4", "sType": "string", "sClass": "text-center" },
                { "sName": "5", "sType": "string", "sClass": "text-center" },
                { "sName": "6", "sType": "string", "sClass": "text-center" },
                { "sName": "7", "sType": "string", "sClass": "text-center" },
                { "sName": "8", "sType": "string", "sClass": "text-center" },
                { "sName": "9", "bSortable": false, "sClass": "text-center"  }
            ],
            "fnCreatedRow": function (nRow, aData, iDataIndex) {
            },
            autoWidth: false,
            preDrawCallback: function () {

            },
            rowCallback: function (nRow) {

            },
            drawCallback: function (oSettings) {
                $('[data-toggle="tooltip"]').tooltip(
                    {
                        position: {
                            my: 'center bottom',
                            at: 'center top-5'
                        },
                        content: function (callback) {
                            callback($(this).prop('title').replace('|', '<br />'));
                        }
                    });
            }
        });

        $(".widget-chart").click(function () {
            if ($(this).attr('id') == "PromoAttive") {
                window.location.href = "@Url.Action("Lista", "Promo", new { IdListino = 0 })"
                return;
            }
            IdRaggruppamentoSelezionato = $(this).attr("id-raggruppamento");
            IdClasseDocumentoSelezionato = $(this).attr("id-classe-documento");
            table.ajax.reload();
            $("#BtnRimuoviFiltro").show();
            $("#TitoloTabella").text($(this).find(".titolo-box").text());
        });

        $("#BtnRimuoviFiltro").click(function () {
            IdRaggruppamentoSelezionato = null;
            IdClasseDocumentoSelezionato = null;
            table.ajax.reload();
            $("#BtnRimuoviFiltro").hide();
            $("#TitoloTabella").text("Ordini cliente");
        });

        $("#Anno").change(RicaricaPagina);
        $("#Periodo").change(RicaricaPagina);

        function RicaricaPagina() {
            //showLoading();
            $("#FormDashboard").submit();
        }


    </script>
}
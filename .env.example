# Esempio per docker-compose.yml (task #210). Copialo in .env e scrivi i valori veri SOLO lì:
# .env non va mai nel repository. Spiegazioni in docs/mappe/contenitori.md.

# Collegamento a 4Grapes (sola lettura). Vuoto = dati di esempio in memoria.
MAPPE_FOURGRAPES=Server=sqlserver.esempio,1433;Database=4Grapes;User Id=utente-di-esempio;Password=CAMBIAMI;TrustServerCertificate=True

# Chiave condivisa fra Web e Api (una stringa lunga a caso, uguale per tutti e due).
MAPPE_CHIAVE_API=CAMBIAMI-stringa-lunga-a-caso

# Login della mappa con gli utenti di 4Grapes. Se manca vale true; false solo per le prove in locale.
MAPPE_ACCESSO=false

# Indirizzo pubblico della mappa, usato nei collegamenti degli avvisi.
MAPPE_INDIRIZZO=https://mappe.esempio.it

# Reti da cui arriva il proxy (Traefik di Coolify), separate da ;. Vuoto in locale.
MAPPE_RETI_PROXY=10.0.0.0/8

# Pagina del vigneto nel portale 4Grapes, con {id}. Vuoto = pulsante nascosto.
MAPPE_PORTALE_VIGNETO=

# Cartella delle proposte «Carica in 4Grapes» (dentro il volume). Vuoto = spento.
MAPPE_CARTELLA_PROPOSTE=

# Porta del Web sul computer (solo per le prove in locale).
MAPPE_PORTA=8080

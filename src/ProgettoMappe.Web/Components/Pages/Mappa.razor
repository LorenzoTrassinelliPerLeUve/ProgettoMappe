    }

    /// <summary>Altro parametro: le voci della legenda cambiano, il filtro per voce decade.</summary>
    private async Task ParametroCambiatoAsync()
    {
        _classeFiltro = null;
        if (TematismoId == "")
        {
            AnnoDa = null; // senza parametro non c'è niente da confrontare
        }
        else if (TematismoAttivo is { SenzaAnno: false } tema && AnniDi(tema.Fonte) is { Count: > 0 } anni)
        {
            // Ogni fonte ha i suoi anni: se l'anno scelto non c'è, si passa a quello predefinito.
            if (Anno is not { } anno || !anni.Contains(anno))
            {
                Anno = TematismiBigot.AnnoPredefinito(anni, _annoCorrente);
            }
            if (AnnoDa is { } da && !anni.Contains(da))
            {
                AnnoDa = ConfrontoBigot.AnnoDaPredefinito(anni, Anno!.Value);
            }
        }
        await TematismoCambiatoAsync();
    }

    /// <summary>Anno o parametro: le voci restano le stesse, il filtro per voce si ricalcola sull'anno nuovo.</summary>
    private async Task TematismoCambiatoAsync()
    {
        await ApplicaFiltriAsync(adatta: false);
        AggiornaIndirizzo();
    }

    /// <summary>Clic su una voce della legenda: solo quei vigneti; di nuovo clic sulla stessa, tutti.</summary>
    private async Task ClasseLegendaAsync(int classe)
    {
        _classeFiltro = _classeFiltro == classe ? null : classe;
        await ApplicaFiltriAsync(adatta: false);
        AggiornaIndirizzo(); // il vigneto selezionato può essere uscito dal filtro
    }

    private sealed record VoceLegenda(int Classe, string Testo, string? Colore, string Css);

    private static IEnumerable<VoceLegenda> VociLegenda(Tematismo tema, bool confronto) =>
        (confronto ? ConfrontoBigot.Classi(tema) : tema.Classi).Select((c, i) => new VoceLegenda(i, c.Testo, c.Colore, ""))
            .Append(new VoceLegenda(TematismiBigot.ClasseNessunDato,
                confronto ? ConfrontoBigot.EtichettaNessunDato : TematismiBigot.EtichettaNessunDato, null, "nd"))
            .Append(new VoceLegenda(TematismiBigot.ClasseFuoriPerimetro,
                confronto ? ConfrontoBigot.EtichettaSenzaRiga(tema) : tema.EtichettaFuoriPerimetro, null, "fp"));

    /// <summary>Cursore degli anni: la posizione è l'indice nell'elenco crescente degli anni disponibili.</summary>
    private async Task CursoreAnnoAsync(ChangeEventArgs e, IReadOnlyList<int> anniCrescenti)
    {
        if (int.TryParse(e.Value?.ToString(), NumberStyles.None, CultureInfo.InvariantCulture, out var indice)
            && indice >= 0 && indice < anniCrescenti.Count)
        {
            await ScegliAnnoAsync(anniCrescenti[indice]);
        }
    }

    /// <summary>Tasti ◀ ▶ e cursore: la mappa si ricolora sui dati già caricati, nessuna richiesta.</summary>
    private async Task ScegliAnnoAsync(int? anno)
    {
        if (anno is { } a && a != Anno)
        {
            Anno = a;
            await TematismoCambiatoAsync();
        }
    }

    /// <summary>Confronto acceso/spento: le voci della legenda cambiano, il filtro per voce decade.</summary>
    private async Task ConfrontoCambiatoAsync(ChangeEventArgs e)
    {
        AnnoDa = e.Value is true && Anno is { } anno ? ConfrontoBigot.AnnoDaPredefinito(AnniCursore, anno) : null;
        await ParametroCambiatoAsync();
    }

    /// <summary>
    /// Filtri Vigna/Vitigno (a cascata): elenco, mappa e conteggi della legenda sui soli vigneti
    /// filtrati. adatta = true porta la camera sui vigneti filtrati.
    /// </summary>
    private async Task ApplicaFiltriAsync(bool adatta)
    {
        if (_vigneti is null)
        {
            return;
        }

        var vignaId = int.TryParse(VignaFiltro, out var vg) ? vg : (int?)null;
        _opzioniVitigni = FiltriVigneti.Vitigni(_vigneti, vignaId);
        if (int.TryParse(VitignoFiltro, out var vtCorrente) && _opzioniVitigni.All(o => o.Id != vtCorrente))
        {
            VitignoFiltro = ""; // vitigno non presente nella vigna scelta
        }

        var vitignoId = int.TryParse(VitignoFiltro, out var vt) ? vt : (int?)null;
        var filtrati = FiltriVigneti.Applica(_vigneti, vignaId, vitignoId);

        // La legenda conta i vigneti di Vigna/Vitigno; la voce scelta restringe poi elenco e mappa
        // ai soli vigneti sulla mappa (con geometria), così il contatore coincide col conteggio.
        var perJs = CalcolaTematismo(filtrati);
        if (_classificazione is null)
        {
            _classeFiltro = null;
        }
        _vignetiFiltrati = _classeFiltro is null
            ? filtrati
            : TematismiBigot.FiltraPerClasse(filtrati.Where(v => v.HaGeometria).ToList(), v => v.Id, _classificazione, _classeFiltro);
        var filtroAttivo = vignaId is not null || vitignoId is not null || _classeFiltro is not null;

        if (_vignetoSelezionatoId is { } selezionato && _vignetiFiltrati.All(v => v.Id != selezionato))
        {
            _vignetoSelezionato = null;
            _vignetoSelezionatoId = null;
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("selezionaVigneto", _mapElementId, null);
            }
        }

        if (_module is not null)
        {
            await _module.InvokeVoidAsync("impostaFiltroVigneti", _mapElementId,
                filtroAttivo ? _vignetiFiltrati.Select(v => v.Id).ToList() : null, adatta);
            await _module.InvokeVoidAsync("impostaTematismo", _mapElementId, perJs);
        }
    }

    /// <summary>
    /// Carica gli indici BIGOT dell'azienda. Se il server non li ha ancora in memoria (la vista
    /// 4Grapes impiega ~40 s) riprova ogni <see cref="AttesaIndici"/>, fino a un massimo di tentativi.
    /// </summary>
    private async Task CaricaIndiciAsync(int aziendaId, CancellationToken ct)
    {
        try
        {
            for (var tentativo = 1; tentativo <= TentativiIndici && !ct.IsCancellationRequested; tentativo++)
            {
                var risposta = await VignetiApiClient.GetIndiciBigotAsync(aziendaId, ct);
                if (ct.IsCancellationRequested)
                {
                    return;
                }
                if (risposta.Pronto)
                {
                    await InvokeAsync(async () =>
                    {
                        _indici = risposta.Indici;
                        _aggiornamentoBigot = risposta.Aggiornamento is { } aggiornamento
                            ? TematismiBigot.EtichettaAggiornamento(aggiornamento, DateTimeOffset.UtcNow, TematismiBigot.FusoItalia)
                            : null;
                        _anni = risposta.Indici.Select(r => r.Anno).Distinct().OrderByDescending(a => a).ToList();
                        _indiciPronti = true;
                        ApplicaAnniIniziali(FonteTematismo.Bigot);
                        // Parametro già scelto (dal link o prima di un cambio azienda): riapplicato sui nuovi dati.
                        await ApplicaFiltriAsync(adatta: false);
                        StateHasChanged();
                        AggiornaIndirizzo();
                    });
                    return;
                }

                await InvokeAsync(() => { _statoIndici = "Indici BIGOT in preparazione sul server…"; StateHasChanged(); });
                await Task.Delay(AttesaIndici, ct);
            }

            await InvokeAsync(() => { _statoIndici = "Indici BIGOT non disponibili al momento."; StateHasChanged(); });
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // Pagina chiusa o azienda cambiata durante il caricamento.
        }
        catch (Exception ex)
        {
            // Anche un timeout dell'HttpClient (TaskCanceledException senza ct annullato) finisce qui.
            Logger.LogWarning("Indici BIGOT non disponibili ({Tipo}: {Messaggio})", ex.GetType().Name, ex.Message);
            await InvokeAsync(() => { _statoIndici = "Indici BIGOT non raggiungibili."; StateHasChanged(); });
        }
    }

    /// <summary>
    /// Anno e confronto del link quando arrivano BIGOT o statistiche. L'anno si sceglie sugli anni
    /// della fonte del parametro (BIGOT se non c'è o è senza anno); se arriva prima l'altra fonte se ne
    /// usa intanto un anno, poi lo si corregge. Il confronto vale solo sugli anni della sua fonte.
    /// </summary>
    private void ApplicaAnniIniziali(FonteTematismo arrivata)
    {
        var tema = Catalogo.Trova(TematismoId);
        var fonteAnno = tema is { SenzaAnno: false } ? tema.Fonte : FonteTematismo.Bigot;
        var definitiva = FontePronta(fonteAnno);
        var anni = AnniDi(definitiva ? fonteAnno : arrivata);

        if (_annoDaLink is { } annoLink && anni.Contains(annoLink))
        {
            Anno = annoLink;
        }
        else if (anni.Count > 0 && (Anno is null || (definitiva && !anni.Contains(Anno.Value))))
        {
            Anno = TematismiBigot.AnnoPredefinito(anni, _annoCorrente);
        }

        if (definitiva)
        {
            _annoDaLink = null;
        }

        if (tema is null || tema.SenzaAnno || FontePronta(tema.Fonte))
        {
            AnnoDa = tema is { SenzaAnno: false } && _confrontoDaLink is { } daLink && AnniDi(tema.Fonte).Contains(daLink) ? daLink : AnnoDa;
            _confrontoDaLink = null;
        }
    }

    /// <summary>Carica rischi, vigoria e potenziale idrico dell'azienda; come gli indici, riprova se il server non è pronto.</summary>
    private async Task CaricaStatisticheAsync(int aziendaId, CancellationToken ct)
    {
        try
        {
            for (var tentativo = 1; tentativo <= TentativiIndici && !ct.IsCancellationRequested; tentativo++)
            {
                var risposta = await VignetiApiClient.GetStatisticheAsync(aziendaId, ct);
                if (ct.IsCancellationRequested)
                {
                    return;
                }
                if (risposta.Pronto)
                {
                    await InvokeAsync(async () =>
                    {
                        _statistiche = risposta;
                        _aggiornamentoStatistiche = risposta.Aggiornamento is { } aggiornamento
                            ? TematismiBigot.EtichettaAggiornamento(aggiornamento, DateTimeOffset.UtcNow, TematismiBigot.FusoItalia, "Rischi e vigoria aggiornati")
                            : null;
                        _statistichePronte = true;
                        ApplicaAnniIniziali(FonteTematismo.Rischi);
                        await ApplicaFiltriAsync(adatta: false);
                        StateHasChanged();
                        AggiornaIndirizzo();
                    });
                    return;
                }

                await InvokeAsync(() => { _statoStatistiche = "Rischi, vigoria e potenziale idrico in preparazione sul server…"; StateHasChanged(); });
                await Task.Delay(AttesaIndici, ct);
            }

            await InvokeAsync(() => { _statoStatistiche = "Rischi, vigoria e potenziale idrico non disponibili al momento."; StateHasChanged(); });
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // Pagina chiusa o azienda cambiata durante il caricamento.
        }
        catch (Exception ex)
        {
            Logger.LogWarning("Statistiche dei vigneti non disponibili ({Tipo}: {Messaggio})", ex.GetType().Name, ex.Message);
            await InvokeAsync(() => { _statoStatistiche = "Rischi, vigoria e potenziale idrico non raggiungibili."; StateHasChanged(); });
        }
    }

    private static readonly System.Collections.Concurrent.ConcurrentDictionary<string, byte> ValoriNonPrevistiSegnalati = new();

    /// <summary>
    /// Classi e conteggi della legenda per parametro e anno correnti, sui vigneti indicati; restituisce
    /// quello che serve alla mappa (null = nessun tematismo).
    /// </summary>
    private object? CalcolaTematismo(IReadOnlyList<VignetoDto> vigneti)
    {
        var tema = TematismoAttivo;
        _conteggi = [];
        _classificazione = null;

        if (tema is not null && (tema.SenzaAnno || Anno is not null) && RigheDi(tema.Fonte) is { } righe && _vigneti is not null)
        {
            var classificazione = Confronto && AnnoDa is { } annoDa && Anno is { } annoA
                ? ConfrontoBigot.Classifica(tema, righe, annoDa, annoA)
                : TematismiBigot.ClassiPerVigneto(tema, righe, Anno);
            var colori = (Confronto ? ConfrontoBigot.Classi(tema) : tema.Classi).Select(c => c.Colore).ToList();
            _classificazione = classificazione;
            foreach (var valore in classificazione.ValoriNonPrevisti)
            {
                // Una riga di log per valore e tematismo, non a ogni cambio di anno o azienda.
                if (ValoriNonPrevistiSegnalati.TryAdd($"{tema.Id}|{valore}", 0))
                {
                    Logger.LogWarning("Indici BIGOT: valore {Valore} di {Tematismo} non previsto dalla mappa, mostrato come \"Altro\"",
                        valore, tema.Nome);
                }
            }
            // Conteggi della legenda solo sui vigneti visibili sulla mappa (con geometria).
            _conteggi = TematismiBigot.Conteggi(classificazione, vigneti.Where(v => v.HaGeometria).Select(v => v.Id));
            // Alla mappa la classe di ogni vigneto, anche "nessun dato" (-1) e "fuori perimetro" (-2).
            var classi = _vigneti.Where(v => v.HaGeometria).DistinctBy(v => v.Id).ToDictionary(v => v.Id, v => classificazione.ClasseDi(v.Id));
            return new { colori, classi };
        }

        return null;
    }

    /// <summary>Quadratino col colore della voce di legenda; senza colore (valore vuoto) uno spazio della stessa larghezza.</summary>
    private static RenderFragment CampioneColore(string? colore) => __builder =>
    {
        <span class="campione @(colore is null ? "vuoto" : null)" style="@(colore is null ? null : $"background-color: {colore}")" aria-hidden="true"></span>
    };

    private string? NomeAzienda => _aziende?.FirstOrDefault(a => a.Id == AziendaId)?.Nome;

    private static string Testo(object? valore, string suffisso = "") => valore switch
    {
        null => "–",
        decimal d => d.ToString("0.##", CultureInfo.GetCultureInfo("it-IT")) + suffisso,
        string s when string.IsNullOrWhiteSpace(s) => "–",
        _ => valore + suffisso,
    };

    private string IdVoceElenco(int vignetoId) => $"{_mapElementId}-voce-{vignetoId}";

    private bool FiltroAttivo => VignaFiltro != "" || VitignoFiltro != "" || _classeFiltro is not null;

    /// <summary>«Scarica»: i vigneti dell'elenco (tutti, o solo i filtrati) con l'anno scelto (BIGOT, rischi, vigoria).</summary>
    private string LinkEsportazione(string formato) => EsportazioneVigneti.Link(AziendaId, formato,
        Anno, FiltroAttivo ? _vignetiFiltrati.Select(v => v.Id) : null);

    // Casella di ricerca (vedi Filtri/RicercaMappa): proposte dalla terza lettera, frecce e Invio per scegliere.
    private string TestoRicerca { get; set; } = "";
    private IReadOnlyList<RisultatoRicerca> _risultatiRicerca = [];
    private int _risultatoAttivo;

    private string IdRisultato(int indice) => $"{_mapElementId}-risultato-{indice}";

    private static string EtichettaTipo(TipoRisultato tipo) => tipo switch
    {
        TipoRisultato.Azienda => "Azienda",
        TipoRisultato.Vigna => "Vigna",
        _ => "Vigneto",
    };

    private void AggiornaRicerca()
    {
        _risultatiRicerca = RicercaMappa.Cerca(TestoRicerca, _aziende ?? [], _vigneti ?? [], AziendaId, NomeAzienda);
        _risultatoAttivo = 0;
    }

    private void SvuotaRicerca()
    {
        TestoRicerca = "";
        _risultatiRicerca = [];
        _risultatoAttivo = 0;
    }

    private async Task TastoRicercaAsync(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown" when _risultatiRicerca.Count > 0:
                _risultatoAttivo = (_risultatoAttivo + 1) % _risultatiRicerca.Count;
                break;
            case "ArrowUp" when _risultatiRicerca.Count > 0:
                _risultatoAttivo = (_risultatoAttivo - 1 + _risultatiRicerca.Count) % _risultatiRicerca.Count;
                break;
            case "Enter" when _risultatiRicerca.Count > 0:
                await ScegliRisultatoAsync(_risultatiRicerca[Math.Min(_risultatoAttivo, _risultatiRicerca.Count - 1)]);
                break;
            case "Escape":
                SvuotaRicerca();
                break;
        }
    }

    /// <summary>
    /// Azienda: si apre (se è già aperta si tolgono i filtri e si inquadra tutta). Vigna: diventa il
    /// filtro e la camera la inquadra. Vigneto: si tolgono i filtri che lo nascondono, la mappa lo
    /// centra e si apre la scheda.
    /// </summary>
    private async Task ScegliRisultatoAsync(RisultatoRicerca risultato)
    {
        SvuotaRicerca();
        switch (risultato.Tipo)
        {
            case TipoRisultato.Azienda when risultato.Id != AziendaId:
                ApriAzienda(risultato.Id);
                return;
            case TipoRisultato.Azienda:
                VignaFiltro = "";
                VitignoFiltro = "";
                await FiltriCambiatiAsync();
                _pannelloAperto = false;
                return;
            case TipoRisultato.Vigna:
                VignaFiltro = risultato.Id.ToString(CultureInfo.InvariantCulture);
                VitignoFiltro = "";
                await FiltriCambiatiAsync();
                _pannelloAperto = false;
                return;
            default:
                if (_vignetiFiltrati.All(v => v.Id != risultato.Id))
                {
                    VignaFiltro = "";
                    VitignoFiltro = "";
                    await ApplicaFiltriAsync(adatta: false);
                    AggiornaIndirizzo();
                }
                await SelezionaVignetoAsync(risultato.Id);
                if (_module is not null)
                {
                    await _module.InvokeVoidAsync("portaInVista", IdVoceElenco(risultato.Id));
                }
                return;
        }
    }

    /// <summary>
    /// Selezione dall'elenco: aggiorna lo stato Blazor e chiede al JS di evidenziare il vigneto
    /// e portarci la camera (il JS non richiama Blazor in questo percorso).
    /// </summary>
    private async Task SelezionaVignetoAsync(int vignetoId)
    {
        AggiornaSelezione(vignetoId);
        _pannelloAperto = false; // su mobile si torna alla mappa con la scheda del vigneto

        if (_module is not null)
        {
            await _module.InvokeVoidAsync("selezionaVigneto", _mapElementId, vignetoId);
        }
    }

    /// <summary>
    /// Richiamato dal JS quando l'utente clicca un vigneto sulla mappa: il JS ha già evidenziato
    /// il poligono, qui si aggiornano solo pannello ed elenco (nessuna chiamata a selezionaVigneto,
    /// quindi nessun movimento della camera e nessun loop).
    /// </summary>
    [JSInvokable]
    public async Task OnVignetoCliccato(int vignetoId)
    {
        AggiornaSelezione(vignetoId);
        StateHasChanged();

        if (_module is not null)
        {
            await _module.InvokeVoidAsync("portaInVista", IdVoceElenco(vignetoId));
        }
    }

    /// <summary>
    /// Richiamato dal JS quando una basemap è stata applicata (anche dopo un fallback): avviso è
    /// "riserva", "interno" oppure null. Non blocca nulla: i dati 4Grapes non dipendono dalla basemap.
    /// </summary>
    [JSInvokable]
    public void OnStatoBasemap(string basemapId, string? avviso)
    {
        _basemapId = basemapId;
        _avviso = avviso switch
        {
            "riserva" => AvvisoRiserva,
            "interno" => AvvisoInterno,
            _ => null,
        };
        StateHasChanged();
    }

    /// <summary>
    /// Richiamato dal JS quando le tessere di sfondo (basemap o satellite) smettono di arrivare
    /// (true) o tornano ad arrivare (false). Solo un avviso: vigneti e filtri non ne dipendono.
    /// </summary>
    [JSInvokable]
    public void OnSfondoNonRisponde(bool nonRisponde)
    {
        _avvisoSfondo = nonRisponde;
        StateHasChanged();
    }

    private async Task ImpostaSatelliteAsync(bool satellite)
    {
        _satellite = satellite && _imageryId is not null;
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("impostaImagery", _mapElementId, _satellite ? _imageryId : null);
        }
    }

    private async Task CommutaTerrenoAsync()
    {
        _terreno = !_terreno;
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("impostaTerreno", _mapElementId, _terreno);
        }
    }

    /// <summary>Solo modalità sviluppatore (benchmark): basemap scelta per provider.</summary>
    private async Task CambiaBasemapAsync(ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        if (_module is not null && !string.IsNullOrEmpty(id))
        {
            await _module.InvokeVoidAsync("impostaBasemap", _mapElementId, id);
        }
    }

    /// <summary>Solo modalità sviluppatore (benchmark): imagery scelta per provider.</summary>
    private async Task CambiaImageryAsync(ChangeEventArgs e)
    {
        _imageryId = e.Value?.ToString();
        if (_satellite)
        {
            await ImpostaSatelliteAsync(true);
        }
    }

    /// <summary>Chiusura della scheda: deseleziona senza muovere la camera.</summary>
    private async Task DeselezionaAsync()
    {
        _vignetoSelezionato = null;
        _vignetoSelezionatoId = null;
        AggiornaIndirizzo();
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("selezionaVigneto", _mapElementId, null);
        }
    }

    /// <summary>Vigneto selezionato per elenco e pannello informazioni; l'indirizzo lo segue (link alla scheda).</summary>
    private void AggiornaSelezione(int vignetoId)
    {
        _vignetoSelezionatoId = vignetoId;
        _vignetoSelezionato = _vigneti?.FirstOrDefault(v => v.Id == vignetoId);
        AggiornaIndirizzo();
    }

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        _ctsIndici?.Dispose();
        _cts.Dispose();
        _dotNetRef?.Dispose();

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("distruggiMappa", _mapElementId);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Il circuito Blazor è già stato chiuso (es. navigazione via o crash del circuito):
                // lato client non c'è più nulla da ripulire, né la mappa né il modulo JS.
            }
        }
    }
}

    private async Task UsaSuoloAsync(RigaConfigurazione r, double awc)
    {
        var c = (r.Calibrazione ?? new CalibrazioneBilancioDto(r.Id)) with { AwcMm = awc };
        await SalvaCalibrazioneAsync(r.Id, c);
        if (_esitiRiga.GetValueOrDefault(r.Id) is { Ok: true })
            _suoloAperto = null;
    }

    private async Task UsaAwcAsync(RigaConfigurazione r)
    {
        if (ConfigurazioneWeb.Numero(_suolo.Awc) is not { } awc)
        {
            _esito = new("Scrivi la riserva utile in mm (per esempio 150).", false);
            return;
        }
        await SalvaCalibrazioneAsync(r.Id, (r.Calibrazione ?? new CalibrazioneBilancioDto(r.Id)) with { AwcMm = awc });
        if (_esitiRiga.GetValueOrDefault(r.Id) is { Ok: true })
            _suoloAperto = null;
    }

    private async Task TogliSuoloAsync(RigaConfigurazione r)
    {
        await SalvaCalibrazioneAsync(r.Id, (r.Calibrazione ?? new CalibrazioneBilancioDto(r.Id)) with { AwcMm = null, ScheletroPerc = null });
        _suoloAperto = null;
    }

    private Task CopiaDaAsync(string? valore) => int.TryParse(valore, out var id) ? CopiaAsync(id) : Task.CompletedTask;

    /// <summary>«Riempi giù» / «Copia da»: stile e suolo/radici del vigneto agli altri scelti, in due salvataggi in blocco.</summary>
    private async Task CopiaAsync(int da)
    {
        if (_cv is not { } cv)
            return;
        var (stili, cal) = cv.Copia(da, _scelti, InizioAnno);
        if (stili.Count + cal.Count == 0)
        {
            _esito = new($"«{cv.Righe.First(r => r.Id == da).Nome}» non ha né stile né suolo scritti qui: niente da copiare.", false);
            return;
        }
        _salvo = true;
        try
        {
            if (await SalvaBloccoAsync(TipoStile, stili) && await SalvaBloccoAsync(TipoCalibrazione, cal))
            {
                var quanti = _scelti.Count(v => v != da);
                _esito = new($"Copiato da «{cv.Righe.First(r => r.Id == da).Nome}» a {ConfigurazioneVigneti.Quanti(quanti)}. Salvato ✓", true);
                foreach (var v in _scelti.Where(v => v != da))
                    _esitiRiga[v] = new("Salvato ✓", true);
                _scelti.Clear();
                await CaricaConfigurazioneAsync();
            }
        }
        finally
        {
            _salvo = false;
        }
    }

    /// <summary>Colonna «Irrigato»: il vigneto passa tutto nel gruppo scelto (0 = non irrigato).</summary>
    private Task SalvaGruppoAsync(RigaConfigurazione r, string? valore) => RigaAsync(r.Id, async () =>
    {
        var nuovo = int.TryParse(valore, out var s) ? s : 0;
        foreach (var q in _cv!.Conf.Quote.Where(q => q.Dati.IdVigneto == r.Id && q.Dati.IdSettore != nuovo).ToList())
            if (await SalvaAsync(TipoQuota, q.Dati, elimina: true) is null)
                return false;
        return nuovo == 0 || await SalvaAsync(TipoQuota, new QuotaBilancioDto(nuovo, r.Id, 100)) is not null;
    });

    private void FaiOra(string azione)
    {
        _esito = null;
        if (azione == "stile" || azione == "suolo")
        {
            _soloDaCompletare = true;
            Navigation.NavigateTo(Navigation.Uri.Split('#')[0] + "#vigneti");
        }
        else if (azione.StartsWith("impianto:") && int.TryParse(azione["impianto:".Length..], out var id))
            CambiaImpianto(id);
    }

    // ---------- percorso guidato dell'irrigazione ----------

    private void NuovoGruppo()
    {
        _passo = 1;
        _gruppo = 0;
        _vignetiGruppo.Clear();
        _nomeScritto = false;
        _nomeGruppo = _cv?.NomeProposto([]) ?? "Gruppo 1";
        _impianto = new();
    }

    private void CambiaImpianto(int idSettore)
    {
        _passo = 2;
        _gruppo = idSettore;
        _impianto = new();
        if (_cv?.Impianto(idSettore, _oggi) is { } i)
            _impianto = new ModuloImpianto
            {
                Tipologia = i.IdTipologiaImpianto is > 0 and var t ? t : 1,
                Distanza = i.DistanzaGocciolatoriM?.ToString("0.###", It), Ali = i.DistanzaAliM?.ToString("0.###", It),
                Portata = i.PortataLh?.ToString("0.###", It),
            };
        _nomeGruppo = _cv?.Conf.NomeSettore(idSettore) ?? "";
        Navigation.NavigateTo(Navigation.Uri.Split('#')[0] + "#irrigazione");
    }

    private void SceltaVignetoGruppo(int id, bool scelto)
    {
        if (scelto) _vignetiGruppo.Add(id); else _vignetiGruppo.Remove(id);
        if (!_nomeScritto && _cv is not null)
            _nomeGruppo = _cv.NomeProposto(_vignetiGruppo);
    }

    private RenderFragment Percorso(ConfigurazioneVigneti cv) => __builder =>
    {
        <ol class="bi-passi" aria-label="Passi">
            <li class="@(_passo == 1 ? "attivo" : "")">Quali vigneti si irrigano insieme?</li>
            <li class="@(_passo == 2 ? "attivo" : "")">Com'è l'impianto?</li>
            <li class="@(_passo == 3 ? "attivo" : "")">Aprite più gruppi insieme?</li>
        </ol>
        @switch (_passo)
        {
            case 1:
                <div class="bi-modulo bi-passo">
                    <strong>Quali vigneti si irrigano insieme? <span class="nota">Quelli che si bagnano aprendo la stessa valvola.</span></strong>
                    <ul class="bi-scelta-vigneti">
                        @foreach (var r in cv.Attivi)
                        {
                            <li><label><input type="checkbox" checked="@_vignetiGruppo.Contains(r.Id)" @onchange="e => SceltaVignetoGruppo(r.Id, e.Value is true)" />
                                @r.Nome @if (r.Gruppi.Count > 0) { <small class="nota">(ora in @cv.Irrigato(r))</small> }</label></li>
                        }
                    </ul>
                    <label>Nome del gruppo <input @bind="_nomeGruppo" @bind:after="() => _nomeScritto = true" maxlength="100" /></label>
                    <button type="button" class="pulsante-principale" disabled="@(_vignetiGruppo.Count == 0 || string.IsNullOrWhiteSpace(_nomeGruppo))"
                            @onclick="() => _passo = 2">Avanti</button>
                    <button type="button" class="pulsante" @onclick="() => _passo = 0">Annulla</button>
                </div>
                break;
            case 2:
                var (mm, testo, ok, salvabile) = ImpiantoGuidato.Controlla(_impianto.Tipologia, ConfigurazioneWeb.Numero(_impianto.Distanza),
                    ConfigurazioneWeb.Numero(_impianto.Ali), ConfigurazioneWeb.Numero(_impianto.Portata));
                var tipo = ImpiantoGuidato.Tipo(_impianto.Tipologia);
                <div class="bi-modulo bi-passo">
                    <strong>Com'è l'impianto di «@_nomeGruppo»?</strong>
                    <label>Tipo
                        <select @bind="_impianto.Tipologia">@foreach (var t in ImpiantoGuidato.Tipi) { <option value="@t.Tipologia">@t.Nome</option> }</select>
                    </label>
                    @* Solo i campi del tipo scelto, con le sue parole (proprietario, 27/11). *@
                    <label>@tipo.Distanza.Etichetta, @tipo.Distanza.Unita
                        <input @bind="_impianto.Distanza" @bind:event="oninput" inputmode="decimal" size="5" placeholder="@tipo.Distanza.Esempio" /></label>
                    <label>@tipo.Linee.Etichetta, @tipo.Linee.Unita
                        <input @bind="_impianto.Ali" @bind:event="oninput" inputmode="decimal" size="5" placeholder="@tipo.Linee.Esempio" /></label>
                    <label>@tipo.Portata.Etichetta, @tipo.Portata.Unita
                        <input @bind="_impianto.Portata" @bind:event="oninput" inputmode="decimal" size="5" placeholder="@tipo.Portata.Esempio" /></label>
                    <p class="bi-risultato @(testo is null ? "" : ok ? "bi-ok" : "bi-manca")" role="status">@(testo ?? "Scrivi distanze e portata: i mm all'ora li calcola il programma.")</p>
                    <button type="button" class="pulsante-principale" disabled="@(mm is null || !salvabile || _salvo)" @onclick="SalvaGruppoEImpiantoAsync">@(_salvo ? "Salvo…" : "Salva")</button>
                    @if (_gruppo == 0)
                    {
                        <button type="button" class="pulsante" @onclick="() => _passo = 1">Indietro</button>
                    }
                    <button type="button" class="pulsante" @onclick="() => _passo = 0">Annulla</button>
                </div>
                break;
            default:
                <div class="bi-modulo bi-passo">
                    <strong>Aprite più gruppi insieme? <span class="nota">Facoltativo: serve solo se una sola valvola, o un programma, apre più gruppi.</span></strong>
                    @Turni(cv)
                    <button type="button" class="pulsante-principale" @onclick="() => _passo = 0">Fatto</button>
                </div>
                break;
        }
    };

    private async Task SalvaGruppoEImpiantoAsync()
    {
        if (Azienda is not { } azienda || _cv is null)
            return;
        var gocc = ConfigurazioneWeb.Numero(_impianto.Distanza);
        var ali = ConfigurazioneWeb.Numero(_impianto.Ali);
        var portata = ConfigurazioneWeb.Numero(_impianto.Portata);
        var (tasso, testo, _, salvabile) = ImpiantoGuidato.Controlla(_impianto.Tipologia, gocc, ali, portata);
        if (tasso is null || !salvabile)
        {
            _esito = new(testo ?? "Scrivi distanze e portata.", false);
            return;
        }
        _salvo = true;
        try
        {
            var nuovo = _gruppo == 0;
            if (nuovo)
            {
                var voce = await SalvaAsync(TipoSettore, new SettoreBilancioDto(0, azienda, _nomeGruppo.Trim()));
                if (voce?.Dati?.Deserialize<SettoreBilancioDto>(ConfigurazioneWeb.Json) is not { } settore)
                    return;
                _gruppo = settore.IdSettore;
                foreach (var v in _vignetiGruppo)
                {
                    // Un vigneto sta in un gruppo solo: esce da quello di prima.
                    foreach (var q in _cv.Conf.Quote.Where(q => q.Dati.IdVigneto == v).ToList())
                        await SalvaAsync(TipoQuota, q.Dati, elimina: true);
                    if (await SalvaAsync(TipoQuota, new QuotaBilancioDto(_gruppo, v, 100)) is null)
                        return;
                }
            }
            if (await SalvaAsync(TipoImpianto, new ImpiantoBilancioDto(_gruppo, InizioAnno, null, _impianto.Tipologia, gocc, ali, portata, tasso)) is null)
                return;
            _esito = new($"Salvato il gruppo «{_nomeGruppo.Trim()}» con il suo impianto ✓", true);
            await CaricaConfigurazioneAsync();
            _passo = nuovo && _cv.Conf.Settori.Count > 1 ? 3 : 0;
        }
        finally
        {
            _salvo = false;
        }
    }

    private async Task TogliGruppoAsync(SettoreBilancioDto s)
    {
        if (_cv is null)
            return;
        _salvo = true;
        try
        {
            foreach (var q in _cv.Conf.Quote.Where(q => q.Dati.IdSettore == s.IdSettore).ToList())
                await SalvaAsync(TipoQuota, q.Dati, elimina: true);
            if (await SalvaAsync(TipoSettore, s, elimina: true) is not null)
                _esito = new($"Tolto il gruppo «{s.Nome}»: i suoi vigneti ora non sono irrigati.", true);
            await CaricaConfigurazioneAsync();
        }
        finally
        {
            _salvo = false;
        }
    }

    private RenderFragment Turni(ConfigurazioneVigneti cv) => __builder =>
    {
        var turni = cv.Turni();
        @if (turni.Count > 0)
        {
            <ul class="bi-gruppi">
                @foreach (var (t, gruppi) in turni)
                {
                    <li>Turno <strong>@t.Nome</strong>: apre @(gruppi.Count == 0 ? "nessun gruppo" : string.Join(", ", gruppi.Select(cv.Conf.NomeSettore)))
                        <button type="button" class="pulsante bi-piccolo" disabled="@(_login is null || _salvo)" @onclick="() => TogliTurnoAsync(t)">Togli</button></li>
                }
            </ul>
        }
        <div class="bi-turno-nuovo">
            <span>Gruppi aperti insieme:</span>
            @foreach (var s in cv.Conf.Settori)
            {
                var id = s.Dati.IdSettore;
                <label><input type="checkbox" checked="@_gruppiTurno.Contains(id)" @onchange="e => { if (e.Value is true) _gruppiTurno.Add(id); else _gruppiTurno.Remove(id); }" /> @s.Dati.Nome</label>
            }
            <label>Nome del turno <input @bind="_nomeTurno" maxlength="100" placeholder="@($"Turno {turni.Count + 1}")" /></label>
            <button type="button" class="pulsante" disabled="@(_login is null || _salvo || _gruppiTurno.Count < 2)" @onclick="SalvaTurnoAsync">Salva il turno</button>
        </div>
    };

    private async Task SalvaTurnoAsync()
    {
        if (Azienda is not { } azienda || _cv is null)
            return;
        var nome = string.IsNullOrWhiteSpace(_nomeTurno) ? $"Turno {_cv.Turni().Count + 1}" : _nomeTurno.Trim();
        _salvo = true;
        try
        {
            if ((await SalvaAsync(TipoShift, new ShiftBilancioDto(0, azienda, nome)))?.Dati?.Deserialize<ShiftBilancioDto>(ConfigurazioneWeb.Json) is not { } turno)
                return;
            foreach (var g in _gruppiTurno)
                if (await SalvaAsync(TipoSettoreShift, new SettoreShiftBilancioDto(turno.IdShift, g, InizioAnno, null)) is null)
                    return;
            _esito = new($"Salvato il turno «{nome}» ✓", true);
            _gruppiTurno.Clear();
            _nomeTurno = "";
            await CaricaConfigurazioneAsync();
        }
        finally
        {
            _salvo = false;
        }
    }

    private async Task TogliTurnoAsync(ShiftBilancioDto t)
    {
        _salvo = true;
        try
        {
            if (await SalvaAsync(TipoShift, t, elimina: true) is not null)
                _esito = new($"Tolto il turno «{t.Nome}».", true);
            await CaricaConfigurazioneAsync();
        }
        finally
        {
            _salvo = false;
        }
    }

    // ---------- Ho irrigato e diario ----------

    /// <summary>Prepara «Ho irrigato» sul gruppo (s…) o turno (h…), con ore e mm del consiglio di oggi.</summary>
    private void PreparaIrrigazione(string dove)
    {
        _irr = new ModuloIrrigazione { Dove = dove };
        if (dove.StartsWith('s') && int.TryParse(dove[1..], out var s) && _stato?.Settori.FirstOrDefault(x => x.IdSettore == s) is { } oggi)
        {
            _irr.Ore = oggi.IrrigazioneSuggeritaOre is > 0 and var o ? o.ToString("0.#", It) : null;
            _irr.Mm = _irr.Ore is null && oggi.IrrigazioneSuggeritaMm > 0 ? oggi.IrrigazioneSuggeritaMm.ToString("0", It) : null;
        }
        else if (dove.StartsWith('h') && int.TryParse(dove[1..], out var h) && _stato?.Shift.FirstOrDefault(x => x.IdShift == h) is { OreComando: > 0 } turno)
            _irr.Ore = turno.OreComando!.Value.ToString("0.#", It);
    }

    private RenderFragment HoIrrigato(ConfigurazioneVigneti cv) => __builder =>
    {
        <div class="bi-modulo bi-ho-irrigato">
            <strong>@(_irr.IdEvento == 0 ? "Registra un'irrigazione" : "Cambia l'irrigazione") <span class="nota">Ore e mm arrivano dal consiglio di oggi: correggili se serve.</span></strong>
            <label>Dove
                <select value="@_irr.Dove" @onchange="e => PreparaIrrigazione(e.Value as string ?? string.Empty)">
                    <option value="">— scegli il gruppo —</option>
                    @foreach (var s in cv.Conf.Settori) { <option value="@($"s{s.Dati.IdSettore}")">@s.Dati.Nome</option> }
                    @foreach (var t in cv.Conf.Shift) { <option value="@($"h{t.Dati.IdShift}")">turno @t.Dati.Nome</option> }
                </select>
            </label>
            <label>Giorno <input type="date" @bind="_irr.Data" /></label>
            <label>Ore <input @bind="_irr.Ore" inputmode="decimal" size="4" /></label>
            <label>oppure mm <input @bind="_irr.Mm" inputmode="decimal" size="4" /></label>
            <button type="button" class="pulsante-principale" disabled="@(_login is null || _salvo || _irr.Dove.Length == 0)" @onclick="SalvaIrrigazioneAsync">Fatto</button>
            @if (_irr.IdEvento != 0)
            {
                <button type="button" class="pulsante" @onclick="() => _irr = new()">Annulla</button>
            }
        </div>
    };

    private async Task SalvaIrrigazioneAsync()
    {
        var ore = ConfigurazioneWeb.Numero(_irr.Ore);
        var mm = ConfigurazioneWeb.Numero(_irr.Mm);
        int? settore = _irr.Dove.StartsWith('s') && int.TryParse(_irr.Dove[1..], out var s) ? s : null;
        int? shift = _irr.Dove.StartsWith('h') && int.TryParse(_irr.Dove[1..], out var h) ? h : null;
        if (settore is null && shift is null)
        {
            _esito = new("Scegli il gruppo.", false);
            return;
        }
        if (ConfigurazioneWeb.ControllaIrrigazione(ore, mm) is { } errore)
        {
            _esito = new(errore, false);
            return;
        }
        _salvo = true;
        try
        {
            if (await SalvaAsync(TipoIrrigazione, new IrrigazioneBilancioDto(_irr.IdEvento, Azienda!.Value, _irr.Data, settore, shift, ore, mm)) is null)
                return;
            _esito = new($"Registrata l'irrigazione del {_irr.Data.ToString("d/M", It)} ✓ Il bilancio la conta fra pochi secondi.", true);
            _irr = new();
            await CaricaConfigurazioneAsync();
        }
        finally
        {
            _salvo = false;
        }
    }

    private RenderFragment Diario(ConfigurazioneVigneti cv) => __builder =>
    {
        <h3>Le irrigazioni fatte</h3>
        @if (cv.Conf.Irrigazioni.Count == 0)
        {
            <p class="nota">Ancora nessuna.</p>
            return;
        }
        <table class="tabella-report bi-tabella bi-conf-tabella bi-diario">
            <thead><tr><th>Giorno</th><th>Dove</th><th>Ore</th><th>mm</th><th class="bi-modifica">Scritta da</th><th></th></tr></thead>
            <tbody>
                @foreach (var i in cv.Conf.Irrigazioni.Take(60))
                {
                    var d = i.Dati;
                    <tr>
                        <td>@d.Data.ToString("ddd d/M", It)</td>
                        <td>@(d.IdSettore is { } se ? cv.Conf.NomeSettore(se) : d.IdShift is { } sh ? "turno " + cv.Conf.NomeShift(sh) : "—")</td>
                        <td>@TestiBilancio.Numero(d.DurataOre, "0.#")</td>
                        <td class="@(ConfigurazioneWeb.IrrigazioneImplausibile(d.VolumeMm) ? "bi-oltre" : "")">@TestiBilancio.Numero(d.VolumeMm, "0")
                            @if (ConfigurazioneWeb.IrrigazioneImplausibile(d.VolumeMm)) { <small class="bi-manca">da controllare</small> }</td>
                        <td class="nota bi-modifica">@ConfigurazioneWeb.ModificaBreve(i)</td>
                        <td>
                            <button type="button" class="pulsante bi-piccolo" disabled="@(_login is null)" @onclick="() => ModificaIrrigazione(d)">Cambia</button>
                            <button type="button" class="pulsante bi-piccolo" disabled="@(_login is null || _salvo)" @onclick="() => TogliIrrigazioneAsync(d)">Togli</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    };

    private void ModificaIrrigazione(IrrigazioneBilancioDto d)
    {
        // Le ore restano se c'erano; i mm solo se sono stati scritti senza ore (con le ore li ricalcola il bilancio).
        _irr = new ModuloIrrigazione
        {
            IdEvento = d.IdEvento, Data = d.Data, Dove = d.IdSettore is { } s ? $"s{s}" : $"h{d.IdShift}",
            Ore = d.DurataOre?.ToString("0.##", It), Mm = d.DurataOre is > 0 ? null : d.VolumeMm?.ToString("0.#", It),
        };
        Navigation.NavigateTo(Navigation.Uri.Split('#')[0] + "#irrigato");
    }

    private async Task TogliIrrigazioneAsync(IrrigazioneBilancioDto d)
    {
        _salvo = true;
        try
        {
            if (await SalvaAsync(TipoIrrigazione, d, elimina: true) is not null)
                _esito = new($"Tolta l'irrigazione del {d.Data.ToString("d/M", It)}.", true);
            await CaricaConfigurazioneAsync();
        }
        finally
        {
            _salvo = false;
        }
    }
}

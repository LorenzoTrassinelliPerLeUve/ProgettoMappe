@page "/portale-nuovo"
@page "/portale-nuovo/{Gruppo}"
@page "/portale-nuovo/{Gruppo}/{Voce}"
@using ProgettoMappe.Web.Portale
@using ProgettoMappe.Web.Components.Portale.Nuovo
@inject PortaleApiClient Api
@inject NavigationManager Nav

@*
    Prototipo del Portale nuovo (task #387, fase 1; docs/specifiche/portale-ux/PROPOSTA.md): menù per lavoro da fare
    (Web/Portale/MenuPortaleNuovo), l'azienda scelta una volta sola in cima e tenuta nell'indirizzo, «Oggi» come pagina
    iniziale, Trattamenti rifatti. Le altre sezioni si aprono come sono oggi dentro il menù nuovo. Sul telefono il menù è
    chiuso (pulsante «Sezioni») e in fondo c'è una barra con le quattro voci più usate in vigna.
*@

<PageTitle>@(_voce is { } v ? $"{v.Voce.Titolo} · Portale" : "Oggi · Portale")</PageTitle>

<div class="pn">
    @if (_idUtente is null)
    {
        <div class="messaggio-errore" role="alert">
            <p>Per usare il Portale serve l'accesso con il tuo utente 4Grapes.</p>
            <a class="pulsante-principale" href="accesso?ReturnUrl=%2Fportale-nuovo" data-enhance-nav="false">Accedi</a>
        </div>
    }
    else if (_errore is not null)
    {
        <div class="messaggio-errore" role="alert">
            <p>@_errore</p>
            <button type="button" class="pulsante-principale" @onclick="CaricaAsync">Riprova</button>
        </div>
    }
    else if (_utente is null)
    {
        <p class="aziende-stato" role="status">Carico il Portale…</p>
    }
    else
    {
        <div class="pn-testata">
            <button type="button" class="pn-sezioni solo-mobile" aria-expanded="@(_menuAperto ? "true" : "false")"
                    @onclick="() => _menuAperto = !_menuAperto">☰ Sezioni</button>
            <p class="pn-dove">
                <a href="@Indirizzo(null, null)">Portale</a>
                @if (_voce is { } dove)
                {
                    <span aria-hidden="true"> › </span><span>@dove.Gruppo.Titolo</span>
                }
            </p>
            <label class="pn-azienda">
                <span>Azienda</span>
                <select value="@(Azienda?.ToString() ?? "")" @onchange="CambiaAzienda">
                    <option value="">Tutte le mie aziende</option>
                    @foreach (var a in _aziende)
                    {
                        <option value="@a.Id">@a.Nome</option>
                    }
                </select>
            </label>
        </div>

        <div class="pn-corpo">
            <nav class="pn-menu @(_menuAperto ? "aperto" : "")" aria-label="Sezioni del Portale">
                <a class="pn-oggi @(_voce is null ? "attiva" : "")" href="@Indirizzo(null, null)" @onclick="() => _menuAperto = false">☀ Oggi</a>
                @foreach (var g in _gruppi)
                {
                    <h2><span aria-hidden="true">@g.Icona</span> @g.Titolo</h2>
                    <ul>
                        @foreach (var v in g.Voci)
                        {
                            <li>
                                <a href="@MenuPortaleNuovo.Indirizzo(g, v, Azienda)" class="@(_voce?.Voce == v ? "attiva" : "")"
                                   @onclick="() => _menuAperto = false">
                                    @v.Titolo
                                    @if (v.Fuori is not null)
                                    {
                                        <span class="pn-fuori" title="Un'altra pagina di Mappe">↗</span>
                                    }
                                </a>
                            </li>
                        }
                    </ul>
                }
                <p class="pn-nota">Prototipo: il Portale di oggi resta su <a href="portale">Portale</a>.</p>
            </nav>

            <main class="pn-contenuto">
                @if (_voce is null)
                {
                    <OggiPortale Utente="_utente" Azienda="Azienda" Gruppi="_gruppi" />
                }
                else if (_voce.Value.Voce.Chiave == "trattamenti")
                {
                    <TrattamentiNuovo Utente="_utente" Scritture="_scritture" Azienda="Azienda" Data="Data" />
                }
                else if (_voce.Value.Voce.Sezione is { } sezione && global::ProgettoMappe.Web.Components.Pages.Portale.Portale.Pagine.TryGetValue(sezione, out var pagina))
                {
                    <h1 class="pn-titolo">@_voce.Value.Voce.Titolo</h1>
                    <p class="pn-nota">Questa sezione è ancora com'era: si rifà nella fase 2.</p>
                    <DynamicComponent Type="pagina" Parameters="@(new Dictionary<string, object?> { ["Utente"] = _utente, ["Scritture"] = _scritture })" />
                }
                else
                {
                    <p class="messaggio-errore" role="alert">Questa pagina non esiste o non hai il permesso di aprirla.</p>
                }
            </main>
        </div>

        <nav class="pn-barra solo-mobile" aria-label="Le voci più usate">
            @foreach (var (testo, icona, gruppo, voce) in Barra)
            {
                <a href="@Indirizzo(gruppo, voce)" class="@((_voce is null && gruppo is null) || _voce?.Gruppo.Chiave == gruppo ? "attiva" : "")">
                    <span aria-hidden="true">@icona</span>@testo
                </a>
            }
            <button type="button" @onclick="() => _menuAperto = !_menuAperto"><span aria-hidden="true">☰</span>Altro</button>
        </nav>
    }
</div>

@code {
    [Parameter] public string? Gruppo { get; set; }
    [Parameter] public string? Voce { get; set; }
    [SupplyParameterFromQuery(Name = "azienda")] public int? Azienda { get; set; }
    [SupplyParameterFromQuery(Name = "data")] public string? Data { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? StatoAccesso { get; set; }

    /// <summary>La barra in fondo al telefono: le voci di chi è in vigna.</summary>
    private static readonly (string Testo, string Icona, string? Gruppo, string? Voce)[] Barra =
    [
        ("Oggi", "☀", null, null), ("Difesa", "🛡", "difesa", "trattamenti"), ("Rilievi", "🔎", "rilievi", "rilievi"),
        ("Foto", "📷", "vigneti", "galleria"),
    ];

    private int? _idUtente;
    private PortaleUtenteDto? _utente;
    private StatoScrittureDto? _scritture;
    private string? _errore;
    private IReadOnlyList<GruppoMenuNuovo> _gruppi = [];
    private List<VoceFiltroDto> _aziende = [];
    private (GruppoMenuNuovo Gruppo, VoceMenuNuovo Voce)? _voce;
    private bool _menuAperto;

    protected override async Task OnInitializedAsync()
    {
        _idUtente = UtentePortale.IdUtente(StatoAccesso is null ? null : (await StatoAccesso).User);
        await CaricaAsync();
    }

    protected override void OnParametersSet() => _voce = Gruppo is null ? null : MenuPortaleNuovo.Trova(_gruppi, Gruppo, Voce);

    private async Task CaricaAsync()
    {
        if (_idUtente is not { } id)
        {
            return;
        }

        _errore = null;
        var risposta = await Api.GetUtenteAsync(id);
        if (!risposta.Riuscita || risposta.Dati is null)
        {
            _errore = risposta.Errore ?? "Non riesco a leggere i tuoi permessi.";
            return;
        }

        _utente = risposta.Dati;
        _scritture = (await Api.GetScrittureAsync(id)).Dati;
        _gruppi = MenuPortaleNuovo.Visibili(_utente);
        _voce = Gruppo is null ? null : MenuPortaleNuovo.Trova(_gruppi, Gruppo, Voce);
        // Le aziende dell'utente: per il prototipo quelle del calendario dei trattamenti (tutte quelle con vigneti in carico).
        var calendario = await Api.GetTrattamentiGiornalieriAsync(id, DateOnly.FromDateTime(DateTime.Today), new Dictionary<string, string>());
        _aziende = calendario.Dati?.Filtri.Aziende.Where(a => int.TryParse(a.Id, out var n) && n > 0).ToList() ?? [];
    }

    private string Indirizzo(string? gruppo, string? voce) =>
        (gruppo is null ? "/" + MenuPortaleNuovo.Percorso : $"/{MenuPortaleNuovo.Percorso}/{gruppo}/{voce}")
        + (Azienda is { } a ? $"?azienda={a}" : "");

    private void CambiaAzienda(ChangeEventArgs e)
    {
        int? scelta = int.TryParse(e.Value?.ToString(), out var n) && n > 0 ? n : null;
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("azienda", scelta), replace: true);
    }
}

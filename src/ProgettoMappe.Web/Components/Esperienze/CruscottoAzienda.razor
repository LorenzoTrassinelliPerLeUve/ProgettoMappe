@using System.Globalization
@using ProgettoMappe.Web.Esperienze
@using ProgettoMappe.Web.Portale
@inject PortaleApiClient Api
@inject AziendeApiClient Aziende
@inject BilancioIdricoApiClient Bilancio

@*
    Il cruscotto di consultazione di un'azienda (task #401): la pagina iniziale delle aziende in consulenza e la parte
    «come stanno i tuoi vigneti» degli abbonati. Solo numeri già calcolati da Mappe (riepilogo, avvisi, bilancio idrico,
    calendario dei trattamenti): ogni tessera porta alla pagina che li spiega. Un numero che non si legge resta «—».
*@

@if (Azienda is null)
{
    <p class="pn-nota">Scegli l'azienda in alto per vedere come sta.</p>
}
else if (!_caricato)
{
    <p class="aziende-stato" role="status">Guardo come sta l'azienda…</p>
}
else
{
    <div class="pn-tessere">
        <a class="pn-tessera" href="@Vai("vigneti")">
            <strong>@(_azienda?.NumeroVigneti.ToString(It) ?? "—")</strong> vigneti
            <small>@(_azienda is { } a ? $"{a.Ettari.ToString("N1", It)} ettari" : "superficie non disponibile")</small>
        </a>
        <a class="pn-tessera @(_daTrattare > 0 ? "pn-tessera-dafare" : "pn-tessera-ok")" href="@Vai("trattamenti")">
            <strong>@(_daTrattare?.ToString(It) ?? "—")</strong> @(_daTrattare == 1 ? "vigneto da trattare oggi" : "vigneti da trattare oggi")
            <small>@(_fatti is { } f ? $"{f} trattamenti fatti negli ultimi {_giorniPrima} giorni" : "trattamenti non disponibili")</small>
        </a>
        <a class="pn-tessera @(_daIrrigare > 0 ? "pn-tessera-dafare" : "")" href="@Vai("bilancio-idrico")">
            <strong>@(_daIrrigare?.ToString(It) ?? "—")</strong> @(_daIrrigare == 1 ? "vigneto in stress idrico" : "vigneti in stress idrico")
            <small>@(_daIrrigare is null ? "bilancio idrico non ancora calcolato" : "dal bilancio idrico di oggi")</small>
        </a>
        <a class="pn-tessera" href="@Vai("indice-bigot")">
            <strong>@(_azienda?.PunteggioBigot?.ToString("N0", It) ?? "—")</strong> indice Bigot medio
            <small>@(_annoBigot is { } anno && _azienda?.PunteggioBigot is not null ? $"{anno}, su {_azienda.VignetiConPunteggio} vigneti" : "nessun indice completo")</small>
        </a>
        <a class="pn-tessera @(_avvisi > 0 ? "pn-tessera-dafare" : "pn-tessera-ok")" href="@Vai("avvisi")">
            <strong>@(_avvisi?.ToString(It) ?? "—")</strong> @(_avvisi == 1 ? "avviso" : "avvisi")
            <small>rischi senza trattamento, rilievi vecchi</small>
        </a>
    </div>

    <section class="pn-blocco">
        <h2>@TitoloConsulta</h2>
        <div class="pn-scorciatoie">
            @foreach (var (chiave, frase) in Consulta)
            {
                if (MenuEsperienze.Voci.First(v => v.Chiave == chiave) is { } voce && voce.Per(Esperienza) != Accesso.Nascosto)
                {
                    <a href="@MenuEsperienze.Indirizzo(Esperienza, voce, Azienda, Come)"><strong>@voce.Titolo</strong><span>@frase</span></a>
                }
            }
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired] public PortaleUtenteDto Utente { get; set; } = default!;
    [Parameter, EditorRequired] public string Esperienza { get; set; } = default!;
    [Parameter] public int? Azienda { get; set; }
    [Parameter] public string? Come { get; set; }
    [Parameter] public string TitoloConsulta { get; set; } = "Da consultare";

    private static readonly CultureInfo It = CultureInfo.GetCultureInfo("it-IT");

    private static readonly (string Chiave, string Frase)[] Consulta =
    [
        ("report-settimanale", "La settimana in vigna, da scaricare"),
        ("report-fine-stagione", "Il riassunto dell'annata"),
        ("bollettini", "I bollettini che ti abbiamo mandato"),
        ("trattamenti", "Trattamenti fatti e consigliati"),
        ("galleria", "Le foto dei rilievi"),
        ("rilievi", "Tutti i rilievi in Excel"),
        ("report-suolo", "Le analisi del terreno"),
    ];

    private bool _caricato;
    private int? _caricata = -1;
    private RiepilogoAziendaDto? _azienda;
    private int? _annoBigot, _avvisi, _daIrrigare, _daTrattare, _fatti, _giorniPrima;

    protected override async Task OnParametersSetAsync()
    {
        if (_caricata == Azienda) return;
        _caricata = Azienda;
        _caricato = false;
        if (Azienda is not { } id) return;

        await Task.WhenAll(RiepilogoAsync(id), AvvisiAsync(id), BilancioAsync(id), TrattamentiAsync(id));
        _caricato = true;
    }

    private string Vai(string chiave) =>
        MenuEsperienze.Indirizzo(Esperienza, MenuEsperienze.Voci.First(v => v.Chiave == chiave), Azienda, Come);

    private async Task RiepilogoAsync(int id)
    {
        try
        {
            var r = await Aziende.GetRiepilogoAsync();
            _azienda = r.Aziende.FirstOrDefault(a => a.Id == id);
            _annoBigot = r.AnnoBigot;
        }
        catch (Exception) { _azienda = null; }
    }

    private async Task AvvisiAsync(int id)
    {
        try
        {
            var r = await Aziende.GetAvvisiAsync();
            _avvisi = r.Pronto ? r.Avvisi.Count(a => a.AziendaId == id) : null;
        }
        catch (Exception) { _avvisi = null; }
    }

    private async Task BilancioAsync(int id)
    {
        try
        {
            var r = await Bilancio.GetStatoAziendaAsync(id);
            _daIrrigare = r?.Calcolo is null ? null : r.Vigneti.Count(v => v.CriticitaPdlwp || v.CriticitaDeficit);
        }
        catch (Exception) { _daIrrigare = null; }
    }

    private async Task TrattamentiAsync(int id)
    {
        var filtri = new Dictionary<string, string> { ["azienda"] = id.ToString(CultureInfo.InvariantCulture) };
        var r = await Api.GetTrattamentiGiornalieriAsync(Utente.IdUtente, DateOnly.FromDateTime(DateTime.Now), filtri);
        if (r.Dati is null) return;
        var oggi = RiepilogoOggi.Calcola(r.Dati);
        (_daTrattare, _fatti, _giorniPrima) = (oggi.DaFareOggi.Count, oggi.FattiNeiGiorniPrima, oggi.GiorniPrima);
    }
}

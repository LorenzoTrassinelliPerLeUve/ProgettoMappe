@page "/bilancio-idrico/configurazione"
@using System.Globalization
@using System.Security.Claims
@using System.Text.Json
@using Microsoft.Extensions.Logging
@using ProgettoMappe.Contracts
@using ProgettoMappe.Web.BilancioIdrico
@inject AziendeApiClient AziendeApiClient
@inject VignetiApiClient VignetiApiClient
@inject BilancioIdricoApiClient BilancioApi
@inject NavigationManager Navigation
@inject ILogger<ConfigurazioneBilancio> Logger

<PageTitle>Configurazione del bilancio idrico</PageTitle>

@* DSS Bilancio Idrico, fase 3 (task #335, punto D): settori, quote, impianti, shift, stili e irrigazioni registrate, con le
   Api della fase 2. Ogni modifica è una versione nuova con autore e data; dopo, l'Api ricalcola l'azienda in background. *@
<div class="contenitore bilancio-idrico">
    <header class="intestazione-pagina">
        <h1 class="titolo-pagina">Configurazione del bilancio idrico</h1>
        <p class="sottotitolo">Settori irrigui, parte di ogni vigneto nei settori, impianti, stile del vino e irrigazioni fatte. Ogni modifica resta nello storico con chi l'ha fatta e quando.</p>
    </header>

    @if (_errore is not null)
    {
        <div class="messaggio-errore" role="alert">
            <p>@_errore</p>
            <button type="button" class="pulsante-principale" @onclick="CaricaAsync">Riprova</button>
        </div>
    }
    else if (_aziende is null)
    {
        <p class="aziende-stato" role="status">Carico le aziende…</p>
    }
    else
    {
        <div class="ib-filtri">
            <label>
                <span>Azienda</span>
                <select value="@(Azienda?.ToString(CultureInfo.InvariantCulture) ?? "")" @onchange="e => CambiaAzienda(e.Value as string)">
                    <option value="">Scegli un'azienda…</option>
                    @foreach (var a in _aziende)
                    {
                        <option value="@a.Id">@a.Nome</option>
                    }
                </select>
            </label>
        </div>

        @if (Azienda is { } azienda && _conf is { } c)
        {
            <p class="nota">
                <a href="@($"bilancio-idrico?azienda={azienda}")">← Bilancio idrico dell'azienda</a>.
                Dopo ogni modifica il bilancio dell'azienda si ricalcola da solo in pochi secondi.
                @if (_login is null)
                {
                    <strong> Per modificare devi entrare con il tuo utente.</strong>
                }
            </p>
            @if (_messaggio is not null)
            {
                <p class="nota bi-avviso" role="status">@_messaggio</p>
            }

            <h2 class="titolo-sezione">Settori irrigui</h2>
            @if (c.Settori.Count == 0)
            {
                <p class="nota">Nessun settore: tutti i vigneti sono in solo monitoraggio (bilancio e suggerimento sì, ore no).</p>
            }
            else
            {
                <table class="tabella-report bi-tabella">
                    <thead><tr><th>N.</th><th>Nome</th><th>Superficie</th><th>Attivo</th><th>Ultima modifica</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var s in c.Settori)
                        {
                            <tr>
                                <td>@s.Dati.IdSettore</td><th scope="row">@s.Dati.Nome</th>
                                <td>@(s.Dati.SuperficieM2 is { } m2 ? (m2 / 10_000).ToString("0.00", It) + " ha" : "—")</td>
                                <td>@(s.Dati.Attivo ? "sì" : "no")</td><td class="nota">@ConfigurazioneWeb.Modifica(s)</td>
                                <td>
                                    <button type="button" class="pulsante" @onclick="() => ModificaSettore(s.Dati)">Modifica</button>
                                    <button type="button" class="pulsante" @onclick="() => SalvaAsync(TipoSettore, s.Dati, true)">Togli</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            <div class="bi-modulo">
                <strong>@(_settore.Id == 0 ? "Nuovo settore" : $"Settore {_settore.Id}")</strong>
                <label>Nome <input @bind="_settore.Nome" maxlength="100" /></label>
                <label>Superficie (ha) <input @bind="_settore.Ettari" inputmode="decimal" size="6" /></label>
                <label><input type="checkbox" @bind="_settore.Attivo" /> attivo</label>
                <button type="button" class="pulsante-principale" @onclick="SalvaSettoreAsync">Salva</button>
                @if (_settore.Id != 0)
                {
                    <button type="button" class="pulsante" @onclick="() => _settore = new()">Annulla</button>
                }
            </div>

            @if (c.Settori.Count > 0)
            {
                <h2 class="titolo-sezione">Vigneti nei settori</h2>
                <p class="nota">La parte del <strong>vigneto</strong> che sta nel settore, in %: la somma di un vigneto non supera 100. Un vigneto senza settore resta in solo monitoraggio.</p>
                @if (c.Quote.Count > 0)
                {
                    <table class="tabella-report bi-tabella">
                        <thead><tr><th>Vigneto</th><th>Settore</th><th>Quota</th><th>Ultima modifica</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var q in c.Quote.OrderBy(q => Nome(q.Dati.IdVigneto)))
                            {
                                <tr>
                                    <th scope="row">@Nome(q.Dati.IdVigneto)</th><td>@c.NomeSettore(q.Dati.IdSettore)</td>
                                    <td>@q.Dati.Percentuale.ToString("0.#", It)%</td><td class="nota">@ConfigurazioneWeb.Modifica(q)</td>
                                    <td><button type="button" class="pulsante" @onclick="() => SalvaAsync(TipoQuota, q.Dati, true)">Togli</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                <div class="bi-modulo">
                    <strong>Aggiungi o cambia</strong>
                    <label>Vigneto <select @bind="_quota.Vigneto"><option value="0">—</option>@foreach (var v in _vigneti) { <option value="@v.Id">@v.Nome</option> }</select></label>
                    <label>Settore <select @bind="_quota.Settore"><option value="0">—</option>@foreach (var s in c.Settori) { <option value="@s.Dati.IdSettore">@s.Dati.Nome</option> }</select></label>
                    <label>Quota % <input @bind="_quota.Percentuale" inputmode="decimal" size="5" /></label>
                    <button type="button" class="pulsante-principale" @onclick="SalvaQuotaAsync">Salva</button>
                </div>

                <h2 class="titolo-sezione">Impianti dei settori</h2>
                <p class="nota">Vale l'impianto con l'inizio più recente. Senza tasso il settore non ha ore suggerite; il tasso si calcola da portata e distanze se mancano.</p>
                @if (c.Impianti.Count > 0)
                {
                    <table class="tabella-report bi-tabella">
                        <thead><tr><th>Settore</th><th>Dal</th><th>Al</th><th>Tipo</th><th>Gocciolatori × ali</th><th>Portata</th><th>Tasso</th><th>Efficienza</th><th>Ultima modifica</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var i in c.Impianti)
                            {
                                var d = i.Dati;
                                <tr>
                                    <th scope="row">@c.NomeSettore(d.IdSettore)</th><td>@d.ValidoDal.ToString("d/M/yyyy", It)</td><td>@(d.ValidoAl?.ToString("d/M/yyyy", It) ?? "—")</td>
                                    <td>@(d.IdTipologiaImpianto is { } t && ConfigurazioneWeb.Tipologie.TryGetValue(t, out var nt) ? nt : "—")</td>
                                    <td>@TestiBilancio.Numero(d.DistanzaGocciolatoriM) × @TestiBilancio.Numero(d.DistanzaAliM) m</td>
                                    <td>@TestiBilancio.Numero(d.PortataLh, "0.0") L/h</td><td>@TestiBilancio.Numero(d.TassoMmOra, "0.00") mm/h</td>
                                    <td>@TestiBilancio.Numero(d.EfficienzaReale)</td><td class="nota">@ConfigurazioneWeb.Modifica(i)</td>
                                    <td><button type="button" class="pulsante" @onclick="() => SalvaAsync(TipoImpianto, d, true)">Togli</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                <div class="bi-modulo">
                    <strong>Aggiungi un impianto</strong>
                    <label>Settore <select @bind="_impianto.Settore"><option value="0">—</option>@foreach (var s in c.Settori) { <option value="@s.Dati.IdSettore">@s.Dati.Nome</option> }</select></label>
                    <label>Dal <input type="date" @bind="_impianto.Dal" /></label>
                    <label>Tipo <select @bind="_impianto.Tipologia">@foreach (var t in ConfigurazioneWeb.Tipologie) { <option value="@t.Key">@t.Value</option> }</select></label>
                    <label>Gocciolatori (m) <input @bind="_impianto.Gocciolatori" inputmode="decimal" size="4" /></label>
                    <label>Ali (m) <input @bind="_impianto.Ali" inputmode="decimal" size="4" /></label>
                    <label>Portata (L/h) <input @bind="_impianto.Portata" inputmode="decimal" size="4" /></label>
                    <label>Tasso (mm/h) <input @bind="_impianto.Tasso" inputmode="decimal" size="4" placeholder="@(ConfigurazioneWeb.TassoDaGocciolatori(ConfigurazioneWeb.Numero(_impianto.Portata), ConfigurazioneWeb.Numero(_impianto.Gocciolatori), ConfigurazioneWeb.Numero(_impianto.Ali))?.ToString("0.00", It) ?? "")" /></label>
                    <label>Efficienza (0–1) <input @bind="_impianto.Efficienza" inputmode="decimal" size="4" placeholder="del tipo" /></label>
                    <button type="button" class="pulsante-principale" @onclick="SalvaImpiantoAsync">Salva</button>
                </div>

                <h2 class="titolo-sezione">Shift</h2>
                <p class="nota">Uno shift comanda più settori insieme: un'irrigazione registrata sullo shift vale per tutti i suoi settori.</p>
                @foreach (var sh in c.Shift)
                {
                    var settori = c.SettoriShift.Where(x => x.Dati.IdShift == sh.Dati.IdShift).ToList();
                    <p>
                        <strong>@sh.Dati.Nome</strong>@(sh.Dati.Attivo ? "" : " (non attivo)") — @(settori.Count == 0 ? "nessun settore" : string.Join(", ", settori.Select(x => $"{c.NomeSettore(x.Dati.IdSettore)} dal {x.Dati.ValidoDal:d/M/yyyy}")))
                        <span class="nota"> · @ConfigurazioneWeb.Modifica(sh)</span>
                        <button type="button" class="pulsante" @onclick="() => SalvaAsync(TipoShift, sh.Dati, true)">Togli</button>
                    </p>
                }
                <div class="bi-modulo">
                    <strong>Nuovo shift</strong>
                    <label>Nome <input @bind="_shiftNome" maxlength="100" /></label>
                    <button type="button" class="pulsante-principale" @onclick="SalvaShiftAsync">Salva</button>
                </div>
                @if (c.Shift.Count > 0)
                {
                    <div class="bi-modulo">
                        <strong>Metti un settore in uno shift</strong>
                        <label>Shift <select @bind="_settoreShift.Shift"><option value="0">—</option>@foreach (var s in c.Shift) { <option value="@s.Dati.IdShift">@s.Dati.Nome</option> }</select></label>
                        <label>Settore <select @bind="_settoreShift.Settore"><option value="0">—</option>@foreach (var s in c.Settori) { <option value="@s.Dati.IdSettore">@s.Dati.Nome</option> }</select></label>
                        <label>Dal <input type="date" @bind="_settoreShift.Dal" /></label>
                        <button type="button" class="pulsante-principale" @onclick="SalvaSettoreShiftAsync">Salva</button>
                    </div>
                }
            }

            <h2 class="titolo-sezione">Stile del vino per vigneto</h2>
            <p class="nota">Lo stile dà la soglia di stress (Pdlwp) per fase: senza stile il vigneto non ha suggerimento. Vale dal giorno indicato.</p>
            <div class="tabella-scorrevole">
                <table class="tabella-report bi-tabella">
                    <thead><tr><th>Vigneto</th><th>Stile oggi</th><th>Ultima modifica</th><th>Nuovo stile</th><th>Dal</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var v in _vigneti)
                        {
                            var attuale = c.StileDi(v.Id, _oggi);
                            var scelta = _stili.GetValueOrDefault(v.Id) ?? new SceltaStile { Stile = attuale?.Dati.IdStileVino ?? 0, Dal = new DateOnly(_oggi.Year, 1, 1) };
                            _stili[v.Id] = scelta;
                            <tr>
                                <th scope="row">@v.Nome</th>
                                <td>@(attuale is null ? "—" : attuale.Dati.IdStileVino.ToString(CultureInfo.InvariantCulture))</td>
                                <td class="nota">@(attuale is null ? "" : ConfigurazioneWeb.Modifica(attuale))</td>
                                <td><select @bind="scelta.Stile"><option value="0">—</option>@foreach (var s in ConfigurazioneWeb.Stili) { <option value="@s.Key">@s.Value</option> }</select></td>
                                <td><input type="date" @bind="scelta.Dal" /></td>
                                <td><button type="button" class="pulsante" disabled="@(scelta.Stile == 0)" @onclick="() => SalvaStileAsync(v.Id, scelta)">Salva</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (c.Settori.Count > 0)
            {
                <h2 class="titolo-sezione">Irrigazioni fatte</h2>
                <div class="bi-modulo">
                    <strong>Registra un'irrigazione</strong>
                    <label>Giorno <input type="date" @bind="_irrigazione.Data" /></label>
                    <label>
                        Dove
                        <select @bind="_irrigazione.Dove">
                            <option value="">—</option>
                            @foreach (var s in c.Settori) { <option value="@($"s{s.Dati.IdSettore}")">Settore: @s.Dati.Nome</option> }
                            @foreach (var s in c.Shift) { <option value="@($"h{s.Dati.IdShift}")">Shift: @s.Dati.Nome</option> }
                        </select>
                    </label>
                    <label>Ore <input @bind="_irrigazione.Ore" inputmode="decimal" size="4" /></label>
                    <label>oppure mm <input @bind="_irrigazione.Mm" inputmode="decimal" size="4" /></label>
                    <button type="button" class="pulsante-principale" @onclick="SalvaIrrigazioneAsync">Registra</button>
                </div>
                <p class="nota">Con le ore i mm li calcola il bilancio dal tasso dell'impianto e dall'efficienza.</p>
                @if (c.Irrigazioni.Count > 0)
                {
                    <table class="tabella-report bi-tabella">
                        <thead><tr><th>Giorno</th><th>Dove</th><th>Ore</th><th>mm</th><th>Registrata</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var i in c.Irrigazioni.Take(60))
                            {
                                var d = i.Dati;
                                <tr>
                                    <td>@d.Data.ToString("d/M/yyyy", It)</td>
                                    <td>@(d.IdSettore is { } se ? c.NomeSettore(se) : d.IdShift is { } sh ? "shift " + c.NomeShift(sh) : "—")</td>
                                    <td>@TestiBilancio.Numero(d.DurataOre, "0.0")</td><td>@TestiBilancio.Numero(d.VolumeMm, "0.0")</td>
                                    <td class="nota">@ConfigurazioneWeb.Modifica(i)</td>
                                    <td><button type="button" class="pulsante" @onclick="() => SalvaAsync(TipoIrrigazione, d, true)">Togli</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }
        }
        else if (Azienda is not null)
        {
            <p class="aziende-stato" role="status">Carico la configurazione…</p>
        }
    }
</div>

@code {
    private const string TipoSettore = "settore", TipoQuota = "quota", TipoImpianto = "impianto", TipoShift = "shift",
        TipoSettoreShift = "settore-shift", TipoStile = "stile", TipoIrrigazione = "irrigazione";
    private static readonly CultureInfo It = CultureInfo.GetCultureInfo("it-IT");

    [SupplyParameterFromQuery(Name = "azienda")] private int? Azienda { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? StatoAccesso { get; set; }

    private sealed class ModuloSettore { public int Id; public string Nome = ""; public string? Ettari; public bool Attivo = true; }
    private sealed class ModuloQuota { public int Vigneto; public int Settore; public string? Percentuale = "100"; }
    private sealed class ModuloImpianto
    {
        public int Settore; public DateOnly Dal = new(DateTime.Today.Year, 1, 1); public int Tipologia = 1;
        public string? Gocciolatori, Ali, Portata, Tasso, Efficienza;
    }
    private sealed class ModuloSettoreShift { public int Shift; public int Settore; public DateOnly Dal = new(DateTime.Today.Year, 1, 1); }
    private sealed class SceltaStile { public int Stile; public DateOnly Dal; }
    private sealed class ModuloIrrigazione { public DateOnly Data = DateOnly.FromDateTime(DateTime.Today); public string Dove = ""; public string? Ore, Mm; }

    private List<AziendaDto>? _aziende;
    private int? _confAzienda;
    private ConfigurazioneWeb? _conf;
    private List<VignetoDto> _vigneti = [];
    private string? _errore;
    private string? _messaggio;
    private string? _login;
    private DateOnly _oggi = DateOnly.FromDateTime(DateTime.Today);

    private ModuloSettore _settore = new();
    private ModuloQuota _quota = new();
    private ModuloImpianto _impianto = new();
    private string _shiftNome = "";
    private ModuloSettoreShift _settoreShift = new();
    private readonly Dictionary<int, SceltaStile> _stili = [];
    private ModuloIrrigazione _irrigazione = new();

    private string Nome(int id) => _vigneti.FirstOrDefault(v => v.Id == id)?.Nome ?? $"Vigneto {id}";

    protected override async Task OnInitializedAsync()
    {
        if (StatoAccesso is not null && (await StatoAccesso).User is { Identity.IsAuthenticated: true } utente)
            _login = utente.FindFirstValue(ClaimTypes.NameIdentifier);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_aziende is null)
            await CaricaAsync();
        else if (Azienda != _confAzienda)
            await CaricaConfigurazioneAsync();
    }

    private async Task CaricaAsync()
    {
        _errore = null;
        try
        {
            _aziende = (await AziendeApiClient.GetAziendeAsync()).OrderBy(a => a.Nome).ToList();
            await CaricaConfigurazioneAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning("Configurazione bilancio: aziende non lette ({Messaggio})", ex.Message);
            _errore = "Non riesco a leggere le aziende, riprova.";
        }
    }

    private async Task CaricaConfigurazioneAsync()
    {
        _confAzienda = Azienda;
        _conf = null;
        _stili.Clear();
        if (Azienda is not { } id)
            return;
        try
        {
            var vigneti = VignetiApiClient.GetVignetiPerAziendaAsync(id);
            _conf = ConfigurazioneWeb.Da(await BilancioApi.GetVociAsync(id));
            _vigneti = (await vigneti).Vigneti.OrderBy(v => v.Nome).ToList();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning("Configurazione bilancio dell'azienda {Azienda} non letta ({Messaggio})", id, ex.Message);
            _errore = "Non riesco a leggere la configurazione di questa azienda, riprova.";
        }
    }

    private async Task SalvaAsync(string tipo, object dati, bool elimina = false)
    {
        if (Azienda is not { } id)
            return;
        if (_login is null)
        {
            _messaggio = "Per modificare devi entrare con il tuo utente: ogni modifica porta il nome di chi la fa.";
            return;
        }
        try
        {
            var esito = await BilancioApi.SalvaVoceAsync(id, tipo,
                new SalvaVoceBilancioDto(_login, JsonSerializer.SerializeToElement(dati, dati.GetType(), ConfigurazioneWeb.Json), elimina));
            if (esito.Errore is not null)
            {
                _messaggio = $"Non salvato: {esito.Errore}.";
                return;
            }
            _messaggio = (elimina ? "Tolto." : "Salvato.") + " Il bilancio dell'azienda si ricalcola da solo fra pochi secondi.";
            var stili = _stili.ToDictionary();
            await CaricaConfigurazioneAsync();
            foreach (var (k, v) in stili.Where(s => s.Key != (dati as StileBilancioDto)?.IdVigneto))
                _stili[k] = v;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning("Configurazione bilancio: {Tipo} non salvata ({Messaggio})", tipo, ex.Message);
            _messaggio = "Non riesco a salvare, riprova.";
        }
    }

    private void ModificaSettore(SettoreBilancioDto s) =>
        _settore = new ModuloSettore { Id = s.IdSettore, Nome = s.Nome, Ettari = s.SuperficieM2 is { } m2 ? (m2 / 10_000).ToString("0.####", It) : null, Attivo = s.Attivo };

    private async Task SalvaSettoreAsync()
    {
        if (string.IsNullOrWhiteSpace(_settore.Nome))
        {
            _messaggio = "Dai un nome al settore.";
            return;
        }
        var ettari = ConfigurazioneWeb.Numero(_settore.Ettari);
        await SalvaAsync(TipoSettore, new SettoreBilancioDto(_settore.Id, Azienda!.Value, _settore.Nome.Trim(), ettari * 10_000, _settore.Attivo));
        if (_messaggio?.StartsWith("Salvato", StringComparison.Ordinal) == true)
            _settore = new();
    }

    private Task SalvaQuotaAsync()
    {
        if (_quota.Vigneto == 0 || _quota.Settore == 0 || ConfigurazioneWeb.Numero(_quota.Percentuale) is not { } perc || perc is <= 0 or > 100)
        {
            _messaggio = "Scegli vigneto e settore e scrivi una quota fra 1 e 100.";
            return Task.CompletedTask;
        }
        return SalvaAsync(TipoQuota, new QuotaBilancioDto(_quota.Settore, _quota.Vigneto, perc));
    }

    private Task SalvaImpiantoAsync()
    {
        var i = _impianto;
        if (i.Settore == 0)
        {
            _messaggio = "Scegli il settore dell'impianto.";
            return Task.CompletedTask;
        }
        var portata = ConfigurazioneWeb.Numero(i.Portata);
        var gocc = ConfigurazioneWeb.Numero(i.Gocciolatori);
        var ali = ConfigurazioneWeb.Numero(i.Ali);
        var tasso = ConfigurazioneWeb.Numero(i.Tasso) ?? ConfigurazioneWeb.TassoDaGocciolatori(portata, gocc, ali);
        if (ConfigurazioneWeb.Numero(i.Efficienza) is { } eff && eff is <= 0 or > 1)
        {
            _messaggio = "L'efficienza va fra 0 e 1 (per esempio 0,9).";
            return Task.CompletedTask;
        }
        return SalvaAsync(TipoImpianto, new ImpiantoBilancioDto(i.Settore, i.Dal, null, i.Tipologia, gocc, ali, portata, tasso,
            ConfigurazioneWeb.Numero(i.Efficienza)));
    }

    private async Task SalvaShiftAsync()
    {
        if (string.IsNullOrWhiteSpace(_shiftNome))
        {
            _messaggio = "Dai un nome allo shift.";
            return;
        }
        await SalvaAsync(TipoShift, new ShiftBilancioDto(0, Azienda!.Value, _shiftNome.Trim()));
        _shiftNome = "";
    }

    private Task SalvaSettoreShiftAsync()
    {
        if (_settoreShift.Shift == 0 || _settoreShift.Settore == 0)
        {
            _messaggio = "Scegli shift e settore.";
            return Task.CompletedTask;
        }
        return SalvaAsync(TipoSettoreShift, new SettoreShiftBilancioDto(_settoreShift.Shift, _settoreShift.Settore, _settoreShift.Dal, null));
    }

    private Task SalvaStileAsync(int idVigneto, SceltaStile scelta) =>
        SalvaAsync(TipoStile, new StileBilancioDto(idVigneto, scelta.Stile, scelta.Dal, null));

    private async Task SalvaIrrigazioneAsync()
    {
        var ir = _irrigazione;
        var ore = ConfigurazioneWeb.Numero(ir.Ore);
        var mm = ConfigurazioneWeb.Numero(ir.Mm);
        int? settore = ir.Dove.StartsWith('s') && int.TryParse(ir.Dove[1..], out var s) ? s : null;
        int? shift = ir.Dove.StartsWith('h') && int.TryParse(ir.Dove[1..], out var h) ? h : null;
        if (settore is null && shift is null || ore is not > 0 && mm is not > 0)
        {
            _messaggio = "Scegli il settore o lo shift e scrivi le ore o i mm.";
            return;
        }
        await SalvaAsync(TipoIrrigazione, new IrrigazioneBilancioDto(0, Azienda!.Value, ir.Data, settore, shift, ore, mm));
        if (_messaggio?.StartsWith("Salvato", StringComparison.Ordinal) == true)
            _irrigazione = new();
    }

    private void CambiaAzienda(string? valore) =>
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("azienda", int.TryParse(valore, out var id) ? id : null));
}

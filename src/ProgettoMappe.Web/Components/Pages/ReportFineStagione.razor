@page "/report-fine-stagione"
@using System.Globalization
@using Microsoft.Extensions.Logging
@using ProgettoMappe.Contracts
@using ProgettoMappe.Web.Report
@using ProgettoMappe.Web.ReportFineStagione
@using ProgettoMappe.Web.Tematismi
@inject AziendeApiClient AziendeApiClient
@inject VignetiApiClient VignetiApiClient
@inject ReportisticaApiClient Reportistica
@inject NavigationManager Navigation
@inject ILogger<ReportFineStagione> Logger

<PageTitle>@T("titolo", AnnataScelta)</PageTitle>

<div class="contenitore indice-bigot report-fine-stagione">
    <header class="intestazione-pagina">
        <h1 class="titolo-pagina">@T("titolo", AnnataScelta)</h1>
        <p class="sottotitolo">@T("pagina.sottotitolo")</p>
    </header>

    @if (_aziende is null && _errore is null)
    {
        <p class="aziende-stato" role="status">@T("carico")</p>
    }
    else
    {
        <div class="ib-filtri">
            <label>
                <span>@T("filtro.azienda")</span>
                <select value="@(Azienda?.ToString(CultureInfo.InvariantCulture) ?? "")" @onchange="e => Cambia(azienda: Numero(e.Value), annata: null)">
                    <option value="">@T("filtro.scegli")</option>
                    @foreach (var a in _aziende ?? [])
                    {
                        <option value="@a.Id">@a.Nome</option>
                    }
                </select>
            </label>
            <label>
                <span>@T("filtro.annata")</span>
                <select value="@AnnataScelta" @onchange="e => Cambia(annata: Numero(e.Value))">
                    @foreach (var a in AnnateScelta)
                    {
                        <option value="@a">@a</option>
                    }
                </select>
            </label>
            <label>
                <span>@T("filtro.lingua")</span>
                <select value="@TestiReport.Codice(Lingua)" @onchange="e => Cambia(lingua: e.Value as string)">
                    <option value="it">Italiano</option>
                    <option value="en">English</option>
                </select>
            </label>
        </div>

        @if (_errore is not null)
        {
            <div class="messaggio-errore" role="alert">
                <p>@_errore</p>
                <button type="button" class="pulsante-principale" @onclick="CaricaAsync">@T("riprova")</button>
            </div>
        }
        else if (Azienda is not null && _meteo is null)
        {
            <p class="aziende-stato" role="status">@T("carico")</p>
        }
        else if (_meteo is { } meteo && NomeAzienda is { } nome)
        {
            @if (_pubblicata is { } pub && Azienda is { } idPub)
            {
                <VersionePubblicata Pubblicazione="pub" Lingua="Lingua"
                                    PowerPoint="@PubblicazioniReport.IndirizzoPowerPoint(CatalogoFineStagione.Report, idPub, EdizionePubblicata, TestiReport.Codice(Lingua), pub.Versione)"
                                    DalVivo="@($"report-fine-stagione?azienda={idPub}&annata={EdizionePubblicata}&lingua={TestiReport.Codice(Lingua)}")" />
            }
            else
            {
            <p class="rfs-scarica">
                <a href="@($"report-fine-stagione/powerpoint?azienda={Azienda}&annata={AnnataScelta}&lingua={TestiReport.Codice(Lingua)}")" download data-enhance-nav="false">@T("scarica.powerpoint")</a>
                · <a href="@($"report-fine-stagione/pdf?azienda={Azienda}&annata={AnnataScelta}&lingua={TestiReport.Codice(Lingua)}")" target="_blank" rel="noopener" data-enhance-nav="false">@T("scarica.pdf")</a>
                · <a href="@($"report/prepara?report={CatalogoFineStagione.Report}&azienda={Azienda}&edizione={AnnataScelta}&lingua={TestiReport.Codice(Lingua)}")">@T("prepara")</a>
            </p>
            }
            @if (_scelte.Nascosti.Count > 0)
            {
                <p class="nota">@T("nascoste", _scelte.Nascosti.Count)</p>
            }
            <section class="ib-sezione rfs-controlli">
                <h2>@T("controlli.titolo")</h2>
                @{
                    var daGuardare = _controlli.Where(c => c.Righe.Count > 0).ToList();
                }
                @if (_controlli.Count == 0)
                {
                    <p class="nota">@T("controlli.nessuno")</p>
                }
                else if (daGuardare.Count == 0)
                {
                    <p>@T("controlli.ok")</p>
                }
                else
                {
                    <p>@T("controlli.trovati", daGuardare.Count)</p>
                    @foreach (var c in daGuardare)
                    {
                        <details class="rfs-controllo rfs-gravita-@c.Gravita">
                            <summary><strong>@c.Codice</strong> @c.Titolo · @c.Gravita · @T("controlli.righe", c.Righe.Count)</summary>
                            @if (!string.IsNullOrWhiteSpace(c.Perche))
                            {
                                <p class="nota">@c.Perche</p>
                            }
                            <div class="ib-tabella-scorre">
                                <table class="ib-tabella">
                                    <thead><tr>@foreach (var col in c.Colonne) { <th>@col</th> }</tr></thead>
                                    <tbody>
                                        @foreach (var riga in c.Righe.Take(50))
                                        {
                                            <tr>@foreach (var v in riga) { <td>@v</td> }</tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </details>
                    }
                }
            </section>

            <section class="rfs-copertina">
                <h2>@T("titolo", AnnataScelta)</h2>
                <p class="rfs-azienda">@nome</p>
                <p class="nota">@T("generato.il", Oggi.ToString("d", TestiReport.Cultura(Lingua)))</p>
                <p class="nota">@(meteo.Snapshot is { } costruito
                    ? T("dati.snapshot", TimeZoneInfo.ConvertTime(costruito, TematismiBigot.FusoItalia).ToString("g", TestiReport.Cultura(Lingua)))
                    : T("dati.diretti"))</p>
                <CommentoConsulente Titolo="@T("commento.generale")" Testo="@_scelte.Commento(CatalogoFineStagione.Copertina)" />
            </section>

            <section class="ib-sezione">
                <h2>@T("sommario")</h2>
                <ol class="rfs-sommario">
                    @foreach (var s in SezioniReport.Tutte.Where(s => _scelte.Visibile(CatalogoFineStagione.Id(s))))
                    {
                        <li>
                            <span class="rfs-numero">@s.Numero.</span> @SezioniReport.Titolo(s, Lingua, AnnataScelta)
                            @if (s.Chiave == "sezione.indice-bigot")
                            {
                                <span> · <a href="@($"indice-bigot?azienda={Azienda}&anno={AnnataScelta}")">@T("indice-bigot.apri", AnnataScelta)</a></span>
                            }
                            @if (s.Tappa > SezioniReport.TappaFatta)
                            {
                                <span class="nota"> · @T("in.arrivo")</span>
                            }
                        </li>
                    }
                </ol>
            </section>

            @if (_scelte.Visibile(CatalogoFineStagione.Id(SezioniReport.Tutte[0])))
            {
            <section class="ib-sezione">
                <h2>I. @SezioniReport.Titolo(SezioniReport.Tutte[0], Lingua, AnnataScelta)</h2>
                @{
                    var storici = meteo.Vigneti.Where(v => v.DatiMeteoStorico).Select(v => v.Nome).ToList();
                }
                @if (storici.Count == 0)
                {
                    <p class="nota">@T("pioggia.nessun-vigneto")</p>
                }
                else
                {
                    @foreach (var fase in MeteoPerFase.Calcola(meteo, AnnataScelta))
                    {
                        <SezioneMeteoFase Dati="fase" Annata="AnnataScelta" Lingua="Lingua" />
                    }

                    <h3>@T("fase.giornaliero")</h3>
                    <div class="rfs-giornalieri">
                        @foreach (var periodo in MeteoPerFase.Giornalieri(meteo, AnnataScelta))
                        {
                            <GraficoLineeReport Etichette="@(periodo.Select(p => p.Data.ToString("dd/MM", CultureInfo.InvariantCulture)).ToList())"
                                Cultura="TestiReport.Cultura(Lingua)" Serie="@([
                                    new GraficoLineeReport.SerieGrafico(T("campo.Pioggia"), "#3c6fb4", periodo.Select(p => p.Pioggia).ToList(), true),
                                    new GraficoLineeReport.SerieGrafico(T("campo.TMax"), "#c0392b", periodo.Select(p => p.TMax).ToList()),
                                    new GraficoLineeReport.SerieGrafico(T("campo.TMed"), "#8dc63e", periodo.Select(p => p.TMed).ToList()),
                                    new GraficoLineeReport.SerieGrafico(T("campo.TMin"), "#5f727f", periodo.Select(p => p.TMin).ToList()),
                                ])" />
                        }
                    </div>

                    @foreach (var agraria in new[] { false, true })
                    {
                        var settimane = PioggiaCumulata.Calcola(meteo, AnnataScelta, agraria);
                        <h3>@T(agraria ? "slide.pioggia-agraria" : "slide.pioggia-storico")</h3>
                        <GraficoLineeReport Cultura="TestiReport.Cultura(Lingua)" Etichette="@settimane.Select(s => T("apici.settimana", s.Settimana)).ToList()"
                            Serie="@([
                                new GraficoLineeReport.SerieGrafico(T("slide.settimanale", AnnataScelta), "#3c6fb4", settimane.Select(s => (decimal?)s.Settimanale).ToList(), true),
                                new GraficoLineeReport.SerieGrafico(T("slide.cumulata-storico"), "#5f727f", settimane.Select(s => (decimal?)s.Storico).ToList()),
                                new GraficoLineeReport.SerieGrafico(T("slide.cumulata-anno", AnnataScelta), "#c0392b", settimane.Select(s => (decimal?)s.Anno).ToList()),
                            ])" />
                    }

                    <h3>@T("pioggia.titolo")</h3>
                    <div class="ib-tabella-scorre">
                        <table class="ib-tabella">
                            <thead>
                                <tr>
                                    <th>@T("pioggia.fase")</th>
                                    <th class="numero">@T("pioggia.annata", AnnataScelta)</th>
                                    <th class="numero">@T("pioggia.media10")</th>
                                    <th class="numero">@T("pioggia.media30")</th>
                                    <th class="numero">@T("pioggia.var10")</th>
                                    <th class="numero">@T("pioggia.var10pct")</th>
                                    <th class="numero">@T("pioggia.var30")</th>
                                    <th class="numero">@T("pioggia.var30pct")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in CalcoloMeteoReport.PioggiaPerFase(meteo, AnnataScelta))
                                {
                                    <tr>
                                        <td>@T($"fase.{r.Fase}")</td>
                                        <td class="numero">@Mm(r.Annata)</td>
                                        <td class="numero">@Mm(r.Media10)</td>
                                        <td class="numero">@Mm(r.Media30)</td>
                                        <td class="numero">@Mm(r.Variazione10)</td>
                                        <td class="numero">@Pct(r.VariazionePct10)</td>
                                        <td class="numero">@Mm(r.Variazione30)</td>
                                        <td class="numero">@Pct(r.VariazionePct30)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <p class="nota">@T("pioggia.vigneti", string.Join(", ", storici))</p>
                    @if (!meteo.StoricoDisponibile)
                    {
                        <p class="nota">@T("pioggia.senza-storico")</p>
                    }
                }
                <CommentoConsulente Titolo="@T("commento.titolo", SezioniReport.Titolo(SezioniReport.Tutte[0], Lingua, AnnataScelta))"
                    Testo="@_scelte.Commento(CatalogoFineStagione.Id(SezioniReport.Tutte[0]))" />
            </section>
            }

            <SezioniCampoReport Campo="_campo" Annata="AnnataScelta" Lingua="Lingua" Scelte="_scelte"
                Nomi="@(meteo.Vigneti.GroupBy(v => v.Id).ToDictionary(g => g.Key, g => g.First().Nome))" />
            <SezioneSanitaReport Campo="_campo" Annata="AnnataScelta" Lingua="Lingua" Scelte="_scelte"
                Nomi="@(meteo.Vigneti.GroupBy(v => v.Id).ToDictionary(g => g.Key, g => g.First().Nome))" />

            @* Reportistica (task #418): l'Indice Bigot (collegamento) e le sezioni che scrive il consulente, con il suo testo. *@
            @foreach (var s in SezioniReport.Tutte.Where(s => (CatalogoFineStagione.Manuale(s) || s.Chiave == "sezione.indice-bigot")
                                                            && _scelte.Visibile(CatalogoFineStagione.Id(s))))
            {
                var testo = _scelte.Commento(CatalogoFineStagione.Id(s));
                if (CatalogoFineStagione.Manuale(s) && testo is null)
                    continue;
                <section class="ib-sezione">
                    <h2>@s.Numero. @SezioniReport.Titolo(s, Lingua, AnnataScelta)</h2>
                    @if (CatalogoFineStagione.Manuale(s))
                    {
                        @foreach (var riga in testo!.Split('\n'))
                        {
                            <p>@riga</p>
                        }
                    }
                    else
                    {
                        <p><a href="@($"indice-bigot?azienda={Azienda}&anno={AnnataScelta}")">@T("indice-bigot.apri", AnnataScelta)</a></p>
                        <CommentoConsulente Titolo="@T("commento.titolo", SezioniReport.Titolo(s, Lingua, AnnataScelta))" Testo="@testo" />
                    }
                </section>
            }
        }
        @* Task #204: le differenze volute rispetto a Qlik (elenco completo in decisioni.md del lavoro). *@
        <section class="differenze-qlik">
            <h2>@T("decisioni.titolo")</h2>
            <ul>
                @foreach (var riga in TestiReport.Testo(Lingua, "decisioni.testo").Split('\n'))
                {
                    <li>@riga</li>
                }
            </ul>
        </section>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "azienda")] private int? Azienda { get; set; }
    [SupplyParameterFromQuery(Name = "annata")] private int? Annata { get; set; }
    [SupplyParameterFromQuery(Name = "lingua")] private string? CodiceLingua { get; set; }
    /// <summary>Reportistica R4 (task #418): «1» = la versione pubblicata dell'annata; <c>versione</c> = una dell'archivio.</summary>
    [SupplyParameterFromQuery(Name = "pubblicato")] private string? Pubblicato { get; set; }
    [SupplyParameterFromQuery(Name = "versione")] private int? Versione { get; set; }

    private PubblicazioneReportDto? _pubblicata;
    private string? _nomePubblicato;

    private bool ModoPubblicato => Pubblicato == "1" || Versione is not null;

    /// <summary>L'annata della versione pubblicata: quella dell'indirizzo, altrimenti l'ultima chiusa.</summary>
    private string EdizionePubblicata => (Annata ?? UltimaChiusa).ToString(CultureInfo.InvariantCulture);

    /// <summary>Quello che, cambiando, fa rileggere i dati: l'azienda e, per una versione pubblicata, annata, lingua e versione.</summary>
    private (int?, string?, LinguaReport?, int?) ChiaveDati =>
        (Azienda, ModoPubblicato ? EdizionePubblicata : null, ModoPubblicato ? Lingua : null, Versione);

    private List<AziendaDto>? _aziende;
    private MeteoReportFineStagioneDto? _meteo;
    private (int?, string?, LinguaReport?, int?)? _meteoAzienda;
    private IReadOnlyList<ControlloReportDto> _controlli = [];
    private CampoReportFineStagioneDto? _campo;
    private string? _errore;
    private ScelteApplicate _scelte = ScelteApplicate.Tutto;
    private (int, int, LinguaReport)? _scelteCaricate;

    private LinguaReport Lingua => TestiReport.DaCodice(CodiceLingua);

    private DateOnly Oggi => DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, TematismiBigot.FusoItalia).DateTime);

    /// <summary>L'ultima annata agraria chiusa (fino a ottobre è quella prima, come il report Qlik dell'anno in corso).</summary>
    private int UltimaChiusa => CalcoloMeteoReport.AnnataAgraria(Oggi) - 1;

    private IReadOnlyList<int> AnnateScelta =>
        (_meteo is { } m ? CalcoloMeteoReport.Annate(m) : [])
            .Where(a => a <= UltimaChiusa).DefaultIfEmpty(UltimaChiusa).ToList();

    private int AnnataScelta => Annata is { } a && AnnateScelta.Contains(a) ? a : AnnateScelta[0];

    private string? NomeAzienda => _nomePubblicato ?? _aziende?.FirstOrDefault(a => a.Id == Azienda)?.Nome;

    private string T(string chiave, params object[] valori) => TestiReport.Testo(Lingua, chiave, valori);

    private string Mm(decimal? valore) => valore is { } v ? v.ToString("N1", TestiReport.Cultura(Lingua)) : "";

    private string Pct(decimal? valore) => valore is { } v ? v.ToString("P1", TestiReport.Cultura(Lingua)) : "";

    protected override async Task OnParametersSetAsync()
    {
        if (_aziende is null)
        {
            await CaricaAsync();
        }
        else if (ChiaveDati != _meteoAzienda)
        {
            await CaricaMeteoAsync();
        }
        // Reportistica (task #418): sezioni nascoste e commenti dell'annata, come nel PowerPoint (pubblicato: quelli congelati).
        if (!ModoPubblicato && _meteo is not null && Azienda is { } id && _scelteCaricate != (id, AnnataScelta, Lingua))
        {
            _scelteCaricate = (id, AnnataScelta, Lingua);
            _scelte = await CatalogoFineStagione.ScelteAsync(Reportistica, id, AnnataScelta, Lingua, Logger);
        }
    }

    private async Task CaricaAsync()
    {
        _errore = null;
        try
        {
            _aziende = (await AziendeApiClient.GetAziendeAsync()).OrderBy(a => a.Nome).ToList();
            await CaricaMeteoAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning("Report fine stagione: aziende non lette ({Messaggio})", ex.Message);
            _errore = T("errore.meteo");
        }
    }

    private async Task CaricaMeteoAsync()
    {
        _meteo = null;
        _controlli = [];
        _campo = null;
        _errore = null;
        _pubblicata = null;
        _nomePubblicato = null;
        _scelteCaricate = null;
        _scelte = ScelteApplicate.Tutto;
        _meteoAzienda = ChiaveDati;
        if (Azienda is not { } id)
        {
            return;
        }

        try
        {
            if (ModoPubblicato)
            {
                await CaricaPubblicatoAsync(id);
                return;
            }
            _meteo = await VignetiApiClient.GetMeteoReportFineStagioneAsync(id);
            if (_meteo is null)
            {
                _errore = T("errore.meteo");
            }
            else
            {
                _controlli = await VignetiApiClient.GetControlliReportFineStagioneAsync(id);
                _campo = await VignetiApiClient.GetCampoReportFineStagioneAsync(id);
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning("Report fine stagione: meteo dell'azienda {Azienda} non letto ({Messaggio})", id, ex.Message);
            _errore = T("errore.meteo");
        }
    }

    /// <summary>
    /// La pubblicazione congelata dell'annata nella lingua (task #418): meteo, campo, controlli, scelte e commenti di quel giorno,
    /// ridisegnati con la stessa pagina. Senza pubblicazione un messaggio, mai il report di oggi.
    /// </summary>
    private async Task CaricaPubblicatoAsync(int id)
    {
        var pubblicata = await Reportistica.GetPubblicataAsync(CatalogoFineStagione.Report, id, EdizionePubblicata, TestiReport.Codice(Lingua), Versione);
        if (pubblicata is null
            || ContenutoReport<DatiFineStagioneCongelati>.Leggi(pubblicata.Contenuto, CatalogoFineStagione.Report) is not { } contenuto)
        {
            _errore = T("pubblicato.nessuno");
            return;
        }
        _pubblicata = pubblicata.Pubblicazione;
        _meteo = contenuto.Dati.Meteo;
        _campo = contenuto.Dati.Campo;
        _controlli = contenuto.Dati.Controlli;
        _scelte = contenuto.Scelte;
        _nomePubblicato = contenuto.Azienda;
    }

    private void Cambia(int? azienda = -1, int? annata = -1, string? lingua = "-")
    {
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["azienda"] = azienda == -1 ? Azienda : azienda,
            ["annata"] = annata == -1 ? Annata : annata,
            ["lingua"] = lingua == "-" ? CodiceLingua : lingua == "it" ? null : lingua,
        }), replace: true);
    }

    private static int? Numero(object? valore) =>
        int.TryParse(valore as string, NumberStyles.Integer, CultureInfo.InvariantCulture, out var n) ? n : null;
}

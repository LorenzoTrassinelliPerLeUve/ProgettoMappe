@page "/"
@inject AziendeApiClient AziendeApiClient

<PageTitle>Aziende</PageTitle>

<div class="contenitore">
    <header class="intestazione-pagina">
        <h1 class="titolo-pagina">Aziende</h1>
        <p class="sottotitolo">Seleziona un'azienda per aprire la mappa interattiva dei suoi vigneti.</p>
    </header>

    @if (_aziende is null)
    {
        <p class="nota">Caricamento…</p>
    }
    else if (_aziende.Count == 0)
    {
        <p class="nota">Nessuna azienda trovata. Verificare il collegamento al database 4Grapes.</p>
    }
    else
    {
        <ul class="griglia-aziende">
            @foreach (var azienda in _aziende)
            {
                <li>
                    <a class="scheda-azienda" href="@($"mappa/{azienda.Id}")">
                        <span class="nome">@azienda.Nome</span>
                        @if (!string.IsNullOrWhiteSpace(azienda.Comune))
                        {
                            <span class="dettaglio">@azienda.Comune (@azienda.Provincia)</span>
                        }
                        <span class="freccia" aria-hidden="true">→</span>
                    </a>
                </li>
            }
        </ul>
    }
</div>

@code {
    private List<AziendaDto>? _aziende;

    protected override async Task OnInitializedAsync()
    {
        _aziende = (await AziendeApiClient.GetAziendeAsync())
            .OrderBy(a => a.Nome, StringComparer.CurrentCultureIgnoreCase).ToList();
    }
}

@page "/mappa/{AziendaId:int}"
@using Microsoft.Extensions.Options
@using ProgettoMappe.Web.Options
@inject VignetiApiClient VignetiApiClient
@inject IJSRuntime JsRuntime
@inject IOptions<MapOptions> MapOptionsAccessor
@implements IAsyncDisposable

<PageTitle>Mappa vigneti</PageTitle>

<div class="mappa-layout">
    <aside class="vigneti-list">
        <h1>Vigneti</h1>

        @if (_vigneti is null)
        {
            <p>Caricamento...</p>
        }
        else if (_vigneti.Count == 0)
        {
            <p>Nessun vigneto trovato per questa azienda.</p>
        }
        else
        {
            <ul>
                @foreach (var vigneto in _vigneti)
                {
                    <li class="@(vigneto.Id == _vignetoSelezionatoId ? "selezionato" : "")">
                        <button type="button" @onclick="() => SelezionaVignetoAsync(vigneto.Id)">
                            @vigneto.Nome
                        </button>
                    </li>
                }
            </ul>
        }

        @if (_vignetoSelezionato is not null)
        {
            <div class="info-panel">
                <h2>@_vignetoSelezionato.Nome</h2>
                @if (!string.IsNullOrWhiteSpace(_vignetoSelezionato.Varieta))
                {
                    <p>Varietà: @_vignetoSelezionato.Varieta</p>
                }
                @if (_vignetoSelezionato.SuperficieEttari is not null)
                {
                    <p>Superficie: @_vignetoSelezionato.SuperficieEttari ha</p>
                }
            </div>
        }
    </aside>

    <div id="@_mapElementId" class="mappa"></div>
</div>

@code {
    [Parameter]
    public int AziendaId { get; set; }

    private readonly string _mapElementId = $"mappa-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private DotNetObjectReference<Mappa>? _dotNetRef;
    private List<VignetoDto>? _vigneti;
    private VignetoDto? _vignetoSelezionato;
    private int? _vignetoSelezionatoId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var opzioni = MapOptionsAccessor.Value;
        _module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/mappa.js");
        _dotNetRef = DotNetObjectReference.Create(this);

        await _module.InvokeVoidAsync("creaMappa", _mapElementId, new
        {
            styleUrl = opzioni.StyleUrl,
            centro = opzioni.CentroIniziale,
            zoom = opzioni.ZoomIniziale,
            terrainSourceUrl = opzioni.TerrainSourceUrl,
            terrainTileSize = opzioni.TerrainTileSize,
            terrainExaggeration = opzioni.TerrainExaggeration,
        }, _dotNetRef);

        _vigneti = await VignetiApiClient.GetVignetiPerAziendaAsync(AziendaId);
        var geojson = await VignetiApiClient.GetVignetiGeoJsonAsync(AziendaId);
        await _module.InvokeVoidAsync("mostraVigneti", _mapElementId, geojson);

        StateHasChanged();
    }

    private Task SelezionaVignetoAsync(int vignetoId) => ApplicaSelezioneAsync(vignetoId, volaSullaMappa: true);

    /// <summary>Richiamato dal JS quando l'utente clicca un vigneto direttamente sulla mappa.</summary>
    [JSInvokable]
    public async Task OnVignetoCliccato(int vignetoId)
    {
        await ApplicaSelezioneAsync(vignetoId, volaSullaMappa: false);
        StateHasChanged();
    }

    private async Task ApplicaSelezioneAsync(int vignetoId, bool volaSullaMappa)
    {
        _vignetoSelezionatoId = vignetoId;
        _vignetoSelezionato = _vigneti?.FirstOrDefault(v => v.Id == vignetoId);

        if (volaSullaMappa && _module is not null)
        {
            await _module.InvokeVoidAsync("selezionaVigneto", _mapElementId, vignetoId);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("distruggiMappa", _mapElementId);
            }
            catch (JSDisconnectedException)
            {
                // Il circuito Blazor è già stato chiuso (es. navigazione via): nulla da ripulire lato client.
            }

            await _module.DisposeAsync();
        }
    }
}

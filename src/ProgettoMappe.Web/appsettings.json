{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Api": {
    "BaseUrl": "https://localhost:7001"
  },
  "Map": {
    "CentroIniziale": [ 11.0, 43.5 ],
    "ZoomIniziale": 12,
    "BasemapPredefinita": "openfreemap-liberty",
    "BasemapFallback": "openfreemap-liberty",
    "ImageryPredefinita": "esri-world-imagery",
    "TerrainPredefinito": "mapterhorn",
    "TerrainExaggeration": 1.2,
    "TimeoutStyleSecondi": 10,
    "Sorgenti": {
      "openfreemap-liberty": {
        "Nome": "OpenFreeMap Liberty",
        "Ruolo": "Basemap",
        "Tipo": "style",
        "StyleUrl": "https://tiles.openfreemap.org/styles/liberty",
        "Attribution": "<a href=\"https://openfreemap.org\" target=\"_blank\">OpenFreeMap</a> <a href=\"https://www.openmaptiles.org/\" target=\"_blank\">&copy; OpenMapTiles</a> Data from <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\">OpenStreetMap</a>"
      },
      "openfreemap-positron": {
        "Nome": "OpenFreeMap Positron",
        "Ruolo": "Basemap",
        "Tipo": "style",
        "StyleUrl": "https://tiles.openfreemap.org/styles/positron",
        "Attribution": "<a href=\"https://openfreemap.org\" target=\"_blank\">OpenFreeMap</a> <a href=\"https://www.openmaptiles.org/\" target=\"_blank\">&copy; OpenMapTiles</a> Data from <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\">OpenStreetMap</a>"
      },
      "esri-world-imagery": {
        "Nome": "Esri World Imagery",
        "Ruolo": "Imagery",
        "Tipo": "raster",
        "TileUrl": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
        "TileSize": 256,
        "MaxZoom": 19,
        "Attribution": "Powered by <a href=\"https://www.esri.com\" target=\"_blank\">Esri</a> | Source: Esri, Maxar, Earthstar Geographics, and the GIS User Community"
      },
      "mapterhorn": {
        "Nome": "Mapterhorn",
        "Ruolo": "Terrain",
        "Tipo": "raster-dem",
        "TileUrl": "https://tiles.mapterhorn.com/{z}/{x}/{y}.webp",
        "Encoding": "terrarium",
        "TileSize": 512,
        "MaxZoom": 12,
        "Attribution": "<a href=\"https://mapterhorn.com/attribution\" target=\"_blank\">&copy; Mapterhorn</a>"
      }
    },
    "ApiKeys": {}
  }
}

@page "/mappa/{AziendaId:int}"
@using Microsoft.Extensions.Options
@using ProgettoMappe.Web.Options
@using ProgettoMappe.Web.Tematismi
@using ProgettoMappe.Web.Filtri
@using ProgettoMappe.Web.Formati
@using System.Globalization
@using System.Net
@using System.Text.Json
@using Microsoft.Extensions.Logging
@inject VignetiApiClient VignetiApiClient
@inject ILogger<Mappa> Logger
@inject AziendeApiClient AziendeApiClient
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime
@inject IOptions<MapOptions> MapOptionsAccessor
@inject ConfigurazioneMappa Configurazione
@inject IOptions<PortaleFourGrapesOptions> PortaleAccessor
@inject CatalogoTematismi Catalogo
@implements IAsyncDisposable

<PageTitle>Mappa vigneti</PageTitle>

<div id="@($"{_mapElementId}-layout")" class="mappa-layout">
    @* Su desktop è la barra laterale; su mobile un pannello a scomparsa dal basso (vedi app.css). *@
    <aside id="@($"{_mapElementId}-pannello")" class="vigneti-list @(_pannelloAperto ? "aperto" : "")" aria-label="Filtri e vigneti">
        <div class="pannello-intestazione solo-mobile">
            <span class="titolo-sezione">Filtri e vigneti</span>
            <button type="button" class="chiudi" aria-label="Chiudi pannello" @onclick="() => _pannelloAperto = false">×</button>
        </div>
        <section class="scheda ricerca" role="search">
            <label for="@($"{_mapElementId}-cerca")" class="titolo-sezione">Cerca</label>
            <input id="@($"{_mapElementId}-cerca")" type="search" autocomplete="off" spellcheck="false"
                   placeholder="Azienda, vigna o vigneto" role="combobox" aria-autocomplete="list"
                   aria-expanded="@(_risultatiRicerca.Count > 0)" aria-controls="@($"{_mapElementId}-risultati")"
                   aria-activedescendant="@(_risultatiRicerca.Count > 0 ? IdRisultato(_risultatoAttivo) : null)"
                   @bind="TestoRicerca" @bind:event="oninput" @bind:after="AggiornaRicerca" @onkeydown="TastoRicercaAsync" />
            @if (_risultatiRicerca.Count > 0)
            {
                <ul id="@($"{_mapElementId}-risultati")" class="risultati-ricerca" role="listbox" aria-label="Risultati">
                    @for (var i = 0; i < _risultatiRicerca.Count; i++)
                    {
                        var risultato = _risultatiRicerca[i];
                        var indice = i;
                        <li id="@IdRisultato(indice)" role="option" aria-selected="@(indice == _risultatoAttivo)"
                            class="@(indice == _risultatoAttivo ? "attivo" : "")">
                            <button type="button" tabindex="-1" @onclick="() => ScegliRisultatoAsync(risultato)">
                                <span class="tipo">@EtichettaTipo(risultato.Tipo)</span>
                                <span class="nome">@risultato.Nome</span>
                                @if (risultato.Dettaglio is not null)
                                {
                                    <span class="dettaglio">@risultato.Dettaglio</span>
                                }
                            </button>
                        </li>
                    }
                </ul>
            }
            else if (RicercaMappa.Normalizza(TestoRicerca).Length >= RicercaMappa.LettereMinime)
            {
                <p class="nota">Nessun risultato@(_aziende is null ? " (elenco aziende non ancora disponibile)" : "").</p>
            }
        </section>

        <section class="scheda tematismo-controlli filtri">
            <h2 class="titolo-sezione">Filtri</h2>
            <label>
                Gruppo
                <select @bind="GruppoFiltro" @bind:after="GruppoCambiato" disabled="@(_gruppi is null || _aziende is null)">
                    <option value="">Tutti i gruppi</option>
                    @foreach (var gruppo in _gruppi ?? [])
                    {
                        @* selected anche qui: il gruppo può arrivare dal link prima delle opzioni. *@
                        <option value="@gruppo.Id" selected="@(gruppo.Id.ToString(CultureInfo.InvariantCulture) == GruppoFiltro)">@FiltriAziende.Etichetta(gruppo, FiltriAziende.DelGruppo(_aziende ?? [], gruppo).Count)</option>
                    }
                </select>
            </label>
            <label>
                Azienda
                <select value="@AziendaId" @onchange="CambiaAzienda" disabled="@(_aziende is null)">
                    @if (_aziende is null)
                    {
                        <option value="@AziendaId">@(_erroreAziende ? "Elenco non disponibile" : "Caricamento…")</option>
                    }
                    else
                    {
                        @* selected sull'opzione (non solo value sul select): le opzioni arrivano dopo il primo render. *@
                        @foreach (var azienda in AziendeVisibili)
                        {
                            <option value="@azienda.Id" selected="@(azienda.Id == AziendaId)">@azienda.Nome</option>
                        }
                    }
                </select>
            </label>
            @if (_erroreAziende)
            {
                <p class="nota">
                    Non riesco a leggere le aziende da 4Grapes.
                    <button type="button" class="riprova" @onclick="RiprovaElencoAziende">Riprova</button>
                </p>
            }
            <label>
                Vigna
                <select @bind="VignaFiltro" @bind:after="FiltriCambiatiAsync" disabled="@(_vigneti is null)">
                    <option value="">Tutte (@(_vigneti?.Count ?? 0))</option>
                    @foreach (var vigna in _opzioniVigne)
                    {
                        <option value="@vigna.Id">@vigna.Nome (@vigna.Conteggio)</option>
                    }
                </select>
            </label>
            <label>
                Vitigno
                <select @bind="VitignoFiltro" @bind:after="FiltriCambiatiAsync" disabled="@(_vigneti is null)">
                    <option value="">Tutti</option>
                    @foreach (var vitigno in _opzioniVitigni)
                    {
                        <option value="@vitigno.Id">@vitigno.Nome (@vitigno.Conteggio)</option>
                    }
                </select>
            </label>
        </section>

        <section class="scheda tematismo-controlli">
            <h2 class="titolo-sezione">Mappe tematiche</h2>
            <label>
                Colora per
                <select @bind="TematismoId" @bind:after="ParametroCambiatoAsync" disabled="@(!_indiciPronti && !_statistichePronte)">
                    <option value="">Nessun parametro</option>
                    @foreach (var gruppo in Catalogo.Tutti.GroupBy(t => t.Gruppo))
                    {
                        <optgroup label="@gruppo.Key">
                            @foreach (var t in gruppo)
                            {
                                <option value="@t.Id" disabled="@(!FontePronta(t.Fonte))">@t.Nome</option>
                            }
                        </optgroup>
                    }
                </select>
            </label>
            @if (TematismoAttivo is not { SenzaAnno: true })
            {
                <label class="spunta">
                    <input type="checkbox" checked="@Confronto" @onchange="ConfrontoCambiatoAsync"
                           disabled="@(TematismoAttivo is null || AnniCursore.Count < 2)" />
                    Confronta due anni
                </label>
            }
            @if (Confronto)
            {
                <label>
                    Dal
                    <select @bind="AnnoDa" @bind:after="TematismoCambiatoAsync">
                        @foreach (var a in AnniCursore)
                        {
                            <option value="@a">@a@(a == _annoCorrente ? " (in corso)" : "")</option>
                        }
                    </select>
                </label>
            }
            @if (TematismoAttivo is { SenzaAnno: true })
            {
                <p class="nota">Un valore per vigneto, senza anno.</p>
            }
            else if (Anno is { } annoCursore && AnniCursore.Count > 0)
            {
                var anniCursore = AnniCursore;
                var anniCrescenti = anniCursore.OrderBy(a => a).ToList();
                var precedente = ConfrontoBigot.AnnoVicino(anniCursore, annoCursore, -1);
                var successivo = ConfrontoBigot.AnnoVicino(anniCursore, annoCursore, +1);
                <div class="cursore-anni">
                    <span class="etichetta" id="@($"{_mapElementId}-anno")">
                        @(Confronto ? "Al" : "Anno") <strong>@annoCursore</strong>@(annoCursore == _annoCorrente ? " (in corso)" : "")
                    </span>
                    <div class="cursore-riga">
                        <button type="button" aria-label="Anno precedente" disabled="@(precedente is null)"
                                @onclick="() => ScegliAnnoAsync(precedente)">◀</button>
                        @* Il cursore scorre sugli anni disponibili (posizione nell'elenco), anche se ne manca qualcuno. *@
                        <input type="range" min="0" max="@(anniCrescenti.Count - 1)" step="1" value="@anniCrescenti.IndexOf(annoCursore)"
                               aria-labelledby="@($"{_mapElementId}-anno")" aria-valuetext="@annoCursore"
                               disabled="@(anniCrescenti.Count < 2)" @oninput="e => CursoreAnnoAsync(e, anniCrescenti)" />
                        <button type="button" aria-label="Anno successivo" disabled="@(successivo is null)"
                                @onclick="() => ScegliAnnoAsync(successivo)">▶</button>
                    </div>
                    <div class="cursore-estremi"><span>@anniCrescenti[0]</span><span>@anniCrescenti[^1]</span></div>
                </div>
                @if (Confronto && AnnoDa == annoCursore)
                {
                    <p class="nota">Scegli due anni diversi.</p>
                }
            }
            @if (!_indiciPronti)
            {
                <p class="nota">@(_statoIndici ?? "Indici BIGOT in caricamento…")</p>
            }
            else if (_anni.Count == 0)
            {
                <p class="nota">Nessun indice BIGOT per i vigneti di questa azienda.</p>
            }
            @if (!_statistichePronte)
            {
                <p class="nota">@(_statoStatistiche ?? "Rischi, vigoria e potenziale idrico in caricamento…")</p>
            }
        </section>

        <section class="scheda elenco-vigneti">
            <h2 class="titolo-sezione">
                Vigneti
                @if (_vigneti is { Count: > 0 })
                {
                    <span class="contatore">@_vignetiFiltrati.Count@(_vignetiFiltrati.Count != _vigneti.Count ? $" / {_vigneti.Count}" : "")</span>
                }
            </h2>
            @if (_erroreVigneti is null && _vignetiFiltrati.Any(v => v.HaGeometria))
            {
                var daScaricare = _vignetiFiltrati.Count(v => v.HaGeometria);
                var senzaGeometria = _vignetiFiltrati.Count - daScaricare;
                <details class="scarica">
                    <summary>Scarica @(FiltroAttivo ? "i vigneti filtrati" : "tutti i vigneti") (@daScaricare)</summary>
                    <ul>
                        @foreach (var formato in EsportazioneVigneti.Formati)
                        {
                            <li><a href="@LinkEsportazione(formato.Id)" download>@formato.Nome</a></li>
                        }
                    </ul>
                    <p class="nota">
                        WGS84, con vigna, vitigno, superficie@(Anno is { } annoFile ? $", indice BIGOT, rischi e vigoria {annoFile}" : ""), potenziale idrico.
                        @if (senzaGeometria > 0)
                        {
                            @($" {senzaGeometria} vigneti senza geometria non sono inclusi.")
                        }
                    </p>
                </details>
            }
            @if (_erroreVigneti is not null)
            {
                <p class="nota">Vigneti non disponibili.</p>
            }
            else if (_vigneti is null)
            {
                <p class="nota">Carico i vigneti…</p>
            }
            else if (_vigneti.Count == 0)
            {
                <p class="nota">Nessun vigneto trovato per questa azienda.</p>
            }
            else if (_vignetiFiltrati.Count == 0)
            {
                <p class="nota">Nessun vigneto corrisponde ai filtri.</p>
            }
            else
            {
                <ul>
                    @foreach (var vigneto in _vignetiFiltrati)
                    {
                        <li id="@IdVoceElenco(vigneto.Id)" class="@(vigneto.Id == _vignetoSelezionatoId ? "selezionato" : "")">
                            <button type="button" @onclick="() => SelezionaVignetoAsync(vigneto.Id)">
                                <span class="nome">@vigneto.Nome</span>
                                @if (!string.IsNullOrWhiteSpace(vigneto.Varieta))
                                {
                                    <span class="dettaglio">@vigneto.Varieta</span>
                                }
                                @if (vigneto.GeometriaNonAttendibile)
                                {
                                    <span class="dettaglio avviso">geometria non attendibile</span>
                                }
                            </button>
                        </li>
                    }
                </ul>
            }
        </section>
    </aside>

    <div class="mappa-area">
        <div id="@_mapElementId" class="mappa"></div>

        @* Mai una mappa vuota muta: o si sta caricando, o si dice perché non ci sono vigneti. *@
        @if (_erroreVigneti is not null)
        {
            <div class="mappa-stato errore" role="alert">
                <p>@_erroreVigneti</p>
                <button type="button" class="pulsante-principale" @onclick="RiprovaAsync">Riprova</button>
            </div>
        }
        else if (_vigneti is null)
        {
            <div class="mappa-stato" role="status">
                <p>Carico i vigneti…</p>
            </div>
        }

        @* L'ora dei dati che la mappa sta mostrando: statistiche se il parametro è loro, altrimenti BIGOT. *@
        @if ((TematismoAttivo is { Fonte: not FonteTematismo.Bigot } ? _aggiornamentoStatistiche : _aggiornamentoBigot) is { } aggiornamento)
        {
            <div class="mappa-aggiornamento">@aggiornamento</div>
        }

        <div class="mappa-controlli">
            <button type="button" class="solo-mobile apri-pannello" aria-expanded="@_pannelloAperto"
                    aria-controls="@($"{_mapElementId}-pannello")" @onclick="() => _pannelloAperto = !_pannelloAperto">
                ☰ Filtri
                @if (_vigneti is { Count: > 0 })
                {
                    <span class="contatore">@_vignetiFiltrati.Count</span>
                }
            </button>
            <div class="gruppo-pulsanti" role="group" aria-label="Tipo di mappa">
                <button type="button" class="@(_satellite ? "" : "attivo")" aria-pressed="@(!_satellite)"
                        @onclick="() => ImpostaSatelliteAsync(false)">Mappa</button>
                <button type="button" class="@(_satellite ? "attivo" : "")" aria-pressed="@_satellite"
                        disabled="@(_imageryId is null)" @onclick="() => ImpostaSatelliteAsync(true)">Satellite</button>
            </div>
            <button type="button" class="@(_terreno ? "attivo" : "")" aria-pressed="@_terreno"
                    disabled="@(Configurazione.TerrainId is null)" @onclick="CommutaTerrenoAsync">3D</button>
            @* La copia la fa mappa.js nel click stesso (Safari/iOS la permettono solo lì): vedi collegaCopiaLink. *@
            <button type="button" data-copia-link="mappa" class="@(_linkCopiato == "mappa" ? "attivo" : "")"
                    title="Copia l'indirizzo di questa vista: chi lo apre vede la stessa mappa">@(_linkCopiato == "mappa" ? "Copiato ✓" : "Copia link")</button>

            @if (Configurazione.ModalitaSviluppatore)
            {
                <select aria-label="Basemap (sviluppo)" value="@_basemapId" @onchange="CambiaBasemapAsync">
                    <option value="@IdStyleInterno">Interno (offline)</option>
                    @foreach (var basemap in Configurazione.DelRuolo(RuoloSorgente.Basemap))
                    {
                        <option value="@basemap.Id">@basemap.Nome</option>
                    }
                </select>
                <select aria-label="Imagery (sviluppo)" value="@_imageryId" @onchange="CambiaImageryAsync">
                    @foreach (var imagery in Configurazione.DelRuolo(RuoloSorgente.Imagery))
                    {
                        <option value="@imagery.Id">@imagery.Nome</option>
                    }
                </select>
            }
        </div>

        @if (_vignetoSelezionato is not null)
        {
            var sottotitolo = string.Join(" · ", new[] { _vignetoSelezionato.Vigna, NomeAzienda }.Where(s => !string.IsNullOrWhiteSpace(s)));
            var link4Grapes = PortaleFourGrapesOptions.Link(PortaleAccessor.Value.IndirizzoVigneto, _vignetoSelezionato.Id);
            @* Su mobile la maniglia trascina la scheda su (espansa) e giù (ridotta): vedi collegaTrascinamentoScheda. *@
            <div class="info-panel" aria-label="Dettaglio vigneto">
                <button type="button" class="info-maniglia solo-mobile" aria-label="Espandi o riduci la scheda" aria-expanded="false"></button>
                <div class="info-intestazione">
                    <div class="info-titoli">
                        <h2>@_vignetoSelezionato.Nome</h2>
                        @if (sottotitolo != "")
                        {
                            <p class="info-sottotitolo">@sottotitolo</p>
                        }
                    </div>
                    <button type="button" class="chiudi" aria-label="Chiudi dettaglio" @onclick="DeselezionaAsync">×</button>
                </div>
                <dl class="info-dati">
                    @if (!string.IsNullOrWhiteSpace(_vignetoSelezionato.Varieta))
                    {
                        <dt>Vitigno</dt><dd>@_vignetoSelezionato.Varieta</dd>
                    }
                    <dt>Superficie</dt>
                    <dd class="@(_vignetoSelezionato.SuperficieEttari is null ? "nota" : null)">@FormatoSuperficie.Testo(_vignetoSelezionato.SuperficieEttari)</dd>
                    @if (_vignetoSelezionato.AnnoImpianto is { } annoImpianto)
                    {
                        <dt>Impianto</dt><dd>@annoImpianto</dd>
                    }
                </dl>
                <div class="info-azioni">
                    @if (link4Grapes is not null)
                    {
                        <a class="pulsante" href="@link4Grapes" target="_blank" rel="noopener noreferrer">Apri in 4Grapes</a>
                    }
                    @* Copia l'indirizzo, che contiene il vigneto: chi lo apre trova la scheda aperta (vedi collegaCopiaLink). *@
                    <button type="button" class="pulsante @(_linkCopiato == "scheda" ? "attivo" : "")" data-copia-link="scheda"
                            title="Copia il link a questa scheda">@(_linkCopiato == "scheda" ? "Copiato ✓" : "Copia link")</button>
                </div>
                @if (_vignetoSelezionato.GeometriaNonAttendibile)
                {
                    <p class="nota">Geometria non attendibile: in 4Grapes il poligono è troppo grande per un vigneto, quindi non è mostrato sulla mappa.</p>
                }
                else if (!_vignetoSelezionato.HaGeometria)
                {
                    <p class="nota">Geometria non disponibile</p>
                }

                @if (Confronto && TematismoAttivo is { } temaScheda && Anno is { } annoAl && AnnoDa is { } annoDal && RigheDi(temaScheda.Fonte) is { } righeConfronto)
                {
                    <p class="confronto-scheda">
                        <strong>@temaScheda.Nome</strong>
                        @ConfrontoBigot.RigaScheda(temaScheda, righeConfronto, _vignetoSelezionato.Id, annoDal, annoAl)
                    </p>
                }
                @if (_statistichePronte && _statistiche is not null
                     && SchedaBigot.RigheStatistiche(Catalogo.Statistiche, _statistiche, _vignetoSelezionato.Id, Anno) is { Count: > 0 } righeStatistiche)
                {
                    <h3 class="titolo-sezione">Rischi e vigoria @Anno</h3>
                    <table class="valori-bigot">
                        @foreach (var (etichetta, valore) in righeStatistiche)
                        {
                            <tr>
                                <th>@etichetta</th>
                                <td><span class="valore-colore">@CampioneColore(valore.Colore)@valore.Testo</span></td>
                            </tr>
                        }
                    </table>
                }
                @if (_indiciPronti && Anno is { } annoPannello && _indici is not null)
                {
                    var riga = _indici.FirstOrDefault(r => r.IdVigneto == _vignetoSelezionato.Id && r.Anno == annoPannello);
                    var anniPrecedenti = SchedaBigot.Precedenti(_anni, annoPannello)
                        .Where(a => _indici.Any(r => r.IdVigneto == _vignetoSelezionato.Id && r.Anno == a)).ToList();
                    var righeScheda = SchedaBigot.Righe(_indici, _vignetoSelezionato.Id, annoPannello, anniPrecedenti);
                    <h3 class="titolo-sezione">Indice BIGOT @annoPannello</h3>
                    @if (riga is null)
                    {
                        <p class="nota">Nessun dato per questo anno.</p>
                    }
                    else
                    {
                        @* Stesso testo e stesso colore della legenda di ciascun parametro (vedi SchedaBigot). *@
                        <table class="valori-bigot">
                            @foreach (var r in righeScheda)
                            {
                                <tr class="@(r == righeScheda[0] ? "evidenza" : null)">
                                    <th>@r.Etichetta</th>
                                    <td><span class="valore-colore">@CampioneColore(r.Valore.Colore)@r.Valore.Testo</span></td>
                                </tr>
                                @if (r == righeScheda[0])
                                {
                                    <tr><th>Parametri</th><td>@Testo(riga.NumParametri) / @TematismiBigot.ParametriTotali</td></tr>
                                }
                            }
                        </table>
                    }
                    @if (anniPrecedenti.Count > 0)
                    {
                        <table class="valori-bigot precedenti" aria-label="Anni precedenti">
                            <thead>
                                <tr><th>Anni precedenti</th>@foreach (var a in anniPrecedenti) { <th scope="col">@a</th> }</tr>
                            </thead>
                            <tbody>
                                @foreach (var r in righeScheda)
                                {
                                    <tr>
                                        <th scope="row">@r.Etichetta</th>
                                        @foreach (var v in r.Precedenti)
                                        {
                                            <td title="@v.Testo"><span class="valore-colore">@CampioneColore(v.Colore)@v.Testo</span></td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                }
            </div>
        }

        @if (TematismoAttivo is { } tema && (tema.SenzaAnno || Anno is not null))
        {
            <div class="mappa-legenda" aria-label="Legenda">
                <strong>@tema.Nome@(tema.SenzaAnno ? "" : Confronto ? $" — {AnnoDa} → {Anno}" : $" — {Anno}")</strong>
                @if ((Confronto ? ConfrontoBigot.Nota(tema) : tema.Nota) is { } notaLegenda)
                {
                    <p class="nota">@notaLegenda</p>
                }
                <ul>
                    @foreach (var voce in VociLegenda(tema, Confronto))
                    {
                        var conteggio = _conteggi.GetValueOrDefault(voce.Classe);
                        var attiva = _classeFiltro == voce.Classe;
                        <li>
                            <button type="button" class="@(attiva ? "attiva" : _classeFiltro is null ? "" : "spenta")" aria-pressed="@attiva"
                                    disabled="@(conteggio == 0 && !attiva)" title="@(attiva ? "Mostra di nuovo tutti i vigneti" : "Mostra solo questi vigneti")"
                                    @onclick="() => ClasseLegendaAsync(voce.Classe)">
                                <span class="campione @voce.Css" style="@(voce.Colore is null ? null : $"background-color: {voce.Colore}")"></span>
                                <span class="etichetta">@voce.Testo</span>
                                <span class="conteggio">(@conteggio)</span>
                            </button>
                        </li>
                    }
                </ul>
                <p class="nota">@(_classeFiltro is null ? "Clic su una voce per vedere solo quei vigneti." : "Clic di nuovo sulla voce per vederli tutti.")</p>
            </div>
        }

        @if (_avviso is not null || _avvisoSfondo)
        {
            <div class="mappa-avvisi">
                @if (_avviso is not null)
                {
                    <div class="mappa-avviso" role="status">
                        <span>@_avviso</span>
                        <button type="button" aria-label="Chiudi avviso" @onclick="() => _avviso = null">×</button>
                    </div>
                }
                @if (_avvisoSfondo)
                {
                    <div class="mappa-avviso" role="status">
                        <span>@AvvisoSfondo</span>
                        <button type="button" aria-label="Chiudi avviso" @onclick="() => _avvisoSfondo = false">×</button>
                    </div>
                }
            </div>

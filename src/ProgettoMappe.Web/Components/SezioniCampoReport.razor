@* Report fine stagione, tappa 3 (task #201): sezione II «Gestione Idrica» (foglio 42, capacità idrica del suolo)
   e III «Scottature» (fogli 43–44), numeri da CalcoloCampoReport sullo snapshot del dba. *@
@using System.Globalization
@using ProgettoMappe.Contracts
@using ProgettoMappe.Web.ReportFineStagione

<section class="ib-sezione">
    <h2>II. @SezioniReport.Titolo(SezioniReport.Tutte[1], Lingua, Annata)</h2>
    @if (Campo is not null)
    {
        var rilievi = Campo.Rilievi ?? [];
        <h3>@T("apici.titolo")</h3>
        var apici = CalcoloStatoIdricoReport.TreAnni(rilievi, Annata);
        if (apici.All(a => a.Valore is null))
        {
            <p class="nota">@T("apici.nessuno")</p>
        }
        else
        {
            <div class="ib-quadranti rfs-quadranti">
                @foreach (var a in apici)
                {
                    <Contachilometri Scala="CalcoloStatoIdricoReport.Scala" Valore="a.Valore" Titolo="@T("apici.anno", a.Anno)"
                        Testo="@(a.Classe is { } c ? $"{T("apici.testo", T($"apici.{c}"))} · {N(a.Valore, "N2")}" : null)" />
                }
            </div>
            @LineeSettimane(T("apici.andamento"), CalcoloStatoIdricoReport.PerVigna(rilievi, Campo.Vigneti, Annata))
            <h3>@T("apici.storico")</h3>
            @LineeSettimane(T("apici.andamento"), CalcoloStatoIdricoReport.Storico(rilievi, Annata))
        }
    }
    <h3>@T("suolo.titolo")</h3>
    @if (Campo is null)
    {
        <p class="nota">@T("campo.non-disponibile")</p>
    }
    else if (Campo.Suolo.Count == 0)
    {
        <p class="nota">@T("suolo.nessuno")</p>
    }
    else
    {
        var s = CalcoloCampoReport.Suolo(Campo.Suolo);
        <div class="rfs-kpi">
            @Kpi(T("suolo.capacita"), N(s.CapacitaDiCampo))
            @Kpi(T("suolo.pietrosita"), N(s.Pietrosita))
            @Kpi(T("suolo.awc"), N(s.AcquaDisponibile))
            @Kpi(T("suolo.appassimento"), N(s.PuntoDiAppassimento))
            @Kpi(T("suolo.profondita"), N(s.Profondita, "N2"))
            @Kpi(T("suolo.awc-vigneto"), N(s.AwcRealeVigneto))
            @Kpi(T("suolo.conducibilita"), N(s.Conducibilita, "N2"))
        </div>
        <div class="ib-tabella-scorre">
            <table class="ib-tabella">
                <thead>
                    <tr>
                        <th>@T("suolo.vigna")</th>
                        <th>@T("suolo.vigneto")</th>
                        <th class="numero">@T("suolo.capacita")</th>
                        <th class="numero">@T("suolo.awc")</th>
                        <th class="numero">@T("suolo.appassimento")</th>
                        <th class="numero">@T("suolo.profondita")</th>
                        <th class="numero">@T("suolo.pietrosita")</th>
                        <th class="numero">@T("suolo.awc-vigneto")</th>
                        <th class="numero">@T("suolo.awc-vigna")</th>
                        <th class="numero">@T("suolo.conducibilita")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in Campo.Suolo)
                    {
                        <tr>
                            <td>@v.Vigna</td>
                            <td>@v.Nome</td>
                            <td class="numero">@N(v.CapacitaDiCampo)</td>
                            <td class="numero">@N(v.AcquaDisponibile)</td>
                            <td class="numero">@N(v.PuntoDiAppassimento)</td>
                            <td class="numero">@N(v.Profondita, "N2")</td>
                            <td class="numero">@N(v.Pietrosita)</td>
                            <td class="numero">@N(v.AwcRealeVigneto)</td>
                            <td class="numero">@N(v.AwcRealeVigna)</td>
                            <td class="numero">@N(v.Conducibilita, "N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="ib-sezione">
    <h2>III. @SezioniReport.Titolo(SezioniReport.Tutte[2], Lingua, Annata)</h2>
    @if (Campo is null)
    {
        <p class="nota">@T("campo.non-disponibile")</p>
    }
    else
    {
        @Scottature(T("scottature.media"), CalcoloCampoReport.Scottature(Campo.ScottatureVista, Campo.Superfici, Annata))
        @Scottature(T("scottature.max"), CalcoloCampoReport.Scottature(Campo.ScottatureRilievi, Campo.Superfici, Annata))
    }
</section>

<section class="ib-sezione">
    <h2>IV. @SezioniReport.Titolo(SezioniReport.Tutte[3], Lingua, Annata)</h2>
    @if (Campo is null)
    {
        <p class="nota">@T("campo.non-disponibile")</p>
    }
    else if (Campo.Vigoria.Count == 0)
    {
        <p class="nota">@T("vigoria.nessuna")</p>
    }
    else
    {
        var anni = CalcoloVigoriaReport.TreAnni(Campo.Vigoria, Annata);
        var corrente = anni[0];
        <div class="rfs-kpi">
            @Kpi(T("vigoria.legno"), N(corrente.LegnoPotatura, "N2"))
            @Kpi(T("vigoria.sfe"), N(corrente.SfePerMetro, "N2"))
            @Kpi(T("vigoria.visiva"), N(corrente.StatoVegetativo, "N2"))
            @Kpi(T("vigoria.chioma"), N(corrente.GestioneChioma, "N2"))
            @Kpi(T("vigoria.indice"), N(corrente.Punteggio, "N2"))
        </div>
        <div class="ib-quadranti rfs-quadranti">
            @foreach (var a in anni)
            {
                <Contachilometri Scala="CalcoloVigoriaReport.Scala" Valore="a.Punteggio" Titolo="@T("vigoria.media", a.Anno)"
                    Testo="@(a.Classe is { } c ? $"{T($"classe.{c}")} · {N(a.Punteggio, "N2")}" : null)" />
            }
        </div>
        <h3>@T("vigoria.per-vigneto")</h3>
        var perVigneto = CalcoloVigoriaReport.PerVignetoEAnno(Campo.Vigoria);
        var anniTabella = perVigneto.Keys.Select(k => k.Anno).Where(a => a <= Annata).Distinct().Order().ToList();
        <div class="ib-tabella-scorre">
            <table class="ib-tabella">
                <thead>
                    <tr>
                        <th>@T("suolo.vigneto")</th>
                        @foreach (var a in anniTabella)
                        {
                            <th class="numero">@a</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var id in perVigneto.Keys.Select(k => k.IdVigneto).Distinct().OrderBy(Nome))
                    {
                        <tr>
                            <td>@Nome(id)</td>
                            @foreach (var a in anniTabella)
                            {
                                <td class="numero">@(perVigneto.TryGetValue((id, a), out var p) ? p.ToString("N1", Cultura) : "")</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="ib-sezione">
    <h2>VI. @SezioniReport.Titolo(SezioniReport.Tutte[5], Lingua, Annata)</h2>
    @if (Campo is null)
    {
        <p class="nota">@T("campo.non-disponibile")</p>
    }
    else
    {
        <h3>@T("chioma.ultimi-due")</h3>
        <div class="rfs-chioma">
            @foreach (var a in new[] { Annata, Annata - 1 }.Select(x => CalcoloChiomaReport.Anno(Campo, x)))
            {
                <div>
                    <h4>@a.Anno</h4>
                    <div class="rfs-kpi">
                        @Kpi(T("chioma.sfe"), N(a.Sfe, "N2") + (a.SfeDevSt is { } d ? $" ({T("chioma.devst", d.ToString("N2", Cultura))})" : ""))
                        @Kpi(T("chioma.altezza"), N(a.AltezzaCm, "N0"))
                        @Kpi(T("chioma.spazi"), a.SpaziVuoti is { } s ? s.ToString("P0", Cultura) : "—")
                        @Kpi(T("chioma.ordine"), a.OrdineGermogli is { } o ? o.ToString("P0", Cultura) : "—")
                    </div>
                </div>
            }
        </div>
        var punti = CalcoloChiomaReport.SfeProduzione(Campo, Annata);
        @if (punti.Count > 0)
        {
            <h3>@T("chioma.sfe-produzione")</h3>
            <div class="ib-tabella-scorre">
                <table class="ib-tabella">
                    <thead><tr><th>@T("suolo.vigneto")</th><th class="numero">@T("chioma.sfe")</th><th class="numero">@T("chioma.produzione")</th><th class="numero">@T("chioma.ettari")</th></tr></thead>
                    <tbody>
                        @foreach (var p in punti.OrderBy(p => Nome(p.IdVigneto)))
                        {
                            <tr><td>@Nome(p.IdVigneto)</td><td class="numero">@N(p.Sfe, "N2")</td><td class="numero">@N(p.Produzione, "N2")</td><td class="numero">@N(p.Ettari, "N2")</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <h3>@T("sfe.fattori")</h3>
        var fattori = CalcoloChiomaReport.Fattori(Campo, Annata);
        @if (fattori.Count == 0)
        {
            <p class="nota">@T("sfe.nessuno")</p>
        }
        else
        {
            <div class="ib-tabella-scorre">
                <table class="ib-tabella">
                    <thead>
                        <tr>
                            <th>@T("sfe.data")</th><th>@T("suolo.vigneto")</th><th>@T("sfe.sottovigneto")</th><th>@T("sfe.vitigno")</th>
                            <th class="numero">@T("sfe.eta")</th><th>@T("sfe.gestione")</th><th class="numero">@T("sfe.per-vite")</th>
                            <th class="numero">@T("chioma.altezza")</th><th class="numero">@T("sfe.larghezza")</th>
                            <th class="numero">@T("chioma.spazi")</th><th class="numero">@T("chioma.ordine")</th><th class="numero">@T("sfe.distanza")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in fattori)
                        {
                            <tr>
                                <td>@f.Data.ToString("d", Cultura)</td><td>@Nome(f.IdVigneto)</td>
                                <td>@(f.IdSubVigneto is int sub && Campo.SottoVigneti?.TryGetValue(sub, out var ns) == true ? ns : f.IdSubVigneto?.ToString(Cultura))</td>
                                <td>@f.Vitigno</td><td class="numero">@f.EtaImpianto</td><td>@f.GestioneChioma</td>
                                <td class="numero">@N(f.SfePerVite, "N2")</td><td class="numero">@N(f.AltezzaChioma, "N0")</td>
                                <td class="numero">@N(f.LarghezzaChioma, "N0")</td><td class="numero">@N(f.SpaziVuoti, "N2")</td>
                                <td class="numero">@N(f.OrdineGermogli, "N2")</td><td class="numero">@N(f.DistanzaPiante, "N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</section>

<section class="ib-sezione">
    <h2>VII. @SezioniReport.Titolo(SezioniReport.Tutte[6], Lingua, Annata)</h2>
    @if (Campo is null)
    {
        <p class="nota">@T("campo.non-disponibile")</p>
    }
    else
    {
        var vitigni = CalcoloProduzioneReport.PerVitigno(Campo, Annata);
        var perAnno = CalcoloProduzioneReport.PerVignetoEAnno(Campo);
        var dellAnnata = perAnno.Where(p => p.Anno == Annata).OrderBy(p => Nome(p.IdVigneto)).ToList();
        if (vitigni.Count == 0 && dellAnnata.Count == 0)
        {
            <p class="nota">@T("prod.nessuna")</p>
        }
        <h3>@T("prod.vitigno")</h3>
        <div class="ib-tabella-scorre">
            <table class="ib-tabella">
                <thead><tr><th>@T("prod.vitigno-col")</th><th class="numero">@T("prod.totale")</th></tr></thead>
                <tbody>
                    @foreach (var v in vitigni)
                    {
                        <tr><td>@v.Vitigno</td><td class="numero">@N(v.Quintali)</td></tr>
                    }
                </tbody>
            </table>
        </div>

        <h3>@T("prod.vigneto")</h3>
        <div class="ib-tabella-scorre">
            <table class="ib-tabella">
                <thead><tr><th>@T("suolo.vigna")</th><th>@T("suolo.vigneto")</th><th class="numero">@T("prod.ettaro")</th><th class="numero">@T("prod.totale")</th><th class="numero">@T("prod.eta")</th></tr></thead>
                <tbody>
                    @foreach (var p in dellAnnata)
                    {
                        <tr><td>@Vigna(p.IdVigneto)</td><td>@Nome(p.IdVigneto)</td><td class="numero">@N(p.QuintaliEttaro)</td><td class="numero">@N(p.Quintali)</td><td class="numero">@p.Eta</td></tr>
                    }
                </tbody>
            </table>
        </div>

        <h3>@T("prod.confronto")</h3>
        var anniProd = perAnno.Select(p => p.Anno).Where(a => a <= Annata).Distinct().Order().ToList();
        var celle = perAnno.ToDictionary(p => (p.IdVigneto, p.Anno), p => p.QuintaliEttaro);
        <div class="ib-tabella-scorre">
            <table class="ib-tabella">
                <thead><tr><th>@T("suolo.vigneto")</th>@foreach (var a in anniProd) { <th class="numero">@a</th> }</tr></thead>
                <tbody>
                    @foreach (var id in perAnno.Select(p => p.IdVigneto).Distinct().OrderBy(Nome))
                    {
                        <tr>
                            <td>@Nome(id)</td>
                            @foreach (var a in anniProd)
                            {
                                <td class="numero">@(celle.TryGetValue((id, a), out var q) ? N(q) : "")</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <h3>@T("prod.stime")</h3>
        <div class="ib-tabella-scorre">
            <table class="ib-tabella">
                <thead>
                    <tr>
                        <th>@T("suolo.vigna")</th><th>@T("suolo.vigneto")</th><th class="numero">@T("prod.ha")</th>
                        <th class="numero">@T("prod.reale")</th><th class="numero">@T("prod.stima")</th>
                        <th class="numero">@T("prod.differenza")</th><th class="numero">@T("prod.differenza-ha")</th>
                        <th class="numero">@T("prod.fallanze")</th><th class="numero">@T("prod.allevamento")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in CalcoloProduzioneReport.Scostamenti(Campo, Annata))
                    {
                        <tr>
                            <td>@s.Vigna</td><td>@s.Nome</td><td class="numero">@N(s.Ettari, "N2")</td>
                            <td class="numero">@N(s.Reale, "N0")</td><td class="numero">@N(s.Stima, "N0")</td>
                            <td class="numero">@N(s.Differenza, "N0")</td><td class="numero">@N(s.DifferenzaEttaro, "N0")</td>
                            <td class="numero">@N(s.PercFallanze)</td><td class="numero">@N(s.PercInAllevamento)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="ib-sezione">
    <h2>VIII. @SezioniReport.Titolo(SezioniReport.Tutte[7], Lingua, Annata)</h2>
    @if (Campo is null)
    {
        <p class="nota">@T("campo.non-disponibile")</p>
    }
    else
    {
        var f = CalcoloFallanzeReport.Calcola(Campo, Annata);
        <h3>@T("fallanze.titolo")</h3>
        <div class="rfs-kpi">
            @Kpi(T("fallanze.ettari"), N(f.Ettari, "N2"))
            @Kpi(T("fallanze.piante"), N(f.PianteMancanti, "N0"))
            @Kpi(T("fallanze.ettari-mancanti"), N(f.EttariMancanti, "N2"))
        </div>
        @if (f.Vigneti.Count == 0)
        {
            <p class="nota">@T("fallanze.nessuna")</p>
        }
        else
        {
            var ordinati = f.Vigneti.OrderBy(v => Nome(v.IdVigneto)).ToList();
            <GraficoLineeReport Etichette="@ordinati.Select(v => Nome(v.IdVigneto)).ToList()" Cultura="Cultura"
                Serie="@([
                    new GraficoLineeReport.SerieGrafico(T("fallanze.fallanze"), "#c0392b", ordinati.Select(v => D(v.Fallanze)).ToList(), true),
                    new GraficoLineeReport.SerieGrafico(T("fallanze.allevamento"), "#8dc63e", ordinati.Select(v => D(v.InAllevamento)).ToList(), true),
                    new GraficoLineeReport.SerieGrafico(T("fallanze.esca"), "#3c3950", ordinati.Select(v => D(v.Esca)).ToList(), true),
                ])" />
            <div class="ib-tabella-scorre">
                <table class="ib-tabella">
                    <thead><tr><th>@T("suolo.vigneto")</th><th class="numero">@T("fallanze.fallanze")</th><th class="numero">@T("fallanze.allevamento")</th><th class="numero">@T("fallanze.esca")</th></tr></thead>
                    <tbody>
                        @foreach (var v in ordinati)
                        {
                            <tr><td>@Nome(v.IdVigneto)</td><td class="numero">@N(v.Fallanze)</td><td class="numero">@N(v.InAllevamento)</td><td class="numero">@N(v.Esca)</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <p class="nota">@T("fallanze.capitozzate")</p>
    }
</section>

@code {
    private static decimal? D(double? v) => v is { } x ? (decimal)x : null;

    private static readonly string[] ColoriLinee = ["#3c6fb4", "#c0392b", "#8dc63e", "#3c3950", "#f8981d", "#5f727f", "#8e477d", "#276e27", "#ffcf02", "#17a2b8"];

    /// <summary>Linee per settimana (asse = le settimane con almeno un valore), una serie per vigna o per anno.</summary>
    private RenderFragment LineeSettimane(string titolo, IReadOnlyList<LineaStatoIdrico> linee) => __builder =>
    {
        var settimane = linee.SelectMany(l => l.PerSettimana.Keys).Distinct().Order().ToList();
        if (settimane.Count > 0)
        {
            <GraficoLineeReport Titolo="@titolo" Cultura="Cultura" Etichette="@settimane.Select(s => T("apici.settimana", s)).ToList()"
                Serie="@linee.Select((l, i) => new GraficoLineeReport.SerieGrafico(l.Nome, ColoriLinee[i % ColoriLinee.Length],
                    settimane.Select(s => l.PerSettimana.TryGetValue(s, out var v) ? (decimal?)v : null).ToList())).ToList()" />
        }
    };

    private string? Vigna(int id) => Campo?.Vigneti.FirstOrDefault(v => v.IdVigneto == id)?.Vigna;

    private string Nome(int id) => Nomi.TryGetValue(id, out var nome) ? nome : $"{id}";

    [Parameter] public CampoReportFineStagioneDto? Campo { get; set; }
    [Parameter, EditorRequired] public int Annata { get; set; }
    [Parameter, EditorRequired] public LinguaReport Lingua { get; set; }

    private CultureInfo Cultura => TestiReport.Cultura(Lingua);

    private string T(string chiave, params object[] valori) => TestiReport.Testo(Lingua, chiave, valori);

    private string N(double? v, string formato = "N1") => v is { } x ? x.ToString(formato, Cultura) : "—";

    /// <summary>IdVigneto → nome, per tutti i vigneti dell'azienda.</summary>
    [Parameter] public IReadOnlyDictionary<int, string> Nomi { get; set; } = new Dictionary<int, string>();

    private RenderFragment Kpi(string titolo, string valore) => __builder =>
    {
        <div class="rfs-riquadro">
            <h4>@titolo</h4>
            <p class="rfs-valore">@valore</p>
        </div>
    };

    private RenderFragment Scottature(string titolo, ScottatureAnnata s) => __builder =>
    {
        <h3>@titolo</h3>
        <div class="rfs-kpi">
            @Kpi(T("scottature.danno"), s.Danno.ToString("P1", Cultura))
            @Kpi(T("scottature.diffusione"), s.Diffusione.ToString("P1", Cultura))
            @Kpi(T("scottature.rilievi"), s.Righe.ToString(Cultura))
        </div>
        @if (s.Vigneti.Count > 0)
        {
            <div class="ib-tabella-scorre">
                <table class="ib-tabella">
                    <thead>
                        <tr>
                            <th>@T("suolo.vigneto")</th>
                            <th class="numero">@T("scottature.intensita")</th>
                            <th class="numero">@T("scottature.diffusione-max")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in s.Vigneti)
                        {
                            <tr>
                                <td>@Nome(v.IdVigneto)</td>
                                <td class="numero">@N(v.Intensita)</td>
                                <td class="numero">@N(v.Diffusione)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    };
}

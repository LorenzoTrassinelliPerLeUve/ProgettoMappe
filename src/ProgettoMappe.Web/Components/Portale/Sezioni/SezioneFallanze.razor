@using ProgettoMappe.Web.Portale
@inject PortaleApiClient Api
@*
    Sezione 7 «Fallanze» (FallanzeController, abilitazione FALLANZE): filtri anno, azienda, vigna, vigneto, vitigno ricavati
    dalle righe; lista di VistaDatiFallanze con le 10 colonne del portale; scheda Azienda → Vigna → Vigneto (fissi dopo
    l'inserimento), vitigno del vigneto, data e i 5 valori. 4Grapes (trigger Tr_Rilievo) ricalcola % in allevamento,
    presente morta e capitozzata quando le sue funzioni hanno un valore.
*@

<div class="portale-filtri">
    <label>
        <span>Anno</span>
        <select @bind="_anno">
            <option value="">-</option>
            @foreach (var anno in Righe.Select(r => r.Anno).OfType<int>().Distinct().OrderDescending())
            {
                <option value="@anno">@anno</option>
            }
        </select>
    </label>
    <label>
        <span>Azienda</span>
        <select @bind="_azienda">
            <option value="">-</option>
            @foreach (var azienda in _dati?.Aziende ?? [])
            {
                <option value="@azienda.Id">@azienda.Nome</option>
            }
        </select>
    </label>
    <label>
        <span>Vigna</span>
        <select @bind="_vigna">
            <option value="">-</option>
            @foreach (var v in Righe.Where(r => r.IdVigna is not null).DistinctBy(r => r.IdVigna).OrderBy(r => r.Vigna))
            {
                <option value="@v.IdVigna">@v.Vigna</option>
            }
        </select>
    </label>
    <label>
        <span>Vigneto</span>
        <select @bind="_vigneto">
            <option value="">-</option>
            @foreach (var v in Righe.Where(r => r.IdVigneto is not null).DistinctBy(r => r.IdVigneto).OrderBy(r => r.Vigneto))
            {
                <option value="@v.IdVigneto">@v.Vigneto</option>
            }
        </select>
    </label>
    <label>
        <span>Vitigno</span>
        <select @bind="_vitigno">
            <option value="">-</option>
            @foreach (var v in Righe.Where(r => r.IdVitigno is not null).DistinctBy(r => r.IdVitigno).OrderBy(r => r.Vitigno))
            {
                <option value="@v.IdVitigno">@v.Vitigno</option>
            }
        </select>
    </label>
</div>

<TabellaPortale TItem="FallanzaDto" TModulo="ModuloFallanza" Elementi="Visibili" Colonne="Colonne"
                Errore="_errore" Riprova="CaricaAsync" TestoVuoto="Nessun rilievo di fallanze con questi filtri."
                TestoNuovo="Nuovo rilievo" TitoloNuovo="Nuovo rilievo fallanze"
                IdDi="r => r.Id" TitoloDi="@(r => $"Fallanze · {r.Vigneto} · {r.InizioRilievo:dd/MM/yyyy}")"
                Modificabile="r => r.Modificabile" ModuloDa="ApriRiga" NuovoModulo="() => new ModuloFallanza { Nuovo = true }"
                SalvaRiga="(id, m) => Api.SalvaAsync(Utente.IdUtente, Percorso, id, m.Dto())"
                EliminaRiga="id => Api.EliminaAsync(Utente.IdUtente, Percorso, id)"
                MessaggioSalvato="Inserimento rilievo completato" MessaggioEliminato="Rilievo analisi eliminato correttamente"
                Scritture="Scritture">
    <Campi>
        <CampoPortale Etichetta="Azienda" Nome="IdAzienda">
            <select value="@context.IdAzienda" disabled="@(!context.Nuovo)"
                    @onchange="e => CambiaAziendaSchedaAsync(context, e)">
                <option value="">-</option>
                @foreach (var azienda in _dati?.Aziende ?? [])
                {
                    <option value="@azienda.Id">@azienda.Nome</option>
                }
            </select>
        </CampoPortale>
        <CampoPortale Etichetta="Vigna" Nome="IdVigna">
            <select value="@context.IdVigna" disabled="@(!context.Nuovo)"
                    @onchange="e => { context.IdVigna = int.TryParse(e.Value?.ToString(), out var v) ? v : null; context.IdVigneto = null; context.Vitigno = null; }">
                <option value="">-</option>
                @foreach (var v in MenuDi(context.IdAzienda).DistinctBy(v => v.IdVigna))
                {
                    <option value="@v.IdVigna">@v.Vigna</option>
                }
            </select>
        </CampoPortale>
        <CampoPortale Etichetta="Vigneto" Nome="IdVigneto">
            <select value="@context.IdVigneto" disabled="@(!context.Nuovo)" @onchange="e => CambiaVigneto(context, e)">
                <option value="">-</option>
                @foreach (var v in MenuDi(context.IdAzienda).Where(v => v.IdVigna == context.IdVigna))
                {
                    <option value="@v.IdVigneto">@v.Vigneto</option>
                }
            </select>
        </CampoPortale>
        <CampoPortale Etichetta="Vitigno">
            <input type="text" value="@context.Vitigno" disabled />
        </CampoPortale>
        <CampoPortale Etichetta="Data" Nome="Data">
            <input type="date" @bind="context.Data" />
        </CampoPortale>
        <CampoPortale Etichetta="% in Allevamento" Nome="PercInAllevamento">
            <input type="number" step="0.01" @bind="context.PercInAllevamento" />
        </CampoPortale>
        <CampoPortale Etichetta="% Capitozzata" Nome="PercCapitozzata">
            <input type="number" step="0.01" @bind="context.PercCapitozzata" />
        </CampoPortale>
        <CampoPortale Etichetta="% Presente Morta" Nome="PercPresenteMorta">
            <input type="number" step="0.01" @bind="context.PercPresenteMorta" />
        </CampoPortale>
        <CampoPortale Etichetta="% fallanze" Nome="PercFallanze">
            <input type="number" step="0.01" @bind="context.PercFallanze" />
        </CampoPortale>
        <CampoPortale Etichetta="N° Organi Controllati" Nome="NrOrganiControllati">
            <input type="number" step="1" @bind="context.NrOrganiControllati" />
        </CampoPortale>
    </Campi>
</TabellaPortale>

@code {
    private const string Percorso = "fallanze";

    [Parameter] public PortaleUtenteDto Utente { get; set; } = default!;

    [Parameter] public StatoScrittureDto? Scritture { get; set; }

    /// <summary>Le 10 colonne della lista del portale, nello stesso ordine.</summary>
    public static readonly IReadOnlyList<ColonnaLista<FallanzaDto>> Colonne =
    [
        new("Data", r => r.InizioRilievo, r => r.InizioRilievo.ToString("dd/MM/yyyy")),
        new("Azienda", r => r.Ente),
        new("Vigna", r => r.Vigna),
        new("Vigneto", r => r.Vigneto),
        new("Vitigno", r => r.Vitigno),
        new("% in Allevamento", r => r.PercInAllevamento, Numerica: true),
        new("% Capitozzata", r => r.PercCapitozzata, Numerica: true),
        new("% Presente Morta", r => r.PercPresenteMorta, Numerica: true),
        new("% fallanze", r => r.PercFallanze, Numerica: true),
        new("N° Organi Controllati", r => r.NrOrganiControllati, Numerica: true),
    ];

    private FallanzeDto? _dati;
    private string? _errore;
    private int? _anno;
    private int? _azienda;
    private int? _vigna;
    private int? _vigneto;
    private int? _vitigno;
    private readonly Dictionary<int, IReadOnlyList<VignetoMenuDto>> _menu = new();

    /// <summary>Le righe dopo azienda/vigna/vigneto/vitigno: da qui anni e menù dei filtri, come la lista del portale.</summary>
    private IEnumerable<FallanzaDto> Righe => (_dati?.Righe ?? [])
        .Where(r => _azienda is null || r.IdEnte == _azienda)
        .Where(r => _vigna is null || r.IdVigna == _vigna)
        .Where(r => _vigneto is null || r.IdVigneto == _vigneto)
        .Where(r => _vitigno is null || r.IdVitigno == _vitigno);

    private IReadOnlyList<FallanzaDto>? Visibili => _dati is null ? null : Righe.Where(r => _anno is null || r.Anno == _anno).ToList();

    protected override Task OnInitializedAsync() => CaricaAsync();

    private async Task CaricaAsync()
    {
        var risposta = await Api.LeggiAsync<FallanzeDto>(Utente.IdUtente, $"api/portale/{Percorso}");
        _errore = risposta.Errore;
        _dati = risposta.Dati;
    }

    private IReadOnlyList<VignetoMenuDto> MenuDi(int? azienda) =>
        azienda is { } a && _menu.TryGetValue(a, out var voci) ? voci : [];

    private async Task CaricaMenuAsync(int? azienda)
    {
        if (azienda is not { } a || _menu.ContainsKey(a)) return;
        var risposta = await Api.LeggiAsync<List<VignetoMenuDto>>(Utente.IdUtente, $"api/portale/{Percorso}/vigneti?azienda={a}");
        _menu[a] = risposta.Dati ?? [];
    }

    private ModuloFallanza ApriRiga(FallanzaDto riga)
    {
        _ = CaricaMenuAsync(riga.IdEnte).ContinueWith(_ => InvokeAsync(StateHasChanged), TaskScheduler.Default);
        return ModuloFallanza.Da(riga);
    }

    private async Task CambiaAziendaSchedaAsync(ModuloFallanza modulo, ChangeEventArgs e)
    {
        modulo.IdAzienda = int.TryParse(e.Value?.ToString(), out var id) ? id : null;
        modulo.IdVigna = modulo.IdVigneto = null;
        modulo.Vitigno = null;
        await CaricaMenuAsync(modulo.IdAzienda);
    }

    private void CambiaVigneto(ModuloFallanza modulo, ChangeEventArgs e)
    {
        modulo.IdVigneto = int.TryParse(e.Value?.ToString(), out var id) ? id : null;
        modulo.Vitigno = MenuDi(modulo.IdAzienda).FirstOrDefault(v => v.IdVigneto == modulo.IdVigneto)?.Vitigno;
    }
}

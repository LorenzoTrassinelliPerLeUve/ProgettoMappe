    "Potassio scambiabile (K) % su CSC",
    "Sodio scambiabile (Na) % su CSC",
    "Acidità di Scambio  % su CSC",
    "Rapporto Mg/K",
    "Rapporto Ca/Mg",
    "Rapporto Ca/K",
    "Fosforo assimilabile (P) Olsen ppm",
    "Fosforo assimilabile (P) Bray Kurz ppm",
    "Zolfo assimilabile (S) ppm",
    "Ferro assimilabile (Fe) ppm DTPA",
    "Manganese assimilabile (Mn) ppm DTPA",
    "Zinco assimilabile (Zn) ppm DTPA",
    "Rame assimilabile (Cu) ppm DTPA",
    "Ferro assimilabile (Fe) ppm EDTA",

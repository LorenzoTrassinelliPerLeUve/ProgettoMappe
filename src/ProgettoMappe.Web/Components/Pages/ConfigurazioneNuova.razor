                    @foreach (var t in SuoloGuidato.Tessiture) { <option value="@t.Id">@t.Nome</option> }
                </select>
            </label>
            <label>Fin dove arrivano le radici
                <select @bind="_suolo.Profondita">@foreach (var p in SuoloGuidato.Profondita) { <option value="@p.Metri">@p.Nome</option> }</select>
            </label>

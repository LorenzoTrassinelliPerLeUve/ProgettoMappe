    "Zinco assimilabile (Zn) ppm EDTA",
    "Rame assimilabile (Cu) ppm EDTA",
    "Boro assimilabile (B) ppm",
    "Molibdeno  assimilabile (Mo) ppm",
    "Calcio idrosolubile (Ca) ppm",
    "Magnesio idrosolubile (Mg)",
    "Potassio idrosolubile (K) ppm",
    "Sodio idrosolubile (Na) ppm",
    "Cloro idrosolubile (Cl) ppm",
    "Calcio idrosolubile (Ca) mmoli",
    "Magnesio idrosolubile (Mg) mmoli",
    "Potassio idrosolubile (K) mmoli",
    "Sodio idrosolubile (Na) mmoli",
    "Cloro idrosolubile (Cl) mmoli",
    "Indice del Potere Clorosante",
    "K2 coeff mineralizzazione",
     ([PROFONDITA' cm]/100) as [PROFONDITA' m],
     [VIGNETO]&'-'&([PROFONDITA' cm]/100) as [DIMENSIONE_COD_PUNTO]
FROM [lib://OneDriveLorenzo/Database/DB ANALISI TERRENI NEW.xlsx]
(ooxml, embedded labels, header is 0 lines, table is DB_ANALISI_TERRENI);


///$tab EXIT
Exit Script;

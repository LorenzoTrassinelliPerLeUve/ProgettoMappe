        var link = LinkMappa.Leggi(Navigation.Uri);
        GruppoFiltro = link.Gruppo?.ToString(CultureInfo.InvariantCulture) ?? "";
        TematismoId = Catalogo.Trova(link.Tema) is not null ? link.Tema! : "";
        _vignaDaLink = link.Vigna;
        _vitignoDaLink = link.Vitigno;
        _annoDaLink = link.Anno;
        _confrontoDaLink = link.Da;
        _vignetoDaLink = link.Vigneto;
        _vistaDaLink = link.Vista;
        _vista = null;
        MostraSoloPunto = true;
        Ordine = link.Ordine;
        FiltriChiusi = link.FiltriChiusi;
        TemiChiusi = link.TemiChiusi;
    }

    private static int? Id(string valore) =>
        int.TryParse(valore, NumberStyles.AllowLeadingSign, CultureInfo.InvariantCulture, out var id) ? id : null;

    /// <summary>Lo stato attuale come link; finché vigneti e indici non arrivano valgono i valori del link aperto.</summary>
    private LinkMappa LinkCorrente() => new(
        Id(GruppoFiltro),
        _vigneti is null ? _vignaDaLink : Id(VignaFiltro),
        _vigneti is null ? _vitignoDaLink : Id(VitignoFiltro),
        TematismoId == "" ? null : TematismoId,
        Anno ?? _annoDaLink,
        _vista ?? _vistaDaLink,
        _confrontoDaLink ?? (Confronto ? AnnoDa : null),
        _vigneti is null ? _vignetoDaLink : _vignetoSelezionatoId,
        Ordine,
        FiltriChiusi,
        TemiChiusi);

    /// <summary>Scrive lo stato nell'indirizzo senza ricaricare e senza aggiungere voci alla cronologia.</summary>
    private void AggiornaIndirizzo()
    {
        var indirizzo = LinkCorrente().Indirizzo(AziendaId);
        if (Navigation.ToAbsoluteUri(indirizzo).AbsoluteUri != Navigation.Uri)
        {
            Navigation.NavigateTo(indirizzo, replace: true);
        }
    }

    /// <summary>Un'altra azienda: restano gruppo e parametro del tematismo, il resto riparte da capo.</summary>
    private void ApriAzienda(int id) =>
        Navigation.NavigateTo((LinkCorrente() with { Vigna = null, Vitigno = null, Anno = null, Vista = null, Da = null, Vigneto = null }).Indirizzo(id));

    /// <summary>
    /// Gruppo del link che non esiste (o non è nel perimetro) o non contiene l'azienda aperta:
    /// si torna a "Tutti i gruppi", l'azienda del percorso vince.
    /// </summary>
    private void ControllaGruppo()
    {
        if (GruppoFiltro == "" || _gruppi is null || _aziende is null)
        {
            return;
        }

        if (GruppoSelezionato is null || AziendeVisibili.All(a => a.Id != AziendaId))
        {
            GruppoFiltro = "";
            AggiornaIndirizzo();
        }
    }

    /// <summary>Richiamato da mappa.js a fine movimento della mappa (già con un piccolo ritardo).</summary>
    [JSInvokable]
    public void OnInquadratura(double lon, double lat, double zoom)
    {
        _vista = new VistaMappa(lon, lat, zoom);
        AggiornaIndirizzo();
    }

    /// <summary>Richiamato da mappa.js dopo il click su «Copia link»: conferma per due secondi, o avviso.</summary>
    [JSInvokable]
    public async Task OnLinkCopiato(bool riuscito, string? pulsante)
    {
        if (!riuscito)
        {
            _avviso = "Non riesco a copiare il link: copialo dalla barra dell'indirizzo.";
            StateHasChanged();
            return;
        }

        _linkCopiato = pulsante;
        StateHasChanged();
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(2), _cts.Token);
        }
        catch (OperationCanceledException)
        {
            return; // pagina chiusa
        }
        if (_linkCopiato == pulsante)
        {
            _linkCopiato = null;
        }
        StateHasChanged();
    }

    /// <summary>Richiamato da mappa.js se «Salva immagine» non riesce (il buon esito è il file scaricato).</summary>
    [JSInvokable]
    public void OnImmagineNonSalvata()
    {
        _avviso = "Non riesco a creare l'immagine della mappa: riprova fra qualche secondo.";
        StateHasChanged();
    }

    /// <summary>Riquadro di «Salva immagine»: la legenda com'è nella pagina, sui vigneti visibili.</summary>
    private RiquadroImmagine DatiImmagine(string azienda)
    {
        var tema = TemaInLegenda;
        IReadOnlyList<VoceLegenda> voci = tema is null ? []
            : LegendaTematismo.Voci(tema, Confronto ? Catalogo.Regola(tema) : null, Anno, _conteggi, _classeFiltro, NomiClassi(tema));
        return ImmagineMappa.Riquadro(azienda, tema?.Nome,
            tema is null ? null : LegendaTematismo.Titolo(tema, Anno, Confronto ? AnnoDa : null),
            voci, _vignetiFiltrati.Count(v => v.HaGeometria), FiltroAttivo);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var opzioni = MapOptionsAccessor.Value;
        _module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/mappa.js");
        _dotNetRef = DotNetObjectReference.Create(this);

        // Le sorgenti risolte possono contenere API key negli URL: vanno solo al browser (dove
        // una chiave è comunque visibile, protetta per Origin dal provider), mai nei log.
        await _module.InvokeVoidAsync("creaMappa", _mapElementId, new
        {
            centro = _vistaDaLink is { } vista ? [vista.Lon, vista.Lat] : opzioni.CentroInizialeValido(),
            zoom = _vistaDaLink?.Zoom ?? opzioni.ZoomIniziale,
            sorgenti = Configurazione.Sorgenti.Select(s => new
            {
                s.Id, s.Nome, Ruolo = s.Ruolo.ToString(), s.Tipo, s.StyleUrl, s.TileUrl, s.TileJsonUrl,
                s.Attribution, s.MinZoom, s.MaxZoom, s.TileSize, s.Encoding, s.Bounds,
            }),
            basemapId = Configurazione.BasemapPredefinitaId,
            basemapFallbackId = Configurazione.BasemapFallbackId,
            avvisoIniziale = Configurazione.BasemapPredefinitaSostituita ? "riserva" : null,
            timeoutStyleMs = Configurazione.TimeoutStyleMs,
            terrainId = Configurazione.TerrainId,
            terrainExaggeration = Configurazione.TerrainExaggeration,
        }, _dotNetRef);
        // Satellite o mappa: la scelta ricordata nel browser, altrimenti il satellite sul telefono.
        await ImpostaSatelliteAsync(await _module.InvokeAsync<bool>("satellitePredefinito"), ricorda: false);
        StateHasChanged();
        await _module.InvokeVoidAsync("collegaCopiaLink", $"{_mapElementId}-layout", _dotNetRef);
        await _module.InvokeVoidAsync("collegaSalvaImmagine", $"{_mapElementId}-layout", _mapElementId, _dotNetRef);
        await _module.InvokeVoidAsync("collegaFogli", $"{_mapElementId}-layout");
        await _module.InvokeVoidAsync("collegaMenu", $"{_mapElementId}-layout");
        await _module.InvokeVoidAsync("collegaEvidenzaElenco", _mapElementId, $"{_mapElementId}-pannello");

        _ = CaricaElencoAziendeAsync();
        await CaricaAziendaAsync();
    }

    /// <summary>
    /// Cambio azienda dal filtro o con avanti/indietro del browser: stessa pagina, la mappa non viene
    /// ricreata; il resto dello stato si rilegge dall'indirizzo. Gli aggiornamenti dell'indirizzo
    /// della stessa azienda (AggiornaIndirizzo) passano di qui senza effetti.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (_module is not null && _aziendaCaricata is not null && _aziendaCaricata != AziendaId)
        {
            LeggiLink();
            ControllaGruppo();
            await CaricaAziendaAsync();
        }
    }

    private async Task CaricaElencoAziendeAsync()
    {
        try
        {
            var aziende = (await AziendeApiClient.GetAziendeAsync())
                .OrderBy(a => a.Nome, StringComparer.CurrentCultureIgnoreCase).ToList();
            await InvokeAsync(() => { _aziende = aziende; StateHasChanged(); });
        }
        catch (Exception ex)
        {
            // Il selettore resta sull'azienda corrente: la mappa funziona comunque.
            Logger.LogWarning("Elenco aziende non disponibile ({Tipo}: {Messaggio})", ex.GetType().Name, ex.Message);
            await InvokeAsync(() => { _erroreAziende = true; StateHasChanged(); });
            return;
        }

        try
        {
            var gruppi = await AziendeApiClient.GetGruppiAsync();
            await InvokeAsync(() => { _gruppi = gruppi; ControllaGruppo(); StateHasChanged(); });
        }
        catch (Exception ex)
        {
            // Senza gruppi il filtro Gruppo resta spento; aziende e mappa restano usabili.
            Logger.LogWarning("Elenco gruppi non disponibile ({Tipo}: {Messaggio})", ex.GetType().Name, ex.Message);
        }
    }

    private void RiprovaElencoAziende()
    {
        _erroreAziende = false;
        _ = CaricaElencoAziendeAsync();
    }

    /// <summary>"Riprova" sulla mappa: vigneti dell'azienda e, se era fallito, anche l'elenco aziende.</summary>
    private async Task RiprovaAsync()
    {
        if (_erroreAziende)
        {
            RiprovaElencoAziende();
        }
        await CaricaAziendaAsync();
    }

    private GruppoDto? GruppoSelezionato =>
        int.TryParse(GruppoFiltro, out var id) ? _gruppi?.FirstOrDefault(g => g.Id == id) : null;

    private IReadOnlyList<AziendaDto> AziendeVisibili => FiltriAziende.DelGruppo(_aziende ?? [], GruppoSelezionato);

    /// <summary>Scelta del gruppo: il menu Aziende si restringe; se l'azienda aperta non ne fa parte si passa alla prima del gruppo.</summary>
    private void GruppoCambiato()
    {
        if (FiltriAziende.AziendaDaMostrare(AziendeVisibili, AziendaId) is { } id && id != AziendaId)
        {
            ApriAzienda(id);
        }
        else
        {
            AggiornaIndirizzo();
        }
    }

    private void CambiaAzienda(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id) && id != AziendaId)
        {
            ApriAzienda(id);
        }
    }

    /// <summary>
    /// Carica vigneti, geometrie e indici dell'azienda corrente. All'apertura e ad ogni cambio
    /// azienda: filtri e selezione si azzerano, il parametro del tematismo scelto resta.
    /// </summary>
    private async Task CaricaAziendaAsync()
    {
        var aziendaId = AziendaId;
        var ricarica = _aziendaCaricata is not null;
        _aziendaCaricata = aziendaId;

        _ctsIndici?.Cancel();
        _ctsIndici = CancellationTokenSource.CreateLinkedTokenSource(_cts.Token);

        _vigneti = null;
        _valoriElenco = null;
        _vignetiFiltrati = [];
        _opzioniVigne = [];
        _opzioniVitigni = [];
        VignaFiltro = "";
        VitignoFiltro = "";
        _classeFiltro = null;
        _vignetoSelezionato = null;
        _vignetoSelezionatoId = null;
        _indici = null;
        _indiciPronti = false;
        _statoIndici = null;
        _statistiche = null;
        _statistichePronte = false;
        _statoStatistiche = null;
        _fenologia = null;
        _fenologiaPronta = false;
        _statoFenologia = null;
        _nomiFasi = new Dictionary<int, string>();
        _rilievi = null;
        _rilieviPronti = false;
        _statoRilievi = null;
        _difesa = null;
        _difesaPronta = false;
        _statoDifesa = null;
        _nomiLinee = new Dictionary<int, string>();
        _sottovigneti = null;
        _statoSottovigneti = null;
        _meteo = null;
        _statoMeteo = null;
        _anni = [];
        Anno = null;
        AnnoDa = null;
        _sceltaDa = false;
        _riepilogo = null;
        _erroreVigneti = null;
        SvuotaRicerca(); // le proposte erano sui vigneti dell'azienda precedente
        StateHasChanged();

        IReadOnlyList<VignetoDto> vigneti;
        JsonElement geojson;
        try
        {
            (vigneti, geojson) = await VignetiApiClient.GetVignetiPerAziendaAsync(aziendaId);
        }
        catch (Exception ex)
        {
            if (aziendaId != AziendaId)
            {
                return;
            }

            Logger.LogWarning("Vigneti dell'azienda {AziendaId} non disponibili ({Tipo}: {Messaggio})",
                aziendaId, ex.GetType().Name, ex.Message);
            _erroreVigneti = ex is HttpRequestException { StatusCode: HttpStatusCode.NotFound }
                ? ErroreAziendaAssente
                : ErroreVigneti;
            if (ricarica && _module is not null)
            {
                // Niente vigneti dell'azienda precedente sotto il messaggio di errore.
                await _module.InvokeVoidAsync("mostraVigneti", _mapElementId, FeatureCollectionVuota, false);
            }
            StateHasChanged();
            return;
        }

        if (aziendaId != AziendaId)
        {
            return; // superato da un altro cambio azienda
        }

        _vigneti = vigneti;
        _vignetiFiltrati = vigneti;
        _opzioniVigne = FiltriVigneti.Vigne(vigneti);
        _opzioniVitigni = FiltriVigneti.Vitigni(vigneti, null);

        // Inquadratura e filtri del link: una volta sola; una vigna che non c'è più si ignora
        // (il vitigno lo controlla ApplicaFiltriAsync).
        var vista = _vistaDaLink;
        _vistaDaLink = null;
        VignaFiltro = _opzioniVigne.Any(o => o.Id == _vignaDaLink) ? _vignaDaLink!.Value.ToString(CultureInfo.InvariantCulture) : "";
        VitignoFiltro = _vitignoDaLink?.ToString(CultureInfo.InvariantCulture) ?? "";
        _vignaDaLink = null;
        _vitignoDaLink = null;

        if (_module is not null)
        {
            await _module.InvokeVoidAsync("impostaTematismo", _mapElementId, null);
            await _module.InvokeVoidAsync("mostraVigneti", _mapElementId, geojson, ricarica, vista);
        }

        if (VignaFiltro != "" || VitignoFiltro != "")
        {
            // Con un'inquadratura nel link la camera resta lì, altrimenti va sui vigneti filtrati.
            await ApplicaFiltriAsync(adatta: vista is null);
        }

        // Scheda del link: si apre se il vigneto c'è (e passa i filtri del link); con
        // un'inquadratura nel link la camera resta lì.
        if (_vignetoDaLink is { } vignetoLink && _vignetiFiltrati.Any(v => v.Id == vignetoLink))
        {
            AggiornaSelezione(vignetoLink);
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("selezionaVigneto", _mapElementId, vignetoLink, vista is null);
                await _module.InvokeVoidAsync("portaInVista", IdVoceElenco(vignetoLink));
            }
        }
        _vignetoDaLink = null;

        StateHasChanged();
        AggiornaIndirizzo();

        // Gli indici arrivano indipendentemente dalla mappa: la pagina è già usabile.
        _ = CaricaIndiciAsync(aziendaId, _ctsIndici.Token);
        _ = CaricaStatisticheAsync(aziendaId, _ctsIndici.Token);
        _ = CaricaFenologiaAsync(aziendaId, _ctsIndici.Token);
        _ = CaricaRilieviAsync(aziendaId, _ctsIndici.Token);
        _ = CaricaDifesaAsync(aziendaId, _ctsIndici.Token);
        _ = CaricaSottovignetiAsync(aziendaId, _ctsIndici.Token);
        _ = CaricaMeteoAsync(aziendaId, _ctsIndici.Token);
    }

    /// <summary>Meteo dell'azienda per il pannello «Meteo»; se non arriva il pannello lo dice, il resto della pagina non cambia.</summary>
    private async Task CaricaMeteoAsync(int aziendaId, CancellationToken ct)
    {
        try
        {
            var meteo = await VignetiApiClient.GetMeteoAsync(aziendaId, ct);
            await InvokeAsync(() =>
            {
                if (ct.IsCancellationRequested || aziendaId != AziendaId)
                {
                    return;
                }

                _meteo = meteo ?? new MeteoAziendaDto(aziendaId, [], null, null, []);
                _statoMeteo = null;
                StateHasChanged();
            });
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // Pagina chiusa o azienda cambiata durante il caricamento.
        }
        catch (Exception ex)
        {
            Logger.LogWarning("Meteo dell'azienda {AziendaId} non disponibile ({Tipo}: {Messaggio})",
                aziendaId, ex.GetType().Name, ex.Message);
            await InvokeAsync(() => { _statoMeteo = "Meteo non disponibile al momento."; StateHasChanged(); });
        }
    }

    /// <summary>
    /// Pannello «Meteo»: pioggia dei 7 giorni a barrette con il totale, temperature di ieri e probabilità
    /// di infezione di oggi (oidio e peronospora separati). Senza dati: «Nessun dato meteo», mai uno zero.
    /// </summary>
    private RenderFragment PannelloMeteo => __builder =>
    {
        if (_statoMeteo is not null)
        {
            <p class="nota">@_statoMeteo</p>
            return;
        }

        if (_meteo is null)
        {
            <p class="nota" role="status">Carico il meteo…</p>
            return;
        }

        if (_meteo.Pioggia is { } pioggia)
        {
            <p class="meteo-totale">
                Pioggia 7 giorni: <strong>@TestiMeteo.Millimetri(pioggia)</strong>
                @if (_meteo.GiorniConPioggia < _meteo.Giorni.Count)
                {
                    <span class="nota"> (dato di @_meteo.GiorniConPioggia giorni su @_meteo.Giorni.Count)</span>
                }
            </p>
            <ol class="meteo-barre" aria-label="Pioggia per giorno">
                @foreach (var barra in TestiMeteo.Barre(_meteo))
                {
                    <li title="@barra.Titolo" class="@(barra.Pioggia is null ? "senza-dato" : "")">
                        <span class="valore">@(barra.Pioggia is { } mm ? mm.ToString("0", CultureInfo.GetCultureInfo("it-IT")) : "–")</span>
                        <span class="colonna"><span class="barra" style="height: @(barra.Altezza)%"></span></span>
                        <span class="giorno">@barra.Giorno</span>
                        <span class="visualmente-nascosto">@barra.Titolo</span>
                    </li>
                }
            </ol>
        }
        else
        {
            <p class="nota">Nessun dato meteo per questa azienda.</p>
        }

        @if (TestiMeteo.Temperature(_meteo) is { } temperature)
        {
            <p class="meteo-temperature">@temperature</p>
        }

        @if (_meteo.Infezioni.Count > 0)
        {
            <ul class="meteo-infezioni" aria-label="Probabilità di infezione di oggi">
                @foreach (var infezione in _meteo.Infezioni)
                {
                    <li class="@(infezione.Alta == true ? "alta" : "")">@TestiMeteo.Infezione(infezione)</li>
                }
            </ul>
            <p class="aggiornamento">Probabilità di infezione di oggi (modello di 4Grapes, stima su meteo previsto).</p>
        }
        else if (_meteo.ConMeteo)
        {
            <p class="nota">Probabilità di infezione non disponibile per oggi.</p>
        }
    };

    /// <summary>
    /// Sottovigneti dell'azienda: sulla mappa (mappa.js li mostra da zoom 15) e nella scheda. Se non
    /// arrivano la mappa resta con i soli vigneti e la scheda lo dice.
    /// </summary>
    private async Task CaricaSottovignetiAsync(int aziendaId, CancellationToken ct)
    {
        try
        {
            var risposta = await VignetiApiClient.GetSottovignetiAsync(aziendaId, ct);
            await InvokeAsync(async () =>
            {
                if (ct.IsCancellationRequested || aziendaId != AziendaId)
                {
                    return;
                }

                _sottovigneti = risposta;
                if (_module is not null && risposta.GeoJson is { } geojson)
                {
                    await _module.InvokeVoidAsync("mostraSottovigneti", _mapElementId, geojson);
                }
                StateHasChanged();
            });
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // Pagina chiusa o azienda cambiata durante il caricamento.
        }
        catch (Exception ex)
        {
            Logger.LogWarning("Sottovigneti dell'azienda {AziendaId} non disponibili ({Tipo}: {Messaggio})",
                aziendaId, ex.GetType().Name, ex.Message);
            await InvokeAsync(() => { _statoSottovigneti = "Sottovigneti non raggiungibili."; StateHasChanged(); });
        }
    }

    private async Task FiltriCambiatiAsync()
    {
        await ApplicaFiltriAsync(adatta: true);
        AggiornaIndirizzo();
    }

    /// <summary>Altro parametro: le voci della legenda cambiano, il filtro per voce decade.</summary>
    private async Task ParametroCambiatoAsync()
    {
        _classeFiltro = null;
        if (TematismoId == "")
        {
            AnnoDa = null; // senza parametro non c'è niente da confrontare
        }
        else if (TematismoAttivo is { SenzaAnno: false } temaScelto && AnniCursore is { Count: > 0 } anni)
        {
            // Ogni fonte ha i suoi anni: se l'anno scelto non c'è, si passa a quello predefinito.
            // La fenologia si apre sempre sull'anno più recente: è quella di quest'anno che serve.
            if (Anno is not { } anno || !anni.Contains(anno) || temaScelto.AnnoRecente)
            {
                Anno = TematismiBigot.AnnoPredefinito(temaScelto, anni, _annoCorrente);
            }
            if (AnnoDa is { } da && (!anni.Contains(da) || da == Anno))
            {
                AnnoDa = ConfrontoBigot.AnnoDaPredefinito(anni, Anno!.Value);
            }
        }
        await TematismoCambiatoAsync();
    }

    /// <summary>Anno o parametro: le voci restano le stesse, il filtro per voce si ricalcola sull'anno nuovo.</summary>
    private async Task TematismoCambiatoAsync()
    {
        await ApplicaFiltriAsync(adatta: false);
        AggiornaIndirizzo();
    }

    /// <summary>Clic su una voce della legenda: solo quei vigneti; di nuovo clic sulla stessa, tutti.</summary>
    private async Task ClasseLegendaAsync(int classe)
    {
        _classeFiltro = _classeFiltro == classe ? null : classe;
        await ApplicaFiltriAsync(adatta: false);
        AggiornaIndirizzo(); // il vigneto selezionato può essere uscito dal filtro
    }

    /// <summary>Altro ordine dell'elenco: solo l'elenco cambia, la mappa no.</summary>
    private void OrdineCambiato()
    {
        AggiornaVociElenco();
        AggiornaIndirizzo();
    }

    private void CommutaFiltri()
    {
        FiltriChiusi = !FiltriChiusi;
        AggiornaIndirizzo();
    }

    private void CommutaTemi()
    {
        TemiChiusi = !TemiChiusi;
        AggiornaIndirizzo();
    }

    /// <summary>Filtri Vigna/Vitigno scelti, per il riquadro Filtri chiuso.</summary>
    private int FiltriAttivi => (VignaFiltro != "" ? 1 : 0) + (VitignoFiltro != "" ? 1 : 0) + (SoloPuntoNascosti ? 1 : 0);

    /// <summary>«Inquadra»: la camera torna su tutti i vigneti dell'elenco (filtrati), come all'apertura.</summary>
    private async Task InquadraAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("inquadraVigneti", _mapElementId);
        }
    }

    /// <summary>
    /// Un anno della barra: cambia l'anno della pillola attiva. La mappa si ricolora sui dati già
    /// caricati, nessuna richiesta.
    /// </summary>
    private async Task ScegliAnnoBarraAsync(int anno)
    {
        if (Confronto && _sceltaDa)
        {
            if (anno == AnnoDa || anno == Anno)
            {
                return;
            }
            AnnoDa = anno;
        }
        else
        {
            if (anno == Anno || (Confronto && anno == AnnoDa))
            {
                return;
            }
            Anno = anno;
        }
        await TematismoCambiatoAsync();
    }

    /// <summary>«+ Confronta con…»: propone l'anno precedente e attiva la sua pillola. Il filtro per voce decade.</summary>
    private async Task AccendiConfrontoAsync()
    {
        if (Anno is { } anno && ConfrontoBigot.AnnoDaPredefinito(AnniCursore, anno) is { } da)
        {
            AnnoDa = da;
            _sceltaDa = true;
            await ParametroCambiatoAsync();
        }
    }

    /// <summary>La × sulla seconda pillola: si torna all'anno solo.</summary>
    private async Task SpegniConfrontoAsync()
    {
        AnnoDa = null;
        _sceltaDa = false;
        await ParametroCambiatoAsync();
    }

    private string NomeVigneto(int id) => _vigneti?.FirstOrDefault(v => v.Id == id)?.Nome ?? $"Vigneto {id}";

    /// <summary>
    /// Filtri Vigna/Vitigno (a cascata): elenco, mappa e conteggi della legenda sui soli vigneti
    /// filtrati. adatta = true porta la camera sui vigneti filtrati.
    /// </summary>
    private async Task ApplicaFiltriAsync(bool adatta)
    {
        if (_vigneti is null)
        {
            return;
        }

        var vignaId = int.TryParse(VignaFiltro, out var vg) ? vg : (int?)null;
        _opzioniVitigni = FiltriVigneti.Vitigni(_vigneti, vignaId);
        if (int.TryParse(VitignoFiltro, out var vtCorrente) && _opzioniVitigni.All(o => o.Id != vtCorrente))
        {
            VitignoFiltro = ""; // vitigno non presente nella vigna scelta
        }

        var vitignoId = int.TryParse(VitignoFiltro, out var vt) ? vt : (int?)null;
        var filtrati = FiltriVigneti.Applica(_vigneti, vignaId, vitignoId);
        if (SoloPuntoNascosti)
        {
            filtrati = filtrati.Where(v => !v.SoloPunto).ToList();
        }

        // La legenda conta i vigneti di Vigna/Vitigno; la voce scelta restringe poi elenco e mappa
        // ai soli vigneti sulla mappa (con geometria), così il contatore coincide col conteggio.
        var perJs = CalcolaTematismo(filtrati);
        if (_classificazione is null)
        {
            _classeFiltro = null;
        }
        _vignetiFiltrati = _classeFiltro is null
            ? filtrati
            : TematismiBigot.FiltraPerClasse(filtrati.Where(v => v.HaGeometria).ToList(), v => v.Id, _classificazione, _classeFiltro);
        var filtroAttivo = vignaId is not null || vitignoId is not null || _classeFiltro is not null || SoloPuntoNascosti;

        if (_vignetoSelezionatoId is { } selezionato && _vignetiFiltrati.All(v => v.Id != selezionato))
        {
            _vignetoSelezionato = null;
            _vignetoSelezionatoId = null;
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("selezionaVigneto", _mapElementId, null);
            }
        }

        if (_module is not null)
        {
            await _module.InvokeVoidAsync("impostaFiltroVigneti", _mapElementId,
                filtroAttivo ? _vignetiFiltrati.Select(v => v.Id).ToList() : null, adatta);
            await _module.InvokeVoidAsync("impostaTematismo", _mapElementId, perJs);
        }
    }

    /// <summary>
    /// Carica gli indici BIGOT dell'azienda. Se il server non li ha ancora in memoria (la vista
    /// 4Grapes impiega ~40 s) riprova ogni <see cref="AttesaIndici"/>, fino a un massimo di tentativi.
    /// </summary>
    private async Task CaricaIndiciAsync(int aziendaId, CancellationToken ct)
    {
        try
        {
            for (var tentativo = 1; tentativo <= TentativiIndici && !ct.IsCancellationRequested; tentativo++)
            {
                var risposta = await VignetiApiClient.GetIndiciBigotAsync(aziendaId, ct);
                if (ct.IsCancellationRequested)
                {
                    return;
                }
                if (risposta.Pronto)
                {
                    await InvokeAsync(async () =>
                    {
                        _indici = risposta.Indici;
                        _aggiornamentoBigot = risposta.Aggiornamento is { } aggiornamento
                            ? TematismiBigot.EtichettaAggiornamento(aggiornamento, DateTimeOffset.UtcNow, TematismiBigot.FusoItalia)
                            : null;
                        _anni = risposta.Indici.Select(r => r.Anno).Distinct().OrderByDescending(a => a).ToList();
                        _indiciPronti = true;
                        ApplicaAnniIniziali(FonteTematismo.Bigot);
                        // Parametro già scelto (dal link o prima di un cambio azienda): riapplicato sui nuovi dati.
                        await ApplicaFiltriAsync(adatta: false);
                        StateHasChanged();
                        AggiornaIndirizzo();
                    });
                    return;
                }

                await InvokeAsync(() => { _statoIndici = "Indici BIGOT in preparazione sul server…"; StateHasChanged(); });
                await Task.Delay(AttesaIndici, ct);
            }

            await InvokeAsync(() => { _statoIndici = "Indici BIGOT non disponibili al momento."; StateHasChanged(); });
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // Pagina chiusa o azienda cambiata durante il caricamento.
        }
        catch (Exception ex)
        {
            // Anche un timeout dell'HttpClient (TaskCanceledException senza ct annullato) finisce qui.
            Logger.LogWarning("Indici BIGOT non disponibili ({Tipo}: {Messaggio})", ex.GetType().Name, ex.Message);
            await InvokeAsync(() => { _statoIndici = "Indici BIGOT non raggiungibili."; StateHasChanged(); });
        }
    }

    /// <summary>
    /// Anno e confronto del link quando arrivano BIGOT o statistiche. L'anno si sceglie sugli anni
    /// della fonte del parametro (BIGOT se non c'è o è senza anno); se arriva prima l'altra fonte se ne
    /// usa intanto un anno, poi lo si corregge. Il confronto vale solo sugli anni della sua fonte.
    /// </summary>
    private void ApplicaAnniIniziali(FonteTematismo arrivata)
    {
        var tema = Catalogo.Trova(TematismoId);
        var fonteAnno = tema is { SenzaAnno: false } ? tema.Fonte : FonteTematismo.Bigot;
        var definitiva = FontePronta(fonteAnno);
        var anni = AnniDi(definitiva ? fonteAnno : arrivata);

        if (_annoDaLink is { } annoLink && anni.Contains(annoLink))
        {
            Anno = annoLink;
        }
        else if (anni.Count > 0 && (Anno is null || (definitiva && !anni.Contains(Anno.Value))
                     || (tema is { AnnoRecente: true } && arrivata == fonteAnno)))
        {
            Anno = TematismiBigot.AnnoPredefinito(definitiva ? tema : null, anni, _annoCorrente);
        }

        if (definitiva)
        {
            _annoDaLink = null;
        }

        if (tema is null || tema.SenzaAnno || FontePronta(tema.Fonte))
        {
            AnnoDa = tema is { Confrontabile: true } && _confrontoDaLink is { } daLink && AnniDi(tema.Fonte).Contains(daLink) ? daLink : AnnoDa;
            _confrontoDaLink = null;
        }
    }


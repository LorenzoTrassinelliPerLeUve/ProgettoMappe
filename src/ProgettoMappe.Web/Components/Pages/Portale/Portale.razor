@page "/portale"
@page "/portale/{Chiave}"
@page "/nutrizione"
@page "/nutrizione/{Voce}"
@using ProgettoMappe.Web.Portale
@using ProgettoMappe.Web.Components.Portale
@using ProgettoMappe.Web.Components.Portale.Sezioni
@inject PortaleApiClient Api
@inject NavigationManager Nav

@*
    Il Portale 4Grapes in Mappe (task #225): a sinistra il menù delle sezioni, solo quelle che l'utente può aprire
    secondo ruoli e abilitazioni di 4Grapes (regole in Api/Portale/SezioniPortale); a destra la sezione scelta.
    Su /nutrizione lo stesso Portale con il menù del sotto-portale «Decision 4Grapes Nutrizione» del vecchio portale
    (Web/Portale/MenuNutrizione, task #293): stesse pagine, stesso ordine del vecchio. Una sezione nuova: docs/portale/LEGGIMI.md.
*@

<PageTitle>@(TitoloAperto is { } t ? $"{t} · {TitoloPagina}" : TitoloPagina)</PageTitle>

<div class="contenitore portale">
    <header class="intestazione-pagina">
        <h1 class="titolo-pagina">@TitoloPagina</h1>
        <p class="sottotitolo">@(_nutrizione
            ? "Le pagine del portale Nutrizione di 4Grapes, rifatte dentro Mappe. Vedi solo quelle che il tuo utente può usare."
            : "Le sezioni del portale di 4Grapes, rifatte dentro Mappe. Vedi solo quelle che il tuo utente può usare.")</p>
    </header>

    @if (_idUtente is null)
    {
        <div class="messaggio-errore" role="alert">
            <p>Per usare il Portale serve l'accesso con il tuo utente 4Grapes. Se sei già entrato prima di oggi, esci e rientra.</p>
            <a class="pulsante-principale" href="@(_nutrizione ? "accesso?ReturnUrl=%2Fnutrizione" : "accesso?ReturnUrl=%2Fportale")" data-enhance-nav="false">Accedi</a>
        </div>
    }
    else if (_errore is not null)
    {
        <div class="messaggio-errore" role="alert">
            <p>@_errore</p>
            <button type="button" class="pulsante-principale" @onclick="CaricaAsync">Riprova</button>
        </div>
    }
    else if (_utente is null)
    {
        <p class="aziende-stato" role="status">Carico i tuoi permessi…</p>
    }
    else
    {
        <div class="portale-corpo">
            <nav class="portale-menu" aria-label="Sezioni del Portale">
                @if (!_utente.PermessiLetti)
                {
                    <p class="portale-problema" role="status">@_utente.Problema Le voci restano spente finché non si leggono.</p>
                }
                else if (_utente.Problema is not null)
                {
                    <p class="portale-problema" role="status">@_utente.Problema</p>
                }
                @if (_nutrizione)
                {
                    <h2>Nutrizione</h2>
                    @foreach (var (gruppo, voci) in MenuNutrizione.Blocchi(MenuNutrizione.Visibili(_utente)))
                    {
                        @if (gruppo is not null)
                        {
                            <h2>@gruppo</h2>
                        }
                        <ul>
                            @foreach (var voce in voci)
                            {
                                <li><NavLink href="@($"nutrizione/{voce.Chiave}")">@voce.Titolo</NavLink></li>
                            }
                        </ul>
                    }
                    <ul>
                        <li><NavLink href="portale" Match="NavLinkMatch.All">← Torna al portale 4Grapes</NavLink></li>
                    </ul>
                }
                else
                {
                @foreach (var gruppo in _utente.Sezioni.GroupBy(s => s.Gruppo))
                {
                    var voci = gruppo.Where(s => s.Accessibile || !_utente.PermessiLetti).ToList();
                    if (voci.Count == 0)
                    {
                        continue;
                    }

                    <h2>@gruppo.Key</h2>
                    <ul>
                        @foreach (var voce in voci)
                        {
                            <li>
                                @if (voce.Accessibile)
                                {
                                    <NavLink href="@($"portale/{voce.Chiave}")">
                                        @voce.Titolo
                                        @if (!voce.Pronta)
                                        {
                                            <span class="portale-etichetta">in arrivo</span>
                                        }
                                    </NavLink>
                                }
                                else
                                {
                                    <span class="portale-voce-spenta" aria-disabled="true">@voce.Titolo</span>
                                }
                            </li>
                        }
                    </ul>
                }
                }
            </nav>

            <div class="portale-sezione">
                @if (_nutrizione && _chiaveVoce is null && _sezione is null)
                {
                    <h2>Benvenuto</h2>
                    <p>Scegli una pagina nel menù. Sono le pagine del portale Nutrizione di 4Grapes, nello stesso ordine.</p>
                }
                else if (!_nutrizione && Chiave is null)
                {
                    <h2>Benvenuto</h2>
                    <SezioneHome Utente="_utente" Scritture="_scritture" />
                    <p>Le sezioni arrivano a tappe: quelle segnate «in arrivo» ci sono già nel menù ma non sono ancora pronte.</p>
                    @if (_utente.PermessiLetti)
                    {
                        <h3>I tuoi permessi in 4Grapes</h3>
                        <p>Ruoli: @(_utente.Ruoli.Count > 0 ? string.Join(", ", _utente.Ruoli) : "nessuno")</p>
                        <ListaPortale TItem="string" Elementi="_utente.Abilitazioni" Colonne="ColonneAbilitazioni"
                                      TestoVuoto="Nessuna abilitazione." PerPagina="30" />
                    }
                }
                else if (_sezione is null)
                {
                    <p class="messaggio-errore" role="alert">Questa sezione non esiste o non hai il permesso di aprirla.</p>
                }
                else
                {
                    <h2>@TitoloAperto</h2>
                    @if (Pagine.TryGetValue(_sezione.Chiave, out var pagina))
                    {
                        <DynamicComponent Type="pagina" Parameters="Parametri" />
                    }
                    else
                    {
                        <p>@_sezione.Descrizione</p>
                        <p class="portale-in-arrivo">In arrivo: questa sezione è prevista nella tappa @_sezione.Tappa del piano.</p>
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string? Chiave { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? StatoAccesso { get; set; }

    /// <summary>
    /// Le sezioni pronte: chiave → componente (in Components/Portale/Sezioni), aperto qui accanto al menù con i parametri
    /// <c>Utente</c> (PortaleUtenteDto) e <c>Scritture</c> (StatoScrittureDto?). Le altre dicono «in arrivo».
    /// </summary>
    private static readonly IReadOnlyDictionary<string, Type> Pagine = new Dictionary<string, Type>(StringComparer.OrdinalIgnoreCase)
    {
        ["home"] = typeof(SezioneHome),
        ["indicatori"] = typeof(SezioneIndicatori),
        ["rilievi"] = typeof(SezioneRilievi),
        ["asportazioni"] = typeof(SezioneAsportazioni),
        ["galleria"] = typeof(SezioneGalleria),
        ["avversita"] = typeof(SezioneAvversita),
        ["fallanze"] = typeof(SezioneFallanze),
        ["analisi-uve"] = typeof(SezioneAnalisiUve),
        ["produzione"] = typeof(SezioneProduzione),
        ["analisi-terreni"] = typeof(SezioneAnalisiTerreni),
        ["linee-difesa"] = typeof(SezioneLineeDifesa),
        ["soglie-trattamenti"] = typeof(SezioneSoglie),
        ["irroratrici"] = typeof(SezioneIrroratrici),
        ["irroratrici-azienda"] = typeof(SezioneIrroratriciAzienda),
        ["concimazioni"] = typeof(SezioneConcimazioni),
        ["trattamenti"] = typeof(SezioneTrattamenti),
        ["bollettini"] = typeof(SezioneBollettini),
        ["utenti"] = typeof(SezioneUtenti),
        ["impostazioni"] = typeof(SezioneImpostazioni),
        ["abilitazioni"] = typeof(SezioneAbilitazioni),
        ["gruppi-utenti"] = typeof(SezioneGruppiUtenti),
        ["notifiche"] = typeof(SezioneNotifiche),
        ["account"] = typeof(SezioneAccount),
        ["vigneti"] = typeof(SezioneVigneti),
        ["dashboard-nutrizione"] = typeof(SezioneDashboardNutrizione),
    };

    private static readonly IReadOnlyList<ColonnaLista<string>> ColonneAbilitazioni =
        [new("Abilitazione", a => a)];

    private int? _idUtente;
    private PortaleUtenteDto? _utente;
    private StatoScrittureDto? _scritture;
    private string? _errore;
    private SezionePortaleDto? _sezione;
    private bool _nutrizione;
    private VoceNutrizione? _voce;
    private string? _chiaveVoce;

    /// <summary>La voce del menù Nutrizione (<c>/nutrizione/{Voce}</c>).</summary>
    [Parameter] public string? Voce { get; set; }

    private string TitoloPagina => _nutrizione ? MenuNutrizione.Titolo : "Portale 4Grapes";

    private string? TitoloAperto => _voce?.Titolo ?? _sezione?.Titolo;

    /// <summary>Utente e Scritture per tutte; Vista solo per le voci Nutrizione che aprono una pagina precisa della sezione.</summary>
    private Dictionary<string, object?> Parametri
    {
        get
        {
            var parametri = new Dictionary<string, object?> { ["Utente"] = _utente, ["Scritture"] = _scritture };
            if (_voce?.Vista is { } vista) parametri["Vista"] = vista;
            return parametri;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _idUtente = UtentePortale.IdUtente(StatoAccesso is null ? null : (await StatoAccesso).User);
        await CaricaAsync();
    }

    protected override void OnParametersSet()
    {
        // La stessa pagina serve /portale e /nutrizione: si decide dall'indirizzo, perché Blazor riusa il componente.
        var percorso = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/');
        _nutrizione = percorso.Equals("nutrizione", StringComparison.OrdinalIgnoreCase)
                      || percorso.StartsWith("nutrizione/", StringComparison.OrdinalIgnoreCase);
        _chiaveVoce = _nutrizione && percorso.Length > "nutrizione/".Length ? Voce : null;
        ScegliSezione();
    }

    private async Task CaricaAsync()
    {
        if (_idUtente is not { } id)
        {
            return;
        }

        _errore = null;
        var risposta = await Api.GetUtenteAsync(id);
        if (!risposta.Riuscita || risposta.Dati is null)
        {
            _errore = risposta.Errore ?? "Non riesco a leggere i tuoi permessi.";
            return;
        }

        _utente = risposta.Dati;
        _scritture = (await Api.GetScrittureAsync(id)).Dati;
        ScegliSezione();
    }

    /// <summary>
    /// Solo una sezione accessibile si apre: le altre dicono «non esiste o non hai il permesso». Su /nutrizione la voce sceglie
    /// la sezione; senza voce si apre la Dashboard, se l'utente la può vedere.
    /// </summary>
    private void ScegliSezione()
    {
        _voce = null;
        var chiave = Chiave;
        if (_nutrizione)
        {
            var visibili = _utente is null ? [] : MenuNutrizione.Visibili(_utente);
            var voce = _chiaveVoce is null ? visibili.FirstOrDefault(v => v.Chiave == "dashboard") : MenuNutrizione.Trova(_chiaveVoce);
            _voce = voce is not null && visibili.Contains(voce) ? voce : null;
            chiave = _voce?.Sezione;
        }

        _sezione = chiave is null ? null : _utente?.Sezioni.FirstOrDefault(s =>
            s.Accessibile && string.Equals(s.Chiave, chiave, StringComparison.OrdinalIgnoreCase));
    }
}
